{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.miraverse.mentor": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "talking": "query.is_sheared"
            }
          ]
        },
        "talking": {
          "animations": [
            "talk"
          ],
          "transitions": [
            {
              "idle": "!query.is_sheared"
            }
          ]
        }
      }
    }
  }
}
