      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">Phoenicia</string>
        </Properties>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Flow</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player journey for the Phoenicia slice, with the game engine behind a host table.
-- Mirrors apps/minecraft/scripts/src/phoenicia/flow.ts.
--
-- host.load(id) -> (ok, value)        ok=false means the store failed, not "no save yet"
-- host.save(id, value) -> boolean
-- host.position(id) -> { region, x, z }?
-- host.teleport(id, region, point)
-- host.ask(id, request) -> optionId?  yields until the player answers
-- host.say(id, text)
-- host.sail(id, fromRegion?, toRegion, seconds)  yields until the voyage ends

local Flow = {}
Flow.__index = Flow

function Flow.new(host, gate, content)
	return setmetatable({ host = host, gate = gate, content = content, sessions = {} }, Flow)
end

function Flow:translate(locale, key: string): string
	local entry = self.content.strings[key]
	if not entry then
		return key
	end
	local fallback = self.content.fallbackLocale
	return entry[locale or fallback] or entry[fallback] or key
end

function Flow:_t(session, key: string): string
	return self:translate(session.state.locale, key)
end

function Flow:_persist(playerId, session)
	if session.saveDisabled then
		return
	end
	if not self.host.save(playerId, session.state) then
		self.host.say(playerId, self:_t(session, "ui.save_failed"))
	end
end

function Flow:getState(playerId)
	local session = self.sessions[playerId]
	return session and session.state
end

function Flow:leave(playerId)
	self.sessions[playerId] = nil
end

function Flow:_direction(session): string
	local locale = session.state.locale or self.content.fallbackLocale
	return self.content.locales[locale].direction
end

function Flow:enter(playerId)
	local ok, value = self.host.load(playerId)
	local parsed = ok and self.gate:parseState(value) or nil
	local session = {
		state = parsed or self.gate:createState(playerId),
		-- After a failed load, writing could overwrite real progress with a fresh save.
		saveDisabled = not ok,
		busy = true,
	}
	self.sessions[playerId] = session

	local success, err = pcall(function()
		if session.saveDisabled then
			self.host.say(playerId, self:_t(session, "ui.save_failed"))
		end
		if not session.state.locale then
			local options = {}
			for _, id in { "en-US", "ar-LB", "fr-FR", "arabizi" } do
				table.insert(options, { id = id, label = self.content.locales[id].label })
			end
			local picked = self.host.ask(playerId, {
				title = self:_t(session, "ui.choose_language"),
				body = "",
				options = options,
				direction = "ltr",
			})
			session.state.locale = picked or self.content.fallbackLocale
		end
		local region = self.content.regions[session.state.region]
		if not session.state.arrived then
			session.state.arrived = true
			self:_persist(playerId, session)
			self.host.sail(playerId, nil, session.state.region, 6)
			self.host.teleport(playerId, session.state.region, region.points.arrival)
			self.host.say(playerId, self:_t(session, "ui.arrival"))
		else
			self.host.teleport(playerId, session.state.region, region.points.resume)
			self.host.say(playerId, self:_t(session, "ui.welcome_back"))
		end
	end)
	session.busy = false
	if not success then
		error(err)
	end
end

-- The action available at the player's current position, if any.
function Flow:promptFor(playerId): string?
	local session = self.sessions[playerId]
	local pos = self.host.position(playerId)
	if not session or not pos or session.busy then
		return nil
	end
	local current = self.gate:currentNode(session.state)
	local nodes = self.gate.quest.nodes
	local anchor = (current or nodes[#nodes]).anchor
	local dx, dz = pos.x - anchor.x, pos.z - anchor.z
	if pos.region ~= anchor.region or dx * dx + dz * dz > anchor.radius * anchor.radius then
		return nil
	end
	return self:_t(session, current and current.promptKey or "prompt.codex")
end

function Flow:interact(playerId)
	local session = self.sessions[playerId]
	if not session or session.busy or not self:promptFor(playerId) then
		return
	end
	session.busy = true
	local success, err = pcall(function()
		local node = self.gate:currentNode(session.state)
		if node then
			self:_playNode(playerId, session, node)
		else
			self:_showCodex(playerId, session)
		end
	end)
	session.busy = false
	if not success then
		error(err)
	end
end

function Flow:_playNode(playerId, session, node)
	while true do
		local options = {}
		for _, option in node.options do
			table.insert(options, { id = option.id, label = self:_t(session, option.labelKey) })
		end
		local choiceId = self.host.ask(playerId, {
			title = self:_t(session, node.titleKey),
			body = self:_t(session, node.bodyKey) .. "\n\n" .. self:_t(session, node.hintKey),
			options = options,
			direction = self:_direction(session),
		})
		if choiceId == nil or self.sessions[playerId] ~= session then
			return
		end
		local pos = self.host.position(playerId)
		if not pos then
			return
		end
		session.state.eventSeq += 1
		local code = self.gate:applyEvent(session.state, {
			eventId = node.id .. ":" .. session.state.eventSeq,
			nodeId = node.id,
			region = pos.region,
			x = pos.x,
			z = pos.z,
			choiceId = choiceId,
		})
		if code == "WRONG_CHOICE" then
			self:_persist(playerId, session)
			for _, option in node.options do
				if option.id == choiceId then
					self.host.say(playerId, self:_t(session, option.feedbackKey))
				end
			end
		elseif code ~= "OK" and code ~= "QUEST_COMPLETED" then
			return
		else
			-- Saving first means a disconnect while sailing resumes at the destination.
			self:_persist(playerId, session)
			self.host.say(playerId, self:_t(session, node.successKey))
			if node.routeId then
				local route = self.content.routes[node.routeId]
				self.host.sail(playerId, route.from, route.to, route.gameSeconds)
				self.host.teleport(playerId, route.to, self.content.regions[route.to].points.arrival)
			end
			if code == "QUEST_COMPLETED" then
				self.host.say(playerId, self:_t(session, "ui.reward"))
			end
			return
		end
	end
end

function Flow:_showCodex(playerId, session)
	local lines = {}
	for _, entry in self.gate.quest.codex do
		local class = self:_t(session, "class." .. entry.classification)
		table.insert(lines, "[" .. class .. "]\n" .. self:_t(session, entry.textKey))
	end
	self.host.ask(playerId, {
		title = self:_t(session, "codex.title"),
		body = table.concat(lines, "\n\n"),
		options = { { id = "close", label = self:_t(session, "ui.continue") } },
		direction = self:_direction(session),
	})
end

return Flow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Gate</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Server-side validation in front of the quest state machine for Phoenicia quests.
-- Mirrors apps/minecraft/scripts/src/phoenicia/gate.ts; tests/phoenicia/vectors.json checks both.
-- Dependencies are passed in so this runs under Lune as well as on a Roblox server.

local Gate = {}
Gate.__index = Gate

local QUEST_ID = "TYR-05"
local SAVE_VERSION = 1
local MAX_PROCESSED_EVENTS = 64

Gate.QUEST_ID = QUEST_ID
Gate.SAVE_VERSION = SAVE_VERSION

function Gate.new(machine, content)
	local self = setmetatable({}, Gate)
	self.machine = machine
	self.content = content
	self.quest = content.quests[QUEST_ID]
	return self
end

function Gate:createState(userId: number)
	return {
		schemaVersion = SAVE_VERSION,
		region = self.quest.hub,
		record = self.machine.newDefinedRecord(userId, self.quest.countryCode, QUEST_ID),
		lifecycle = "AVAILABLE",
		attempts = 0,
		processedEventIds = {},
		storySparks = 0,
		artifacts = {},
		arrived = false,
		locale = nil,
		eventSeq = 0,
	}
end

-- Returns nil for anything that is not a valid save of this version.
function Gate:parseState(raw)
	if type(raw) ~= "table" or raw.schemaVersion ~= SAVE_VERSION then
		return nil
	end
	if type(raw.region) ~= "string" or type(self.content.regions[raw.region]) ~= "table" then
		return nil
	end
	local record = raw.record
	if type(record) ~= "table" or record.questId ~= QUEST_ID or type(record.completedSteps) ~= "table" then
		return nil
	end
	if type(record.currentStepIndex) ~= "number" or type(record.grantedEventIds) ~= "table" then
		return nil
	end
	if type(raw.processedEventIds) ~= "table" or type(raw.artifacts) ~= "table" or type(raw.storySparks) ~= "number" then
		return nil
	end
	return raw
end

function Gate:currentNode(state)
	local id = self.quest.nodeOrder[state.record.currentStepIndex]
	return id and self:findNode(id) or nil
end

function Gate:findNode(id)
	for _, node in self.quest.nodes do
		if node.id == id then
			return node
		end
	end
	return nil
end

local function remember(state, eventId: string)
	table.insert(state.processedEventIds, eventId)
	if #state.processedEventIds > MAX_PROCESSED_EVENTS then
		table.remove(state.processedEventIds, 1)
	end
end

function Gate:applyEvent(state, e): string
	if
		type(e) ~= "table"
		or type(e.eventId) ~= "string"
		or #e.eventId < 4
		or type(e.nodeId) ~= "string"
		or type(e.region) ~= "string"
		or type(e.x) ~= "number"
		or type(e.z) ~= "number"
	then
		return "INVALID_EVENT"
	end
	if table.find(state.processedEventIds, e.eventId) then
		return "DUPLICATE_EVENT"
	end
	if state.lifecycle == "COMPLETED" then
		return "ALREADY_COMPLETE"
	end

	local node = self:findNode(e.nodeId)
	if not node then
		return "UNKNOWN_NODE"
	end
	local current = self:currentNode(state)
	if not current or current.id ~= node.id then
		return "OUT_OF_ORDER"
	end

	local anchor = node.anchor
	if state.region ~= anchor.region or e.region ~= anchor.region then
		return "WRONG_REGION"
	end
	local dx, dz = e.x - anchor.x, e.z - anchor.z
	if dx * dx + dz * dz > anchor.radius * anchor.radius then
		return "OUT_OF_RANGE"
	end

	local option = nil
	for _, candidate in node.options do
		if candidate.id == e.choiceId then
			option = candidate
			break
		end
	end
	if not option then
		return "INVALID_CHOICE"
	end

	if not option.correct then
		state.attempts += 1
		remember(state, e.eventId)
		return "WRONG_CHOICE"
	end

	local ok, machineCode = self.machine.submitDefinedNode(state.record, self.quest.nodeOrder, e.eventId, node.id)
	if not ok then
		return "OUT_OF_ORDER"
	end
	remember(state, e.eventId)
	if node.arriveRegion then
		state.region = node.arriveRegion
	end
	if machineCode ~= "CHAPTER_COMPLETED" then
		state.lifecycle = "OBJECTIVE_PROGRESS"
		return "OK"
	end

	state.lifecycle = "COMPLETED"
	local reward = self.quest.reward
	if not table.find(state.artifacts, reward.artifactId) then
		state.storySparks += reward.storySparks
		table.insert(state.artifacts, reward.artifactId)
	end
	return "QUEST_COMPLETED"
end

-- Engine-neutral view of the state, compared against the shared test vectors.
function Gate:snapshot(state)
	local completed = {}
	for _, id in self.quest.nodeOrder do
		if state.record.completedSteps[id] then
			table.insert(completed, id)
		end
	end
	return {
		lifecycle = state.lifecycle,
		completed = completed,
		region = state.region,
		storySparks = state.storySparks,
		artifacts = table.clone(state.artifacts),
		attempts = state.attempts,
	}
end

return Gate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Service</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Binds the Phoenicia flow to Roblox: world, NPCs, prompts, remotes, voyages and DataStore saves.
-- Only started when Workspace has the MV_PHOENICIA attribute.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Content = require(ReplicatedStorage:WaitForChild("MiraVerseShared"):WaitForChild("Phoenicia"):WaitForChild("Content"))
local Machine = require(script.Parent.Parent.QuestEngine.ByblosQuestStateMachine)
local Gate = require(script.Parent.Gate)
local Flow = require(script.Parent.Flow)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Service = {}

local STORE_NAME = "MiraVersePhoenicia_v1"
local ASK_TIMEOUT_SECONDS = 120
local STORE_ATTEMPTS = 3
local SAIL_STEP_SECONDS = 0.1
local STAND_Y = Content.projection.landTopY + 1
local DECK_CLEARANCE_STUDS = 3

local gate = Gate.new(Machine, Content)
local flow
local remotes
local store
local ships = {}
local pendingAsks = {}
local nextAskToken = 0

local function withRetries(callback)
	local ok, result
	for attempt = 1, STORE_ATTEMPTS do
		ok, result = pcall(callback)
		if ok then
			return true, result
		end
		if attempt < STORE_ATTEMPTS then
			task.wait(attempt)
		end
	end
	return false, result
end

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function worldPoint(regionId, point)
	return WorldBuilder.unitToWorld(Content, regionId, point.x + 0.5, point.y or STAND_Y, point.z + 0.5)
end

local function positionOf(player)
	local root = rootOf(player)
	if not root then
		return nil
	end
	local s = Content.projection.robloxStudsPerUnit
	for id, region in Content.regions do
		local origin = region.origins.roblox
		local x = (root.Position.X - origin[1]) / s
		local z = (root.Position.Z - origin[2]) / s
		if math.abs(x) <= region.bounds and math.abs(z) <= region.bounds then
			return { region = id, x = x, z = z }
		end
	end
	return nil
end

-- Moves the region's ship between two points, carrying the player, then restores it.
local function animateShip(player, regionId, fromPoint, toPoint, seconds)
	local ship = ships[regionId]
	local root = rootOf(player)
	if not ship or not root then
		task.wait(seconds)
		return
	end
	local home = ship:GetPivot()
	local deck = worldPoint(regionId, Content.regions[regionId].points.shipDeck)
	local fromOffset = worldPoint(regionId, fromPoint) - deck
	local toOffset = worldPoint(regionId, toPoint) - deck
	local steps = math.max(1, math.floor(seconds / SAIL_STEP_SECONDS))
	root.Anchored = true
	for step = 0, steps do
		if not player.Parent or rootOf(player) ~= root then
			break
		end
		local offset = fromOffset:Lerp(toOffset, step / steps)
		ship:PivotTo(home + offset)
		root.CFrame = CFrame.new(deck + offset + Vector3.new(0, DECK_CLEARANCE_STUDS, 0))
		task.wait(SAIL_STEP_SECONDS)
	end
	ship:PivotTo(home)
	if root.Parent then
		root.Anchored = false
	end
end

local host = {}

function host.load(userId)
	if not store then
		return false, nil
	end
	return withRetries(function()
		return store:GetAsync(tostring(userId))
	end)
end

function host.save(userId, state)
	if not store then
		return false
	end
	local ok = withRetries(function()
		store:UpdateAsync(tostring(userId), function()
			return state
		end)
	end)
	return ok
end

function host.position(userId)
	local player = Players:GetPlayerByUserId(userId)
	return player and positionOf(player)
end

function host.teleport(userId, regionId, point)
	local player = Players:GetPlayerByUserId(userId)
	local character = player and player.Character
	if character then
		character:PivotTo(CFrame.new(worldPoint(regionId, point) + Vector3.new(0, DECK_CLEARANCE_STUDS, 0)))
	end
end

function host.ask(userId, request)
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return nil
	end
	nextAskToken += 1
	local token = nextAskToken
	pendingAsks[token] = { userId = userId, thread = coroutine.running(), options = request.options }
	remotes.Ask:FireClient(player, token, request)
	task.delay(ASK_TIMEOUT_SECONDS, function()
		local pending = pendingAsks[token]
		if pending then
			pendingAsks[token] = nil
			task.spawn(pending.thread, nil)
		end
	end)
	return coroutine.yield()
end

function host.say(userId, text)
	local player = Players:GetPlayerByUserId(userId)
	if player then
		remotes.Toast:FireClient(player, text)
	end
end

function host.sail(userId, fromRegion, toRegion, seconds)
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return
	end
	local state = flow:getState(userId)
	remotes.Toast:FireClient(player, flow:translate(state and state.locale, "ui.sailing"))
	if fromRegion then
		local from = Content.regions[fromRegion].points
		animateShip(player, fromRegion, from.shipDeck, from.seaApproach, seconds / 2)
	end
	local to = Content.regions[toRegion].points
	animateShip(player, toRegion, to.seaApproach, to.shipDeck, fromRegion and seconds / 2 or seconds)
end

local function buildNpc(regionId, npc, parent)
	local description = Instance.new("HumanoidDescription")
	local ok, rig = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		warn("Phoenicia: could not create NPC rig for " .. npc.id)
		return
	end
	rig.Name = npc.id
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = flow:translate("en-US", npc.nameKey)
	humanoid.WalkSpeed = 6
	rig:PivotTo(CFrame.new(worldPoint(regionId, npc) + Vector3.new(0, DECK_CLEARANCE_STUDS, 0)))
	rig.Parent = parent

	-- A small state machine: walk to the next waypoint, pause, repeat.
	task.spawn(function()
		local index = 1
		while rig.Parent do
			local waypoint = npc.patrol[index]
			humanoid:MoveTo(worldPoint(regionId, { x = waypoint[1], z = waypoint[2] }))
			humanoid.MoveToFinished:Wait()
			task.wait(3)
			index = index % #npc.patrol + 1
		end
	end)
end

local function addPrompt(regionId, anchor, parent)
	local part = Instance.new("Part")
	part.Name = "PhoeniciaAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Size = Vector3.new(2, 2, 2)
	part.Position = worldPoint(regionId, anchor) + Vector3.new(0, DECK_CLEARANCE_STUDS, 0)
	part.Parent = parent
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Interact"
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = anchor.radius * Content.projection.robloxStudsPerUnit
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		flow:interact(player.UserId)
	end)
end

local function createRemotes()
	local folder = Instance.new("Folder")
	folder.Name = "PhoeniciaRemotes"
	local function remote(name)
		local event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = folder
		return event
	end
	local result = { Ask = remote("Ask"), Answer = remote("Answer"), Toast = remote("Toast"), Objective = remote("Objective") }
	folder.Parent = ReplicatedStorage
	return result
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function()
		task.wait()
		local state = flow:getState(player.UserId)
		if state and state.arrived then
			host.teleport(player.UserId, state.region, Content.regions[state.region].points.resume)
		end
	end)
	if not player.Character then
		player.CharacterAdded:Wait()
	end
	flow:enter(player.UserId)
end

function Service.start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("Phoenicia: DataStore unavailable, progress will not be saved: " .. tostring(result))
	end

	flow = Flow.new(host, gate, Content)
	remotes = createRemotes()

	remotes.Answer.OnServerEvent:Connect(function(player, token, optionId)
		local pending = type(token) == "number" and pendingAsks[token]
		if not pending or pending.userId ~= player.UserId then
			return
		end
		for _, option in pending.options do
			if option.id == optionId then
				pendingAsks[token] = nil
				task.spawn(pending.thread, optionId)
				return
			end
		end
	end)

	for regionId in Content.regions do
		local folder = WorldBuilder.build(Content, regionId, Workspace.Terrain, Workspace)
		ships[regionId] = folder:FindFirstChild("Ship")
		for _, npc in Content.regions[regionId].npcs do
			buildNpc(regionId, npc, folder)
		end
	end
	local anchorsFolder = Workspace:FindFirstChild("Phoenicia_tyre")
	local seen = {}
	for _, node in Content.quests[Gate.QUEST_ID].nodes do
		local key = string.format("%s:%d:%d", node.anchor.region, node.anchor.x, node.anchor.z)
		if not seen[key] then
			seen[key] = true
			addPrompt(node.anchor.region, node.anchor, anchorsFolder)
		end
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		for token, pending in pendingAsks do
			if pending.userId == player.UserId then
				pendingAsks[token] = nil
				task.spawn(pending.thread, nil)
			end
		end
		flow:leave(player.UserId)
	end)

	-- Objective text for the HUD.
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				local state = flow:getState(player.UserId)
				if state then
					local node = gate:currentNode(state)
					local text = node and flow:translate(state.locale, node.promptKey)
						or flow:translate(state.locale, "prompt.codex")
					remotes.Objective:FireClient(player, flow:translate(state.locale, "quest.tyr05.title"), text)
				end
			end
			task.wait(1)
		end
	end)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds a compiled Phoenicia region. One layout unit is three studs, and unit y
-- covers studs [3y, 3y + 3), so a player standing on unit y + 1 has feet at 3(y + 1).

local WorldBuilder = {}

-- Terrain voxels are 4 studs, so land rows overlap slightly to avoid gaps.
local ROW_THICKNESS = 4
local SEABED_THICKNESS = 4

function WorldBuilder.unitToWorld(content, regionId: string, x: number, y: number, z: number): Vector3
	local origin = content.regions[regionId].origins.roblox
	local s = content.projection.robloxStudsPerUnit
	return Vector3.new(origin[1] + x * s, y * s, origin[2] + z * s)
end

local function addBox(content, regionId: string, box, parent)
	local s = content.projection.robloxStudsPerUnit
	local part = Instance.new("Part")
	part.Name = box.id
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(
		(box.max[1] - box.min[1] + 1) * s,
		(box.max[2] - box.min[2] + 1) * s,
		(box.max[3] - box.min[3] + 1) * s
	)
	local center = WorldBuilder.unitToWorld(
		content,
		regionId,
		(box.min[1] + box.max[1] + 1) / 2,
		(box.min[2] + box.max[2] + 1) / 2,
		(box.min[3] + box.max[3] + 1) / 2
	)
	part.CFrame = CFrame.new(center)
	local material = content.materials[box.material].roblox
	part.Color = Color3.fromRGB(material.color[1], material.color[2], material.color[3])
	part.Material = Enum.Material[material.material]
	part.Parent = parent
	return part
end

local function buildTerrain(content, regionId: string, terrain)
	local region = content.regions[regionId]
	local p = content.projection
	local s = p.robloxStudsPerUnit
	local origin = region.origins.roblox
	local span = (region.bounds * 2 + 1) * s
	local center = Vector3.new(origin[1], 0, origin[2])
	local seabedTop = p.seabedY * s
	local seaTop = (p.seaLevelY + 1) * s

	terrain:FillBlock(
		CFrame.new(center + Vector3.new(0, seabedTop - SEABED_THICKNESS / 2, 0)),
		Vector3.new(span, SEABED_THICKNESS, span),
		Enum.Material.Sand
	)
	terrain:FillBlock(
		CFrame.new(center + Vector3.new(0, (seabedTop + seaTop) / 2, 0)),
		Vector3.new(span, seaTop - seabedTop, span),
		Enum.Material.Water
	)
	for _, row in region.landRows do
		local landTop = (row.y + 1) * s
		for _, spanRow in row.spans do
			local width = (spanRow[2] - spanRow[1] + 1) * s
			local x = origin[1] + (spanRow[1] + spanRow[2] + 1) / 2 * s
			local z = origin[2] + (row.z + 0.5) * s
			terrain:FillBlock(
				CFrame.new(x, (seabedTop + landTop) / 2, z),
				Vector3.new(width, landTop - seabedTop, ROW_THICKNESS),
				Enum.Material.Limestone
			)
		end
	end
end

-- Returns the region's folder. Boxes in the "ship" group form a movable Model.
function WorldBuilder.build(content, regionId: string, terrain, parent)
	buildTerrain(content, regionId, terrain)

	local folder = Instance.new("Folder")
	folder.Name = "Phoenicia_" .. regionId
	local ship = Instance.new("Model")
	ship.Name = "Ship"
	ship.Parent = folder

	for _, box in content.regions[regionId].boxes do
		addBox(content, regionId, box, box.group == "ship" and ship or folder)
	end
	folder.Parent = parent
	return folder
end

return WorldBuilder
]]></string>
