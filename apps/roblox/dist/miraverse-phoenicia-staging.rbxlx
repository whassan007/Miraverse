		["codex.title"] = {
			["en-US"] = "Phoenician Codex: fact, legend and fiction",
			["ar-LB"] = "الموسوعة الفينيقية: حقيقة وأسطورة وخيال",
			["fr-FR"] = "Codex phénicien : faits, légendes et fiction",
			["arabizi"] = "El mawsou3a el finiqiyye: 7a2i2a w ostoura w khayal",
		},
		["course.coast_right"] = {
			["en-US"] = "Keep the coast on your right",
			["ar-LB"] = "خلّي الشط عيمينك",
			["fr-FR"] = "Garde la côte à ta droite",
			["arabizi"] = "Khalli el shatt 3a yaminak",
		},
		["course.coast_left"] = {
			["en-US"] = "Keep the coast on your left",
			["ar-LB"] = "خلّي الشط عشمالك",
			["fr-FR"] = "Garde la côte à ta gauche",
			["arabizi"] = "Khalli el shatt 3a shmalak",
		},
		["course.open_west"] = {
			["en-US"] = "Head straight out to the open sea",
			["ar-LB"] = "روح دغري عالبحر المفتوح",
			["fr-FR"] = "Pars droit vers le large",
			["arabizi"] = "Rou7 daghri 3al ba7r el maftou7",
		},
		["course.wrong_open_west"] = {
			["en-US"] = "West leads away from land, and Byblos and Tyre are both on this coast. Try another course.",
			["ar-LB"] = "الغرب بيبعّدك عن البر، وجبيل وصور عالشط نفسو. جرّب طريق تاني.",
			["fr-FR"] = "L'ouest t'éloigne de la terre, et Byblos et Tyr sont sur cette même côte. Essaie un autre cap.",
			["arabizi"] = "El gharb bib3eddak 3an el bar, w Jbeil w Sour 3al shatt nafso. Jarreb tari2 tene.",
		},
		["tyr05.accept.body"] = {
			["en-US"] = "Tyre's yards need straight cedar for a long-distance merchant ship. Sail north to Byblos, choose good timber from Arishat's yard and bring word back to me.",
			["ar-LB"] = "ورش صور بدها أرز مستقيم لمركب تجاري بعيد المدى. ابحر شمال لجبيل، نقّي خشب منيح من عند أريشات وارجع خبّرني.",
			["fr-FR"] = "Les chantiers de Tyr ont besoin de cèdre bien droit pour un navire marchand au long cours. Navigue au nord jusqu'à Byblos, choisis du bon bois chez Arishat et reviens me voir.",
			["arabizi"] = "War4et Sour badda arz mousta2im la markab tejari b3id. Eb7or shmal 3a Jbeil, na2e khashab mni7 men 3and Arishat w erja3 khabberni.",
		},
		["tyr05.accept.hint"] = {
			["en-US"] = "Your ship waits at the north harbor dock.",
			["ar-LB"] = "مركبك ناطرك عرصيف المرفأ الشمالي.",
			["fr-FR"] = "Ton navire t'attend au quai du port nord.",
			["arabizi"] = "Markabak nater 3a rasif el marfa el shamale.",
		},
		["tyr05.accept.yes"] = {
			["en-US"] = "I'll sail for Byblos",
			["ar-LB"] = "رح إبحر على جبيل",
			["fr-FR"] = "Je pars pour Byblos",
			["arabizi"] = "Ra7 eb7or 3a Jbeil",
		},
		["tyr05.accept.success"] = {
			["en-US"] = "Follow the street north, through the gate, to the dock.",
			["ar-LB"] = "امشي بالشارع شمال، من البوابة، للرصيف.",
			["fr-FR"] = "Suis la rue vers le nord, passe la porte et va au quai.",
			["arabizi"] = "Emshi bel share3 shmal, men el bawwabe, lal rasif.",
		},
		["tyr05.sail_north.title"] = {
			["en-US"] = "Set a course north to Byblos",
			["ar-LB"] = "حدّد طريقك شمال لجبيل",
			["fr-FR"] = "Cap au nord vers Byblos",
			["arabizi"] = "7added tari2ak shmal la Jbeil",
		},
		["tyr05.sail_north.body"] = {
			["en-US"] = "You are heading north along the Lebanese coast. Land lies to the east. How do you keep your ship on course?",
			["ar-LB"] = "إنت رايح شمال حد الشط اللبناني. البر من جهة الشرق. كيف بتضل عطريقك؟",
			["fr-FR"] = "Tu navigues vers le nord le long de la côte libanaise. La terre est à l'est. Comment garder ton cap ?",
			["arabizi"] = "Enta rayi7 shmal 7ad el shatt el lebnene. El bar men jihet el shar2. Kif btdall 3a tari2ak?",
		},
		["tyr05.sail_north.hint"] = {
			["en-US"] = "Face north. Which hand points east?",
			["ar-LB"] = "اتطلّع شمال. أي إيد بتأشّر عالشرق؟",
			["fr-FR"] = "Regarde vers le nord. Quelle main montre l'est ?",
			["arabizi"] = "Ttalla3 shmal. Ayya id bt2asher 3al shar2?",
		},
		["tyr05.sail_north.wrong_port"] = {
			["en-US"] = "Heading north with the coast on your left would put land to the west, but this coast lies east. Try again.",
			["ar-LB"] = "إذا رحت شمال والشط عشمالك، بيصير البر بالغرب، بس هالشط بالشرق. جرّب كمان مرة.",
			["fr-FR"] = "Vers le nord, la côte à gauche mettrait la terre à l'ouest, or elle est à l'est. Réessaie.",
			["arabizi"] = "Iza re7t shmal w el shatt 3a shmalak, byseer el bar bel gharb, bas hal shatt bel shar2. Jarreb kaman marra.",
		},
		["tyr05.sail_north.success"] = {
			["en-US"] = "The coast stays on your right as the ship runs north.",
			["ar-LB"] = "الشط بيضل عيمينك والمركب ماشي شمال.",
			["fr-FR"] = "La côte reste à ta droite tandis que le navire file au nord.",
			["arabizi"] = "El shatt byedall 3a yaminak w el markab mashi shmal.",
		},
		["tyr05.cedar.body"] = {
			["en-US"] = "Welcome to Byblos. Three stacks are for sale. Which timber should go into a ship's keel?",
			["ar-LB"] = "أهلا بجبيل. في تلات كومات للبيع. أي خشب لازم ينحط بعارضة المركب؟",
			["fr-FR"] = "Bienvenue à Byblos. Trois piles sont à vendre. Quel bois choisir pour la quille d'un navire ?",
			["arabizi"] = "Ahla b Jbeil. Fi tlet koumet lal bay3. Ayya khashab lezem yen7at b 3arodet el markab?",
		},
		["tyr05.cedar.hint"] = {
			["en-US"] = "Walk over and look at the stacks. Long voyages punish wood that warps or cracks.",
			["ar-LB"] = "روح اتطلّع عالكومات. السفر الطويل ما بيرحم الخشب اللي بيلتوي أو بيتشقّق.",
			["fr-FR"] = "Va voir les piles. Les longs voyages ne pardonnent pas au bois qui gauchit ou se fend.",
			["arabizi"] = "Rou7 ttalla3 3al koumet. El safar el tawil ma byer7am el khashab elli byelwi aw byetsha22a2.",
		},
		["tyr05.cedar.seasoned"] = {
			["en-US"] = "The pale, dried, straight trunks",
			["ar-LB"] = "الجذوع الفاتحة، الناشفة والمستقيمة",
			["fr-FR"] = "Les troncs clairs, secs et droits",
			["arabizi"] = "El jzou3 el fet7a, el nashfe w el mousta2ime",
		},
		["tyr05.cedar.green"] = {
			["en-US"] = "The freshly felled trunks, still green",
			["ar-LB"] = "الجذوع المقطوعة جديد، بعدها خضرا",
			["fr-FR"] = "Les troncs fraîchement coupés, encore verts",
			["arabizi"] = "El jzou3 el ma2tou3a jdid, ba3da khadra",
		},
		["tyr05.cedar.split"] = {
			["en-US"] = "The dark trunks, cracked along the grain",
			["ar-LB"] = "الجذوع الغامقة، المشقّقة بالطول",
			["fr-FR"] = "Les troncs sombres, fendus dans le sens du fil",
			["arabizi"] = "El jzou3 el ghem2a, el msha22a2a bel toul",
		},
		["tyr05.cedar.wrong_green"] = {
			["en-US"] = "Green wood is still drying and can warp as it does. Look again.",
			["ar-LB"] = "الخشب الأخضر بعدو عم ينشف وممكن يلتوي. اتطلّع كمان مرة.",
			["fr-FR"] = "Le bois vert sèche encore et peut gauchir. Regarde encore.",
			["arabizi"] = "El khashab el akhdar ba3do 3am yenshaf w momken yelwi. Ttalla3 kaman marra.",
		},
		["tyr05.cedar.wrong_split"] = {
			["en-US"] = "A crack along the grain weakens the whole beam. Look again.",
			["ar-LB"] = "الشق بالطول بيضعّف العارضة كلها. اتطلّع كمان مرة.",
			["fr-FR"] = "Une fente dans le fil affaiblit toute la poutre. Regarde encore.",
			["arabizi"] = "El sha22 bel toul byda33ef el 3arda kella. Ttalla3 kaman marra.",
		},
		["tyr05.cedar.success"] = {
			["en-US"] = "A good eye. Arishat marks your timber for shipment to Tyre.",
			["ar-LB"] = "عينك منيحة. أريشات علّمت خشبك للشحن على صور.",
			["fr-FR"] = "Bon œil. Arishat marque ton bois pour l'expédier à Tyr.",
			["arabizi"] = "3aynak mni7a. Arishat 3allamet khashabak lal sha7en 3a Sour.",
		},
		["tyr05.sail_south.title"] = {
			["en-US"] = "Set a course south to Tyre",
			["ar-LB"] = "حدّد طريقك جنوب لصور",
			["fr-FR"] = "Cap au sud vers Tyr",
			["arabizi"] = "7added tari2ak jnoub la Sour",
		},
		["tyr05.sail_south.body"] = {
			["en-US"] = "Now you are heading south, with cedar aboard. The land is still to the east. Which course keeps you safe?",
			["ar-LB"] = "هلق إنت رايح جنوب، والأرز معك. البر بعدو بالشرق. أي طريق بيخلّيك بأمان؟",
			["fr-FR"] = "Tu vas maintenant vers le sud, avec le cèdre à bord. La terre est toujours à l'est. Quel cap choisir ?",
			["arabizi"] = "Halla2 enta rayi7 jnoub, w el arz ma3ak. El bar ba3do bel shar2. Ayya tari2 bikhallik b aman?",
		},
		["tyr05.sail_south.hint"] = {
			["en-US"] = "You turned around, so your hands swapped sides.",
			["ar-LB"] = "إنت برمت، فإيديك بدّلوا مطارحهن.",
			["fr-FR"] = "Tu as fait demi-tour : tes mains ont changé de côté.",
			["arabizi"] = "Enta baramt, fa ideik baddalo matar7on.",
		},
		["tyr05.sail_south.wrong_starboard"] = {
			["en-US"] = "Heading south, your right hand points west, out to sea. The coast is on the other side. Try again.",
			["ar-LB"] = "وإنت رايح جنوب، إيدك اليمين بتأشّر عالغرب، صوب البحر. الشط من الجهة التانية. جرّب كمان مرة.",
			["fr-FR"] = "Vers le sud, ta main droite montre l'ouest et le large. La côte est de l'autre côté. Réessaie.",
			["arabizi"] = "W enta rayi7 jnoub, idak el yamin bt2asher 3al gharb, sob el ba7r. El shatt men el jihe el tenye. Jarreb kaman marra.",
		},
		["tyr05.sail_south.success"] = {
			["en-US"] = "With the coast on your left, the walls of Tyre rise ahead.",
			["ar-LB"] = "والشط عشمالك، بتبيّن حيطان صور قدّامك.",
			["fr-FR"] = "La côte à ta gauche, les murailles de Tyr se dressent devant toi.",
			["arabizi"] = "W el shatt 3a shmalak, btban 7itan Sour 2eddemak.",
		},
		["tyr05.commission.body"] = {
			["en-US"] = "You chose well, and the timber is on its way. Shall we commission the shipwrights to lay the keel?",
			["ar-LB"] = "نقّيت منيح، والخشب بالطريق. منكلّف النجارين يبلّشوا بالعارضة؟",
			["fr-FR"] = "Bon choix, le bois est en route. Commandons-nous aux charpentiers de poser la quille ?",
			["arabizi"] = "Na2ayt mni7, w el khashab bel tari2. Mnkallef el najjarin yballsho bel 3arda?",
		},
		["tyr05.commission.hint"] = {
			["en-US"] = "This is the last step of the voyage.",
			["ar-LB"] = "هيدي آخر خطوة بالرحلة.",
			["fr-FR"] = "C'est la dernière étape du voyage.",
			["arabizi"] = "Haydi akher khatwe bel re7le.",
		},
		["tyr05.commission.yes"] = {
			["en-US"] = "Commission the merchant ship",
			["ar-LB"] = "كلّف ببناء المركب التجاري",
			["fr-FR"] = "Commander le navire marchand",
			["arabizi"] = "Kallef b bina el markab el tejari",
		},
		["tyr05.commission.success"] = {
			["en-US"] = "The keel of a new Tyrian merchant ship is laid. You connected Tyre and Byblos.",
			["ar-LB"] = "انحطّت عارضة مركب تجاري جديد لصور. وصّلت صور بجبيل.",
			["fr-FR"] = "La quille d'un nouveau navire marchand de Tyr est posée. Tu as relié Tyr et Byblos.",
			["arabizi"] = "En7attet 3arodet markab tejari jdid la Sour. Wassalt Sour b Jbeil.",
		},
		["quest.tyr05.title"] = {
			["en-US"] = "The Cedar Fleet",
			["ar-LB"] = "أسطول الأرز",
			["fr-FR"] = "La flotte de cèdre",
			["arabizi"] = "Ostoul el arz",
		},
		["codex.island"] = {
			["en-US"] = "Early Tyre stood on an island close to the coast, with a second settlement on the mainland, known as Ushu and later Palaetyrus.",
			["ar-LB"] = "صور القديمة كانت على جزيرة قريبة من الشط، مع مستوطنة تانية عالبر اسمها أوشو وبعدين باليتيروس.",
			["fr-FR"] = "La Tyr ancienne se dressait sur une île proche de la côte, avec un second établissement sur le continent, Ushu, plus tard Palaetyrus.",
			["arabizi"] = "Sour el 2adime kenet 3a jazira 2arib men el shatt, ma3 mostawtana tenye 3al bar esma Ushu w ba3den Palaetyrus.",
		},
		["codex.harbors"] = {
			["en-US"] = "Scholars name a northern 'Sidonian' and a southern 'Egyptian' harbor. The north has submerged evidence; the location of the south is still uncertain.",
			["ar-LB"] = "الباحثين بيسمّوا مرفأ شمالي 'صيداوي' ومرفأ جنوبي 'مصري'. الشمالي عليه أدلة تحت المي؛ ومطرح الجنوبي بعد مش أكيد.",
			["fr-FR"] = "Les chercheurs parlent d'un port nord « sidonien » et d'un port sud « égyptien ». Le nord a des traces immergées ; l'emplacement du sud reste incertain.",
			["arabizi"] = "El ba7sin bysammo marfa shamale 'Saydawi' w marfa jnoube 'Masri'. El shamale 3le adelle ta7t el mayy; w matra7 el jnoube ba3d mish akid.",
		},
		["codex.byblos_timber"] = {
			["en-US"] = "Timber from Byblos reached Egypt very early: First Dynasty tombs used it.",
			["ar-LB"] = "خشب جبيل وصل على مصر من بكير كتير: مقابر الأسرة الأولى استعملتو.",
			["fr-FR"] = "Le bois de Byblos a atteint l'Égypte très tôt : des tombes de la Ire dynastie l'ont utilisé.",
			["arabizi"] = "Khashab Jbeil wosel 3a Masr men bakkir ktir: ma2aber el osra el oula esta3malato.",
		},
		["codex.wenamun"] = {
			["en-US"] = "The Story of Wenamun describes an Egyptian envoy bargaining for lumber with Zakar-Baal of Byblos. Most Egyptologists now consider it mostly fiction.",
			["ar-LB"] = "قصة ونآمون بتحكي عن مبعوث مصري بيفاصل على خشب مع زكر بعل ملك جبيل. أغلب علماء المصريات هلق بيعتبروها خيال بمعظمها.",
			["fr-FR"] = "Le Récit d'Ounamon montre un envoyé égyptien négociant du bois avec Zakar-Baal de Byblos. La plupart des égyptologues le jugent aujourd'hui surtout fictif.",
			["arabizi"] = "2ossat Wenamun bte7ke 3an mab3outh Masri bifasel 3a khashab ma3 Zakar-Baal malak Jbeil. Aghlab 3oulama el masriyyat halla2 by3tabrouha khayal b mo3zama.",
		},
		["codex.league"] = {
			["en-US"] = "The Phoenician Maritime League is invented for this game. Phoenician cities were independent and never formed one state.",
			["ar-LB"] = "الرابطة البحرية الفينيقية مخترعة لهيدي اللعبة. المدن الفينيقية كانت مستقلة وما شكّلت دولة وحدة.",
			["fr-FR"] = "La Ligue maritime phénicienne est inventée pour ce jeu. Les cités phéniciennes étaient indépendantes et n'ont jamais formé un seul État.",
			["arabizi"] = "El rabta el ba7riyye el finiqiyye mokhtara3a la haydi el le3bi. El modon el finiqiyye kenet mosta2ille w ma shakkalet dawle wa7de.",
		},
	},
}
]]></string>
