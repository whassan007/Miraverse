			["arabizi"] = "Hanno, tejer el arz",
		},
		["npc.arishat"] = {
			["en-US"] = "Arishat, cedar broker",
			["ar-LB"] = "أريشات، سمسارة الأرز",
			["fr-FR"] = "Arishat, courtière en cèdre",
			["arabizi"] = "Arishat, samsaret el arz",
		},
		["npc.harbor_master"] = {
			["en-US"] = "Harbor master",
			["ar-LB"] = "مدير المرفأ",
			["fr-FR"] = "Maître du port",
			["arabizi"] = "Modir el marfa",
