		["ui.arrival"] = {
			["en-US"] = "Your ship nears Tyre, the island city. Go ashore and find Hanno in the Great Market.",
			["ar-LB"] = "مركبك قرّب على صور، مدينة الجزيرة. انزل عالبر ودوّر على حنّو بالسوق الكبير.",
			["fr-FR"] = "Ton navire approche de Tyr, la cité insulaire. Débarque et trouve Hannon au Grand Marché.",
