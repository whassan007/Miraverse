		["prompt.talk_arishat"] = {
			["en-US"] = "Talk to Arishat",
			["ar-LB"] = "احكي مع أريشات",
			["fr-FR"] = "Parler à Arishat",
			["arabizi"] = "E7ki ma3 Arishat",
		},
		["prompt.board_ship"] = {
			["en-US"] = "Board the ship",
			["ar-LB"] = "اطلع عالمركب",
			["fr-FR"] = "Monter à bord",
			["arabizi"] = "Tla3 3al markab",
		},
		["prompt.codex"] = {
			["en-US"] = "Open the Codex",
			["ar-LB"] = "افتح الموسوعة",
			["fr-FR"] = "Ouvrir le Codex",
			["arabizi"] = "Efta7 el mawsou3a",
		},
		["codex.title"] = {
			["en-US"] = "Phoenician Codex: fact, legend and fiction",
			["ar-LB"] = "الموسوعة الفينيقية: حقيقة وأسطورة وخيال",
			["fr-FR"] = "Codex phénicien : faits, légendes et fiction",
			["arabizi"] = "El mawsou3a el finiqiyye: 7a2i2a w ostoura w khayal",
		},
		["course.coast_right"] = {
			["en-US"] = "Keep the coast on your right",
			["ar-LB"] = "خلّي الشط عيمينك",
			["fr-FR"] = "Garde la côte à ta droite",
			["arabizi"] = "Khalli el shatt 3a yaminak",
		},
		["course.coast_left"] = {
			["en-US"] = "Keep the coast on your left",
			["ar-LB"] = "خلّي الشط عشمالك",
			["fr-FR"] = "Garde la côte à ta gauche",
			["arabizi"] = "Khalli el shatt 3a shmalak",
		},
		["course.open_west"] = {
			["en-US"] = "Head straight out to the open sea",
			["ar-LB"] = "روح دغري عالبحر المفتوح",
			["fr-FR"] = "Pars droit vers le large",
			["arabizi"] = "Rou7 daghri 3al ba7r el maftou7",
		},
		["course.wrong_open_west"] = {
			["en-US"] = "West leads away from land, and Byblos and Tyre are both on this coast. Try another course.",
			["ar-LB"] = "الغرب بيبعّدك عن البر، وجبيل وصور عالشط نفسو. جرّب طريق تاني.",
			["fr-FR"] = "L'ouest t'éloigne de la terre, et Byblos et Tyr sont sur cette même côte. Essaie un autre cap.",
			["arabizi"] = "El gharb bib3eddak 3an el bar, w Jbeil w Sour 3al shatt nafso. Jarreb tari2 tene.",
		},
		["tyr05.accept.body"] = {
			["en-US"] = "Tyre's yards need straight cedar for a long-distance merchant ship. Sail north to Byblos, choose good timber from Arishat's yard and bring word back to me.",
			["ar-LB"] = "ورش صور بدها أرز مستقيم لمركب تجاري بعيد المدى. ابحر شمال لجبيل، نقّي خشب منيح من عند أريشات وارجع خبّرني.",
			["fr-FR"] = "Les chantiers de Tyr ont besoin de cèdre bien droit pour un navire marchand au long cours. Navigue au nord jusqu'à Byblos, choisis du bon bois chez Arishat et reviens me voir.",
			["arabizi"] = "War4et Sour badda arz mousta2im la markab tejari b3id. Eb7or shmal 3a Jbeil, na2e khashab mni7 men 3and Arishat w erja3 khabberni.",
		},
		["tyr05.accept.hint"] = {
			["en-US"] = "Your ship waits at the north harbor dock.",
			["ar-LB"] = "مركبك ناطرك عرصيف المرفأ الشمالي.",
			["fr-FR"] = "Ton navire t'attend au quai du port nord.",
			["arabizi"] = "Markabak nater 3a rasif el marfa el shamale.",
		},
		["tyr05.accept.yes"] = {
			["en-US"] = "I'll sail for Byblos",
			["ar-LB"] = "رح إبحر على جبيل",
			["fr-FR"] = "Je pars pour Byblos",
			["arabizi"] = "Ra7 eb7or 3a Jbeil",
		},
		["tyr05.accept.success"] = {
			["en-US"] = "Follow the street north, through the gate, to the dock.",
			["ar-LB"] = "امشي بالشارع شمال، من البوابة، للرصيف.",
			["fr-FR"] = "Suis la rue vers le nord, passe la porte et va au quai.",
			["arabizi"] = "Emshi bel share3 shmal, men el bawwabe, lal rasif.",
		},
		["tyr05.sail_north.title"] = {
			["en-US"] = "Set a course north to Byblos",
			["ar-LB"] = "حدّد طريقك شمال لجبيل",
			["fr-FR"] = "Cap au nord vers Byblos",
			["arabizi"] = "7added tari2ak shmal la Jbeil",
		},
		["tyr05.sail_north.body"] = {
			["en-US"] = "You are heading north along the Lebanese coast. Land lies to the east. How do you keep your ship on course?",
			["ar-LB"] = "إنت رايح شمال حد الشط اللبناني. البر من جهة الشرق. كيف بتضل عطريقك؟",
			["fr-FR"] = "Tu navigues vers le nord le long de la côte libanaise. La terre est à l'est. Comment garder ton cap ?",
			["arabizi"] = "Enta rayi7 shmal 7ad el shatt el lebnene. El bar men jihet el shar2. Kif btdall 3a tari2ak?",
		},
		["tyr05.sail_north.hint"] = {
			["en-US"] = "Face north. Which hand points east?",
			["ar-LB"] = "اتطلّع شمال. أي إيد بتأشّر عالشرق؟",
			["fr-FR"] = "Regarde vers le nord. Quelle main montre l'est ?",
			["arabizi"] = "Ttalla3 shmal. Ayya id bt2asher 3al shar2?",
		},
		["tyr05.sail_north.wrong_port"] = {
			["en-US"] = "Heading north with the coast on your left would put land to the west, but this coast lies east. Try again.",
			["ar-LB"] = "إذا رحت شمال والشط عشمالك، بيصير البر بالغرب، بس هالشط بالشرق. جرّب كمان مرة.",
			["fr-FR"] = "Vers le nord, la côte à gauche mettrait la terre à l'ouest, or elle est à l'est. Réessaie.",
			["arabizi"] = "Iza re7t shmal w el shatt 3a shmalak, byseer el bar bel gharb, bas hal shatt bel shar2. Jarreb kaman marra.",
		},
		["tyr05.sail_north.success"] = {
			["en-US"] = "The coast stays on your right as the ship runs north.",
			["ar-LB"] = "الشط بيضل عيمينك والمركب ماشي شمال.",
			["fr-FR"] = "La côte reste à ta droite tandis que le navire file au nord.",
			["arabizi"] = "El shatt byedall 3a yaminak w el markab mashi shmal.",
		},
		["tyr05.cedar.body"] = {
			["en-US"] = "Welcome to Byblos. Three stacks are for sale. Which timber should go into a ship's keel?",
			["ar-LB"] = "أهلا بجبيل. في تلات كومات للبيع. أي خشب لازم ينحط بعارضة المركب؟",
			["fr-FR"] = "Bienvenue à Byblos. Trois piles sont à vendre. Quel bois choisir pour la quille d'un navire ?",
			["arabizi"] = "Ahla b Jbeil. Fi tlet koumet lal bay3. Ayya khashab lezem yen7at b 3arodet el markab?",
		},
		["tyr05.cedar.hint"] = {
			["en-US"] = "Walk over and look at the stacks. Long voyages punish wood that warps or cracks.",
			["ar-LB"] = "روح اتطلّع عالكومات. السفر الطويل ما بيرحم الخشب اللي بيلتوي أو بيتشقّق.",
			["fr-FR"] = "Va voir les piles. Les longs voyages ne pardonnent pas au bois qui gauchit ou se fend.",
			["arabizi"] = "Rou7 ttalla3 3al koumet. El safar el tawil ma byer7am el khashab elli byelwi aw byetsha22a2.",
		},
		["tyr05.cedar.seasoned"] = {
			["en-US"] = "The pale, dried, straight trunks",
			["ar-LB"] = "الجذوع الفاتحة، الناشفة والمستقيمة",
			["fr-FR"] = "Les troncs clairs, secs et droits",
			["arabizi"] = "El jzou3 el fet7a, el nashfe w el mousta2ime",
		},
		["tyr05.cedar.green"] = {
			["en-US"] = "The freshly felled trunks, still green",
			["ar-LB"] = "الجذوع المقطوعة جديد، بعدها خضرا",
			["fr-FR"] = "Les troncs fraîchement coupés, encore verts",
			["arabizi"] = "El jzou3 el ma2tou3a jdid, ba3da khadra",
		},
		["tyr05.cedar.split"] = {
			["en-US"] = "The dark trunks, cracked along the grain",
			["ar-LB"] = "الجذوع الغامقة، المشقّقة بالطول",
			["fr-FR"] = "Les troncs sombres, fendus dans le sens du fil",
			["arabizi"] = "El jzou3 el ghem2a, el msha22a2a bel toul",
		},
		["tyr05.cedar.wrong_green"] = {
			["en-US"] = "Green wood is still drying and can warp as it does. Look again.",
			["ar-LB"] = "الخشب الأخضر بعدو عم ينشف وممكن يلتوي. اتطلّع كمان مرة.",
			["fr-FR"] = "Le bois vert sèche encore et peut gauchir. Regarde encore.",
			["arabizi"] = "El khashab el akhdar ba3do 3am yenshaf w momken yelwi. Ttalla3 kaman marra.",
		},
		["tyr05.cedar.wrong_split"] = {
