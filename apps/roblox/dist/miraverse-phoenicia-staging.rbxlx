<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">MiraVerse</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Challenges</string>
          <string name="Source"><![CDATA[-- Server-validated challenge runner. All state lives on the server; client
-- input arrives via ReplicatedStorage.ChallengeRemotes.Action and is validated
-- by the per-type handler. Nothing is persisted or sent off-platform.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Challenges = {}

local HANDLERS = {
	gather = "Gather",
	cook = "Cook",
	build = "Build",
	trade = "Trade",
	word = "Word",
}

local active = {} -- [Player] = session
local remotes = nil
local inventory = nil -- optional provider: { has, remove, add }

local function getRemotes()
	if remotes then
		return remotes
	end
	local folder = ReplicatedStorage:FindFirstChild("ChallengeRemotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ChallengeRemotes"
		folder.Parent = ReplicatedStorage
	end
	local function ensure(name)
		local r = folder:FindFirstChild(name)
		if not r then
			r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
		return r
	end
	remotes = { Action = ensure("Action"), Notify = ensure("Notify"), State = ensure("State") }
	if RunService:IsServer() then
		remotes.Action.OnServerEvent:Connect(function(player, challengeId, action)
			local session = active[player]
			if not session or session.done or session.challenge.id ~= challengeId then
				return
			end
			if type(action) ~= "table" then
				return
			end
			if session.busy then
				return
			end
			session.busy = true
			local ok, err = pcall(session.handler.onAction, session.handler, action)
			session.busy = false
			if not ok then
				warn("[Challenges] handler error: " .. tostring(err))
			end
		end)
	end
	return remotes
end

-- Creates the remotes up front so clients can subscribe before the first challenge.
function Challenges.init()
	getRemotes()
end

-- Optional hook so the host game can back items with a real inventory.
function Challenges.setInventoryProvider(provider)
	inventory = provider
end

-- Local ledger fallback when no provider is installed (session-only).
local ledgers = {}
local function ledgerOf(player)
	local l = ledgers[player]
	if not l then
		l = {}
		ledgers[player] = l
	end
	return l
end

local function invHas(player, item, count)
	if inventory and inventory.has then
		return inventory.has(player, item, count)
	end
	return (ledgerOf(player)[item] or 0) >= count
end

local function invAdd(player, item, count)
	if inventory and inventory.add then
		inventory.add(player, item, count)
		return
	end
	local l = ledgerOf(player)
	l[item] = (l[item] or 0) + count
end

local function invRemove(player, item, count)
	if inventory and inventory.remove then
		inventory.remove(player, item, count)
		return
	end
	local l = ledgerOf(player)
	l[item] = math.max(0, (l[item] or 0) - count)
end

local function cleanup(session)
	if session.cleaned then
		return
	end
	session.cleaned = true
	for _, c in ipairs(session.connections) do
		c:Disconnect()
	end
	table.clear(session.connections)
	if session.folder then
		session.folder:Destroy()
	end
	if active[session.player] == session then
		active[session.player] = nil
	end
end

local function buildContext(session)
	local player, pack = session.player, session.pack
	local items = {}
	for _, it in ipairs(pack.items or {}) do
		items[it.id] = it
	end
	local ctx = {
		player = player,
		challenge = session.challenge,
		pack = pack,
		folder = session.folder,
		results = session.results,
	}

	function ctx.origin()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			local look = root.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.01 then
				flat = Vector3.new(0, 0, -1)
			end
			return CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
		return CFrame.new(0, 5, 0)
	end

	function ctx.itemName(id)
		return items[id] and items[id].name_en or tostring(id)
	end

	function ctx.itemColor(id)
		local it = items[id]
		if it and type(it.color) == "string" then
			local ok, c = pcall(Color3.fromHex, it.color)
			if ok then
				return c
			end
		end
		return Color3.fromRGB(200, 200, 200)
	end

	function ctx.isOwner(who)
		return who == player
	end

	-- Resolve a Touched/Click source to a Player.
	function ctx.playerFromPart(part)
		local model = part and part:FindFirstAncestorOfClass("Model")
		return model and Players:GetPlayerFromCharacter(model) or nil
	end

	function ctx.newPart(name, size, cframe, color, parent)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cframe
		p.Color = color
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = parent or session.folder
		return p
	end

	function ctx.label(part, text)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 40)
		gui.StudsOffset = Vector3.new(0, 2.5, 0)
		gui.AlwaysOnTop = true
		gui.Parent = part
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 0.3
		t.BackgroundColor3 = Color3.new(1, 1, 1)
		t.TextColor3 = Color3.new(0, 0, 0)
		t.TextScaled = true
		t.Text = text
		t.Parent = gui
		return gui
	end

	function ctx.click(part, fn)
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 40
		cd.Parent = part
		table.insert(session.connections, cd.MouseClick:Connect(function(who)
			if who == player and not session.done and not session.busy then
				session.busy = true
				local ok, err = pcall(fn, who)
				session.busy = false
				if not ok then
					warn("[Challenges] click error: " .. tostring(err))
				end
			end
		end))
		return cd
	end

	function ctx.connect(conn)
		table.insert(session.connections, conn)
	end

	function ctx.notify(text, kind)
		getRemotes().Notify:FireClient(player, session.challenge.id, text, kind or "info")
	end

	function ctx.progress(payload)
		getRemotes().State:FireClient(player, session.challenge.id, payload)
	end

	ctx.has = function(item, count)
		return invHas(player, item, count)
	end
	ctx.remove = function(item, count)
		invRemove(player, item, count)
	end
	ctx.grant = function(item, count)
		invAdd(player, item, count)
		table.insert(session.results, { item = item, count = count })
	end

	function ctx.finish(ok)
		if session.done then
			return
		end
		session.done = true
		session.success = ok and true or false
		session.finished:Fire()
	end

	return ctx
end

-- Blocks the calling thread until the challenge completes (true) or is
-- abandoned (false). Returns success, results.
function Challenges.run(player, challenge, pack)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
		return false, {}
	end
	if type(challenge) ~= "table" or type(pack) ~= "table" then
		return false, {}
	end
	if active[player] then
		return false, {} -- already running one; reject double submission
	end
	local moduleName = HANDLERS[challenge.type]
	if not moduleName then
		warn("[Challenges] unknown challenge type: " .. tostring(challenge.type))
		return false, {}
	end
	getRemotes()

	local session = {
		player = player,
		challenge = challenge,
		pack = pack,
		connections = {},
		results = {},
		done = false,
		busy = false,
		finished = Instance.new("BindableEvent"),
	}
	active[player] = session
	session.folder = Instance.new("Folder")
	session.folder.Name = "Challenge_" .. tostring(challenge.id) .. "_" .. tostring(player.UserId)
	session.folder.Parent = workspace

	table.insert(session.connections, Players.PlayerRemoving:Connect(function(who)
		if who == player then
			session.done = true
			session.success = false
			session.finished:Fire()
		end
	end))

	local ctx = buildContext(session)
	local okReq, handlerModule = pcall(function()
		return require(script:WaitForChild(moduleName))
	end)
	local started = okReq and pcall(function()
		session.handler = handlerModule.start(ctx)
	end)
	if not started or not session.handler then
		warn("[Challenges] failed to start " .. tostring(challenge.id))
		cleanup(session)
		session.finished:Destroy()
		return false, {}
	end

	ctx.notify(challenge.goal_en or challenge.title_en or "", "goal")
	if not session.done then
		session.finished.Event:Wait()
	end
	local success, results = session.success, session.results
	cleanup(session)
	session.finished:Destroy()
	ledgers[player] = player.Parent == Players and ledgers[player] or nil
	return success, results
end

-- Abort a running challenge (e.g. player walked away).
function Challenges.cancel(player)
	local s = active[player]
	if s and not s.done then
		s.done = true
		s.success = false
		s.finished:Fire()
	end
end

function Challenges.isActive(player)
	return active[player] ~= nil
end

return Challenges
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[-- Build: ghost blueprint grid; each placed tile validated against the legend.
local Build = {}
Build.__index = Build

local CELL = 4

function Build.start(ctx)
	local ch = ctx.challenge
	local self = setmetatable({
		ctx = ctx,
		required = {}, -- ["r,c"] = item id
		filled = {},
		cells = {},
		remaining = 0,
		selected = nil,
		rows = #ch.blueprint,
		cols = 0,
	}, Build)
	local legend = ch.blueprintLegend or {}
	local origin = ctx.origin() * CFrame.new(0, 0, -14)
	self.origin = origin

	for r, line in ipairs(ch.blueprint) do
		self.cols = math.max(self.cols, #line)
		for c = 1, #line do
			local sym = line:sub(c, c)
			if sym ~= "." and legend[sym] then
				self.required[r .. "," .. c] = legend[sym]
				self.remaining += 1
				local part = ctx.newPart("Ghost", Vector3.new(CELL - 0.2, CELL - 0.2, 0.5), self:cellCFrame(r, c), ctx.itemColor(legend[sym]))
				part.Transparency = 0.7
				part.CanCollide = false
				self.cells[r .. "," .. c] = part
				ctx.click(part, function()
					if not self.selected then
						ctx.notify("Choose a block first.", "info")
						return
					end
					self:place(r, c, self.selected)
				end)
			end
		end
	end

	-- Palette: one pickable block per distinct legend item.
	local seen, i = {}, 0
	for _, id in pairs(legend) do
		if not seen[id] then
			seen[id] = true
			i += 1
			local pal = ctx.newPart("Palette_" .. id, Vector3.new(3, 3, 3), origin * CFrame.new(-8 + i * 4, 1.5, 6), ctx.itemColor(id))
			ctx.label(pal, ctx.itemName(id))
			ctx.click(pal, function()
				self:select(id)
			end)
		end
	end
	ctx.progress({ remaining = self.remaining })
	return self
end

function Build:cellCFrame(r, c)
	local x = (c - (self.cols + 1) / 2) * CELL
	local y = (self.rows - r) * CELL + CELL / 2
	return self.origin * CFrame.new(x, y, 0)
end

function Build:select(id)
	-- Only allow items that appear in the blueprint legend.
	for _, req in pairs(self.required) do
		if req == id then
			self.selected = id
			self.ctx.notify("Selected " .. self.ctx.itemName(id), "info")
			return
		end
	end
end

function Build:place(r, c, id)
	local key = tostring(r) .. "," .. tostring(c)
	local need = self.required[key]
	if not need or self.filled[key] then
		return
	end
	if need ~= id then
		self.ctx.notify("That block does not belong there.", "error")
		return
	end
	self.filled[key] = true
	self.remaining -= 1
	local ghost = self.cells[key]
	if ghost then
		ghost:Destroy()
	end
	local solid = self.ctx.newPart("Tile", Vector3.new(CELL - 0.2, CELL - 0.2, 1), self:cellCFrame(r, c), self.ctx.itemColor(id))
	solid:SetAttribute("ItemId", id)
	self.ctx.progress({ remaining = self.remaining })
	if self.remaining == 0 then
		self.ctx.notify("Blueprint complete!", "ok")
		self.ctx.finish(true)
	end
end

function Build:onAction(action)
	if action.kind == "select" and type(action.item) == "string" then
		self:select(action.item)
	elseif action.kind == "place" and type(action.row) == "number" and type(action.col) == "number" and type(action.item) == "string" then
		if action.row % 1 == 0 and action.col % 1 == 0 then
			self:place(action.row, action.col, action.item)
		end
	end
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Cook</string>
            <string name="Source"><![CDATA[-- Cook: ordered recipe; each input must be added in sequence.
local Cook = {}
Cook.__index = Cook

function Cook.start(ctx)
	local recipe = ctx.challenge.recipe
	local self = setmetatable({ ctx = ctx, inputs = recipe.inputs, output = recipe.output, step = 0 }, Cook)
	local seen, distinct = {}, {}
	for _, id in ipairs(self.inputs) do
		if not seen[id] then
			seen[id] = true
			table.insert(distinct, id)
		end
	end
	local origin = ctx.origin()
	for i, id in ipairs(distinct) do
		local off = (i - (#distinct + 1) / 2) * 5
		local part = ctx.newPart("Station_" .. id, Vector3.new(3, 3, 3), origin * CFrame.new(off, 1.5, -10), ctx.itemColor(id))
		ctx.label(part, ctx.itemName(id))
		ctx.click(part, function()
			self:add(id)
		end)
	end
	ctx.progress({ step = 0, total = #self.inputs })
	return self
end

function Cook:add(id)
	if self.ctx.challenge.recipe == nil or self.step >= #self.inputs then
		return
	end
	if self.inputs[self.step + 1] == id then
		self.step += 1
		self.ctx.notify("Added " .. self.ctx.itemName(id), "ok")
		self.ctx.progress({ step = self.step, total = #self.inputs })
		if self.step == #self.inputs then
			self.ctx.grant(self.output, 1)
			self.ctx.notify("Made " .. self.ctx.itemName(self.output) .. "!", "ok")
			self.ctx.finish(true)
		end
	else
		self.step = 0
		self.ctx.notify("Wrong order! Start again from the first step.", "error")
		self.ctx.progress({ step = 0, total = #self.inputs })
	end
end

function Cook:onAction(action)
	if action.kind == "add" and type(action.item) == "string" then
		self:add(action.item)
	end
end

return Cook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Gather</string>
            <string name="Source"><![CDATA[-- Gather: spawn collectible parts per needed item; count touches server-side.
local Gather = {}
Gather.__index = Gather

function Gather.start(ctx)
	local self = setmetatable({ ctx = ctx, need = {}, got = {}, order = {} }, Gather)
	for _, n in ipairs(ctx.challenge.needs or {}) do
		self.need[n.item] = (self.need[n.item] or 0) + n.count
		self.got[n.item] = self.got[n.item] or 0
		table.insert(self.order, n.item)
	end

	local origin = ctx.origin()
	local total, idx = 0, 0
	for _, c in pairs(self.need) do
		total += c
	end
	for _, item in ipairs(self.order) do
		for _ = 1, self.need[item] do
			if idx >= total then
				break
			end
			idx += 1
			local angle = (idx / math.max(total, 1)) * math.pi - math.pi / 2
			local pos = origin * CFrame.new(math.sin(angle) * 12, 1.5, -8 - math.cos(angle) * 6)
			local part = ctx.newPart("Collect_" .. item, Vector3.new(2, 2, 2), pos, ctx.itemColor(item))
			part.Shape = Enum.PartType.Ball
			part.CanCollide = false
			part:SetAttribute("ItemId", item)
			ctx.label(part, ctx.itemName(item))
			local taken = false
			ctx.connect(part.Touched:Connect(function(hit)
				if taken or ctx.playerFromPart(hit) ~= ctx.player then
					return
				end
				taken = true
				part:Destroy()
				self:collect(item)
			end))
		end
	end
	self:report()
	return self
end

function Gather:collect(item)
	if self.got[item] >= self.need[item] then
		return
	end
	self.got[item] += 1
	self.ctx.notify("Collected " .. self.ctx.itemName(item), "ok")
	self:report()
	for id, n in pairs(self.need) do
		if self.got[id] < n then
			return
		end
	end
	for id, n in pairs(self.got) do
		self.ctx.grant(id, n)
	end
	self.ctx.finish(true)
end

function Gather:report()
	local p = {}
	for id, n in pairs(self.need) do
		p[id] = { have = self.got[id], need = n }
	end
	self.ctx.progress(p)
end

-- Collection is touch-driven; client actions are ignored.
function Gather:onAction() end

return Gather
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Trade</string>
            <string name="Source"><![CDATA[-- Trade: player offers required items to the mentor and receives the reward.
local MentorCharacter = require(script.Parent.Parent.Characters.MentorCharacter)

local Trade = {}
Trade.__index = Trade

function Trade.start(ctx)
	local self = setmetatable({ ctx = ctx }, Trade)
	local mentor = ctx.pack.mentor or {}
	local place = ctx.origin() * CFrame.new(0, 3, -10)
	local part = ctx.newPart("Mentor", Vector3.new(3, 6, 3), place, Color3.fromRGB(240, 200, 150))
	part.Transparency = 1
	local colors = ctx.pack.colors or {}
	local function color(hex, fallback)
		local ok, value = pcall(Color3.fromHex, hex)
		return ok and value or fallback
	end
	MentorCharacter.build(
		"MentorCharacter",
		place * CFrame.new(0, -3, 0) * CFrame.Angles(0, math.pi, 0),
		color(colors.primary, Color3.fromRGB(120, 60, 70)),
		color(colors.secondary, Color3.fromRGB(220, 180, 90)),
		ctx.folder
	)
	ctx.label(part, mentor.name or "Mentor")
	ctx.click(part, function()
		self:describe()
		-- Convenience: clicking the mentor offers exactly what is needed.
		self:offer(ctx.challenge.needs)
	end)
	return self
end

function Trade:describe()
	local parts = {}
	for _, n in ipairs(self.ctx.challenge.needs or {}) do
		table.insert(parts, n.count .. " x " .. self.ctx.itemName(n.item))
	end
	self.ctx.notify("Needs: " .. table.concat(parts, ", "), "info")
end

function Trade:offer(offered)
	local ctx = self.ctx
	if type(offered) ~= "table" then
		return
	end
	-- Aggregate the offer and compare with requirement exactly.
	local have = {}
	for _, o in ipairs(offered) do
		if type(o) ~= "table" or type(o.item) ~= "string" or type(o.count) ~= "number" or o.count < 1 or o.count % 1 ~= 0 then
			ctx.notify("That offer is not valid.", "error")
			return
		end
		have[o.item] = (have[o.item] or 0) + o.count
	end
	local need = {}
	for _, n in ipairs(ctx.challenge.needs or {}) do
		need[n.item] = (need[n.item] or 0) + n.count
	end
	for item, count in pairs(need) do
		if (have[item] or 0) < count then
			ctx.notify("Not enough " .. ctx.itemName(item) .. ".", "error")
			return
		end
	end
	for item in pairs(have) do
		if not need[item] then
			ctx.notify("The mentor did not ask for " .. ctx.itemName(item) .. ".", "error")
			return
		end
	end
	for item, count in pairs(need) do
		if not ctx.has(item, count) then
			ctx.notify("You do not have " .. ctx.itemName(item) .. " yet.", "error")
			return
		end
	end
	for item, count in pairs(need) do
		ctx.remove(item, count)
	end
	local reward = ctx.challenge.reward
	if reward then
		ctx.grant(reward.item, reward.count)
		ctx.notify("Received " .. reward.count .. " x " .. ctx.itemName(reward.item), "ok")
	end
	ctx.finish(true)
end

function Trade:onAction(action)
	if action.kind == "offer" then
		self:offer(action.items)
	end
end

return Trade
]]></string>
          </Properties>
