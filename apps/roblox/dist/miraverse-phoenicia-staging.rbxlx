        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">SecurityAndPersistence</string>
            <string name="Source"><![CDATA[--!strict
-- MiraVerse v0.4 Roblox Persistence, Remotes Anti-Exploit & Commerce Boundary
-- Owner: CL06
-- Strictly forbids external payment links, Stripe URLs, QR codes, or web gift codes.
-- Optional Roblox-native MarketplaceService module is disabled by default.
local SecurityAndPersistence = {}

SecurityAndPersistence.ENABLE_ROBLOX_MONETIZATION = false
SecurityAndPersistence.ALLOW_EXTERNAL_PAYMENT_LINKS = false
SecurityAndPersistence.MAX_INTERACT_DISTANCE_STUDS = 24
SecurityAndPersistence.COOLDOWN_SECONDS = 0.25

function SecurityAndPersistence.validateRemotePayload(payload: any): (boolean, string)
	if type(payload) ~= "table" then
		return false, "INVALID_TABLE"
	end
	if type(payload.country) ~= "string" or type(payload.action) ~= "string" then
		return false, "MISSING_FIELDS"
	end
	if payload.action == "EXTERNAL_CHECKOUT" or payload.action == "WEB_GIFT_REDEEM" then
		return false, "FORBIDDEN_EXTERNAL_COMMERCE"
	end
	return true, "OK"
end

return SecurityAndPersistence
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">SessionManager</string>
            <string name="Source"><![CDATA[--!strict
-- Server-owned, session-only player state and remote handlers. No DataStore, no network calls.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Stamp = require(script.Parent.Stamp)

local SessionManager = {}

local COOLDOWN = 0.25
local CHALLENGES_PER_CHAPTER = 5
local PHRASES = { "Hello!", "Great job!", "Follow me!", "Thank you!" }
local VALID = { LB = true, EG = true, IQ = true, KR = true, FR = true }

type Session = {
	country: string?,
	index: number,
	completed: { [number]: boolean },
	stamps: { string },
	busy: boolean,
}

local sessions: { [Player]: Session } = {}
local lastCall: { [Player]: { [string]: number } } = {}
local Challenges: any = nil
local Packs: any = nil
local remotes: Folder

local function limited(player: Player, name: string): boolean
	local t = os.clock()
	local per = lastCall[player]
	if not per then
		per = {}
		lastCall[player] = per
	end
	local prev = per[name]
	if prev and t - prev < COOLDOWN then
		return true
	end
	per[name] = t
	return false
end

local function snapshot(s: Session)
	local done = 0
	for _ in s.completed do
		done += 1
	end
	return { country = s.country, index = s.index, done = done, total = CHALLENGES_PER_CHAPTER, stamps = table.clone(s.stamps) }
end

local function getChallenges(cc: string): { any }
	local pack = Packs and Packs[cc]
	local chapter = pack and pack.chapters and pack.chapters[1]
	return chapter and chapter.challenges or {}
end

local function newRemote(class: string, name: string): Instance
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end

function SessionManager.init()
	local shared = ReplicatedStorage:WaitForChild("MiraVerseShared")
	Challenges = require(shared:WaitForChild("Challenges"))
	Packs = require(shared:WaitForChild("Packs"))
	Challenges.init()

	remotes = Instance.new("Folder")
	remotes.Name = "MiraVerseRemotes"
	remotes.Parent = ReplicatedStorage

	local getState = newRemote("RemoteFunction", "GetState") :: RemoteFunction
	local selectCountry = newRemote("RemoteFunction", "SelectCountry") :: RemoteFunction
	local runChallenge = newRemote("RemoteFunction", "RunChallenge") :: RemoteFunction
	local say = newRemote("RemoteEvent", "Say") :: RemoteEvent
	local phraseOut = newRemote("RemoteEvent", "PhraseShown") :: RemoteEvent

	local function sessionOf(player: Player): Session
		local s = sessions[player]
		if not s then
			s = { country = nil, index = 1, completed = {}, stamps = {}, busy = false }
			sessions[player] = s
		end
		return s
	end

	getState.OnServerInvoke = function(player)
		if limited(player, "GetState") then
			return nil
		end
		return snapshot(sessionOf(player))
	end

	selectCountry.OnServerInvoke = function(player, cc)
		if limited(player, "SelectCountry") then
			return { ok = false, reason = "slow" }
		end
		if type(cc) ~= "string" or not VALID[cc] then
			return { ok = false, reason = "invalid" }
		end
		local s = sessionOf(player)
		s.country = cc
		s.index = 1
		s.completed = {}
		local spawn = Workspace:FindFirstChild("Spawn_" .. cc, true)
		local char = player.Character
		if spawn and spawn:IsA("BasePart") and char then
			char:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
		end
		return { ok = true, state = snapshot(s), challenge = getChallenges(cc)[1] and getChallenges(cc)[1].id }
	end

	runChallenge.OnServerInvoke = function(player)
		if limited(player, "RunChallenge") then
			return { ok = false, reason = "slow" }
		end
		local s = sessionOf(player)
		local cc = s.country
		if not cc or s.busy then
			return { ok = false, reason = "not-ready" }
		end
		-- The index is server-owned; the client cannot choose or report completion.
		local list = getChallenges(cc)
		local challenge = list[s.index]
		if not challenge then
			return { ok = false, reason = "no-challenge" }
		end
		s.busy = true
		local okRun, result = pcall(function()
			return Challenges.run(player, challenge, Packs[cc])
		end)
		s.busy = false
		if sessions[player] ~= s or s.country ~= cc then
			return { ok = false, reason = "changed" }
		end
		if not okRun or result ~= true then
			return { ok = false, reason = "failed", state = snapshot(s) }
		end
		s.completed[s.index] = true
		local stampCode: string? = nil
		local all = true
		for i = 1, CHALLENGES_PER_CHAPTER do
			if not s.completed[i] then
				all = false
				break
			end
		end
		if all then
			stampCode = Stamp.make(cc, 1)
			table.insert(s.stamps, stampCode)
		elseif s.index < CHALLENGES_PER_CHAPTER then
			s.index += 1
		end
		return { ok = true, state = snapshot(s), stamp = stampCode }
	end

	say.OnServerEvent:Connect(function(player, idx)
		if limited(player, "Say") then
			return
		end
		if type(idx) ~= "number" or idx % 1 ~= 0 or idx < 1 or idx > #PHRASES then
			return
		end
		phraseOut:FireAllClients(player.UserId, PHRASES[idx])
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		lastCall[player] = nil
	end)
end

return SessionManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Stamp</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic Luau port of packages/shared/stamp.md (decorative souvenir only).
local Stamp = {}

Stamp.ALPHABET = "23456789ABCDEFGHJKMNPQRSTVWXYZ"
Stamp.SALT = "miraverse-v0"

local COUNTRIES = { LB = true, EG = true, IQ = true, KR = true, FR = true }
local PRIME = 16777619
local MOD = 4294967296

local function fnv1a(payload: string): number
	local h = 2166136261
	for i = 1, #payload do
		h = bit32.bxor(h, string.byte(payload, i))
		local hi = bit32.rshift(h, 16)
		local lo = bit32.band(h, 0xFFFF)
		h = (((hi * PRIME) % 65536) * 65536 + lo * PRIME) % MOD
	end
	return h
end

local function checksum(ccChapter: string, nonce: string): string
	local h = fnv1a(Stamp.SALT .. ccChapter .. nonce)
	local out = ""
	for _ = 1, 4 do
		local idx = h % 30
		out ..= string.sub(Stamp.ALPHABET, idx + 1, idx + 1)
		h = h // 30
	end
	return out
end

Stamp.checksum = checksum

local rng = Random.new()

local function randomNonce(): string
	local out = ""
	for _ = 1, 4 do
		local i = rng:NextInteger(1, 30)
		out ..= string.sub(Stamp.ALPHABET, i, i)
	end
	return out
end

function Stamp.make(cc: string, chapter: number, nonceOverride: string?): string
	assert(COUNTRIES[cc], "invalid country")
	assert(chapter >= 1 and chapter % 1 == 0, "invalid chapter")
	local nonce = nonceOverride or randomNonce()
	assert(#nonce == 4, "invalid nonce")
	local ccChapter = cc .. tostring(chapter)
	return string.format("MV-%s-%s-%s", ccChapter, nonce, checksum(ccChapter, nonce))
end

function Stamp.verify(code: string): boolean
	if type(code) ~= "string" then
		return false
	end
	code = string.upper((string.gsub(code, "^%s+", "")))
	code = (string.gsub(code, "%s+$", ""))
	local cc, chapter, nonce, check = string.match(code, "^MV%-(%u%u)([1-9]%d*)%-(%w%w%w%w)%-(%w%w%w%w)$")
	if not cc or not COUNTRIES[cc] or chapter ~= "1" then
		return false
	end
	for _, part in { nonce, check } do
		for i = 1, 4 do
			if not string.find(Stamp.ALPHABET, string.sub(part, i, i), 1, true) then
				return false
			end
		end
	end
	return checksum(cc .. chapter, nonce) == check
end

return Stamp
]]></string>
          </Properties>
        </Item>
