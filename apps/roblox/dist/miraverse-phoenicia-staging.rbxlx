          <string name="Name">MiraVerseClient</string>
        </Properties>
        <Item class="LocalScript" referent="81">
          <Properties>
            <string name="Name">AdventureClient</string>
            <string name="Source"><![CDATA[--!strict
-- MiraVerse v0.4 Roblox Client HUD, ProximityPrompt Listener & Safe Quick-Chat
-- Owner: CL05
local TextChatService = game:GetService("TextChatService")
local NpcAnimator = require(game:GetService("ReplicatedStorage"):WaitForChild("MiraVerse"):WaitForChild("npc"):WaitForChild("NpcAnimator"))

-- Child-safety policy: no free-text chat or external purchase prompts
pcall(function()
	local chatWindow = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	if chatWindow then
		chatWindow.Enabled = false
	end
end)

local _loadedClips = NpcAnimator.CLIPS
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="82">
          <Properties>
            <string name="Name">Controls</string>
          </Properties>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">NativeControllerAdapter</string>
              <string name="Source"><![CDATA[--!strict
-- MiraVerse v0.7 (Option A) — Native Roblox Humanoid Controller, Camera & Accessibility Adapter (CX06)

local NativeControllerAdapter = {}

export type AccessibilityPreferences = {
    subtitlesEnabled: boolean,
    textSizeScale: number, -- 1.0 to 1.35
    colorIndependentCues: boolean,
    reducedMotion: boolean,
    cameraShakeDisabled: boolean,
    inputMode: "KeyboardMouse" | "Touch" | "Gamepad",
}

function NativeControllerAdapter.defaultPreferences(): AccessibilityPreferences
    return {
        subtitlesEnabled = true,
        textSizeScale = 1.0,
        colorIndependentCues = true,
        reducedMotion = false,
        cameraShakeDisabled = true,
        inputMode = "KeyboardMouse",
    }
end

function NativeControllerAdapter.getPromptLabel(inputMode: string, actionName: string): string
    if inputMode == "Gamepad" then
        return string.format("[ButtonX] %s", actionName)
    elseif inputMode == "Touch" then
        return string.format("[Tap] %s", actionName)
    end
    return string.format("[E] %s", actionName)
end

return NativeControllerAdapter
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="84">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent.UI)

-- Child safety: no free-text chat.
pcall(function()
	TextChatService.ChatWindowConfiguration.Enabled = false
	TextChatService.ChatInputBarConfiguration.Enabled = false
end)
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
end)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("MiraVerseRemotes")
local getState = remotes:WaitForChild("GetState") :: RemoteFunction
local selectCountry = remotes:WaitForChild("SelectCountry") :: RemoteFunction
local runChallenge = remotes:WaitForChild("RunChallenge") :: RemoteFunction
local say = remotes:WaitForChild("Say") :: RemoteEvent
local phraseShown = remotes:WaitForChild("PhraseShown") :: RemoteEvent

local PHRASES = { "Hello!", "Great job!", "Follow me!", "Thank you!" }
local COUNTRIES = {
	{ "LB", "Lebanon" },
	{ "EG", "Egypt" },
	{ "IQ", "Iraq" },
	{ "KR", "South Korea" },
	{ "FR", "France" },
}

local gui = UI.make("ScreenGui", { Name = "MiraVerseUI", ResetOnSpawn = false }, player:WaitForChild("PlayerGui"))

-- Country selection
local picker = UI.panel(gui, UDim2.fromScale(0.5, 0.6), UDim2.fromScale(0.25, 0.2))
UI.label(picker, "Choose a country!", UDim2.fromScale(0.9, 0.14), UDim2.fromScale(0.05, 0.03))

-- The Phoenicia staging build starts in Tyre, so the picker would cover it.
if Workspace:GetAttribute("MV_PHOENICIA") == true then
	picker.Visible = false
end

-- HUD
local hud = UI.panel(gui, UDim2.fromScale(0.3, 0.14), UDim2.fromScale(0.35, 0.02))
hud.Visible = false
local hudText = UI.label(hud, "", UDim2.fromScale(0.94, 0.5), UDim2.fromScale(0.03, 0.05))
local playBtn: TextButton

-- Stamp modal
local modal = UI.panel(gui, UDim2.fromScale(0.4, 0.4), UDim2.fromScale(0.3, 0.3))
modal.Visible = false
modal.ZIndex = 10
local modalTitle = UI.label(modal, "Souvenir stamp!", UDim2.fromScale(0.9, 0.25), UDim2.fromScale(0.05, 0.05))
local modalCode = UI.label(modal, "", UDim2.fromScale(0.9, 0.3), UDim2.fromScale(0.05, 0.35))
modalTitle.ZIndex = 11
modalCode.ZIndex = 11
local closeBtn = UI.button(modal, "Close", UDim2.fromScale(0.4, 0.2), function()
	modal.Visible = false
end)
closeBtn.Position = UDim2.fromScale(0.3, 0.72)
closeBtn.ZIndex = 11

local function render(state: any)
	if not state or not state.country then
		return
	end
	picker.Visible = false
	hud.Visible = true
	hudText.Text = string.format("%s - challenge %d of %d (%d done)", state.country, state.index, state.total, state.done)
end

for i, c in COUNTRIES do
	local btn = UI.button(picker, c[2], UDim2.fromScale(0.9, 0.12), function()
		local res = selectCountry:InvokeServer(c[1])
		if res and res.ok then
			render(res.state)
		end
	end)
	btn.Position = UDim2.fromScale(0.05, 0.2 + (i - 1) * 0.15)
end

playBtn = UI.button(hud, "Play challenge", UDim2.fromScale(0.5, 0.4), function()
	playBtn.Active = false
	local res = runChallenge:InvokeServer()
	playBtn.Active = true
	if res and res.state then
		render(res.state)
	end
	if res and res.ok and res.stamp then
		modalCode.Text = res.stamp
		modal.Visible = true
	end
end)
playBtn.Position = UDim2.fromScale(0.25, 0.55)

-- Predefined phrase bar (the only communication allowed)
local bar = UI.panel(gui, UDim2.fromScale(0.5, 0.08), UDim2.fromScale(0.25, 0.9))
for i, text in PHRASES do
	local b = UI.button(bar, text, UDim2.fromScale(0.23, 0.76), function()
		say:FireServer(i)
	end)
	b.Position = UDim2.fromScale(0.01 + (i - 1) * 0.248, 0.12)
end

phraseShown.OnClientEvent:Connect(function(userId: any, text: any)
	if type(userId) ~= "number" or type(text) ~= "string" then
		return
	end
	local other = Players:GetPlayerByUserId(userId)
	local char = other and other.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = UI.make("BillboardGui", {
		Size = UDim2.fromOffset(160, 40),
		StudsOffset = Vector3.new(0, 3, 0),
		AlwaysOnTop = true,
		Adornee = head,
	}, gui)
	UI.label(bb, text, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0)).BackgroundTransparency = 0.2
	task.delay(3, function()
		bb:Destroy()
	end)
end)

-- Challenge goals and feedback from the server.
local TOAST_SECONDS = 6
local toast = UI.panel(gui, UDim2.fromScale(0.5, 0.1), UDim2.fromScale(0.25, 0.18))
toast.Name = "ChallengeToast"
toast.Visible = false
local toastMessage = UI.label(toast, "", UDim2.fromScale(0.94, 0.86), UDim2.fromScale(0.03, 0.07))
toastMessage.Name = "Message"
local toastVersion = 0
local challengeRemotes = ReplicatedStorage:WaitForChild("ChallengeRemotes")
local notify = challengeRemotes:WaitForChild("Notify") :: RemoteEvent
notify.OnClientEvent:Connect(function(_challengeId: any, text: any)
	if type(text) ~= "string" then
		return
	end
	toastVersion += 1
	local version = toastVersion
	toastMessage.Text = text
	toast.Visible = true
	task.delay(TOAST_SECONDS, function()
		if version == toastVersion then
			toast.Visible = false
		end
	end)
end)

task.spawn(function()
	render(getState:InvokeServer())
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="85">
          <Properties>
            <string name="Name">PhoeniciaClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Phoenicia dialogue, toast and objective UI. Exits at once unless the feature flag is on.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

if Workspace:GetAttribute("MV_PHOENICIA") ~= true then
	return
end

local UI = require(script.Parent.UI)

local TOAST_SECONDS = 6
local BUTTON_HEIGHT = 0.13

local remotes = ReplicatedStorage:WaitForChild("PhoeniciaRemotes")
local player = Players.LocalPlayer

local gui = UI.make("ScreenGui", { Name = "PhoeniciaUI", ResetOnSpawn = false, IgnoreGuiInset = true }, player:WaitForChild("PlayerGui"))

local objective = UI.panel(gui, UDim2.fromScale(0.4, 0.1), UDim2.fromScale(0.3, 0.02))
local objectiveTitle = UI.label(objective, "", UDim2.fromScale(0.96, 0.45), UDim2.fromScale(0.02, 0.05))
local objectiveText = UI.label(objective, "", UDim2.fromScale(0.96, 0.45), UDim2.fromScale(0.02, 0.5))
objective.Visible = false

local toast = UI.panel(gui, UDim2.fromScale(0.6, 0.12), UDim2.fromScale(0.2, 0.14))
local toastText = UI.label(toast, "", UDim2.fromScale(0.96, 0.9), UDim2.fromScale(0.02, 0.05))
toastText.TextWrapped = true
toast.Visible = false
local toastVersion = 0

local dialog = UI.panel(gui, UDim2.fromScale(0.7, 0.72), UDim2.fromScale(0.15, 0.14))
dialog.ZIndex = 10
dialog.Visible = false
local dialogTitle = UI.label(dialog, "", UDim2.fromScale(0.92, 0.1), UDim2.fromScale(0.04, 0.03))
dialogTitle.ZIndex = 11
local bodyScroll = UI.make("ScrollingFrame", {
	Size = UDim2.fromScale(0.92, 0.42),
	Position = UDim2.fromScale(0.04, 0.14),
	BackgroundTransparency = 1,
	ZIndex = 11,
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new(),
	ScrollBarThickness = 6,
}, dialog)
local dialogBody = UI.label(bodyScroll, "", UDim2.fromScale(1, 0), UDim2.fromScale(0, 0))
dialogBody.AutomaticSize = Enum.AutomaticSize.Y
dialogBody.TextWrapped = true
dialogBody.TextScaled = false
dialogBody.TextSize = 18
dialogBody.BackgroundTransparency = 1
dialogBody.ZIndex = 12
local optionButtons = {}

local function applyDirection(direction)
	local alignment = direction == "rtl" and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
	dialogTitle.TextXAlignment = alignment
	dialogBody.TextXAlignment = alignment
end

remotes:WaitForChild("Ask").OnClientEvent:Connect(function(token, request)
	for _, button in optionButtons do
		button:Destroy()
	end
	table.clear(optionButtons)
	dialogTitle.Text = request.title
	dialogBody.Text = request.body
	applyDirection(request.direction)
	local maxButtons = math.max(#request.options, 4)
	for index, option in request.options do
		local button = UI.button(dialog, option.label, UDim2.fromScale(0.92, BUTTON_HEIGHT * 4 / maxButtons - 0.01), function()
			dialog.Visible = false
			remotes.Answer:FireServer(token, option.id)
		end)
		button.Position = UDim2.fromScale(0.04, 0.58 + (index - 1) * (BUTTON_HEIGHT * 4 / maxButtons))
		button.ZIndex = 11
		table.insert(optionButtons, button)
	end
	dialog.Visible = true
end)

remotes:WaitForChild("Toast").OnClientEvent:Connect(function(text)
	toastVersion += 1
	local version = toastVersion
	toastText.Text = text
	toast.Visible = true
	task.delay(TOAST_SECONDS, function()
		if version == toastVersion then
			toast.Visible = false
		end
	end)
end)

remotes:WaitForChild("Objective").OnClientEvent:Connect(function(title, text)
	objectiveTitle.Text = title
	objectiveText.Text = text
	objective.Visible = true
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="86">
          <Properties>
            <string name="Name">Presentation</string>
          </Properties>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">NativeQuestHud</string>
              <string name="Source"><![CDATA[--!strict
-- MiraVerse v0.7 (Option A) — Native Roblox Quest HUD, Dialogue, Passport & RTL Layout (AG06)

local NativeQuestHud = {}

function NativeQuestHud.formatObjectiveBanner(countryId: string, stepName: string, locale: string): { text: string, isRtl: boolean }
    local isRtl = (locale == "ar-LB" or locale == "ar-EG" or locale == "ar-IQ")
    return {
        text = string.format("[%s] Active Quest Step: %s", countryId, stepName),
        isRtl = isRtl,
    }
end

return NativeQuestHud
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="88">
            <Properties>
              <string name="Name">social-avatar</string>
            </Properties>
            <Item class="ModuleScript" referent="89">
              <Properties>
                <string name="Name">AvatarStudioUI</string>
                <string name="Source"><![CDATA[--!strict
-- MiraVerse v0.7 (Option A) — In-Experience Avatar Studio & Friends/Co-op HUD (AG06 Section 8A)
-- Allows previewing, rotating/zooming, equipping owned items, and inviting friends via SocialService.

local SocialAvatarContracts = require(script.Parent.Parent.Parent.Parent.shared.Systems.SocialAvatar.SocialAvatarContracts)

local AvatarStudioUI = {}

export type StudioPreviewState = {
    selectedItemId: string,
    cameraYawDeg: number,
    cameraZoomStuds: number,
    badgeLabel: string,
}

function AvatarStudioUI.inspectCatalogItem(itemId: string): StudioPreviewState?
    local item = SocialAvatarContracts.CATALOG[itemId]
    if not item then
        return nil
    end
    local badge = if item.status == "experience_only"
        then "In-Experience Cosmetic (Earned via Quests)"
        else "Marketplace Candidate (Pending Creator Approval)"

    return {
        selectedItemId = item.itemId,
        cameraYawDeg = 25,
        cameraZoomStuds = 6.5,
        badgeLabel = badge,
    }
end

return AvatarStudioUI
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Small UI helpers (no external assets, no network).
local UI = {}

function UI.make(class: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(class)
	for k, v in props do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

function UI.button(parent: Instance, text: string, size: UDim2, onClick: () -> ()): TextButton
	local b = UI.make("TextButton", {
		Text = text,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(255, 196, 61),
		TextColor3 = Color3.fromRGB(40, 30, 10),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
	}, parent)
	UI.make("UICorner", { CornerRadius = UDim.new(0, 12) }, b)
	b.Activated:Connect(onClick)
	return b
end

function UI.panel(parent: Instance, size: UDim2, pos: UDim2): Frame
	local f = UI.make("Frame", {
		Size = size,
		Position = pos,
		BackgroundColor3 = Color3.fromRGB(32, 41, 77),
		BackgroundTransparency = 0.1,
	}, parent)
	UI.make("UICorner", { CornerRadius = UDim.new(0, 16) }, f)
	return f
end

function UI.label(parent: Instance, text: string, size: UDim2, pos: UDim2): TextLabel
	return UI.make("TextLabel", {
		Text = text,
		Size = size,
		Position = pos,
		BackgroundTransparency = 1,
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamMedium,
		TextScaled = true,
		TextWrapped = true,
	}, parent)
end

return UI
]]></string>
