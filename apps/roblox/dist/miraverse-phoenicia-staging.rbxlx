			["arabizi"] = "Na2e loghtak",
		},
		["ui.arrival"] = {
			["en-US"] = "Your ship nears Tyre, the island city. Go ashore and find Hanno in the Great Market.",
			["ar-LB"] = "مركبك قرّب على صور، مدينة الجزيرة. انزل عالبر ودوّر على حنّو بالسوق الكبير.",
			["fr-FR"] = "Ton navire approche de Tyr, la cité insulaire. Débarque et trouve Hannon au Grand Marché.",
			["arabizi"] = "Markabak 2arrab 3a Sour, madinet el jazira. Nzal 3al bar w dawwer 3a Hanno bel souk el kbir.",
		},
		["ui.welcome_back"] = {
			["en-US"] = "Welcome back. Your journey is saved.",
			["ar-LB"] = "أهلا برجعتك. رحلتك محفوظة.",
			["fr-FR"] = "Bon retour. Ton voyage est sauvegardé.",
			["arabizi"] = "Ahla b raj3tak. Re7ltak mahfouza.",
		},
		["ui.save_failed"] = {
			["en-US"] = "Progress can't be saved right now. You can keep playing, but it may be lost if you leave.",
			["ar-LB"] = "ما فينا نحفظ تقدّمك هلق. فيك تكمّل، بس ممكن يضيع إذا فلّيت.",
			["fr-FR"] = "Impossible de sauvegarder pour l'instant. Tu peux continuer, mais tout peut être perdu si tu quittes.",
			["arabizi"] = "Ma fina ne7faz ta2addomak halla2. Fik tkammel, bas momken yde3 iza fallet.",
		},
		["ui.continue"] = {
			["en-US"] = "Continue",
			["ar-LB"] = "كمّل",
