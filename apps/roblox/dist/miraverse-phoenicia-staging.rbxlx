		["prompt.talk_hanno"] = {
			["en-US"] = "Talk to Hanno",
			["ar-LB"] = "احكي مع حنّو",
			["fr-FR"] = "Parler à Hannon",
			["arabizi"] = "E7ki ma3 Hanno",
