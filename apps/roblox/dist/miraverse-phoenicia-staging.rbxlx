		["ui.reward"] = {
			["en-US"] = "Reward: Cedar Keel Token and 50 Story Sparks",
			["ar-LB"] = "الجائزة: رمز عارضة الأرز و٥٠ شرارة حكاية",
			["fr-FR"] = "Récompense : jeton de quille en cèdre et 50 étincelles d'histoire",
