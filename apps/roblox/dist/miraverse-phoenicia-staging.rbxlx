			["ar-LB"] = "الشق بالطول بيضعّف العارضة كلها. اتطلّع كمان مرة.",
			["fr-FR"] = "Une fente dans le fil affaiblit toute la poutre. Regarde encore.",
			["arabizi"] = "El sha22 bel toul byda33ef el 3arda kella. Ttalla3 kaman marra.",
