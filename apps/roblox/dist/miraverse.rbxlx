	["artifact.de_lorelei_songstone.name"] = "حجر أغنية لورلاي",
	["quest.DE03.title"] = "خيار الملاّح",
	["quest.DE03.summary"] = "ساعِد قارب ليوصل لبر الأمان، وفضّل الإشارات الحقيقية على الصدى يلي بيشتت الانتباه",
	["quest.DE03.greeting"] = "أهلاً فيك بـ خيار الملاّح! خلّينا نشتغل سوا: ساعِد قارب ليوصل لبر الأمان، وفضّل الإشارات الحقيقية على الصدى يلي بيشتت الانتباه.",
