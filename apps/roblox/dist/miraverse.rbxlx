	["quest.MA01.title"] = "Komm in den Kreis",
	["quest.MA01.summary"] = "Finde den Platz und lerne, wie das Publikum dabei hilft, eine Geschichte lebendig werden zu lassen",
	["quest.MA01.greeting"] = "Willkommen bei Komm in den Kreis! Lass uns zusammenarbeiten: Finde den Platz und lerne, wie das Publikum dabei hilft, eine Geschichte lebendig werden zu lassen.",
	["quest.MA01.completion"] = "Kapitel MA01 abgeschlossen! Du hast Einladung in den Kreis erhalten.",
	["quest.MA01.source_note"] = "Dieses Kapitel stützt sich auf lebendige Traditionen, die Familien noch heute pflegen. Sie können sich von Zuhause zu Zuhause unterscheiden.",
	["artifact.ma_circle_invitation.name"] = "Einladung in den Kreis",
	["quest.MA02.title"] = "Eine Geschichte mit vielen Stimmen",
	["quest.MA02.summary"] = "Wähle Klänge, Gesten und Fragen für eine verzweigte mündliche Erzählung aus",
	["quest.MA02.greeting"] = "Willkommen bei Eine Geschichte mit vielen Stimmen! Lass uns zusammenarbeiten: Wähle Klänge, Gesten und Fragen für eine verzweigte mündliche Erzählung aus.",
