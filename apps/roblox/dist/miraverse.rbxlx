	["artifact.ma_hakawati_token.name"] = "عملة الحكواتي",
	["quest.MA03.title"] = "الشاي والحرف اليدوية",
	["quest.MA03.summary"] = "اجمع نعناع وكمّل خطوات الضيافة من غير حرارة؛ وبدّلها عشان تاخد زينة للأشغال اليدوية",
	["quest.MA03.greeting"] = "أهلاً بيك في الشاي والحرف اليدوية! يلا نشتغل مع بعض: اجمع نعناع وكمّل خطوات الضيافة من غير حرارة؛ وبدّلها عشان تاخد زينة للأشغال اليدوية.",
