	["vocab.EG.koshari"] = "كشري (kusharī) — Блюдо из слоёв риса, чечевицы, макарон, томатного соуса и хрустящего лука",
	["vocab.EG.mashrabiya"] = "مشربية (mashrabiyya) — Резная деревянная решётка с геометрическим узором",
	["npc.eg_layla_guide.name"] = "Лейла и бабушка Самира (ليلى وتيتا سميرة)",
	["npc.eg_lantern_maker_amm_adel.name"] = "Мастер фонарей дядя Адель (عم عادل صانع الفوانيس)",
	["npc.eg_market_auntie_nadia.name"] = "Тётушка Надия с рынка (طنط نادية في السوق)",
	["npc.eg_cook_ibrahim.name"] = "Шеф-повар Ибрагим (الشيف إبراهيم)",
	["npc.eg_storyteller_youssef.name"] = "Сказитель Юсеф (الحكواتي يوسف)",
	["quest.EG01.title"] = "Тёмный дворик",
	["quest.EG01.summary"] = "Следуй за цветными огоньками фонарей и найди пропавшие медные пластины",
	["quest.EG01.greeting"] = "Добро пожаловать в Тёмный дворик! Давай работать вместе: следуй за цветными огоньками фонарей и найди пропавшие медные пластины.",
	["quest.EG01.completion"] = "Глава EG01 завершена! Ты получаешь Каркас фонаря.",
	["quest.EG01.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного отличаться.",
	["artifact.eg_lantern_frame.name"] = "Каркас фонаря",
	["quest.EG02.title"] = "Мастерская фанусов",
	["quest.EG02.summary"] = "Смастери безопасный декоративный фонарик из узорных воксельных деталей",
	["quest.EG02.greeting"] = "Добро пожаловать в Мастерскую фанусов! Давай поработаем вместе: собери красивый и безопасный фонарик из узорных воксельных деталей.",
	["quest.EG02.completion"] = "Глава EG02 завершена! Твоя награда — Стеклянная звезда.",
	["quest.EG02.source_note"] = "Эта глава опирается на живые традиции, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.eg_glass_star.name"] = "Стеклянная звезда",
	["quest.EG03.title"] = "Рынок на закате",
	["quest.EG03.summary"] = "Торгуй чечевицей, рисом и овощами, разбираясь с весами",
	["quest.EG03.greeting"] = "Добро пожаловать на Рынок на закате! Давай поработаем вместе: торгуй чечевицей, рисом и овощами, разбираясь с весами.",
	["quest.EG03.completion"] = "Глава EG03 завершена! Твоя награда — Рыночные весы.",
	["quest.EG03.source_note"] = "Эта глава опирается на живые традиции, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.eg_market_scale.name"] = "Рыночные весы",
	["quest.EG04.title"] = "Кошари для всех",
	["quest.EG04.summary"] = "Соблюдай последовательность в готовке и помоги накрыть общий стол",
	["quest.EG04.greeting"] = "Добро пожаловать в «Кошари для всех»! Давай поработаем вместе: соблюдай последовательность в готовке и помоги накрыть общий стол.",
	["quest.EG04.completion"] = "Глава EG04 завершена! Твоя награда — Миска кошари.",
	["quest.EG04.source_note"] = "Эта глава опирается на живые традиции, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.eg_koshari_bowl.name"] = "Миска кошари",
	["quest.EG05.title"] = "Истории о фонарике",
	["quest.EG05.summary"] = "Сравнивай семейные рассказы, отмечай фольклор и укрась пешеходную дорожку",
	["quest.EG05.greeting"] = "Добро пожаловать в «Истории о фонарике»! Давай поработаем вместе: сравнивай семейные рассказы, отмечай фольклор и укрась пешеходную дорожку.",
	["quest.EG05.completion"] = "Глава EG05 завершена! Твоя награда — Огонёк историй.",
	["quest.EG05.source_note"] = "Это взято из фольклора: такие истории рассказываются во множестве версий и не являются описанием реальных событий.",
	["artifact.eg_story_flame.name"] = "Огонёк историй",
	["quest.EG06.title"] = "Город света",
	["quest.EG06.summary"] = "Проложи удобный маршрут с фонариками и отпразднуй общие традиции соседей",
	["quest.EG06.greeting"] = "Добро пожаловать в Город света! Давай поработаем вместе: проложи удобный маршрут с фонариками и отпразднуй общие традиции соседей.",
	["quest.EG06.completion"] = "Глава EG06 завершена! Твоя награда — Штамп «Свет Каира».",
	["quest.EG06.source_note"] = "Эта глава опирается на живые традиции, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.eg_cairo_light_stamp.name"] = "Штамп «Свет Каира»",
	["country.FR.name"] = "Франция (Старый Лион)",
	["country.FR.story"] = "Тайный ход и кухня",
	["country.FR.cultural_warning"] = "Traboules have varied uses over time; do not imply every passage has a documented Resistance history. Present Mères Lyonnaises as diverse chefs rather than one singular myth.",
	["artifact.fr_meres_lyonnaises_recipe_book.name"] = "Книга рецептов лионских матерей",
	["vocab.FR.traboule"] = "traboule (trah-bool) — Крытый проход, соединяющий дворы и улицы в Лионе",
	["vocab.FR.boulangerie"] = "boulangerie (boo-lahn-zhuh-ree) — Местная булочная-пекарня со свежим хлебом и выпечкой",
	["vocab.FR.canut"] = "canut (kah-noo) — Старинный лионский ткач шёлка",
	["npc.fr_camille_mamie.name"] = "Камилла и бабушка Клер (Camille et Mamie Claire)",
	["npc.fr_silk_artisan_henri.name"] = "Мастер по шёлку Анри (Henri l’Artisan Canut)",
	["npc.fr_chef_marguerite.name"] = "Шеф-повар Маргарита (Cheffe Marguerite)",
	["npc.fr_guide_luc.name"] = "Местный гид Люк (Luc le Guide)",
	["npc.fr_merchant_elise.name"] = "Рыночный торговец Элиза (Élise du Marché)",
	["quest.FR01.title"] = "Карта проходов",
	["quest.FR01.summary"] = "Найди скрытые, но безопасные проходы и проложи маршрут между мастерскими",
	["quest.FR01.greeting"] = "Добро пожаловать в «Карту проходов»! Давай работать вместе: найди скрытые, но безопасные проходы и проложи маршрут между мастерскими.",
	["quest.FR01.completion"] = "Глава FR01 завершена! Ты получаешь Ключ от трабули.",
	["quest.FR01.source_note"] = "Эта глава основана на реальной истории, но некоторые детали придуманы для игры.",
	["artifact.fr_traboule_key.name"] = "Ключ от трабули",
	["quest.FR02.title"] = "Нити города",
	["quest.FR02.summary"] = "Собери волокна и сотки повторяющийся шёлковый узор",
	["quest.FR02.greeting"] = "Добро пожаловать в «Нити города»! Давай работать вместе: собери волокна и сотки повторяющийся шёлковый узор.",
	["quest.FR02.completion"] = "Глава FR02 завершена! Ты получаешь Шёлковую ленту.",
	["quest.FR02.source_note"] = "Эта глава основана на реальной истории, но некоторые детали придуманы для игры.",
	["artifact.fr_silk_ribbon.name"] = "Шёлковая лента",
	["quest.FR03.title"] = "За столом лионских матерей",
	["quest.FR03.summary"] = "Собери ингредиенты и узнай семейный рецепт, вдохновлённый Лионом",
	["quest.FR03.greeting"] = "Добро пожаловать в «За столом лионских матерей»! Давай работать вместе: собери ингредиенты и узнай семейный рецепт, вдохновлённый Лионом.",
	["quest.FR03.completion"] = "Глава FR03 завершена! Ты получаешь Блокнот шеф-повара.",
	["quest.FR03.source_note"] = "Эта глава основана на реальной истории, но некоторые детали придуманы для игры.",
	["artifact.fr_chefs_notebook.name"] = "Блокнот шеф-повара",
	["quest.FR04.title"] = "Рынок вкусов",
	["quest.FR04.summary"] = "Обменивай ингредиенты, читай вывески и сравнивай происхождение сезонных продуктов",
	["quest.FR04.greeting"] = "Добро пожаловать в «Рынок вкусов»! Давай работать вместе: обменивай ингредиенты, читай вывески и сравнивай происхождение сезонных продуктов.",
	["quest.FR04.completion"] = "Глава FR04 завершена! Ты получаешь Рыночную корзинку.",
	["quest.FR04.source_note"] = "Эта глава опирается на живые традиции, которые семьи соблюдают и сегодня. От дома к дому они могут различаться.",
	["artifact.fr_market_basket.name"] = "Рыночная корзинка",
	["quest.FR05.title"] = "Камень за камнем",
	["quest.FR05.summary"] = "Почини фасад закрытой пекарни из настоящих блоков и материалов",
	["quest.FR05.greeting"] = "Добро пожаловать в главу «Камень за камнем»! Давай поработаем вместе: почини фасад закрытой пекарни из настоящих блоков и материалов.",
	["quest.FR05.completion"] = "Глава FR05 пройдена! Твоя награда — Герб каменщика.",
	["quest.FR05.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут быть немного своими.",
	["artifact.fr_masons_crest.name"] = "Герб каменщика",
	["quest.FR06.title"] = "Рецепт родного дома",
	["quest.FR06.summary"] = "Устрой дружную встречу и собери общий архив рецептов",
	["quest.FR06.greeting"] = "Добро пожаловать в главу «Рецепт родного дома»! Давай поработаем вместе: устрой дружную встречу и собери общий архив рецептов.",
	["quest.FR06.completion"] = "Глава FR06 пройдена! Твоя награда — Лионская марка наследия.",
	["quest.FR06.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут быть немного своими.",
	["artifact.fr_lyon_heritage_stamp.name"] = "Лионская марка наследия",
	["country.KR.name"] = "Южная Корея (Чонджу)",
	["country.KR.story"] = "Пять цветов Чонджу",
	["country.KR.cultural_warning"] = "The historical origin of bibimbap is debated; five-color symbolism is an interpretation and should be marked as such. Do not substitute generic Japanese or Chinese assets.",
	["artifact.kr_five_color_bibimbap_bowl.name"] = "Чаша для пятицветного пибимпапа",
	["vocab.KR.hanok"] = "한옥 (hanok) — Традиционный корейский деревянный дом с изогнутой черепичной крышей кива",
	["vocab.KR.obangsaek"] = "오방색 (obangsaek) — Традиционная корейская палитра гармонии из пяти цветов",
	["vocab.KR.bibimbap"] = "비빔밥 (bibimbap) — Тёплый рис с приправленными овощами и аппетитными соусами",
	["npc.kr_jiwoo_halmeoni.name"] = "Джиу и Хальмони (지우와 할머니)",
	["npc.kr_gardener_minho.name"] = "Огородник Минхо (농부 민호)",
	["npc.kr_carpenter_seojun.name"] = "Мастер ханоков Соджун (대목장 서준)",
	["npc.kr_cook_soyeon.name"] = "Повар Соён (요리사 소연)",
	["npc.kr_guide_haneul.name"] = "Архивист Ханыль (학예사 하늘)",
	["quest.KR01.title"] = "Ворота ханока",
	["quest.KR01.summary"] = "Найди путь к входу и почини садовую дорожку",
	["quest.KR01.greeting"] = "Добро пожаловать в главу «Ворота ханока»! Давай поработаем вместе: найди путь к входу и почини садовую дорожку.",
	["quest.KR01.completion"] = "Глава KR01 пройдена! Твоя награда — Дверной оберег ханока.",
	["quest.KR01.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут быть немного своими.",
	["artifact.kr_hanok_door_charm.name"] = "Дверной оберег ханока",
	["quest.KR02.title"] = "Пять цветов и множество смыслов",
	["quest.KR02.summary"] = "Собери и разложи ингредиенты по цветам обансэк",
	["quest.KR02.greeting"] = "Добро пожаловать в «Пять цветов, много смыслов»! Давай действовать сообща: собери и разложи ингредиенты по цветам обансэк.",
	["quest.KR02.completion"] = "Глава KR02 пройдена! Твоя награда — Пятицветная палитра.",
	["quest.KR02.source_note"] = "Эта глава основана на настоящей истории, но некоторые детали придуманы специально для игры.",
	["artifact.kr_five_color_palette.name"] = "Пятицветная палитра",
	["quest.KR03.title"] = "Утро на рынке",
	["quest.KR03.summary"] = "Торгуй овощами и учись вежливому общению на рынке",
	["quest.KR03.greeting"] = "Добро пожаловать в «Утро на рынке»! Давай действовать сообща: торгуй овощами и учись вежливому общению на рынке.",
	["quest.KR03.completion"] = "Глава KR03 пройдена! Твоя награда — Рыночный жетон.",
	["quest.KR03.source_note"] = "Эта глава опирается на живые традиции, которым семьи следуют и сегодня. В каждом доме они могут немного различаться.",
	["artifact.kr_market_token.name"] = "Рыночный жетон",
	["quest.KR04.title"] = "Общая чаша Чонджу",
	["quest.KR04.summary"] = "Приготовь пибимпап в игре, аккуратно укладывая ингредиенты слоями",
	["quest.KR04.greeting"] = "Добро пожаловать в «Общую чашу Чонджу»! Давай действовать сообща: приготовь пибимпап в игре, аккуратно укладывая ингредиенты слоями.",
	["quest.KR04.completion"] = "Глава KR04 пройдена! Твоя награда — Чаша для пибимпапа.",
	["quest.KR04.source_note"] = "Эта глава опирается на живые традиции, которым семьи следуют и сегодня. В каждом доме они могут немного различаться.",
	["artifact.kr_bibimbap_bowl.name"] = "Чаша для пибимпапа",
	["quest.KR05.title"] = "Мастерство во дворе",
	["quest.KR05.summary"] = "Восстанови деталь ханока, выбирая подходящие деревянные формы",
	["quest.KR05.greeting"] = "Добро пожаловать в «Мастерство во дворе»! Давай действовать сообща: восстанови деталь ханока, выбирая подходящие деревянные формы.",
	["quest.KR05.completion"] = "Глава KR05 пройдена! Твоя награда — Плотницкий узор.",
	["quest.KR05.source_note"] = "Эта глава опирается на живые традиции, которым семьи следуют и сегодня. В каждом доме они могут немного различаться.",
	["artifact.kr_joinery_pattern.name"] = "Плотницкий узор",
	["quest.KR06.title"] = "Пир гармонии",
	["quest.KR06.summary"] = "Устрой общий праздничный обед и сочини историю о дружбе и согласии",
	["quest.KR06.greeting"] = "Добро пожаловать на «Пир гармонии»! Давай действовать сообща: устрой общий праздничный обед и сочини историю о дружбе и согласии.",
	["quest.KR06.completion"] = "Глава KR06 пройдена! Твоя награда — Печать гармонии Чонджу.",
	["quest.KR06.source_note"] = "Эта глава опирается на живые традиции, которым семьи следуют и сегодня. В каждом доме они могут немного различаться.",
	["artifact.kr_jeonju_harmony_stamp.name"] = "Печать гармонии Чонджу",
	["country.DE.name"] = "Германия (Рейн / символический пейзаж Грааля)",
	["country.DE.story"] = "Песнь и исцеляющий вопрос",
	["country.DE.cultural_warning"] = "Lorelei and Parzival are literary/mythic tales and should not be presented as literal history. Remove drowning, trauma and religious coercion from child-facing gameplay; provide respectful historical framing.",
	["artifact.de_compass_of_compassion.name"] = "Компас сочувствия",
	["vocab.DE.mitgefuehl"] = "Mitgefühl (mit-guh-fuel) — Сочувствие и искреннее сопереживание другим",
	["vocab.DE.strom"] = "Strom (shtrohm) — Широкое судоходное речное течение",
	["vocab.DE.frage"] = "Frage (frah-guh) — Заботливый вопрос, который открывает путь к взаимопониманию",
	["npc.de_navigator_klara.name"] = "Речной лоцман Клара (Flusslotsin Klara)",
	["npc.de_historian_lukas.name"] = "Историк Лукас (Historiker Lukas)",
	["npc.de_narrator_lorelei.name"] = "Рассказчица Марлен (Erzählerin Marlene)",
	["npc.de_parzival.name"] = "Странник Парцифаль (Wanderer Parzival)",
	["npc.de_gardener_jonas.name"] = "Садовник Йонас (Gärtner Jonas)",
	["quest.DE01.title"] = "Излучина реки",
	["quest.DE01.summary"] = "Проложи безопасный путь по Рейну, используя маяки, направление течения и знаки на карте",
	["quest.DE01.greeting"] = "Добро пожаловать в главу «Излучина реки»! Давай действовать сообща: проложи безопасный путь по Рейну, используя маяки, направление течения и знаки на карте.",
	["quest.DE01.completion"] = "Глава DE01 пройдена! Твоя награда — Карта маршрута по Рейну.",
	["quest.DE01.source_note"] = "Эта глава основана на настоящей истории, но некоторые подробности придуманы для игры.",
	["artifact.de_rhine_route_map.name"] = "Карта маршрута по Рейну",
	["quest.DE02.title"] = "Заколдованная песня",
	["quest.DE02.summary"] = "Определи, что отвлекает тебя в загадке звуков и света, и послушай разные версии легенды о Лорелее",
	["quest.DE02.greeting"] = "Добро пожаловать в главу «Заколдованная песня»! Давай действовать сообща: определи, что отвлекает тебя в загадке звуков и света, и послушай разные версии легенды о Лорелее.",
	["quest.DE02.completion"] = "Глава DE02 пройдена! Твоя награда — Поющий камень Лорелеи.",
	["quest.DE02.source_note"] = "Это взято из литературы: плод воображения, а не запись настоящих событий.",
	["artifact.de_lorelei_songstone.name"] = "Поющий камень Лорелеи",
	["quest.DE03.title"] = "Выбор лоцмана",
	["quest.DE03.summary"] = "Помоги лодке добраться до тихого убежища, выбирая верные ориентиры вместо обманчивого эха",
	["quest.DE03.greeting"] = "Добро пожаловать в главу «Выбор лоцмана»! Давай действовать сообща: помоги лодке добраться до тихого убежища, выбирая верные ориентиры вместо обманчивого эха.",
	["quest.DE03.completion"] = "Глава DE03 пройдена! Твоя награда — Верный штурвал.",
	["quest.DE03.source_note"] = "Это задание придумано специально для игры, чтобы оживить рассказ.",
	["artifact.de_steady_helm.name"] = "Верный штурвал",
	["quest.DE04.title"] = "Тихий зал Грааля",
	["quest.DE04.summary"] = "Исследуй сказочный замок и обрати внимание на того, кому нужна помощь",
	["quest.DE04.greeting"] = "Добро пожаловать в главу «Тихий зал Грааля»! Давай действовать сообща: исследуй сказочный замок и обрати внимание на того, кому нужна помощь.",
	["quest.DE04.completion"] = "Глава DE04 пройдена! Твоя награда — Жетон Зала вопросов.",
	["quest.DE04.source_note"] = "Это взято из литературы: плод воображения, а не запись настоящих событий.",
	["artifact.de_hall_of_questions_token.name"] = "Жетон Зала вопросов",
	["quest.DE05.title"] = "Что тебя тревожит?",
	["quest.DE05.summary"] = "Задай участливый вопрос и помоги делом, вместо того чтобы молчать",
	["quest.DE05.greeting"] = "Добро пожаловать в главу «Что тебя тревожит?»! Давай действовать сообща: задай участливый вопрос и помоги делом, вместо того чтобы молчать.",
	["quest.DE05.completion"] = "Глава DE05 пройдена! Твоя награда — Свиток исцеляющего вопроса.",
	["quest.DE05.source_note"] = "Это взято из литературы: плод воображения, а не рассказ о реальных событиях.",
	["artifact.de_healing_question_scroll.name"] = "Свиток исцеляющего вопроса",
	["quest.DE06.title"] = "Возвращение сада",
	["quest.DE06.summary"] = "Помоги восстановить заброшенный сад сообща и запиши, что изменилось",
	["quest.DE06.greeting"] = "Добро пожаловать в главу «Возвращение сада»! Давай действовать сообща: помоги восстановить заброшенный сад и запиши, что изменилось.",
	["quest.DE06.completion"] = "Глава DE06 пройдена! Твоя награда — Немецкая марка воспоминаний.",
	["quest.DE06.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут различаться.",
	["artifact.de_german_memory_stamp.name"] = "Немецкая марка воспоминаний",
	["country.CN.name"] = "Китай (Персиковый источник, места, вдохновлённые Улином)",
	["country.CN.story"] = "Долина за цветущими садами",
	["country.CN.cultural_warning"] = "Peach Blossom Spring is literary fiction. Chang’e’s moon story has multiple versions and should be introduced as folklore, not fact.",
	["artifact.cn_peach_blossom_keepsake.name"] = "Сувенир с цветком персика",
	["vocab.CN.taohua"] = "桃花 (táohuā) — Цветок персика",
	["vocab.CN.tuanyuan"] = "团圆 (tuányuán) — Тёплое воссоединение и радостная встреча всей семьёй",
	["vocab.CN.bianhua"] = "变化 (biànhuà) — Естественные перемены и обновление со временем",
	["npc.cn_elder_lin.name"] = "Старейшина деревни Линь (林长老)",
	["npc.cn_fisher_zhou.name"] = "Рыбак Чжоу (渔夫周叔)",
	["npc.cn_orchard_keeper_mei.name"] = "Хранительница сада Мэй (果园守护者梅姨)",
	["npc.cn_mapmaker_chen.name"] = "Картограф Чэнь (制图师小陈)",
	["npc.cn_moon_host_yue.name"] = "Ведущая Праздника середины осени Юэ (中秋主理人悦姐)",
	["quest.CN01.title"] = "Там, где поворачивает река",
	["quest.CN01.summary"] = "Следуй за рыбаком вверх по течению и найди цветущую рощу",
	["quest.CN01.greeting"] = "Добро пожаловать в главу «Там, где поворачивает река»! Давай действовать сообща: следуй за рыбаком вверх по течению и найди цветущую рощу.",
	["quest.CN01.completion"] = "Глава CN01 пройдена! Твоя награда — Лепесток цветка.",
	["quest.CN01.source_note"] = "Это взято из литературы: плод воображения, а не рассказ о реальных событиях.",
	["artifact.cn_blossom_petal.name"] = "Лепесток цветка",
	["quest.CN02.title"] = "Тайная долина",
	["quest.CN02.summary"] = "Познакомься с жителями деревни, собери всё нужное для сада и помоги починить мост",
	["quest.CN02.greeting"] = "Добро пожаловать в Тайную долину! Давай действовать сообща: познакомься с жителями деревни, собери всё нужное для сада и помоги починить мост.",
	["quest.CN02.completion"] = "Глава CN02 завершена! Твоя награда — Карта долины.",
	["quest.CN02.source_note"] = "Это взято из литературы: плод воображения, а не запись реальных событий.",
	["artifact.cn_valley_map.name"] = "Карта долины",
	["quest.CN03.title"] = "Календарь перемен",
	["quest.CN03.summary"] = "Сравни сезонный урожай и приметы смены времён года",
	["quest.CN03.greeting"] = "Добро пожаловать в Календарь перемен! Давай действовать сообща: сравни сезонный урожай и приметы смены времён года.",
	["quest.CN03.completion"] = "Глава CN03 завершена! Твоя награда — Колесо сезонов.",
	["quest.CN03.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут быть своими.",
	["artifact.cn_season_wheel.name"] = "Колесо сезонов",
	["quest.CN04.title"] = "Меняющаяся тропа",
	["quest.CN04.summary"] = "Попробуй пройти по меняющемуся маршруту и узнай, почему карта из памяти больше не помогает",
	["quest.CN04.greeting"] = "Добро пожаловать на Меняющуюся тропу! Давай действовать сообща: попробуй пройти по меняющемуся маршруту и узнай, почему карта из памяти больше не помогает.",
	["quest.CN04.completion"] = "Глава CN04 завершена! Твоя награда — Меняющийся компас.",
	["quest.CN04.source_note"] = "Это взято из литературы: плод воображения, а не запись реальных событий.",
	["artifact.cn_changing_compass.name"] = "Меняющийся компас",
	["quest.CN05.title"] = "Лунные письма",
	["quest.CN05.summary"] = "Познакомься с историей о Чанъэ и приготовь праздничные лунные пряники",
	["quest.CN05.greeting"] = "Добро пожаловать в Лунные письма! Давай действовать сообща: познакомься с историей о Чанъэ и приготовь праздничные лунные пряники.",
	["quest.CN05.completion"] = "Глава CN05 завершена! Твоя награда — Лунное письмо.",
	["quest.CN05.source_note"] = "Это взято из фольклора: сказания со множеством версий, а не запись реальных событий.",
	["artifact.cn_moon_letter.name"] = "Лунное письмо",
	["quest.CN06.title"] = "Посади новый сад",
	["quest.CN06.summary"] = "Разбей новый общий сад вместо того, чтобы повторять исчезнувшее прошлое",
	["quest.CN06.greeting"] = "Добро пожаловать в испытание «Посади новый сад»! Давай действовать сообща: разбей новый общий сад вместо того, чтобы повторять исчезнувшее прошлое.",
	["quest.CN06.completion"] = "Глава CN06 завершена! Твоя награда — Печать Персикового источника.",
	["quest.CN06.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут быть своими.",
	["artifact.cn_peach_spring_stamp.name"] = "Печать Персикового источника",
	["country.JP.name"] = "Япония (путешествие Басё, маршрут по мотивам Тохоку)",
	["country.JP.story"] = "Узкая дорога домой",
	["country.JP.cultural_warning"] = "Bashō’s journey is historical literature; distinguish reconstructed poetic scenes from verified route facts. Haiku examples must be newly authored or rights-cleared translations.",
	["artifact.jp_travelers_ink_brush.name"] = "Кисть путешественника",
	["vocab.JP.tabi"] = "旅 (tabi) — Путешествие и вдумчивое странствие сквозь смену времён года",
	["vocab.JP.haiku"] = "俳句 (haiku) — Короткое стихотворение из трёх строк о природе и временах года",
	["vocab.JP.kakehashi"] = "架け橋 (kakehashi) — Мост, соединяющий разные места и людей",
	["npc.jp_guide_haruka.name"] = "Гид для путешественников Харука (旅の案内人 はるか)",
	["npc.jp_innkeeper_kenji.name"] = "Хозяин гостиницы Кэндзи (宿の主人 けんじ)",
	["npc.jp_bridge_builder_takumi.name"] = "Строитель мостов Такуми (橋大工 たくみ)",
	["npc.jp_poet_aoi.name"] = "Поэт Аои (俳人 あおい)",
	["npc.jp_gardener_ren.name"] = "Садовник Рэн (庭師 れん)",
	["quest.JP01.title"] = "Первый шаг",
	["quest.JP01.summary"] = "Собери дорожный набор, выбери указатель пути и встреться с путешественником",
	["quest.JP01.greeting"] = "Добро пожаловать в «Первый шаг»! Давай поработаем вместе: собери дорожный набор, выбери указатель пути и встреться с путешественником.",
	["quest.JP01.completion"] = "Глава JP01 пройдена! Ты получаешь Сандалию путешественника.",
	["quest.JP01.source_note"] = "Это взято из литературы: произведение воображения, а не запись реальных событий.",
	["artifact.jp_travelers_sandal.name"] = "Сандалия путешественника",
	["quest.JP02.title"] = "Переправа через реку",
	["quest.JP02.summary"] = "Помоги восстановить надёжный мост и перенести припасы",
	["quest.JP02.greeting"] = "Добро пожаловать в «Переправу через реку»! Давай поработаем вместе: помоги восстановить надёжный мост и перенести припасы.",
	["quest.JP02.completion"] = "Глава JP02 пройдена! Ты получаешь Жетон речного моста.",
	["quest.JP02.source_note"] = "Эта глава опирается на живые традиции, которым семьи следуют и сегодня. В разных домах они могут различаться.",
	["artifact.jp_river_bridge_token.name"] = "Жетон речного моста",
	["quest.JP03.title"] = "Три строки неба",
	["quest.JP03.summary"] = "Понаблюдай за погодой и сочини короткое стихотворение о времени года по подсказкам",
	["quest.JP03.greeting"] = "Добро пожаловать в «Три строки неба»! Давай поработаем вместе: понаблюдай за погодой и сочини короткое стихотворение о времени года по подсказкам.",
	["quest.JP03.completion"] = "Глава JP03 пройдена! Ты получаешь Листок хайку.",
	["quest.JP03.source_note"] = "Это взято из литературы: произведение воображения, а не запись реальных событий.",
	["artifact.jp_haiku_leaf.name"] = "Листок хайку",
	["quest.JP04.title"] = "Приют путешественника",
	["quest.JP04.summary"] = "Обменяй припасы и почини крышу небольшой гостиницы",
	["quest.JP04.greeting"] = "Добро пожаловать в «Приют путешественника»! Давай поработаем вместе: обменяй припасы и почини крышу небольшой гостиницы.",
	["quest.JP04.completion"] = "Глава JP04 пройдена! Ты получаешь Фонарь станции отдыха.",
	["quest.JP04.source_note"] = "Эта глава опирается на живые традиции, которым семьи следуют и сегодня. В разных домах они могут различаться.",
	["artifact.jp_waystation_lantern.name"] = "Путевой фонарь",
	["quest.JP05.title"] = "Меняющаяся тропа",
	["quest.JP05.summary"] = "Исследуй пейзаж в разное время и запиши, что изменилось",
	["quest.JP05.greeting"] = "Добро пожаловать в «Меняющуюся тропу»! Давай работать вместе: исследуй пейзаж в разное время и запиши, что изменилось.",
	["quest.JP05.completion"] = "Глава JP05 пройдена! Ты получаешь Сезонный свиток.",
	["quest.JP05.source_note"] = "Это взято из литературы: плод воображения, а не запись реальных событий.",
	["artifact.jp_seasonal_scroll.name"] = "Сезонный свиток",
	["quest.JP06.title"] = "Дорога — это дом",
	["quest.JP06.summary"] = "Построй общий сад для отдыха и подумай о том, где твой дом среди перемен",
	["quest.JP06.greeting"] = "Добро пожаловать в «Дорога — это дом»! Давай работать вместе: построй общий сад для отдыха и подумай о том, где твой дом среди перемен.",
	["quest.JP06.completion"] = "Глава JP06 пройдена! Ты получаешь Печать узкой дороги.",
	["quest.JP06.source_note"] = "Эта глава основана на живых традициях, которым семьи следуют и сегодня. В разных домах они могут различаться.",
	["artifact.jp_narrow_road_stamp.name"] = "Печать узкой дороги",
	["country.RU.name"] = "Россия (озеро Светлояр / мифический пейзаж по мотивам Китежа)",
	["country.RU.story"] = "Колокола на дне озера",
	["country.RU.cultural_warning"] = "Kitezh is folklore with historical variants, not a factual submerged city. Avoid romanticizing political violence or presenting spiritual-national exclusivity as moral truth; support plural interpretations.",
	["artifact.ru_kitezh_bell.name"] = "Китежский колокол",
	["vocab.RU.ozero"] = "озеро (ózero) — Чистое лесное озеро",
	["vocab.RU.gusli"] = "гусли (gúsli) — Традиционный щипковый многострунный народный инструмент",
	["vocab.RU.predaniye"] = "предание (predániye) — Устная легенда, передаваемая из поколения в поколение",
	["npc.ru_keeper_yelena.name"] = "Хранительница озера Елена",
	["npc.ru_historian_pavel.name"] = "Историк Павел",
	["npc.ru_musician_ilya.name"] = "Музыкант Илья",
	["npc.ru_archivist_vera.name"] = "Архивист Вера",
	["npc.ru_carpenter_maksim.name"] = "Плотник Максим",
	["quest.RU01.title"] = "Колокол на рассвете",
	["quest.RU01.summary"] = "Найди звуковые метки на берегу и восстанови деревенский колокол",
	["quest.RU01.greeting"] = "Добро пожаловать в «Колокол на рассвете»! Давай работать вместе: найди звуковые метки на берегу и восстанови деревенский колокол.",
	["quest.RU01.completion"] = "Глава RU01 пройдена! Ты получаешь Осколок озёрного колокола.",
	["quest.RU01.source_note"] = "Это взято из фольклора: истории, которые рассказывают во множестве версий, а не запись реальных событий.",
	["artifact.ru_lake_bell_fragment.name"] = "Осколок озёрного колокола",
	["quest.RU02.title"] = "Город в отражении",
	["quest.RU02.summary"] = "Исследуй волшебное видение, которое меняется в отражении воды",
	["quest.RU02.greeting"] = "Добро пожаловать в «Город в отражении»! Давай работать вместе: исследуй волшебное видение, которое меняется в отражении воды.",
	["quest.RU02.completion"] = "Глава RU02 пройдена! Ты получаешь Призму отражения.",
	["quest.RU02.source_note"] = "Это взято из фольклора: такие истории рассказывали во множестве вариантов, и они не описывают реальные события.",
	["artifact.ru_reflection_prism.name"] = "Призма отражения",
	["quest.RU03.title"] = "Струны Садко",
	["quest.RU03.summary"] = "Сыграй в ритм-головоломку, вдохновлённую фольклорным музыкантом Садко",
	["quest.RU03.greeting"] = "Добро пожаловать в «Струны Садко»! Давай действовать сообща: сыграй в ритм-головоломку, вдохновлённую фольклорным музыкантом Садко.",
	["quest.RU03.completion"] = "Глава RU03 завершена! Ты получаешь амулет «Гусли».",
	["quest.RU03.source_note"] = "Это взято из фольклора: такие истории рассказывали во множестве вариантов, и они не описывают реальные события.",
	["artifact.ru_gusli_charm.name"] = "Амулет «Гусли»",
	["quest.RU04.title"] = "Водный сад",
	["quest.RU04.summary"] = "Помоги создать уютный сад у озера, не нарушая жизнь природы",
	["quest.RU04.greeting"] = "Добро пожаловать в «Водный сад»! Давай действовать сообща: помоги создать уютный сад у озера, не нарушая жизнь природы.",
	["quest.RU04.completion"] = "Глава RU04 завершена! Ты получаешь венок из тростника.",
	["quest.RU04.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного отличаться.",
	["artifact.ru_reed_wreath.name"] = "Венок из тростника",
	["quest.RU05.title"] = "Хранители историй",
	["quest.RU05.summary"] = "Запиши разные варианты сказания о Китеже в местный архив",
	["quest.RU05.greeting"] = "Добро пожаловать в «Хранители историй»! Давай действовать сообща: запиши разные варианты сказания о Китеже в местный архив.",
	["quest.RU05.completion"] = "Глава RU05 завершена! Ты получаешь фолиант легенд.",
	["quest.RU05.source_note"] = "Это взято из фольклора: такие истории рассказывали во множестве вариантов, и они не описывают реальные события.",
	["artifact.ru_legend_folio.name"] = "Фолиант легенд",
	["quest.RU06.title"] = "История над водой",
	["quest.RU06.summary"] = "Построй беседку для сказителей и научись отличать предания от доказанных фактов",
	["quest.RU06.greeting"] = "Добро пожаловать в главу «История над водой»! Давай действовать сообща: построй беседку для сказителей и научись отличать предания от доказанных фактов.",
	["quest.RU06.completion"] = "Глава RU06 завершена! Ты получаешь памятную печать Китежа.",
	["quest.RU06.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного отличаться.",
	["artifact.ru_kitezh_memory_stamp.name"] = "Памятная печать Китежа",
	["country.UA.name"] = "Украина (холмы основания Киева / общинная музыкальная площадь)",
	["country.UA.story"] = "Хранительница песен",
	["country.UA.cultural_warning"] = "The Kyiv founders are chronicle legends. Kobzar traditions are varied; do not imply all practitioners were blind or use disability as a supernatural device. No graphic violence or combat reenactment.",
	["artifact.ua_bandura_memory_charm.name"] = "Памятный амулет бандуры",
	["vocab.UA.bandura"] = "бандура (bandúra) — украинский щипковый струнный инструмент, сочетающий черты лютни и арфы",
	["vocab.UA.dumy"] = "думи (dúmy) — песенные эпические поэмы, сохраняющие устную память народа",
	["vocab.UA.toloka"] = "толока (tolóka) — совместный труд ради взаимопомощи, чтобы вместе строить или восстанавливать",
	["npc.ua_guide_lybid.name"] = "Гид Елена (маршрут «Лыбедь») (Провідниця Олена)",
	["npc.ua_storyteller_taras.name"] = "Исторический сказитель Тарас (Оповідач Тарас)",
	["npc.ua_kobzar_mykola.name"] = "Музыкант Микола (Кобзар Микола)",
	["npc.ua_maker_solomiya.name"] = "Мастерица инструментов Соломия (Майстриня Соломія)",
	["npc.ua_curator_kateryna.name"] = "Куратор Катерина (Кураторка Катерина)",
	["quest.UA01.title"] = "Четыре основателя",
	["quest.UA01.summary"] = "Исследуй три холма и реку, собирая карту легенды об основании",
	["quest.UA01.greeting"] = "Добро пожаловать в «Четыре основателя»! Давай работать вместе: исследуй три холма и реку, собирая карту легенды об основании.",
	["quest.UA01.completion"] = "Глава UA01 завершена! Ты получаешь Речную карту основателей.",
	["quest.UA01.source_note"] = "Это взято из фольклора: такие истории рассказывают во множестве версий, и это не запись реальных событий.",
	["artifact.ua_founders_river_map.name"] = "Речная карта основателей",
	["quest.UA02.title"] = "Город у воды",
	["quest.UA02.summary"] = "Собери дерево и камень, чтобы восстановить доступный пешеходный мостик",
	["quest.UA02.greeting"] = "Добро пожаловать в «Город у воды»! Давай работать вместе: собери дерево и камень, чтобы восстановить доступный пешеходный мостик.",
	["quest.UA02.completion"] = "Глава UA02 завершена! Ты получаешь Табличку речного моста.",
	["quest.UA02.source_note"] = "Эта глава опирается на живые традиции, которые семьи хранят и сегодня. В каждом доме они могут различаться.",
	["artifact.ua_river_bridge_plaque.name"] = "Табличка речного моста",
	["quest.UA03.title"] = "Послушай кобзаря",
	["quest.UA03.summary"] = "Научись с уважением слушать музыку и участвовать в игре-перекличке",
	["quest.UA03.greeting"] = "Добро пожаловать в «Послушай кобзаря»! Давай работать вместе: научись с уважением слушать музыку и участвовать в игре-перекличке.",
	["quest.UA03.completion"] = "Глава UA03 завершена! Ты получаешь Струну бандуры.",
	["quest.UA03.source_note"] = "Эта глава опирается на живые традиции, которые семьи хранят и сегодня. В каждом доме они могут различаться.",
	["artifact.ua_bandura_string.name"] = "Струна бандуры",
	["quest.UA04.title"] = "Тетрадь дум",
	["quest.UA04.summary"] = "Собери и расставь по порядку строфы историй, отделяя устную память от документальных событий",
	["quest.UA04.greeting"] = "Добро пожаловать в «Тетрадь дум»! Давай работать вместе: собери и расставь по порядку строфы историй, отделяя устную память от документальных событий.",
	["quest.UA04.completion"] = "Глава UA04 завершена! Ты получаешь Страницу думы.",
	["quest.UA04.source_note"] = "Эта глава основана на реальной истории, но некоторые детали придуманы для игры.",
	["artifact.ua_dumy_page.name"] = "Страница думы",
	["quest.UA05.title"] = "Зал живой музыки",
	["quest.UA05.summary"] = "Отремонтируй концертный зал и расставь инструменты с табличками",
	["quest.UA05.greeting"] = "Добро пожаловать в «Зал живой музыки»! Давай работать вместе: отремонтируй концертный зал и расставь инструменты с табличками.",
	["quest.UA05.completion"] = "Глава UA05 пройдена! Твоя награда — резной пюпитр.",
	["quest.UA05.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.ua_carved_music_stand.name"] = "Резной пюпитр",
	["quest.UA06.title"] = "Песни-путешественницы",
	["quest.UA06.summary"] = "Придумай вместе с друзьями новую мелодию или ритм и создай общий архив",
	["quest.UA06.greeting"] = "Добро пожаловать в «Песни-путешественницы»! Давай объединим усилия: придумай вместе с друзьями новую мелодию или ритм и создай общий архив.",
	["quest.UA06.completion"] = "Глава UA06 пройдена! Твоя награда — штамп «Украинская песня».",
	["quest.UA06.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.ua_ukraine_song_stamp.name"] = "Штамп «Украинская песня»",
	["country.MA.name"] = "Марокко (Марракеш / площадь в стиле Джемаа-эль-Фна)",
	["country.MA.story"] = "Живой круг",
	["country.MA.cultural_warning"] = "Al Halqa is a living performance tradition, not one fixed text. Cultural/religious stories, including the Seven Saints, must be reviewed and presented respectfully without assigning sacred characters arbitrary game powers.",
	["artifact.ma_storytellers_circle_drum.name"] = "Барабан сказительского круга",
	["vocab.MA.halqa"] = "حلقة (ḥalqa) — круг зрителей и слушателей, которые собираются вокруг сказителя и оживляют историю",
	["vocab.MA.atay"] = "أتاي (atāy) — марокканский зелёный чай со свежей мятой",
	["vocab.MA.zellij"] = "زليج (zallīj) — вырезанная вручную геометрическая мозаика из глазурованной плитки",
	["npc.ma_hakawati_driss.name"] = "Мастер-хакавати Дрисс (الحكواتي المعلم إدريس)",
	["npc.ma_tea_host_kenza.name"] = "Хозяйка чайной Кенза (لالة كنزة مضيفة أتاي)",
	["npc.ma_merchant_yassine.name"] = "Торговец ремёслами Яссин (الصانع ياسين)",
	["npc.ma_historian_salma.name"] = "Историк Сальма (المؤرخة سلمى)",
	["npc.ma_performer_amine.name"] = "Юный артист Амин (الفنان الشاب أمين)",
	["quest.MA01.title"] = "Вставай в круг",
	["quest.MA01.summary"] = "Найди площадь и узнай, как зрители помогают сказке ожить",
	["quest.MA01.greeting"] = "Добро пожаловать в задание «Вставай в круг»! Давай действовать сообща: найди площадь и узнай, как зрители помогают сказке ожить.",
	["quest.MA01.completion"] = "Глава MA01 пройдена! Твоя награда — приглашение в круг.",
	["quest.MA01.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.ma_circle_invitation.name"] = "Приглашение в круг",
	["quest.MA02.title"] = "Сказка на много голосов",
	["quest.MA02.summary"] = "Выбирай звуки, жесты и вопросы для разветвлённой устной сказки",
	["quest.MA02.greeting"] = "Добро пожаловать в историю «Сказка на много голосов»! Давай действовать сообща: выбирай звуки, жесты и вопросы для разветвлённой устной сказки.",
	["quest.MA02.completion"] = "Глава MA02 пройдена! Ты получаешь жетон хакавати.",
	["quest.MA02.source_note"] = "Это взято из фольклора: такие истории передаются во множестве версий, и это не запись реальных событий.",
	["artifact.ma_hakawati_token.name"] = "Жетон хакавати",
	["quest.MA03.title"] = "Чай и ремесло",
	["quest.MA03.summary"] = "Собери мяту, выполни традиции гостеприимства без нагревания и обменяй её на ремесленные украшения",
	["quest.MA03.greeting"] = "Добро пожаловать в главу «Чай и ремесло»! Давай сделаем это вместе: собери мяту, выполни традиции гостеприимства без нагревания и обменяй её на ремесленные украшения.",
	["quest.MA03.completion"] = "Глава MA03 пройдена! Ты получаешь поднос для мятного чая.",
	["quest.MA03.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.ma_mint_tea_tray.name"] = "Поднос для мятного чая",
	["quest.MA04.title"] = "История, которую мы меняем",
	["quest.MA04.summary"] = "Сочини вместе с другими короткую сказку с разными концовками и сохрани имена авторов",
	["quest.MA04.greeting"] = "Добро пожаловать в главу «История, которую мы меняем»! Давай сделаем это вместе: сочини короткую сказку с разными концовками и сохрани имена авторов.",
	["quest.MA04.completion"] = "Глава MA04 пройдена! Ты получаешь нить истории.",
	["quest.MA04.source_note"] = "Это задание придумано специально для игры, чтобы помочь рассказать историю.",
	["artifact.ma_story_thread.name"] = "Нить истории",
	["quest.MA05.title"] = "Тропы мудрости",
	["quest.MA05.summary"] = "Исследуй карту культурного наследия, вдохновлённую историями о семи святых Марракеша",
	["quest.MA05.greeting"] = "Добро пожаловать в главу «Тропы мудрости»! Давай сделаем это вместе: исследуй карту культурного наследия, вдохновлённую историями о семи святых Марракеша.",
	["quest.MA05.completion"] = "Глава MA05 пройдена! Ты получаешь карту наследия.",
	["quest.MA05.source_note"] = "Эта глава основана на реальной истории, но некоторые детали были придуманы для игры.",
	["artifact.ma_heritage_map.name"] = "Карта наследия",
	["quest.MA06.title"] = "Круг путешествует",
	["quest.MA06.summary"] = "Построй небольшую сцену для сказителя и устрой совместное выступление на разных языках",
	["quest.MA06.greeting"] = "Добро пожаловать в главу «Круг путешествует»! Давай сделаем это вместе: построй небольшую сцену для сказителя и устрой совместное выступление на разных языках.",
	["quest.MA06.completion"] = "Глава MA06 пройдена! Ты получаешь печать «Марокканский круг».",
