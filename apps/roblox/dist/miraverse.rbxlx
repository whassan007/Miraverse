	["artifact.cn_blossom_petal.name"] = "بتلة الزهرة",
	["quest.CN02.title"] = "الوادي الخفي",
	["quest.CN02.summary"] = "تعرّف على القرويين، واجمع أدوات الحديقة، وساعد في إصلاح الجسر",
	["quest.CN02.greeting"] = "أهلاً بك في الوادي الخفي! هيا نعمل معاً: تعرّف على القرويين، واجمع أدوات الحديقة، وساعد في إصلاح الجسر.",
	["quest.CN02.completion"] = "اكتمل الفصل CN02! لقد حصلت على خريطة الوادي.",
	["quest.CN02.source_note"] = "هذه القصة مستوحاة من الأدب: عمل خيالي وليست تسجيلاً لأحداث حقيقية.",
	["artifact.cn_valley_map.name"] = "خريطة الوادي",
	["quest.CN03.title"] = "تقويم التغيير",
	["quest.CN03.summary"] = "قارن بين المحاصيل الموسمية وتعرّف على علامات مرور الوقت",
	["quest.CN03.greeting"] = "أهلاً بك في تقويم التغيير! هيا نعمل معاً: قارن بين المحاصيل الموسمية وتعرّف على علامات مرور الوقت.",
