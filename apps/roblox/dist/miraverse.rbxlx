	["npc.ma_performer_amine.name"] = "الفنان الشاب أمين",
	["quest.MA01.title"] = "انضم إلى الحلقة",
	["quest.MA01.summary"] = "ابحث عن الساحة وتعلّم كيف يساعد الجمهور في سرد الحكاية",
	["quest.MA01.greeting"] = "أهلاً بك في انضم إلى الحلقة! هيا نعمل معاً: ابحث عن الساحة وتعلّم كيف يساعد الجمهور في سرد الحكاية.",
	["quest.MA01.completion"] = "اكتمل الفصل MA01! لقد حصلت على دعوة إلى الحلقة.",
	["quest.MA01.source_note"] = "يستند هذا الفصل إلى تقاليد حية ما زالت العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.ma_circle_invitation.name"] = "دعوة الحلقة",
	["quest.MA02.title"] = "حكاية بأصوات متعددة",
	["quest.MA02.summary"] = "اختر تلميحات للأصوات والحركات والأسئلة لحكاية شفهية متفرعة",
	["quest.MA02.greeting"] = "أهلاً بك في حكاية بأصوات متعددة! هيا نعمل معاً: اختر تلميحات للأصوات والحركات والأسئلة لحكاية شفهية متفرعة.",
	["quest.MA02.completion"] = "اكتمل الفصل MA02! لقد حصلت على رمز الحكواتي.",
	["quest.MA02.source_note"] = "هذا مستمد من الفولكلور (التراث الشعبي): وهي قصص تُروى بروايات متعددة، وليست تسجيلاً لأحداث حقيقية.",
	["artifact.ma_hakawati_token.name"] = "رمز الحكواتي",
	["quest.MA03.title"] = "الشاي والحرفة",
	["quest.MA03.summary"] = "اجمع النعناع وأكمل خطوات الضيافة بدون تسخين، وبادلها بزينات حرفية",
	["quest.MA03.greeting"] = "أهلاً بك في الشاي والحرفة! هيا نعمل معاً: اجمع النعناع وأكمل خطوات الضيافة بدون تسخين، وبادلها بزينات حرفية.",
	["quest.MA03.completion"] = "اكتمل الفصل MA03! لقد حصلت على صينية شاي النعناع.",
	["quest.MA03.source_note"] = "يستند هذا الفصل إلى تقاليد حية ما زالت العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.ma_mint_tea_tray.name"] = "صينية شاي النعناع",
	["quest.MA04.title"] = "الحكاية التي نغيرها",
	["quest.MA04.summary"] = "شارك في تأليف حكاية قصيرة بنهايات مختلفة مع حفظ نسبة القصة لمؤلفها",
	["quest.MA04.greeting"] = "أهلاً بك في الحكاية التي نغيرها! هيا نعمل معاً: شارك في تأليف حكاية قصيرة بنهايات مختلفة مع حفظ نسبة القصة لمؤلفها.",
	["quest.MA04.completion"] = "اكتمل الفصل MA04! لقد حصلت على خيط الحكاية.",
	["quest.MA04.source_note"] = "ابتُكر هذا النشاط خصيصاً للعبة للمساعدة في سرد القصة.",
	["artifact.ma_story_thread.name"] = "خيط الحكاية",
	["quest.MA05.title"] = "مسارات الحكمة",
	["quest.MA05.summary"] = "استكشف خريطة تراثية ملؤها الاحترام مستوحاة من روايات رجال مراكش السبعة",
	["quest.MA05.greeting"] = "أهلاً بك في مسارات الحكمة! هيا نعمل معاً: استكشف خريطة تراثية ملؤها الاحترام مستوحاة من روايات رجال مراكش السبعة.",
	["quest.MA05.completion"] = "اكتمل الفصل MA05! لقد حصلت على خريطة التراث.",
	["quest.MA05.source_note"] = "يستند هذا الفصل إلى تاريخ حقيقي، مع بعض التفاصيل الخيالية التي أُضيفت للعبة.",
