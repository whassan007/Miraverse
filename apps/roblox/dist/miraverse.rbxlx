            <Properties>
              <string name="Name">ru-RU</string>
              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "Ливан (Библ/Джубейль)",
	["country.LB.story"] = "Гавань возвращающихся историй",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "Сундучок воспоминаний из кедра и моря",
	["vocab.LB.saj"] = "صاج (ṣāj) — выпуклая круглая сковорода для выпечки лепешек",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — ароматная смесь дикого тимьяна, кунжута и сумаха",
	["vocab.LB.mina"] = "مينا (mīnā) — прибрежная гавань и каменный причал",
	["npc.lb_teta_nahla.name"] = "Тета Нахла (تيتا نهلة)",
	["npc.lb_archivist_rami.name"] = "Юный архивариус Рами (الأرشيفي رامي)",
	["npc.lb_captain_faris.name"] = "Капитан гавани Фарис (القبطان فارس)",
	["npc.lb_baker_tariq.name"] = "Пекарь Тарик (الخبّاز طارق)",
	["npc.lb_artisan_nadia.name"] = "Мастерица надписей Надя (الحرفية نادية)",
	["quest.LB01.title"] = "Гавань просыпается",
	["quest.LB01.summary"] = "Иди вдоль освещенных фонарями причалов, собери припасы в гавани и почини безопасную тропинку",
	["quest.LB01.greeting"] = "Добро пожаловать в главу «Гавань просыпается»! Давай сделаем это вместе: иди вдоль освещенных фонарями причалов, собери припасы в гавани и почини безопасную тропинку.",
	["quest.LB01.completion"] = "Глава LB01 пройдена! Твоя награда — Компас гавани.",
	["quest.LB01.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут немного различаться.",
	["artifact.lb_harbor_compass.name"] = "Компас гавани",
	["quest.LB02.title"] = "Письмена на камне",
	["quest.LB02.summary"] = "Подбери финикийские буквенные узоры к торговым табличкам и восстанови небольшую табличку с надписью",
	["quest.LB02.greeting"] = "Добро пожаловать в главу «Письмена на камне»! Давай сделаем это вместе: подбери финикийские буквенные узоры к торговым табличкам и восстанови небольшую табличку с надписью.",
	["quest.LB02.completion"] = "Глава LB02 пройдена! Ты получаешь плитку с алфавитом.",
	["quest.LB02.source_note"] = "Эта глава основана на реальной истории, но некоторые детали были придуманы для игры.",
	["artifact.lb_alphabet_tile.name"] = "Плитка с алфавитом",
	["quest.LB03.title"] = "Стол Тэты",
	["quest.LB03.summary"] = "Собери заатар и ингредиенты, поторгуйся на рынке и приготовь мануше на безопасной игровой плите",
	["quest.LB03.greeting"] = "Добро пожаловать за стол Тэты! Давай сделаем это вместе: собери заатар и ингредиенты, поторгуйся на рынке и приготовь мануше на безопасной игровой плите.",
	["quest.LB03.completion"] = "Глава LB03 пройдена! Ты получаешь карточку с семейным рецептом.",
	["quest.LB03.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут различаться.",
	["artifact.lb_family_recipe_card.name"] = "Карточка с семейным рецептом",
	["quest.LB04.title"] = "Кедровый сундук",
	["quest.LB04.summary"] = "Исследуй кедровый сундук из мифов и сопоставь легенду с историческими свидетельствами",
	["quest.LB04.greeting"] = "Добро пожаловать к Кедровому сундуку! Давай сделаем это вместе: исследуй кедровый сундук из мифов и сопоставь легенду с историческими свидетельствами.",
	["quest.LB04.completion"] = "Глава LB04 пройдена! Ты получаешь кедровый жетон.",
	["quest.LB04.source_note"] = "Это взято из фольклора — историй, у которых много разных версий, а не записей реальных событий.",
	["artifact.lb_cedar_token.name"] = "Кедровый жетон",
	["quest.LB05.title"] = "Фотографии из-за моря",
	["quest.LB05.summary"] = "Поговори с вымышленными персонажами семьи, расставь фотографии по датам и подготовь выставку с согласия героев",
	["quest.LB05.greeting"] = "Добро пожаловать к «Фотографиям из-за моря»! Давай сделаем это вместе: поговори с вымышленными персонажами семьи, расставь фотографии по датам и подготовь выставку с согласия героев.",
	["quest.LB05.completion"] = "Глава LB05 пройдена! Ты получаешь архивный альбом.",
	["quest.LB05.source_note"] = "Это задание было придумано специально для игры, чтобы помочь рассказать историю.",
	["artifact.lb_archive_album.name"] = "Архивный альбом",
	["quest.LB06.title"] = "Праздник возвращения",
	["quest.LB06.summary"] = "Восстанови площадь для встреч, устрой общий праздник и расскажи новую семейную историю",
	["quest.LB06.greeting"] = "Добро пожаловать на Праздник возвращения! Давай сделаем это вместе: восстанови площадь для встреч, устрой общий праздник и расскажи новую семейную историю.",
	["quest.LB06.completion"] = "Глава LB06 пройдена! Ты получаешь штамп «Дом у гавани».",
	["quest.LB06.source_note"] = "Эта глава основана на живых традициях, которые семьи соблюдают и сегодня. В каждом доме они могут различаться.",
	["artifact.lb_harbor_home_stamp.name"] = "Штамп «Дом у гавани»",
	["country.IQ.name"] = "Ирак (Багдад)",
	["country.IQ.story"] = "Библиотека-путешественница",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "Книга из Дома мудрости",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — Резной деревянный решётчатый балкон, нависающий над улицей",
	["vocab.IQ.kleicha"] = "كليجة (klīcha) — Праздничное печенье с финиками и кардамоном, которым угощают близких",
	["vocab.IQ.hikma"] = "حكمة (ḥikma) — Мудрость и совместный поиск знаний",
	["npc.iq_bibi_amal.name"] = "Биби Амаль (بيبي أمل)",
	["npc.iq_merchant_hassan.name"] = "Книготорговец Хасан (الكتبي حسان)",
	["npc.iq_translator_mariam.name"] = "Переводчица Марьям (المترجمة مريم)",
	["npc.iq_baker_salim.name"] = "Пекарь Салим (الخبّاز سليم)",
	["npc.iq_astronomer_zaid.name"] = "Ученик астронома Зайд (الفلكي زيد)",
	["quest.IQ01.title"] = "Улица книг",
	["quest.IQ01.summary"] = "Открой ставни, верни разбросанные книги торговцам и составь карту полок",
	["quest.IQ01.greeting"] = "Добро пожаловать на Улицу книг! Давай работать вместе: открой ставни, верни разбросанные книги торговцам и составь карту полок.",
	["quest.IQ01.completion"] = "Глава IQ01 завершена! Ты получил печать книготорговца.",
	["quest.IQ01.source_note"] = "Эта глава опирается на живые традиции, которые семьи соблюдают и сегодня. В разных семьях они могут отличаться.",
	["artifact.iq_bookseller_seal.name"] = "Печать книготорговца",
	["quest.IQ02.title"] = "Дом мудрости",
	["quest.IQ02.summary"] = "Собери математические инструменты и помоги восстановить комнату учёных",
	["quest.IQ02.greeting"] = "Добро пожаловать в Дом мудрости! Давай работать вместе: собери математические инструменты и помоги восстановить комнату учёных.",
	["quest.IQ02.completion"] = "Глава IQ02 завершена! Ты получил астролябию учёного.",
	["quest.IQ02.source_note"] = "Эта глава основана на реальной истории, но некоторые детали придуманы специально для игры.",
	["artifact.iq_scholars_astrolabe.name"] = "Астролябия учёного",
	["quest.IQ03.title"] = "Слова, которые путешествуют",
	["quest.IQ03.summary"] = "Сопоставь переводы понятий из арабского, греческого и сирийского языков с табличками их происхождения",
	["quest.IQ03.greeting"] = "Добро пожаловать в «Слова, которые путешествуют»! Давай работать вместе: сопоставь переводы понятий из арабского, греческого и сирийского языков с табличками их происхождения.",
	["quest.IQ03.completion"] = "Глава IQ03 завершена! Ты получил свиток перевода.",
	["quest.IQ03.source_note"] = "Эта глава основана на реальной истории, но некоторые детали придуманы специально для игры.",
