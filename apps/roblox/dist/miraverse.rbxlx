	["artifact.iq_house_of_wisdom_book.name"] = "كتاب بيت الحكمة",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — بلكونة خشب مشبكة ومحفورة بتطل على الشارع",
