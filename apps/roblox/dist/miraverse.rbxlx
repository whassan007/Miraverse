	["artifact.de_lorelei_songstone.name"] = "罗蕾莱歌之石",
	["quest.DE03.title"] = "引航员的抉择",
	["quest.DE03.summary"] = "分辨真实信号与干扰回声，帮助船只驶向避风港",
	["quest.DE03.greeting"] = "欢迎来到引航员的抉择！让我们携手合作：分辨真实信号与干扰回声，帮助船只驶向避风港。",
	["quest.DE03.completion"] = "DE03章节完成！你获得了稳固之舵。",
	["quest.DE03.source_note"] = "本活动是专为游戏创作的虚构内容，旨在帮助讲述故事。",
