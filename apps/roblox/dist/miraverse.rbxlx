	["quest.DE01.title"] = "منعطف النهر",
	["quest.DE01.summary"] = "خطط لمسار آمن في نهر الراين مستعيناً بالمنارات وأنماط التيارات ورموز الخريطة",
	["quest.DE01.greeting"] = "مرحباً بك في منعطف النهر! لنعمل معاً: خطط لمسار آمن في نهر الراين مستعيناً بالمنارات وأنماط التيارات ورموز الخريطة.",
	["quest.DE01.completion"] = "اكتمل الفصل DE01! لقد حصلت على خريطة مسار نهر الراين.",
	["quest.DE01.source_note"] = "يستند هذا الفصل إلى تاريخ حقيقي، مع بعض التفاصيل الخيالية المبتكرة من أجل اللعبة.",
	["artifact.de_rhine_route_map.name"] = "خريطة مسار نهر الراين",
	["quest.DE02.title"] = "الأغنية المسحورة",
	["quest.DE02.summary"] = "تعرّف على عناصر التشتيت في لغز الصوت والضوء، واستمع إلى روايات مختلفة لأسطورة لوريلاي",
	["quest.DE02.greeting"] = "مرحباً بك في الأغنية المسحورة! لنعمل معاً: تعرّف على عناصر التشتيت في لغز الصوت والضوء، واستمع إلى روايات مختلفة لأسطورة لوريلاي.",
	["quest.DE02.completion"] = "اكتمل الفصل DE02! لقد حصلت على حجر أغنية لوريلاي.",
	["quest.DE02.source_note"] = "هذا مأخوذ من الأدب: إنه عمل من وحي الخيال، وليس تسجيلاً لأحداث حقيقية.",
	["artifact.de_lorelei_songstone.name"] = "حجر أغنية لوريلاي",
	["quest.DE03.title"] = "خيار الملاح",
	["quest.DE03.summary"] = "ساعد قارباً في الوصول إلى بر الأمان عبر تفضيل الإشارات الحقيقية على أصداء الصوت المشتتة",
	["quest.DE03.greeting"] = "مرحباً بك في خيار الملاح! لنعمل معاً: ساعد قارباً في الوصول إلى بر الأمان عبر تفضيل الإشارات الحقيقية على أصداء الصوت المشتتة.",
	["quest.DE03.completion"] = "اكتمل الفصل DE03! لقد حصلت على الدفة الثابتة.",
	["quest.DE03.source_note"] = "ابتُكر هذا النشاط من أجل اللعبة للمساعدة في رواية القصة.",
	["artifact.de_steady_helm.name"] = "الدفة الثابتة",
	["quest.DE04.title"] = "قاعة الكأس الهادئة",
	["quest.DE04.summary"] = "استكشف قلعة أسطورية وانتبه إلى أن إحدى الشخصيات تحتاج إلى مساعدة",
	["quest.DE04.greeting"] = "مرحباً بك في قاعة الكأس الهادئة! لنعمل معاً: استكشف قلعة أسطورية وانتبه إلى أن إحدى الشخصيات تحتاج إلى مساعدة.",
	["quest.DE04.completion"] = "اكتمل الفصل DE04! لقد حصلت على رمز قاعة الأسئلة.",
	["quest.DE04.source_note"] = "هذا مأخوذ من الأدب: إنه عمل من وحي الخيال، وليس تسجيلاً لأحداث حقيقية.",
	["artifact.de_hall_of_questions_token.name"] = "رمز قاعة الأسئلة",
	["quest.DE05.title"] = "ما الذي يؤلمك؟",
	["quest.DE05.summary"] = "اطرح سؤالاً يملؤه التعاطف واختر أفعالاً مفيدة بدلاً من التزام الصمت",
	["quest.DE05.greeting"] = "أهلاً بك في «ما الذي يؤلمك؟»! هيا نعمل معاً: اطرح سؤالاً يملؤه التعاطف واختر أفعالاً مفيدة بدلاً من التزام الصمت.",
	["quest.DE05.completion"] = "اكتمل الفصل DE05! لقد حصلتَ على لفافة سؤال الشفاء.",
	["quest.DE05.source_note"] = "هذا مأخوذ من الأدب: عملٌ من نسج الخيال، وليس تسجيلاً لأحداث حقيقية.",
	["artifact.de_healing_question_scroll.name"] = "لفافة سؤال الشفاء",
	["quest.DE06.title"] = "عودة الحديقة",
	["quest.DE06.summary"] = "تعاون مع الآخرين لإعادة إحياء حديقة مهجورة وسجّل ما تغير فيها",
	["quest.DE06.greeting"] = "أهلاً بك في «عودة الحديقة»! هيا نعمل معاً: تعاون مع الآخرين لإعادة إحياء حديقة مهجورة وسجّل ما تغير فيها.",
	["quest.DE06.completion"] = "اكتمل الفصل DE06! لقد حصلتَ على طابع الذكريات الألمانية.",
	["quest.DE06.source_note"] = "يستند هذا الفصل إلى تقاليد حية لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.de_german_memory_stamp.name"] = "طابع الذكريات الألمانية",
