          <Item class="ModuleScript" referent="16">
            <Properties>
              <string name="Name">ko-KR</string>
              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "레바논 (비블로스/즈베일)",
	["country.LB.story"] = "돌아오는 이야기의 항구",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "삼나무와 바다의 기억 상자",
	["vocab.LB.saj"] = "صاج (ṣāj) — 납작빵을 굽는 돔 모양의 철판",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — 향긋한 야생 타임, 참깨, 수막을 섞은 양념",
	["vocab.LB.mina"] = "مينا (mīnā) — 해안 항구와 돌 부두",
	["npc.lb_teta_nahla.name"] = "테타 나흘라 (تيتا نهلة)",
	["npc.lb_archivist_rami.name"] = "어린 기록보관사 라미 (الأرشيفي رامي)",
	["npc.lb_captain_faris.name"] = "항구 선장 파리스 (القبطان فارس)",
	["npc.lb_baker_tariq.name"] = "제빵사 타리크 (الخبّاز طارق)",
	["npc.lb_artisan_nadia.name"] = "글자 공예가 나디아 (الحرفية نادية)",
	["quest.LB01.title"] = "깨어나는 항구",
	["quest.LB01.summary"] = "등불이 켜진 부두를 따라가고, 항구 물자를 모아 안전한 길을 고쳐 봐",
	["quest.LB01.greeting"] = "'깨어나는 항구'에 온 걸 환영해! 함께 힘을 모아 보자. 등불이 켜진 부두를 따라가고, 항구 물자를 모아 안전한 길을 고쳐 보는 거야.",
	["quest.LB01.completion"] = "LB01 챕터 완료! '항구 나침반'을 얻었어.",
	["quest.LB01.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.lb_harbor_compass.name"] = "항구 나침반",
	["quest.LB02.title"] = "돌에 새겨진 글자들",
	["quest.LB02.summary"] = "페니키아 문자에서 영감을 얻은 글자 문양을 무역 표식과 맞추고, 글자가 새겨진 작은 팻말을 다시 완성해 봐",
	["quest.LB02.greeting"] = "'돌에 새겨진 글자들'에 온 걸 환영해! 함께 힘을 모아 보자. 페니키아 문자에서 영감을 얻은 글자 문양을 무역 표식과 맞추고, 글자가 새겨진 작은 팻말을 다시 완성해 보는 거야.",
	["quest.LB02.completion"] = "LB02 챕터 완료! 알파벳 타일을 얻었어.",
	["quest.LB02.source_note"] = "이 챕터는 실제 역사를 바탕으로 하지만, 게임을 위해 상상으로 덧붙인 부분도 있어.",
	["artifact.lb_alphabet_tile.name"] = "알파벳 타일",
	["quest.LB03.title"] = "테타의 식탁",
	["quest.LB03.summary"] = "자타르와 재료들을 모으고, 시장에서 흥정하고, 지도를 받으며 안전한 가상 열기로 마누셰 만들기",
	["quest.LB03.greeting"] = "테타의 식탁에 온 걸 환영해! 함께 힘을 모아보자: 자타르와 재료들을 모으고, 시장에서 흥정하고, 지도를 받으며 안전한 가상 열기로 마누셰를 만들어 봐.",
	["quest.LB03.completion"] = "LB03 챕터 완료! 가족 레시피 카드를 얻었어.",
	["quest.LB03.source_note"] = "이 챕터는 오늘날 가족들이 여전히 이어오고 있는 살아있는 전통을 담고 있어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.lb_family_recipe_card.name"] = "가족 레시피 카드",
	["quest.LB04.title"] = "삼나무 상자",
	["quest.LB04.summary"] = "신화에서 영감을 얻은 삼나무 상자를 조사하고 전설과 역사적 증거를 비교하기",
	["quest.LB04.greeting"] = "삼나무 상자에 온 걸 환영해! 함께 힘을 모아보자: 신화에서 영감을 얻은 삼나무 상자를 조사하고 전설과 역사적 증거를 비교해 봐.",
	["quest.LB04.completion"] = "LB04 챕터 완료! 삼나무 토큰을 얻었어.",
	["quest.LB04.source_note"] = "이 내용은 민속 설화에서 따온 것으로, 실제 일어난 일의 기록이 아니라 여러 가지 버전으로 전해 내려오는 이야기야.",
	["artifact.lb_cedar_token.name"] = "삼나무 토큰",
	["quest.LB05.title"] = "바다 건너온 사진들",
	["quest.LB05.summary"] = "가상의 가족 인물들을 인터뷰하고, 날짜순으로 사진을 정리하고, 동의를 받아 안전한 전시회를 꾸미기",
	["quest.LB05.greeting"] = "바다 건너온 사진들에 온 걸 환영해! 함께 힘을 모아보자: 가상의 가족 인물들을 인터뷰하고, 날짜순으로 사진을 정리하고, 동의를 받아 안전한 전시회를 꾸며 봐.",
	["quest.LB05.completion"] = "LB05 챕터 완료! 아카이브 앨범을 얻었어.",
	["quest.LB05.source_note"] = "이 활동은 이야기를 들려주기 위해 게임용으로 지어낸 가상의 활동이야.",
	["artifact.lb_archive_album.name"] = "아카이브 앨범",
	["quest.LB06.title"] = "귀환 축제",
	["quest.LB06.summary"] = "만남의 광장을 복원하고, 함께하는 잔치를 준비하고, 새로운 가족 이야기를 들려주기",
	["quest.LB06.greeting"] = "귀환 축제에 온 걸 환영해! 함께 힘을 모아보자: 만남의 광장을 복원하고, 함께하는 잔치를 준비하고, 새로운 가족 이야기를 들려줘 봐.",
	["quest.LB06.completion"] = "LB06 챕터 완료! 항구 집 스탬프를 얻었어.",
	["quest.LB06.source_note"] = "이 챕터는 오늘날 가족들이 여전히 이어오고 있는 살아있는 전통을 담고 있어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.lb_harbor_home_stamp.name"] = "항구 집 스탬프",
	["country.IQ.name"] = "이라크 (바그다드)",
	["country.IQ.story"] = "여행하는 도서관",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "지혜의 집 책",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — 거리 위로 돌출된 조각된 목재 격자 발코니",
	["vocab.IQ.kleicha"] = "كليجة (klīcha) — 축하할 때 함께 나누어 먹는 카다멈 향의 대추야자 페이스트리",
	["vocab.IQ.hikma"] = "حكمة (ḥikma) — 지혜와 함께 나누는 학문적 탐구",
	["npc.iq_bibi_amal.name"] = "비비 아말 (بيبي أمل)",
	["npc.iq_merchant_hassan.name"] = "책 상인 하산 (الكتبي حسان)",
	["npc.iq_translator_mariam.name"] = "번역가 마리암 (المترجمة مريم)",
	["npc.iq_baker_salim.name"] = "제빵사 살림 (الخبّاز سليم)",
	["npc.iq_astronomer_zaid.name"] = "수습 천문학자 자이드 (الفلكي زيد)",
	["quest.IQ01.title"] = "책들의 거리",
	["quest.IQ01.summary"] = "덧문을 열고, 흩어진 책을 상인들에게 돌려준 뒤 책장 지도를 정리해 보자",
	["quest.IQ01.greeting"] = "책들의 거리에 온 걸 환영해! 함께 힘을 모아 덧문을 열고, 흩어진 책을 상인들에게 돌려준 뒤 책장 지도를 정리해 보자.",
	["quest.IQ01.completion"] = "IQ01장 완료! 책 상인의 인장을 얻었어.",
	["quest.IQ01.source_note"] = "이 장은 오늘날에도 가족들이 이어가고 있는 살아있는 전통을 바탕으로 만들어졌어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.iq_bookseller_seal.name"] = "책 상인의 인장",
	["quest.IQ02.title"] = "지혜의 집",
	["quest.IQ02.summary"] = "수학 도구를 모으고 학자들의 방을 원래대로 꾸며 보자",
	["quest.IQ02.greeting"] = "지혜의 집에 온 걸 환영해! 함께 힘을 모아 수학 도구를 모으고 학자들의 방을 원래대로 꾸며 보자.",
	["quest.IQ02.completion"] = "IQ02장 완료! 학자의 아스트롤라베를 얻었어.",
	["quest.IQ02.source_note"] = "이 장은 실제 역사 이야기를 바탕으로 했고, 게임을 위해 상상력을 더한 부분도 있단다.",
	["artifact.iq_scholars_astrolabe.name"] = "학자의 아스트롤라베",
	["quest.IQ03.title"] = "여행하는 낱말들",
	["quest.IQ03.summary"] = "아랍어, 그리스어, 시리아어에서 비롯된 번역 단어들을 출처 표시에 알맞게 짝지어 보자",
	["quest.IQ03.greeting"] = "여행하는 낱말들에 온 걸 환영해! 함께 힘을 모아 아랍어, 그리스어, 시리아어에서 비롯된 번역 단어들을 출처 표시에 알맞게 짝지어 보자.",
	["quest.IQ03.completion"] = "IQ03장 완료! 번역 두루마리를 얻었어.",
	["quest.IQ03.source_note"] = "이 장은 실제 역사 이야기를 바탕으로 했고, 게임을 위해 상상력을 더한 부분도 있단다.",
	["artifact.iq_translation_scroll.name"] = "번역 두루마리",
	["quest.IQ04.title"] = "대추야자와 클레이차",
	["quest.IQ04.summary"] = "대추야자를 수확하고, 향신료를 나누며 온 가족과 함께 과자를 구워 보자",
	["quest.IQ04.greeting"] = "대추야자와 클레이차에 온 걸 환영해! 함께 힘을 모아 대추야자를 따고, 향신료를 나누고, 온 가족과 함께 과자를 구워 보자.",
	["quest.IQ04.completion"] = "IQ04장 완료! 클레이차 틀을 얻었어.",
	["quest.IQ04.source_note"] = "이 장은 오늘날에도 가족들이 이어가고 있는 살아있는 전통을 바탕으로 만들어졌어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.iq_kleicha_mold.name"] = "클레이차 틀",
	["quest.IQ05.title"] = "질문의 안뜰",
	["quest.IQ05.summary"] = "샤나실을 수리하고 햇빛과 그늘이 어우러진 독서 공간을 만들어 보자",
	["quest.IQ05.greeting"] = "질문의 안뜰에 온 걸 환영해! 함께 힘을 모아 보자: 샤나실을 수리하고 빛과 그늘이 어우러진 독서 공간을 만들어 봐.",
	["quest.IQ05.completion"] = "챕터 IQ05 완료! 안뜰 격자창을 획득했어.",
	["quest.IQ05.source_note"] = "이 챕터는 오늘날에도 가족들이 이어 가는 살아 있는 전통을 바탕으로 해. 집집마다 서로 다를 수 있어.",
	["artifact.iq_courtyard_lattice.name"] = "안뜰 격자창",
	["quest.IQ06.title"] = "바다를 건넌 도서관",
	["quest.IQ06.summary"] = "두 가지 언어로 전시를 열고, 방문객과 이야기를 나누며 도서 목록을 보존해 봐",
	["quest.IQ06.greeting"] = "바다를 건넌 도서관에 온 걸 환영해! 함께 힘을 모아 보자: 두 가지 언어로 전시를 열고, 방문객과 이야기를 나누며 도서 목록을 보존해 봐.",
	["quest.IQ06.completion"] = "챕터 IQ06 완료! 지식 지킴이 스탬프를 획득했어.",
	["quest.IQ06.source_note"] = "이 활동은 이야기를 들려주기 위해 게임용으로 만들어진 가상의 활동이야.",
	["artifact.iq_knowledge_keeper_stamp.name"] = "지식 지킴이 스탬프",
	["country.EG.name"] = "이집트 (카이로)",
	["country.EG.story"] = "카이로의 등불",
	["country.EG.cultural_warning"] = "The Fatimid lantern origin is a widely circulated tradition, not a single definitively established historical account. Distinguish contemporary Cairo from ancient Egyptian settings.",
	["artifact.eg_fanous_of_shared_light.name"] = "함께 나누는 빛의 파누스",
	["vocab.EG.fanous"] = "فانوس (fānūs) — 황동과 색유리로 만든 장식용 등불",
	["vocab.EG.koshari"] = "كشري (kusharī) — 쌀, 렌틸콩, 파스타, 토마토소스, 바삭한 양파를 층층이 쌓은 요리",
	["vocab.EG.mashrabiya"] = "مشربية (mashrabiyya) — 깎은 나무로 짠 기하학적 무늬의 격자창",
	["npc.eg_layla_guide.name"] = "라일라와 테타 사미라 (ليلى وتيتا سميرة)",
	["npc.eg_lantern_maker_amm_adel.name"] = "등불 장인 암 아델 (عم عادل صانع الفوانيس)",
	["npc.eg_market_auntie_nadia.name"] = "시장 이모 나디아 (طنط نادية في السوق)",
	["npc.eg_cook_ibrahim.name"] = "셰프 이브라힘 (الشيف إبراهيم)",
	["npc.eg_storyteller_youssef.name"] = "이야기꾼 유세프 (الحكواتي يوسف)",
	["quest.EG01.title"] = "어두워진 안뜰",
	["quest.EG01.summary"] = "색색의 등불 빛을 따라가며 사라진 구리 판을 찾아봐",
	["quest.EG01.greeting"] = "어두워진 안뜰에 온 걸 환영해! 함께 힘을 모아 보자: 색색의 등불 빛을 따라가며 사라진 구리 판을 찾아봐.",
	["quest.EG01.completion"] = "챕터 EG01 완료! 등불 틀을 획득했어.",
	["quest.EG01.source_note"] = "이 챕터는 오늘날에도 가족들이 이어 가는 살아 있는 전통을 바탕으로 해. 집집마다 서로 다를 수 있어.",
	["artifact.eg_lantern_frame.name"] = "등불 틀",
	["quest.EG02.title"] = "파누스 공방",
	["quest.EG02.summary"] = "무늬가 있는 복셀 부품으로 안전한 장식용 등불을 만들어 봐",
	["quest.EG02.greeting"] = "파누스 공방에 온 걸 환영해! 함께 힘을 모아 보자: 무늬가 있는 복셀 조각으로 안전하고 예쁜 장식 등불을 만들어 봐.",
	["quest.EG02.completion"] = "챕터 EG02 완료! 유리 별을 얻었어.",
	["quest.EG02.source_note"] = "이 챕터는 오늘날에도 가족들이 이어가는 생활 전통을 바탕으로 해. 집집마다 서로 다를 수 있어.",
	["artifact.eg_glass_star.name"] = "유리 별",
	["quest.EG03.title"] = "해 질 녘의 시장",
	["quest.EG03.summary"] = "무게를 확인하며 렌틸콩, 쌀, 채소를 거래해 봐",
	["quest.EG03.greeting"] = "해 질 녘의 시장에 온 걸 환영해! 함께 힘을 모아 보자: 무게를 확인하며 렌틸콩, 쌀, 채소를 거래해 봐.",
	["quest.EG03.completion"] = "챕터 EG03 완료! 시장 저울을 얻었어.",
	["quest.EG03.source_note"] = "이 챕터는 오늘날에도 가족들이 이어가는 생활 전통을 바탕으로 해. 집집마다 서로 다를 수 있어.",
	["artifact.eg_market_scale.name"] = "시장 저울",
	["quest.EG04.title"] = "모두를 위한 코샤리",
	["quest.EG04.summary"] = "요리 순서를 맞추고 이웃과 함께하는 식탁 차리기를 도와줘",
	["quest.EG04.greeting"] = "모두를 위한 코샤리에 온 걸 환영해! 함께 힘을 모아 보자: 요리 순서를 맞추고 이웃과 함께하는 식탁 차리기를 도와줘.",
	["quest.EG04.completion"] = "챕터 EG04 완료! 코샤리 그릇을 얻었어.",
	["quest.EG04.source_note"] = "이 챕터는 오늘날에도 가족들이 이어가는 생활 전통을 바탕으로 해. 집집마다 서로 다를 수 있어.",
	["artifact.eg_koshari_bowl.name"] = "코샤리 그릇",
	["quest.EG05.title"] = "등불 이야기",
	["quest.EG05.summary"] = "가족들의 이야기를 비교하고, 민간 전승을 구분하며, 모두가 다니는 길을 꾸며 봐",
	["quest.EG05.greeting"] = "등불 이야기에 온 걸 환영해! 함께 힘을 모아 보자: 가족들의 이야기를 비교하고, 민간 전승을 구분하며, 모두가 다니는 길을 꾸며 봐.",
	["quest.EG05.completion"] = "챕터 EG05 완료! 이야기 불꽃을 얻었어.",
	["quest.EG05.source_note"] = "이 내용은 민간 전승에서 전해진 것으로, 실제 일어난 사건의 기록이 아니라 여러 갈래로 전해 내려오는 설화야.",
	["artifact.eg_story_flame.name"] = "이야기 불꽃",
	["quest.EG06.title"] = "빛의 도시",
	["quest.EG06.summary"] = "누구나 다니기 편한 등불 길을 디자인하고, 이웃들이 함께 나누는 전통을 축하해 봐",
	["quest.EG06.greeting"] = "빛의 도시에 온 걸 환영해! 함께 힘을 모아 보자: 누구나 다니기 편한 등불 길을 디자인하고, 이웃들이 함께 나누는 전통을 축하해 봐.",
	["quest.EG06.completion"] = "챕터 EG06 완료! 카이로 빛 스탬프를 얻었어.",
	["quest.EG06.source_note"] = "이 챕터는 오늘날에도 가족들이 이어가는 생활 전통을 바탕으로 해. 집집마다 서로 다를 수 있어.",
	["artifact.eg_cairo_light_stamp.name"] = "카이로 빛 스탬프",
	["country.FR.name"] = "프랑스 (비외 리옹)",
	["country.FR.story"] = "숨겨진 통로와 주방",
	["country.FR.cultural_warning"] = "Traboules have varied uses over time; do not imply every passage has a documented Resistance history. Present Mères Lyonnaises as diverse chefs rather than one singular myth.",
	["artifact.fr_meres_lyonnaises_recipe_book.name"] = "메르 리오네즈 요리책",
	["vocab.FR.traboule"] = "traboule (trah-bool) — 리옹에서 안뜰과 거리를 연결해 주는 지붕 덮인 통로",
	["vocab.FR.boulangerie"] = "boulangerie (boo-lahn-zhuh-ree) — 동네의 빵과 페이스트리를 파는 빵집",
	["vocab.FR.canut"] = "canut (kah-noo) — 리옹의 역사적인 비단 직조공",
	["npc.fr_camille_mamie.name"] = "카미유와 클레르 할머니 (Camille et Mamie Claire)",
	["npc.fr_silk_artisan_henri.name"] = "비단 장인 앙리 (Henri l’Artisan Canut)",
	["npc.fr_chef_marguerite.name"] = "요리사 마르게리트 (Cheffe Marguerite)",
	["npc.fr_guide_luc.name"] = "현지 가이드 뤼크 (Luc le Guide)",
	["npc.fr_merchant_elise.name"] = "시장 상인 엘리즈 (Élise du Marché)",
	["quest.FR01.title"] = "통로 지도",
	["quest.FR01.summary"] = "숨겨져 있지만 안전한 통로를 찾고 공방 사이의 길을 그려 봐",
	["quest.FR01.greeting"] = "통로 지도에 온 걸 환영해! 우리 함께 힘을 모아 보자: 숨겨져 있지만 안전한 통로를 찾고 공방 사이의 길을 그려 봐.",
	["quest.FR01.completion"] = "FR01 챕터 완료! 트라불 열쇠를 얻었어.",
	["quest.FR01.source_note"] = "이 챕터는 실제 역사를 바탕으로 하지만, 게임을 위해 상상으로 꾸며낸 부분도 있어.",
	["artifact.fr_traboule_key.name"] = "트라불 열쇠",
	["quest.FR02.title"] = "도시의 실",
	["quest.FR02.summary"] = "섬유를 모아서 반복되는 비단 무늬를 짜 봐",
	["quest.FR02.greeting"] = "도시의 실에 온 걸 환영해! 우리 함께 힘을 모아 보자: 섬유를 모아서 반복되는 비단 무늬를 짜 봐.",
	["quest.FR02.completion"] = "FR02 챕터 완료! 비단 리본을 얻었어.",
	["quest.FR02.source_note"] = "이 챕터는 실제 역사를 바탕으로 하지만, 게임을 위해 상상으로 꾸며낸 부분도 있어.",
	["artifact.fr_silk_ribbon.name"] = "비단 리본",
	["quest.FR03.title"] = "메르들의 식탁에서",
	["quest.FR03.summary"] = "재료를 모아 리옹의 전통이 담긴 가족 요리법을 배워 봐",
	["quest.FR03.greeting"] = "메르들의 식탁에서에 온 걸 환영해! 우리 함께 힘을 모아 보자: 재료를 모아 리옹의 전통이 담긴 가족 요리법을 배워 봐.",
	["quest.FR03.completion"] = "FR03 챕터 완료! 요리사의 수첩을 얻었어.",
	["quest.FR03.source_note"] = "이 챕터는 실제 역사를 바탕으로 하지만, 게임을 위해 상상으로 꾸며낸 부분도 있어.",
	["artifact.fr_chefs_notebook.name"] = "요리사의 수첩",
	["quest.FR04.title"] = "맛의 시장",
	["quest.FR04.summary"] = "재료를 바꾸고, 표지판을 읽으며 제철 음식의 원산지를 비교해 봐",
	["quest.FR04.greeting"] = "맛의 시장에 온 걸 환영해! 우리 함께 힘을 모아 보자: 재료를 바꾸고, 표지판을 읽으며 제철 음식의 원산지를 비교해 봐.",
	["quest.FR04.completion"] = "FR04 챕터 완료! 시장 바구니를 얻었어.",
	["quest.FR04.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어오고 있는 살아있는 전통을 바탕으로 해. 집집마다 조금씩 다를 수 있어.",
	["artifact.fr_market_basket.name"] = "시장 바구니",
	["quest.FR05.title"] = "돌을 하나하나",
	["quest.FR05.summary"] = "진짜 블록과 재료를 사용해 문 닫힌 빵집 앞면 수리하기",
	["quest.FR05.greeting"] = "‘돌을 차곡차곡’에 온 걸 환영해! 함께 힘을 모아 보자: 진짜 블록과 재료를 사용해 문 닫힌 빵집 앞면 수리하기.",
	["quest.FR05.completion"] = "FR05 장 완료! ‘석공의 문장’을 얻었어.",
	["quest.FR05.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 만들었어. 집마다 전통의 모습은 조금씩 다를 수 있단다.",
	["artifact.fr_masons_crest.name"] = "석공의 문장",
	["quest.FR06.title"] = "우리 집 요리법",
	["quest.FR06.summary"] = "함께 모이는 자리를 열고 마을 요리법 모음집 완성하기",
	["quest.FR06.greeting"] = "‘우리 집 요리법’에 온 걸 환영해! 함께 힘을 모아 보자: 함께 모이는 자리를 열고 마을 요리법 모음집 완성하기.",
	["quest.FR06.completion"] = "FR06 장 완료! ‘리옹 문화유산 우표’를 얻었어.",
	["quest.FR06.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 만들었어. 집마다 전통의 모습은 조금씩 다를 수 있단다.",
	["artifact.fr_lyon_heritage_stamp.name"] = "리옹 문화유산 우표",
	["country.KR.name"] = "대한민국 (전주)",
	["country.KR.story"] = "전주의 다섯 가지 색",
	["country.KR.cultural_warning"] = "The historical origin of bibimbap is debated; five-color symbolism is an interpretation and should be marked as such. Do not substitute generic Japanese or Chinese assets.",
	["artifact.kr_five_color_bibimbap_bowl.name"] = "오색 비빔밥 그릇",
	["vocab.KR.hanok"] = "한옥 (hanok) — 곡선형 기와지붕을 얹은 한국 전통 목조 가옥",
	["vocab.KR.obangsaek"] = "오방색 (obangsaek) — 조화와 어울림을 나타내는 한국 전통의 다섯 가지 색채",
	["vocab.KR.bibimbap"] = "비빔밥 (bibimbap) — 따뜻한 밥에 갖은 나물과 맛깔난 양념을 비벼 먹는 음식",
	["npc.kr_jiwoo_halmeoni.name"] = "지우와 할머니",
	["npc.kr_gardener_minho.name"] = "농부 민호",
	["npc.kr_carpenter_seojun.name"] = "대목장 서준",
	["npc.kr_cook_soyeon.name"] = "요리사 소연",
	["npc.kr_guide_haneul.name"] = "학예사 하늘",
	["quest.KR01.title"] = "한옥 대문",
	["quest.KR01.summary"] = "들어가는 길을 찾고 마당 길 고치기",
	["quest.KR01.greeting"] = "‘한옥 대문’에 온 걸 환영해! 함께 힘을 모아 보자: 들어가는 길을 찾고 마당 길 고치기.",
	["quest.KR01.completion"] = "KR01 장 완료! ‘한옥 문 부적’을 얻었어.",
	["quest.KR01.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 만들었어. 집마다 전통의 모습은 조금씩 다를 수 있단다.",
	["artifact.kr_hanok_door_charm.name"] = "한옥 문 부적",
	["quest.KR02.title"] = "다섯 가지 색, 수많은 의미",
	["quest.KR02.summary"] = "오방색에 맞춰 재료를 모으고 분류하기",
	["quest.KR02.greeting"] = "‘다섯 가지 색, 수많은 의미’에 온 걸 환영해! 함께 힘을 모아 보자: 오방색에 맞춰 재료를 모으고 분류하기.",
	["quest.KR02.completion"] = "KR02 장 완료! ‘오색 팔레트’를 얻었어.",
	["quest.KR02.source_note"] = "이 장은 실제 역사를 바탕으로 만들어졌지만, 게임을 위해 상상으로 꾸며낸 부분도 있단다.",
	["artifact.kr_five_color_palette.name"] = "오색 팔레트",
	["quest.KR03.title"] = "시장의 아침",
	["quest.KR03.summary"] = "채소를 사고팔며 시장에서 예의 바르게 대화하는 법을 배워 봐",
	["quest.KR03.greeting"] = "시장의 아침에 온 걸 환영해! 함께 힘을 모아 보자: 채소를 사고팔며 시장에서 예의 바르게 대화하는 법을 배워 봐.",
	["quest.KR03.completion"] = "KR03 장 완료! 시장 토큰을 얻었어.",
	["quest.KR03.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 모습이 조금씩 다를 수 있어.",
	["artifact.kr_market_token.name"] = "시장 토큰",
	["quest.KR04.title"] = "전주의 나눔 그릇",
	["quest.KR04.summary"] = "재료를 차곡차곡 얹고 요리해 보며 비빔밥을 완성해 봐",
	["quest.KR04.greeting"] = "전주의 나눔 그릇에 온 걸 환영해! 함께 힘을 모아 보자: 재료를 차곡차곡 얹고 요리해 보며 비빔밥을 완성해 봐.",
	["quest.KR04.completion"] = "KR04 장 완료! 비빔밥 그릇을 얻었어.",
	["quest.KR04.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 모습이 조금씩 다를 수 있어.",
	["artifact.kr_bibimbap_bowl.name"] = "비빔밥 그릇",
	["quest.KR05.title"] = "마당의 공예",
	["quest.KR05.summary"] = "알맞은 나무 부재를 골라 한옥의 한 부분을 멋지게 복원해 봐",
	["quest.KR05.greeting"] = "마당의 공예에 온 걸 환영해! 함께 힘을 모아 보자: 알맞은 나무 부재를 골라 한옥의 한 부분을 멋지게 복원해 봐.",
	["quest.KR05.completion"] = "KR05 장 완료! 짜맞춤 문양을 얻었어.",
	["quest.KR05.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 모습이 조금씩 다를 수 있어.",
	["artifact.kr_joinery_pattern.name"] = "짜맞춤 문양",
	["quest.KR06.title"] = "어울림 잔치",
	["quest.KR06.summary"] = "모두 함께 나누는 밥상을 차리고 소속감이 담긴 이야기를 써 봐",
	["quest.KR06.greeting"] = "어울림 잔치에 온 걸 환영해! 함께 힘을 모아 보자: 모두 함께 나누는 밥상을 차리고 소속감이 담긴 이야기를 써 봐.",
	["quest.KR06.completion"] = "KR06 장 완료! 전주 어울림 도장을 얻었어.",
	["quest.KR06.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 모습이 조금씩 다를 수 있어.",
	["artifact.kr_jeonju_harmony_stamp.name"] = "전주 어울림 도장",
	["country.DE.name"] = "독일 (라인강 / 상징적인 성배의 풍경)",
	["country.DE.story"] = "노래와 치유의 질문",
	["country.DE.cultural_warning"] = "Lorelei and Parzival are literary/mythic tales and should not be presented as literal history. Remove drowning, trauma and religious coercion from child-facing gameplay; provide respectful historical framing.",
	["artifact.de_compass_of_compassion.name"] = "공감의 나침반",
	["vocab.DE.mitgefuehl"] = "Mitgefühl (mit-guh-fuel) — 다른 사람을 깊이 공감하고 따뜻하게 배려하는 마음",
	["vocab.DE.strom"] = "Strom (shtrohm) — 배가 다닐 수 있는 넓고 큰 강물의 흐름",
	["vocab.DE.frage"] = "Frage (frah-guh) — 서로를 이해할 수 있도록 마음을 열어 주는 다정한 질문",
	["npc.de_navigator_klara.name"] = "강 도선사 클라라 (Flusslotsin Klara)",
	["npc.de_historian_lukas.name"] = "역사가 루카스 (Historiker Lukas)",
	["npc.de_narrator_lorelei.name"] = "이야기꾼 마를레네 (Erzählerin Marlene)",
	["npc.de_parzival.name"] = "여행자 파르치발 (Wanderer Parzival)",
	["npc.de_gardener_jonas.name"] = "정원사 요나스 (Gärtner Jonas)",
	["quest.DE01.title"] = "강이 굽이치는 곳",
	["quest.DE01.summary"] = "신호 표지와 물살의 흐름, 지도 기호를 활용해 안전한 라인강 항로를 그려봐",
	["quest.DE01.greeting"] = "강이 굽이치는 곳에 온 걸 환영해! 함께 힘을 모아 보자: 신호 표지와 물살의 흐름, 지도 기호를 활용해 안전한 라인강 항로를 그려봐.",
	["quest.DE01.completion"] = "DE01 챕터 완료! 라인강 항로 지도를 얻었어.",
	["quest.DE01.source_note"] = "이 장은 실제 역사를 바탕으로 하지만, 게임을 위해 상상으로 덧붙인 부분도 있어.",
	["artifact.de_rhine_route_map.name"] = "라인강 항로 지도",
	["quest.DE02.title"] = "마법에 걸린 노래",
	["quest.DE02.summary"] = "소리와 빛 퍼즐에서 주의를 흩뜨리는 함정을 찾아내고, 다양한 버전의 로렐라이 전설을 들어봐",
	["quest.DE02.greeting"] = "마법에 걸린 노래에 온 걸 환영해! 함께 힘을 모아 보자: 소리와 빛 퍼즐에서 주의를 흩뜨리는 함정을 찾아내고, 다양한 버전의 로렐라이 전설을 들어봐.",
	["quest.DE02.completion"] = "DE02 챕터 완료! 로렐라이 노래의 돌을 얻었어.",
	["quest.DE02.source_note"] = "이 이야기는 문학 작품에서 가져온 것으로, 실제 일어난 일이 아니라 상상으로 쓴 이야기야.",
	["artifact.de_lorelei_songstone.name"] = "로렐라이 노래의 돌",
	["quest.DE03.title"] = "항해사의 선택",
	["quest.DE03.summary"] = "혼란스러운 메아리 대신 진짜 신호에 집중해서 배가 안전한 쉼터에 닿도록 도와줘",
	["quest.DE03.greeting"] = "항해사의 선택에 온 걸 환영해! 함께 힘을 모아 보자: 혼란스러운 메아리 대신 진짜 신호에 집중해서 배가 안전한 쉼터에 닿도록 도와줘.",
	["quest.DE03.completion"] = "DE03 챕터 완료! 흔들리지 않는 키를 얻었어.",
	["quest.DE03.source_note"] = "이 활동은 이야기를 들려주기 위해 게임용으로 만들어진 거야.",
	["artifact.de_steady_helm.name"] = "흔들리지 않는 키",
	["quest.DE04.title"] = "고요한 성배의 전당",
	["quest.DE04.summary"] = "신화 속 성을 탐험하며 도움이 필요한 인물이 있는지 살펴봐",
	["quest.DE04.greeting"] = "고요한 성배의 전당에 온 걸 환영해! 함께 힘을 모아 보자: 신화 속 성을 탐험하며 도움이 필요한 인물이 있는지 살펴봐.",
	["quest.DE04.completion"] = "DE04 챕터 완료! 질문의 전당 토큰을 얻었어.",
	["quest.DE04.source_note"] = "이 이야기는 문학 작품에서 가져온 것으로, 실제 일어난 일이 아니라 상상으로 쓴 이야기야.",
	["artifact.de_hall_of_questions_token.name"] = "질문의 전당 토큰",
	["quest.DE05.title"] = "어디가 아프니?",
	["quest.DE05.summary"] = "침묵하는 대신 따뜻한 마음으로 질문을 건네고 도움이 되는 행동을 해봐",
	["quest.DE05.greeting"] = "'어디가 아프니?'에 온 걸 환영해! 함께 힘을 모아 보자: 침묵하는 대신 따뜻한 마음으로 질문을 건네고 도움이 되는 행동을 해봐.",
	["quest.DE05.completion"] = "DE05 챕터 완료! 치유의 질문 두루마리를 얻었어.",
	["quest.DE05.source_note"] = "이 이야기는 문학 작품에서 가져온 것으로, 실제 일어난 일이 아니라 상상으로 쓴 이야기야.",
	["artifact.de_healing_question_scroll.name"] = "치유의 질문 두루마리",
	["quest.DE06.title"] = "돌아온 정원",
	["quest.DE06.summary"] = "함께 힘을 모아 버려진 정원을 되살리고 달라진 점을 기록하기",
	["quest.DE06.greeting"] = "'돌아온 정원'에 온 걸 환영해! 우리 함께 힘을 모아 버려진 정원을 되살리고, 어떤 점이 달라졌는지 기록해 보자.",
	["quest.DE06.completion"] = "DE06 챕터 완료! '독일 추억 우표'를 얻었어.",
	["quest.DE06.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어오고 있는 살아 있는 전통을 바탕으로 해. 집집마다 조금씩 다를 수 있단다.",
	["artifact.de_german_memory_stamp.name"] = "독일 추억 우표",
	["country.CN.name"] = "중국 (무릉에서 영감을 받은 도화원 배경)",
	["country.CN.story"] = "복사꽃 너머의 골짜기",
	["country.CN.cultural_warning"] = "Peach Blossom Spring is literary fiction. Chang’e’s moon story has multiple versions and should be introduced as folklore, not fact.",
	["artifact.cn_peach_blossom_keepsake.name"] = "복사꽃 기념품",
	["vocab.CN.taohua"] = "桃花 (táohuā) — 복사꽃",
	["vocab.CN.tuanyuan"] = "团圆 (tuányuán) — 따뜻한 재회와 다 함께 모임",
	["vocab.CN.bianhua"] = "变化 (biànhuà) — 시간이 흐르며 자연스럽게 변하고 새로워짐",
	["npc.cn_elder_lin.name"] = "마을 장로 린 (林长老)",
	["npc.cn_fisher_zhou.name"] = "어부 저우 (渔夫周叔)",
	["npc.cn_orchard_keeper_mei.name"] = "과수원 지기 메이 (果园守护者梅姨)",
	["npc.cn_mapmaker_chen.name"] = "지도 제작자 천 (制图师小陈)",
	["npc.cn_moon_host_yue.name"] = "중추절 진행자 웨 (中秋主理人悦姐)",
	["quest.CN01.title"] = "강물이 굽이치는 곳",
	["quest.CN01.summary"] = "어부를 따라 물길을 거슬러 올라가 복사꽃 숲 발견하기",
	["quest.CN01.greeting"] = "'강물이 굽이치는 곳'에 온 걸 환영해! 우리 함께 어부를 따라 물길을 거슬러 올라가 복사꽃 숲을 발견해 보자.",
	["quest.CN01.completion"] = "CN01 챕터 완료! '꽃잎'을 얻었어.",
	["quest.CN01.source_note"] = "이 이야기는 문학 작품에서 가져온 거야. 실제 있었던 일이 아니라 상상으로 지어낸 이야기란다.",
	["artifact.cn_blossom_petal.name"] = "꽃잎",
	["quest.CN02.title"] = "숨겨진 골짜기",
	["quest.CN02.summary"] = "마을 사람들을 만나고 정원 도구를 모아 다리 수리를 돕기",
	["quest.CN02.greeting"] = "'숨겨진 골짜기'에 온 걸 환영해! 우리 함께 마을 사람들을 만나고 정원 도구를 모아 다리 수리를 도와보자.",
	["quest.CN02.completion"] = "CN02 챕터 완료! '골짜기 지도'를 얻었어.",
	["quest.CN02.source_note"] = "이 이야기는 문학 작품에서 가져온 거야. 실제 있었던 일이 아니라 상상으로 지어낸 이야기란다.",
	["artifact.cn_valley_map.name"] = "골짜기 지도",
	["quest.CN03.title"] = "변화의 달력",
	["quest.CN03.summary"] = "계절별 농작물과 시간이 흘러가는 흔적 비교해 보기",
	["quest.CN03.greeting"] = "변화의 달력에 온 걸 환영해! 함께 계절별 농작물과 시간이 흘러가는 흔적을 비교해 보자.",
	["quest.CN03.completion"] = "CN03 챕터 완료! 계절의 바퀴를 얻었어.",
	["quest.CN03.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.cn_season_wheel.name"] = "계절의 바퀴",
	["quest.CN04.title"] = "움직이는 길",
	["quest.CN04.summary"] = "변화하는 길을 따라가 보며 기억 속 지도가 왜 더 이상 맞지 않는지 알아보기",
	["quest.CN04.greeting"] = "움직이는 길에 온 걸 환영해! 함께 변화하는 길을 따라가 보며, 기억 속 지도가 왜 더 이상 맞지 않는지 알아보자.",
	["quest.CN04.completion"] = "CN04 챕터 완료! 변하는 나침반을 얻었어.",
	["quest.CN04.source_note"] = "이 이야기는 문학 작품에서 따온 거야. 실제 일어난 일이 아니라 상상으로 지어낸 작품이란다.",
	["artifact.cn_changing_compass.name"] = "변하는 나침반",
	["quest.CN05.title"] = "달빛 편지",
	["quest.CN05.summary"] = "어린이 눈높이에 맞춘 항아 이야기를 배우고 의미가 담긴 월병 만들어 보기",
	["quest.CN05.greeting"] = "달빛 편지에 온 걸 환영해! 함께 어린이 눈높이에 맞춘 항아 이야기를 알아보고 의미가 담긴 월병을 준비해 보자.",
	["quest.CN05.completion"] = "CN05 챕터 완료! 달 편지를 얻었어.",
	["quest.CN05.source_note"] = "이 이야기는 민속 설화에서 따온 거야. 실제 일어난 일이 아니라 여러 가지 이야기로 전해 내려오는 것이란다.",
	["artifact.cn_moon_letter.name"] = "달 편지",
	["quest.CN06.title"] = "새로운 정원 가꾸기",
	["quest.CN06.summary"] = "사라진 과거를 흉내 내기보다는 새로운 마을 정원 가꿔 보기",
	["quest.CN06.greeting"] = "새로운 정원 가꾸기에 온 걸 환영해! 함께 사라진 과거를 흉내 내기보다는 새로운 마을 정원을 가꿔 보자.",
	["quest.CN06.completion"] = "CN06 챕터 완료! 도화원 도장을 얻었어.",
	["quest.CN06.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 집집마다 조금씩 다를 수 있단다.",
	["artifact.cn_peach_spring_stamp.name"] = "도화원 도장",
	["country.JP.name"] = "일본 (바쇼의 여정, 도호쿠에서 영감을 얻은 길)",
	["country.JP.story"] = "집으로 가는 좁은 길",
	["country.JP.cultural_warning"] = "Bashō’s journey is historical literature; distinguish reconstructed poetic scenes from verified route facts. Haiku examples must be newly authored or rights-cleared translations.",
	["artifact.jp_travelers_ink_brush.name"] = "여행자의 붓",
	["vocab.JP.tabi"] = "旅 (tabi) — 계절을 느끼며 마음을 담아 떠나는 여행",
	["vocab.JP.haiku"] = "俳句 (haiku) — 자연을 관찰하여 지은 짧은 세 줄짜리 계절 시",
	["vocab.JP.kakehashi"] = "架け橋 (kakehashi) — 장소와 사람을 이어 주는 다리",
	["npc.jp_guide_haruka.name"] = "여행 안내자 하루카 (旅の案内人 はるか)",
	["npc.jp_innkeeper_kenji.name"] = "여관 주인 겐지 (宿の主人 けんじ)",
	["npc.jp_bridge_builder_takumi.name"] = "다리 목수 타쿠미 (橋大工 たくみ)",
	["npc.jp_poet_aoi.name"] = "시인 아오이 (俳人 あおい)",
	["npc.jp_gardener_ren.name"] = "정원사 렌 (庭師 れん)",
	["quest.JP01.title"] = "첫걸음",
	["quest.JP01.summary"] = "여행 준비물을 챙기고, 길잡이 표식을 고르고, 여행자를 만나보자",
	["quest.JP01.greeting"] = "첫걸음에 온 걸 환영해! 함께 힘을 모아보자: 여행 준비물을 챙기고, 길잡이 표식을 고르고, 여행자를 만나보자.",
	["quest.JP01.completion"] = "JP01 챕터 완료! 여행자의 짚신을 얻었어.",
	["quest.JP01.source_note"] = "이 이야기는 문학 작품에서 온 거야. 실제 일어난 사건의 기록이 아니라 상상으로 지어낸 이야기란다.",
	["artifact.jp_travelers_sandal.name"] = "여행자의 짚신",
	["quest.JP02.title"] = "강 건너기",
	["quest.JP02.summary"] = "안전한 다리를 다시 놓는 걸 돕고 물자를 날라보자",
	["quest.JP02.greeting"] = "강 건너기에 온 걸 환영해! 함께 힘을 모아보자: 안전한 다리를 다시 놓는 걸 돕고 물자를 날라보자.",
	["quest.JP02.completion"] = "JP02 챕터 완료! 강 다리 증표를 얻었어.",
	["quest.JP02.source_note"] = "이 챕터는 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 이 전통은 집집마다 조금씩 다를 수 있단다.",
	["artifact.jp_river_bridge_token.name"] = "강 다리 증표",
	["quest.JP03.title"] = "세 줄의 하늘",
	["quest.JP03.summary"] = "날씨를 관찰하고 제시어를 보고 짧은 계절 시를 지어보자",
	["quest.JP03.greeting"] = "세 줄의 하늘에 온 걸 환영해! 함께 힘을 모아보자: 날씨를 관찰하고 제시어를 보고 짧은 계절 시를 지어보자.",
	["quest.JP03.completion"] = "JP03 챕터 완료! 하이쿠 나뭇잎을 얻었어.",
	["quest.JP03.source_note"] = "이 이야기는 문학 작품에서 온 거야. 실제 일어난 사건의 기록이 아니라 상상으로 지어낸 이야기란다.",
	["artifact.jp_haiku_leaf.name"] = "하이쿠 나뭇잎",
	["quest.JP04.title"] = "여행자의 쉼터",
	["quest.JP04.summary"] = "물건을 교환해 필요한 것을 구하고 작은 여관 지붕을 고쳐보자",
	["quest.JP04.greeting"] = "여행자의 쉼터에 온 걸 환영해! 함께 힘을 모아보자: 물건을 교환해 필요한 것을 구하고 작은 여관 지붕을 고쳐보자.",
	["quest.JP04.completion"] = "JP04 챕터 완료! 역참 등불을 얻었어.",
	["quest.JP04.source_note"] = "이 챕터는 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 하고 있어. 이 전통은 집집마다 조금씩 다를 수 있단다.",
	["artifact.jp_waystation_lantern.name"] = "역참 등불",
	["quest.JP05.title"] = "변해가는 길",
	["quest.JP05.summary"] = "서로 다른 시간대의 풍경을 둘러보고 달라진 점을 기록해보자",
	["quest.JP05.greeting"] = "변해가는 길에 온 걸 환영해! 함께 힘을 모아보자: 서로 다른 시간대의 풍경을 둘러보고 달라진 점을 기록해보자.",
	["quest.JP05.completion"] = "JP05 챕터 완료! 계절 두루마리를 얻었어.",
	["quest.JP05.source_note"] = "이 이야기는 문학 작품에서 온 것이야. 실제 일어난 일이 아니라 상상으로 지어낸 이야기란다.",
	["artifact.jp_seasonal_scroll.name"] = "계절 두루마리",
	["quest.JP06.title"] = "길 위의 집",
	["quest.JP06.summary"] = "모두가 함께 쉬는 쉼터 정원을 만들고, 변화 속에서 우리가 머무는 곳을 돌아보자",
	["quest.JP06.greeting"] = "'길 위의 집'에 온 걸 환영해! 함께 힘을 모아 보자: 모두가 함께 쉬는 쉼터 정원을 만들고, 변화 속에서 우리가 머무는 곳을 돌아보는 거야.",
	["quest.JP06.completion"] = "JP06 챕터 완료! '좁은 길 스탬프'를 얻었어.",
	["quest.JP06.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어오고 있는 생활 속 전통을 바탕으로 해. 집집마다 조금씩 다를 수 있단다.",
	["artifact.jp_narrow_road_stamp.name"] = "좁은 길 스탬프",
	["country.RU.name"] = "러시아 (스베틀로야르 호수 / 키테시 이야기에서 영감을 받은 신비로운 풍경)",
	["country.RU.story"] = "호수 아래의 종소리",
	["country.RU.cultural_warning"] = "Kitezh is folklore with historical variants, not a factual submerged city. Avoid romanticizing political violence or presenting spiritual-national exclusivity as moral truth; support plural interpretations.",
	["artifact.ru_kitezh_bell.name"] = "키테시의 종",
	["vocab.RU.ozero"] = "озеро (ózero) — 맑은 숲속 호수",
	["vocab.RU.gusli"] = "гусли (gúsli) — 줄을 뜯어 연주하는 전통 민속 현악기",
	["vocab.RU.predaniye"] = "предание (predániye) — 대대로 전해 내려오는 구전 전설",
	["npc.ru_keeper_yelena.name"] = "호수 지킴이 옐레나 (Хранительница озера Елена)",
	["npc.ru_historian_pavel.name"] = "마을 역사학자 파벨 (Историк Павел)",
	["npc.ru_musician_ilya.name"] = "음악 여행가 일리야 (Музыкант Илья)",
	["npc.ru_archivist_vera.name"] = "기록보관사 베라 (Архивист Вера)",
	["npc.ru_carpenter_maksim.name"] = "목수 막심 (Плотник Максим)",
	["quest.RU01.title"] = "새벽의 종소리",
	["quest.RU01.summary"] = "호숫가 소리 표식을 찾아 마을의 종을 복원하자",
	["quest.RU01.greeting"] = "'새벽의 종소리'에 온 걸 환영해! 함께 힘을 모아 보자: 호숫가 소리 표식을 찾아 마을의 종을 복원하는 거야.",
	["quest.RU01.completion"] = "RU01 챕터 완료! '호수 종 파편'을 얻었어.",
	["quest.RU01.source_note"] = "이 이야기는 민간 전승에서 온 것이야. 실제 일어난 일이 아니라 여러 갈래로 전해 내려오는 이야기란다.",
	["artifact.ru_lake_bell_fragment.name"] = "호수 종 파편",
	["quest.RU02.title"] = "물에 비친 도시",
	["quest.RU02.summary"] = "물에 비치는 모습에 따라 달라지는 신비로운 광경을 탐험해보자",
	["quest.RU02.greeting"] = "'물에 비친 도시'에 온 걸 환영해! 함께 힘을 모아 보자: 물에 비치는 모습에 따라 달라지는 신비로운 광경을 탐험해보는 거야.",
	["quest.RU02.completion"] = "RU02 챕터 완료! '반사 프리즘'을 얻었어.",
	["quest.RU02.source_note"] = "이 이야기는 실제로 일어난 일의 기록이 아니라, 여러 모습으로 전해 내려오는 민속 설화에서 따온 이야기야.",
	["artifact.ru_reflection_prism.name"] = "반사 프리즘",
	["quest.RU03.title"] = "사드코의 현",
	["quest.RU03.summary"] = "민속 음악가 사드코에게서 영감을 받은 리듬 퍼즐을 풀어 봐",
	["quest.RU03.greeting"] = "'사드코의 현'에 온 걸 환영해! 함께 힘을 모아 보자. 민속 음악가 사드코에게서 영감을 받은 리듬 퍼즐을 풀어 봐.",
	["quest.RU03.completion"] = "Chapter RU03 완료! 구슬리 부적을 얻었어.",
	["quest.RU03.source_note"] = "이 이야기는 실제로 일어난 일의 기록이 아니라, 여러 모습으로 전해 내려오는 민속 설화에서 따온 이야기야.",
	["artifact.ru_gusli_charm.name"] = "구슬리 부적",
	["quest.RU04.title"] = "물의 정원",
	["quest.RU04.summary"] = "생태계를 해치지 않으면서 평화로운 호숫가 정원을 만드는 걸 도와줘",
	["quest.RU04.greeting"] = "'물의 정원'에 온 걸 환영해! 함께 힘을 모아 보자. 생태계를 해치지 않으면서 평화로운 호숫가 정원을 만드는 걸 도와줘.",
	["quest.RU04.completion"] = "Chapter RU04 완료! 갈대 화관을 얻었어.",
	["quest.RU04.source_note"] = "이 챕터는 오늘날에도 가족들이 지켜 오고 있는 살아 있는 전통을 바탕으로 하고 있어. 가정마다 전해지는 방식이 조금씩 다를 수 있단다.",
	["artifact.ru_reed_wreath.name"] = "갈대 화관",
	["quest.RU05.title"] = "이야기를 지키는 사람들",
	["quest.RU05.summary"] = "키테지 이야기의 다양한 전승을 지역 보관소에 기록해 봐",
	["quest.RU05.greeting"] = "'이야기를 지키는 사람들'에 온 걸 환영해! 함께 힘을 모아 보자. 키테지 이야기의 다양한 전승을 지역 보관소에 기록해 봐.",
	["quest.RU05.completion"] = "Chapter RU05 완료! 전설 자료집을 얻었어.",
	["quest.RU05.source_note"] = "이 이야기는 실제로 일어난 일의 기록이 아니라, 여러 모습으로 전해 내려오는 민속 설화에서 따온 이야기야.",
	["artifact.ru_legend_folio.name"] = "전설 자료집",
	["quest.RU06.title"] = "물 위에 떠오른 이야기",
	["quest.RU06.summary"] = "이야기 정자를 짓고, 전해 내려오는 전통과 실제로 관찰된 증거를 구별해 봐",
	["quest.RU06.greeting"] = "'물 위에 떠오른 이야기'에 온 걸 환영해! 함께 힘을 모아 보자. 이야기 정자를 짓고, 전해 내려오는 전통과 실제로 관찰된 증거를 구별해 봐.",
	["quest.RU06.completion"] = "Chapter RU06 완료! 키테지 기억 스탬프를 얻었어.",
	["quest.RU06.source_note"] = "이 챕터는 오늘날에도 가족들이 지켜 오고 있는 살아 있는 전통을 바탕으로 하고 있어. 가정마다 전해지는 방식이 조금씩 다를 수 있단다.",
	["artifact.ru_kitezh_memory_stamp.name"] = "키테지 기억 스탬프",
	["country.UA.name"] = "우크라이나 (키이우 건국 언덕 / 마을 음악 광장)",
	["country.UA.story"] = "노래의 수호자",
	["country.UA.cultural_warning"] = "The Kyiv founders are chronicle legends. Kobzar traditions are varied; do not imply all practitioners were blind or use disability as a supernatural device. No graphic violence or combat reenactment.",
	["artifact.ua_bandura_memory_charm.name"] = "반두라 기억 부적",
	["vocab.UA.bandura"] = "бандура (bandúra) — 류트와 하프의 특징을 함께 지닌 우크라이나의 뜯는 현악기",
	["vocab.UA.dumy"] = "думи (dúmy) — 입으로 전해 온 문화적 기억을 담아 노래하는 서사시",
	["vocab.UA.toloka"] = "толока (tolóka) — 함께 무언가를 짓거나 복구하기 위해 모이는 마을 연대 모임",
	["npc.ua_guide_lybid.name"] = "가이드 올레나 (리비디 경로) (Провідниця Олена)",
	["npc.ua_storyteller_taras.name"] = "역사 이야기꾼 타라스 (Оповідач Тарас)",
	["npc.ua_kobzar_mykola.name"] = "음악가 미콜라 (Кобзар Микола)",
	["npc.ua_maker_solomiya.name"] = "악기 제작자 솔로미야 (Майстриня Соломія)",
	["npc.ua_curator_kateryna.name"] = "큐레이터 카테리나 (Кураторка Катерина)",
	["quest.UA01.title"] = "네 명의 건국자",
	["quest.UA01.summary"] = "건국 전설 지도를 완성하면서 세 언덕과 강을 탐험해 봐",
	["quest.UA01.greeting"] = "‘네 명의 건국자’에 온 걸 환영해! 함께 힘을 모아 보자: 건국 전설 지도를 완성하면서 세 언덕과 강을 탐험해 봐.",
	["quest.UA01.completion"] = "UA01 챕터 완료! ‘건국자의 강 지도’를 얻었어.",
	["quest.UA01.source_note"] = "이 이야기는 민속에서 전해진 설화야. 여러 가지 이야기로 전해 내려오는 옛이야기이며, 실제 일어난 사건을 기록한 것이 아니란다.",
	["artifact.ua_founders_river_map.name"] = "건국자의 강 지도",
	["quest.UA02.title"] = "물가의 도시",
	["quest.UA02.summary"] = "누구나 건널 수 있는 다리를 고치기 위해 나무와 돌을 모아 봐",
	["quest.UA02.greeting"] = "‘물가의 도시’에 온 걸 환영해! 함께 힘을 모아 보자: 누구나 건널 수 있는 다리를 고치기 위해 나무와 돌을 모아 봐.",
	["quest.UA02.completion"] = "UA02 챕터 완료! ‘강 다리 명판’을 얻었어.",
	["quest.UA02.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어 가고 있는 살아 있는 전통을 담고 있어. 집집마다 모습이 조금씩 다를 수 있단다.",
	["artifact.ua_river_bridge_plaque.name"] = "강 다리 명판",
	["quest.UA03.title"] = "코브자르에게 귀 기울여 봐",
	["quest.UA03.summary"] = "예의 바르게 음악을 감상하고 서로 주고받으며 노래하는 활동을 배워 봐",
	["quest.UA03.greeting"] = "‘코브자르에게 귀 기울여 봐’에 온 걸 환영해! 함께 힘을 모아 보자: 예의 바르게 음악을 감상하고 서로 주고받으며 노래하는 활동을 배워 봐.",
	["quest.UA03.completion"] = "UA03 챕터 완료! ‘반두라 줄’을 얻었어.",
	["quest.UA03.source_note"] = "이 챕터는 오늘날에도 여러 가족이 이어 가고 있는 살아 있는 전통을 담고 있어. 집집마다 모습이 조금씩 다를 수 있단다.",
	["artifact.ua_bandura_string.name"] = "반두라 줄",
	["quest.UA04.title"] = "두마 공책",
	["quest.UA04.summary"] = "이야기 구절을 모아 순서대로 맞추고, 입으로 전해진 기억과 기록된 역사를 구분해 봐",
	["quest.UA04.greeting"] = "‘두마 공책’에 온 걸 환영해! 함께 힘을 모아 보자: 이야기 구절을 모아 순서대로 맞추고, 입으로 전해진 기억과 기록된 역사를 구분해 봐.",
	["quest.UA04.completion"] = "UA04 챕터 완료! ‘두마 페이지’를 얻었어.",
	["quest.UA04.source_note"] = "이 챕터는 실제 역사를 바탕으로 하고 있지만, 게임을 위해 상상으로 꾸며낸 부분도 담겨 있어.",
	["artifact.ua_dumy_page.name"] = "두마 페이지",
	["quest.UA05.title"] = "살아 있는 음악당",
	["quest.UA05.summary"] = "공연장을 수리하고 이름표를 붙여 악기를 전시해 봐",
	["quest.UA05.greeting"] = "‘살아 있는 음악당’에 온 걸 환영해! 함께 힘을 모아 보자: 공연장을 수리하고 이름표를 붙여 악기를 전시해 봐.",
	["quest.UA05.completion"] = "UA05 챕터 완료! 조각 보면대를 얻었어.",
	["quest.UA05.source_note"] = "이 챕터는 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 해. 집마다 서로 다를 수 있어.",
	["artifact.ua_carved_music_stand.name"] = "조각 보면대",
	["quest.UA06.title"] = "여행하는 노래들",
	["quest.UA06.summary"] = "새로운 멜로디나 리듬을 함께 만들고 우리 마을 기록 보관소를 꾸며보자",
	["quest.UA06.greeting"] = "‘여행하는 노래들’에 온 걸 환영해! 함께 힘을 모아보자: 새로운 멜로디나 리듬을 함께 만들고 우리 마을 기록 보관소를 꾸며보는 거야.",
	["quest.UA06.completion"] = "UA06 챕터 완료! 우크라이나 노래 스탬프를 얻었어.",
	["quest.UA06.source_note"] = "이 챕터는 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 해. 집마다 서로 다를 수 있어.",
	["artifact.ua_ukraine_song_stamp.name"] = "우크라이나 노래 스탬프",
	["country.MA.name"] = "모로코 (마라케시 / 제마 엘프나에서 영감을 얻은 광장)",
	["country.MA.story"] = "살아 숨 쉬는 원",
	["country.MA.cultural_warning"] = "Al Halqa is a living performance tradition, not one fixed text. Cultural/religious stories, including the Seven Saints, must be reviewed and presented respectfully without assigning sacred characters arbitrary game powers.",
	["artifact.ma_storytellers_circle_drum.name"] = "이야기꾼의 둥근 북",
	["vocab.MA.halqa"] = "حلقة (ḥalqa) — 이야기꾼 주변에 둥글게 모여 함께 참여하는 관객들의 원",
	["vocab.MA.atay"] = "أتاي (atāy) — 신선한 박하(스피어민트)를 우려낸 모로코식 녹차",
	["vocab.MA.zellij"] = "زليج (zallīj) — 손으로 직접 깎아 만든 기하학무늬의 유약 타일 공예",
	["npc.ma_hakawati_driss.name"] = "하카와티 장인 드리스 (الحكواتي المعلم إدريس)",
	["npc.ma_tea_host_kenza.name"] = "차 호스트 켄자 (لالة كنزة مضيفة أتاي)",
	["npc.ma_merchant_yassine.name"] = "공예품 상인 야신 (الصانع ياسين)",
	["npc.ma_historian_salma.name"] = "역사가 살마 (المؤرخة سلمى)",
	["npc.ma_performer_amine.name"] = "젊은 공연가 아민 (الفنان الشاب أمين)",
	["quest.MA01.title"] = "서클에 함께하기",
	["quest.MA01.summary"] = "광장을 찾아서 관객들이 어떻게 이야기를 함께 펼쳐나가는지 알아보자",
	["quest.MA01.greeting"] = "‘서클에 함께하기’에 온 걸 환영해! 함께 힘을 모아보자: 광장을 찾아서 관객들이 어떻게 이야기를 함께 펼쳐나가는지 알아보는 거야.",
	["quest.MA01.completion"] = "MA01 챕터 완료! 서클 초대장을 얻었어.",
	["quest.MA01.source_note"] = "이 챕터는 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 해. 집마다 서로 다를 수 있어.",
	["artifact.ma_circle_invitation.name"] = "서클 초대장",
	["quest.MA02.title"] = "여러 목소리가 담긴 이야기",
	["quest.MA02.summary"] = "여러 갈래로 이어지는 구전 이야기를 위해 소리와 몸짓, 질문을 골라보자",
	["quest.MA02.greeting"] = "‘여러 목소리가 담긴 이야기’에 온 걸 환영해! 함께 힘을 모아보자: 여러 갈래로 이어지는 구전 이야기를 위해 소리와 몸짓, 질문을 골라보는 거야.",
	["quest.MA02.completion"] = "Chapter MA02 완료! 하카와티 토큰을 얻었어.",
	["quest.MA02.source_note"] = "이 이야기는 민간 전승에서 전해진 거야. 실제 사건을 기록한 것이 아니라, 여러 갈래로 전해 내려오는 이야기란다.",
	["artifact.ma_hakawati_token.name"] = "하카와티 토큰",
	["quest.MA03.title"] = "차와 공예",
	["quest.MA03.summary"] = "민트를 모으고 불을 쓰지 않는 손님맞이 순서를 마친 뒤 공예 장식품으로 바꿔봐",
	["quest.MA03.greeting"] = "'차와 공예'에 온 걸 환영해! 우리 함께해보자. 민트를 모으고 불을 쓰지 않는 손님맞이 순서를 마친 뒤 공예 장식품으로 바꿔보자.",
	["quest.MA03.completion"] = "Chapter MA03 완료! 민트차 쟁반을 얻었어.",
	["quest.MA03.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 했어. 집집마다 방식이 조금씩 다를 수 있단다.",
	["artifact.ma_mint_tea_tray.name"] = "민트차 쟁반",
	["quest.MA04.title"] = "우리가 바꾸는 이야기",
	["quest.MA04.summary"] = "다양한 결말을 가진 짧은 이야기를 함께 만들고 원작자의 이름을 남겨봐",
	["quest.MA04.greeting"] = "'우리가 바꾸는 이야기'에 온 걸 환영해! 우리 함께해보자. 다양한 결말을 가진 짧은 이야기를 함께 만들고 원작자의 이름을 남겨보자.",
	["quest.MA04.completion"] = "Chapter MA04 완료! 이야기 실타래를 얻었어.",
	["quest.MA04.source_note"] = "이 활동은 이야기를 들려주기 위해 이 게임에서 만들어 낸 창작 활동이야.",
	["artifact.ma_story_thread.name"] = "이야기 실타래",
	["quest.MA05.title"] = "지혜의 길",
	["quest.MA05.summary"] = "마라케시의 일곱 성인 이야기에서 영감을 얻은 유산 지도를 정성껏 탐험해봐",
	["quest.MA05.greeting"] = "'지혜의 길'에 온 걸 환영해! 우리 함께해보자. 마라케시의 일곱 성인 이야기에서 영감을 얻은 유산 지도를 정성껏 탐험해보자.",
	["quest.MA05.completion"] = "Chapter MA05 완료! 유산 지도를 얻었어.",
	["quest.MA05.source_note"] = "이 장은 실제 역사를 바탕으로 하지만, 게임을 위해 상상으로 꾸며낸 부분도 있단다.",
	["artifact.ma_heritage_map.name"] = "유산 지도",
	["quest.MA06.title"] = "여행하는 이야기 서클",
	["quest.MA06.summary"] = "작은 이야기꾼 무대를 만들고 여러 언어로 함께하는 협동 공연을 열어봐",
	["quest.MA06.greeting"] = "'여행하는 이야기 서클'에 온 걸 환영해! 우리 함께해보자. 작은 이야기꾼 무대를 만들고 여러 언어로 함께하는 협동 공연을 열어보자.",
	["quest.MA06.completion"] = "Chapter MA06 완료! 모로코 서클 스탬프를 얻었어.",
	["quest.MA06.source_note"] = "이 장은 오늘날에도 가족들이 이어오고 있는 살아있는 전통을 바탕으로 했어. 집집마다 방식이 조금씩 다를 수 있단다.",
	["artifact.ma_morocco_circle_stamp.name"] = "모로코 서클 스탬프",
