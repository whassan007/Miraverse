	["quest.UA01.title"] = "المؤسسون الأربعة",
	["quest.UA01.summary"] = "استكشف تلات تلال ونهر وإنت عم تركّب خريطة أسطورة التأسيس",
	["quest.UA01.greeting"] = "أهلاً فيك بـ المؤسسون الأربعة! خلينا نشتغل سوا: استكشف تلات تلال ونهر وإنت عم تركّب خريطة أسطورة التأسيس.",
	["quest.UA01.completion"] = "اكتمل الفصل UA01! ربحت خريطة نهر المؤسسين.",
	["quest.UA01.source_note"] = "هيدا الشي جايي من الفلكلور: قصص انحكت بروايات كتيرة، ومش تسجيل لأحداث حقيقية.",
	["artifact.ua_founders_river_map.name"] = "خريطة نهر المؤسسين",
	["quest.UA02.title"] = "المدينة حد المي",
	["quest.UA02.summary"] = "جمّع خشب وحجر تترمّم جسر مشاة بيقدر الكل يمرق عليه بسهولة",
	["quest.UA02.greeting"] = "أهلاً فيك بـ المدينة حد المي! خلينا نشتغل سوا: جمّع خشب وحجر تترمّم جسر مشاة بيقدر الكل يمرق عليه بسهولة.",
	["quest.UA02.completion"] = "اكتمل الفصل UA02! ربحت لوحة جسر النهر.",
	["quest.UA02.source_note"] = "هيدا الفصل مستوحى من تقاليد حيّة لليوم العِيَل عم تمارسها، وممكن تختلف من بيت للتاني.",
	["artifact.ua_river_bridge_plaque.name"] = "لوحة جسر النهر",
	["quest.UA03.title"] = "اسمع للكوبزار",
	["quest.UA03.summary"] = "تعلّم كيف تسمع الموسيقى باحترام وتشارك بنشاط النداء والجواب الموسيقي",
	["quest.UA03.greeting"] = "أهلاً فيك بـ اسمع للكوبزار! خلينا نشتغل سوا: تعلّم كيف تسمع الموسيقى باحترام وتشارك بنشاط النداء والجواب الموسيقي.",
	["quest.UA03.completion"] = "اكتمل الفصل UA03! ربحت وتر باندورا.",
	["quest.UA03.source_note"] = "هيدا الفصل مستوحى من تقاليد حيّة لليوم العِيَل عم تمارسها، وممكن تختلف من بيت للتاني.",
	["artifact.ua_bandura_string.name"] = "وتر باندورا",
	["quest.UA04.title"] = "دفتر الدومي",
	["quest.UA04.summary"] = "جمّع ورتّب مقاطع القصة، وميِّز بين الذاكرة الشفهية والأحداث الموثقة",
	["quest.UA04.greeting"] = "أهلاً فيك بـ دفتر الدومي! خلينا نشتغل سوا: جمّع ورتّب مقاطع القصة، وميِّز بين الذاكرة الشفهية والأحداث الموثقة.",
	["quest.UA04.completion"] = "اكتمل الفصل UA04! ربحت صفحة دومي.",
	["quest.UA04.source_note"] = "هيدا الفصل مبني على تاريخ حقيقي، مع شوية تفاصيل من الخيال انعملت مخصوص للّعبة.",
	["artifact.ua_dumy_page.name"] = "صفحة دومي",
	["quest.UA05.title"] = "قاعة الموسيقى الحيّة",
	["quest.UA05.summary"] = "صلّح مسرح العروض واعرض الآلات الموسيقية مع بطاقات بتعرّف عنها",
	["quest.UA05.greeting"] = "أهلاً فيك بـ قاعة الموسيقى الحيّة! خلينا نشتغل سوا: صلّح مسرح العروض واعرض الآلات الموسيقية مع بطاقات بتعرّف عنها.",
