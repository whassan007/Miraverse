          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">uk-UA</string>
              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "Ліван (Бібл / Джбейль)",
	["country.LB.story"] = "Гавань історій, що повертаються",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "Скриня спогадів із кедра й моря",
	["vocab.LB.saj"] = "صاج (ṣāj) — опукла пательня для випікання коржів",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — духмяна суміш дикого чебрецю, кунжуту та сумаху",
	["vocab.LB.mina"] = "مينا (mīnā) — приморська гавань і кам'яний причал",
	["npc.lb_teta_nahla.name"] = "Тета Нахла (تيتا نهلة)",
	["npc.lb_archivist_rami.name"] = "Юний архівіст Рамі (الأرشيفي رامي)",
	["npc.lb_captain_faris.name"] = "Капітан порту Фаріс (القبطان فارس)",
	["npc.lb_baker_tariq.name"] = "Пекар Тарік (الخبّاز طارق)",
	["npc.lb_artisan_nadia.name"] = "Майстриня писемності Надія (الحرفية نادية)",
	["quest.LB01.title"] = "Гавань прокидається",
	["quest.LB01.summary"] = "Крокуй причалами з ліхтарями, збирай припаси гавані та полагодь безпечну стежку",
	["quest.LB01.greeting"] = "Ласкаво просимо до завдання «Гавань прокидається»! Нумо працювати разом: крокуй причалами з ліхтарями, збирай припаси гавані та полагодь безпечну стежку.",
	["quest.LB01.completion"] = "Розділ LB01 пройдено! Твоя нагорода — Компас гавані.",
	["quest.LB01.source_note"] = "Цей розділ ґрунтується на живих традиціях, які родини бережуть і досі. У різних домівках вони можуть відрізнятися.",
	["artifact.lb_harbor_compass.name"] = "Компас гавані",
	["quest.LB02.title"] = "Літери на камені",
	["quest.LB02.summary"] = "Зістав фінікійські візерунки літер із торговельними ярликами та віднови невелику табличку з написом",
	["quest.LB02.greeting"] = "Ласкаво просимо до завдання «Літери на камені»! Нумо працювати разом: зістав фінікійські візерунки літер із торговельними ярликами та віднови невелику табличку з написом.",
	["quest.LB02.completion"] = "Розділ LB02 пройдено! Твоя нагорода — Плитка з абеткою.",
	["quest.LB02.source_note"] = "Цей розділ ґрунтується на справжній історії, але деякі деталі вигадані спеціально для гри.",
	["artifact.lb_alphabet_tile.name"] = "Плитка з абеткою",
	["quest.LB03.title"] = "Бабусин стіл",
	["quest.LB03.summary"] = "Збери заатар та інгредієнти, поторгуйся на ринку та приготуй мануше під наглядом на безпечному ігровому теплі",
	["quest.LB03.greeting"] = "Ласкаво просимо до «Бабусиного столу»! Нумо працювати разом: збери заатар та інгредієнти, поторгуйся на ринку та приготуй мануше під наглядом на безпечному ігровому теплі.",
	["quest.LB03.completion"] = "Розділ LB03 пройдено! Твоя нагорода — Картка з родинним рецептом.",
	["quest.LB03.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і досі. У різних домівках вони можуть відрізнятися.",
	["artifact.lb_family_recipe_card.name"] = "Картка з родинним рецептом",
	["quest.LB04.title"] = "Кедрова скриня",
	["quest.LB04.summary"] = "Досліди кедрову скриню, навіяну міфами, і порівняй легенду з історичними свідченнями",
	["quest.LB04.greeting"] = "Ласкаво просимо до «Кедрової скрині»! Нумо працювати разом: досліди кедрову скриню, навіяну міфами, і порівняй легенду з історичними свідченнями.",
	["quest.LB04.completion"] = "Розділ LB04 пройдено! Твоя нагорода — Кедровий жетон.",
	["quest.LB04.source_note"] = "Це походить із фольклору: народних історій, які розповідають по-різному, а не з описів справжніх подій.",
	["artifact.lb_cedar_token.name"] = "Кедровий жетон",
	["quest.LB05.title"] = "Світлини з-за моря",
	["quest.LB05.summary"] = "Поговори з вигаданими персонажами родини, впорядкуй світлини за датами та підготуй безпечну виставку за згодою кожного",
	["quest.LB05.greeting"] = "Ласкаво просимо до «Світлин з-за моря»! Нумо працювати разом: поговори з вигаданими персонажами родини, впорядкуй світлини за датами та підготуй безпечну виставку за згодою кожного.",
	["quest.LB05.completion"] = "Розділ LB05 пройдено! Твоя нагорода — Архівний альбом.",
	["quest.LB05.source_note"] = "Це завдання було вигадано спеціально для гри, щоб допомогти розповісти історію.",
	["artifact.lb_archive_album.name"] = "Архівний альбом",
	["quest.LB06.title"] = "Свято повернення",
	["quest.LB06.summary"] = "Віднови майдан для зустрічей, організуй спільне застілля та розкажи нову родинну історію",
	["quest.LB06.greeting"] = "Ласкаво просимо на «Свято повернення»! Нумо працювати разом: віднови майдан для зустрічей, організуй спільне застілля та розкажи нову родинну історію.",
	["quest.LB06.completion"] = "Розділ LB06 пройдено! Твоя нагорода — Штамп «Рідна гавань».",
	["quest.LB06.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і досі. У різних домівках вони можуть відрізнятися.",
	["artifact.lb_harbor_home_stamp.name"] = "Штамп «Рідна гавань»",
	["country.IQ.name"] = "Ірак (Багдад)",
	["country.IQ.story"] = "Бібліотека-мандрівниця",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "Книга Будинку мудрості",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — Різьблений дерев’яний ґратчастий балкон, що виступає над вулицею",
	["vocab.IQ.kleicha"] = "كليجة (klīcha) — Пряне печиво з фініками та кардамоном, яким частують на свята",
	["vocab.IQ.hikma"] = "حكمة (ḥikma) — Мудрість і спільні наукові пошуки",
	["npc.iq_bibi_amal.name"] = "Бібі Амаль (بيبي أمل)",
	["npc.iq_merchant_hassan.name"] = "Книготорговець Хасан (الكتبي حسان)",
	["npc.iq_translator_mariam.name"] = "Перекладачка Мар'ям (المترجمة مريم)",
	["npc.iq_baker_salim.name"] = "Пекар Салім (الخبّاز سليم)",
	["npc.iq_astronomer_zaid.name"] = "Учень астронома Зайд (الفلكي زيد)",
	["quest.IQ01.title"] = "Вулиця книг",
	["quest.IQ01.summary"] = "Відчиняй віконниці, повертай розкидані книжки торговцям і позначай полиці на карті",
	["quest.IQ01.greeting"] = "Ласкаво просимо на Вулицю книг! Нумо працювати разом: відчиняй віконниці, повертай розкидані книжки торговцям і позначай полиці на карті.",
	["quest.IQ01.completion"] = "Розділ IQ01 завершено! Ти отримуєш Печатку книготорговця.",
	["quest.IQ01.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.iq_bookseller_seal.name"] = "Печатка книготорговця",
	["quest.IQ02.title"] = "Дім мудрості",
	["quest.IQ02.summary"] = "Збирай математичні інструменти та допоможи відновити кімнату вчених",
	["quest.IQ02.greeting"] = "Ласкаво просимо до Дому мудрості! Нумо працювати разом: збирай математичні інструменти та допоможи відновити кімнату вчених.",
	["quest.IQ02.completion"] = "Розділ IQ02 завершено! Ти отримуєш Астролябію вченого.",
	["quest.IQ02.source_note"] = "Цей розділ заснований на справжній історії, але деякі деталі вигадані спеціально для гри.",
	["artifact.iq_scholars_astrolabe.name"] = "Астролябія вченого",
	["quest.IQ03.title"] = "Слова, що мандрують",
	["quest.IQ03.summary"] = "Поєднуй поняття, перекладені з арабської, грецької та сирійської мов, із позначками їхнього походження",
	["quest.IQ03.greeting"] = "Ласкаво просимо до гри «Слова, що мандрують»! Нумо працювати разом: поєднуй поняття, перекладені з арабської, грецької та сирійської мов, із позначками їхнього походження.",
	["quest.IQ03.completion"] = "Розділ IQ03 завершено! Ти отримуєш Сувій перекладу.",
	["quest.IQ03.source_note"] = "Цей розділ заснований на справжній історії, але деякі деталі вигадані спеціально для гри.",
	["artifact.iq_translation_scroll.name"] = "Сувій перекладу",
	["quest.IQ04.title"] = "Фініки та клейча",
	["quest.IQ04.summary"] = "Збирай фініки, обмінюй прянощі та виконай усі кроки сімейної випічки",
	["quest.IQ04.greeting"] = "Ласкаво просимо до гри «Фініки та клейча»! Нумо працювати разом: збирай фініки, обмінюй прянощі та виконай усі кроки сімейної випічки.",
	["quest.IQ04.completion"] = "Розділ IQ04 завершено! Ти отримуєш Формочку для клейчі.",
	["quest.IQ04.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.iq_kleicha_mold.name"] = "Формочка для клейчі",
	["quest.IQ05.title"] = "Дворик запитань",
	["quest.IQ05.summary"] = "Відремонтуй шанашіл і облаштуй куточок для читання зі світлом і затінком",
	["quest.IQ05.greeting"] = "Ласкаво просимо до Дворика запитань! Давай попрацюємо разом: полагодь шанашіл та облаштуй куточок для читання зі світлом і затінком.",
	["quest.IQ05.completion"] = "Розділ IQ05 завершено! Твоя нагорода — Дворикова решітка.",
	["quest.IQ05.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У кожній оселі вони можуть бути різними.",
	["artifact.iq_courtyard_lattice.name"] = "Дворикова решітка",
	["quest.IQ06.title"] = "Бібліотека крізь океани",
	["quest.IQ06.summary"] = "Створи двомовну виставку, поділися історією з відвідувачами та збережи каталог",
	["quest.IQ06.greeting"] = "Ласкаво просимо до Бібліотеки крізь океани! Давай попрацюємо разом: створи двомовну виставку, поділися історією з відвідувачами та збережи каталог.",
	["quest.IQ06.completion"] = "Розділ IQ06 завершено! Твоя нагорода — Печатка хранителя знань.",
	["quest.IQ06.source_note"] = "Це завдання було вигадано спеціально для гри, щоб допомогти розповісти історію.",
	["artifact.iq_knowledge_keeper_stamp.name"] = "Печатка хранителя знань",
	["country.EG.name"] = "Єгипет (Каїр)",
	["country.EG.story"] = "Ліхтарі Каїра",
	["country.EG.cultural_warning"] = "The Fatimid lantern origin is a widely circulated tradition, not a single definitively established historical account. Distinguish contemporary Cairo from ancient Egyptian settings.",
	["artifact.eg_fanous_of_shared_light.name"] = "Фанус спільного світла",
	["vocab.EG.fanous"] = "فانوس (fānūs) — Декоративний ліхтар із латуні та кольорового скла",
	["vocab.EG.koshari"] = "كشري (kusharī) — Страва з шарів рису, сочевиці, макаронів, томатного соусу та хрусткої цибулі",
	["vocab.EG.mashrabiya"] = "مشربية (mashrabiyya) — Різьблена дерев'яна решітка з геометричним візерунком",
	["npc.eg_layla_guide.name"] = "Лайла та Тета Саміра (ليلى وتيتا سميرة)",
	["npc.eg_lantern_maker_amm_adel.name"] = "Майстер ліхтарів Амм Адель (عم عادل صانع الفوانيس)",
	["npc.eg_market_auntie_nadia.name"] = "Тітонька Надія з ринку (طنط نادية في السوق)",
	["npc.eg_cook_ibrahim.name"] = "Шеф-кухар Ібрагім (الشيف إبراهيم)",
	["npc.eg_storyteller_youssef.name"] = "Казкар Юсеф (الحكواتي يوسف)",
	["quest.EG01.title"] = "Потемнілий дворик",
	["quest.EG01.summary"] = "Йди за кольоровим світлом ліхтарів і знайди зниклі мідні панелі",
	["quest.EG01.greeting"] = "Ласкаво просимо до Потемнілого дворика! Давай попрацюємо разом: йди за кольоровим світлом ліхтарів і знайди зниклі мідні панелі.",
	["quest.EG01.completion"] = "Розділ EG01 завершено! Твоя нагорода — Каркас ліхтаря.",
	["quest.EG01.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У кожній оселі вони можуть бути різними.",
	["artifact.eg_lantern_frame.name"] = "Каркас ліхтаря",
	["quest.EG02.title"] = "Майстерня фанусів",
	["quest.EG02.summary"] = "Змайструй безпечний декоративний ліхтар із візерунчастих воксельних деталей",
	["quest.EG02.greeting"] = "Ласкаво просимо до Майстерні фанусів! Працюймо разом: змайструй безпечний декоративний ліхтарик із візерунчастих воксельних деталей.",
	["quest.EG02.completion"] = "Розділ EG02 завершено! Ти отримуєш Скляну зірку.",
	["quest.EG02.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.eg_glass_star.name"] = "Скляна зірка",
	["quest.EG03.title"] = "Ринок у сутінках",
	["quest.EG03.summary"] = "Торгуй сочевицею, рисом і овочами, визначаючи вагу",
	["quest.EG03.greeting"] = "Ласкаво просимо на Ринок у сутінках! Працюймо разом: торгуй сочевицею, рисом і овочами, визначаючи вагу.",
	["quest.EG03.completion"] = "Розділ EG03 завершено! Ти отримуєш Ринкові ваги.",
	["quest.EG03.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.eg_market_scale.name"] = "Ринкові ваги",
	["quest.EG04.title"] = "Кошарі для всіх",
	["quest.EG04.summary"] = "Дотримуйся послідовності приготування страв і допомагай накривати спільний стіл",
	["quest.EG04.greeting"] = "Ласкаво просимо до «Кошарі для всіх»! Працюймо разом: дотримуйся послідовності приготування страв і допомагай накривати спільний стіл.",
	["quest.EG04.completion"] = "Розділ EG04 завершено! Ти отримуєш Миску кошарі.",
	["quest.EG04.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.eg_koshari_bowl.name"] = "Миска кошарі",
	["quest.EG05.title"] = "Історії ліхтарика",
	["quest.EG05.summary"] = "Порівнюй родинні оповідки, розпізнавай фольклор і прикрашай пішохідну вулицю",
	["quest.EG05.greeting"] = "Ласкаво просимо до «Історій ліхтарика»! Працюймо разом: порівнюй родинні оповідки, розпізнавай фольклор і прикрашай пішохідну вулицю.",
	["quest.EG05.completion"] = "Розділ EG05 завершено! Ти отримуєш Вогник історій.",
	["quest.EG05.source_note"] = "Це походить із фольклору: історії, що розповідаються в багатьох версіях і не є описом реальних подій.",
	["artifact.eg_story_flame.name"] = "Вогник історій",
	["quest.EG06.title"] = "Місто світла",
	["quest.EG06.summary"] = "Створи зручний маршрут із ліхтариками та святкуй спільні сусідські традиції",
	["quest.EG06.greeting"] = "Ласкаво просимо до Міста світла! Працюймо разом: створи зручний маршрут із ліхтариками та святкуй спільні сусідські традиції.",
	["quest.EG06.completion"] = "Розділ EG06 завершено! Ти отримуєш штамп «Світло Каїра».",
	["quest.EG06.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.eg_cairo_light_stamp.name"] = "Штамп «Світло Каїра»",
	["country.FR.name"] = "Франція (Старий Ліон)",
	["country.FR.story"] = "Таємний прохід і кухня",
	["country.FR.cultural_warning"] = "Traboules have varied uses over time; do not imply every passage has a documented Resistance history. Present Mères Lyonnaises as diverse chefs rather than one singular myth.",
	["artifact.fr_meres_lyonnaises_recipe_book.name"] = "Книга рецептів ліонських матерів",
	["vocab.FR.traboule"] = "traboule (trah-bool) — Критий прохід, що з'єднує подвір'я та вулиці в Ліоні",
	["vocab.FR.boulangerie"] = "boulangerie (boo-lahn-zhuh-ree) — Затишна сусідська пекарня зі свіжим хлібом і випічкою",
	["vocab.FR.canut"] = "canut (kah-noo) — Старовинний ліонський ткач шовку",
	["npc.fr_camille_mamie.name"] = "Каміль і бабуся Клер (Camille et Mamie Claire)",
	["npc.fr_silk_artisan_henri.name"] = "Шовковий майстер Анрі (Henri l’Artisan Canut)",
	["npc.fr_chef_marguerite.name"] = "Шеф-кухарка Марґеріт (Cheffe Marguerite)",
	["npc.fr_guide_luc.name"] = "Місцевий гід Люк (Luc le Guide)",
	["npc.fr_merchant_elise.name"] = "Ринкова продавчиня Еліза (Élise du Marché)",
	["quest.FR01.title"] = "Мапа переходів",
	["quest.FR01.summary"] = "Знайди приховані, але безпечні переходи й намалюй маршрут між майстернями",
	["quest.FR01.greeting"] = "Ласкаво просимо до «Мапи переходів»! Давай працювати разом: знайди приховані, але безпечні переходи й намалюй маршрут між майстернями.",
	["quest.FR01.completion"] = "Розділ FR01 завершено! Твоя нагорода — Ключ від трабулі.",
	["quest.FR01.source_note"] = "Цей розділ засновано на реальній історії, а деякі деталі вигадано для гри.",
	["artifact.fr_traboule_key.name"] = "Ключ від трабулі",
	["quest.FR02.title"] = "Нитки міста",
	["quest.FR02.summary"] = "Збери волокна й витчи шовковий візерунок, що повторюється",
	["quest.FR02.greeting"] = "Ласкаво просимо до «Ниток міста»! Давай працювати разом: збери волокна й витчи шовковий візерунок, що повторюється.",
	["quest.FR02.completion"] = "Розділ FR02 завершено! Твоя нагорода — Шовкова стрічка.",
	["quest.FR02.source_note"] = "Цей розділ засновано на реальній історії, а деякі деталі вигадано для гри.",
	["artifact.fr_silk_ribbon.name"] = "Шовкова стрічка",
	["quest.FR03.title"] = "За столом Матерів",
	["quest.FR03.summary"] = "Збери інгредієнти та дізнайся сімейний рецепт, натхненний Ліоном",
	["quest.FR03.greeting"] = "Ласкаво просимо до «За столом Матерів»! Давай працювати разом: збери інгредієнти та дізнайся сімейний рецепт, натхненний Ліоном.",
	["quest.FR03.completion"] = "Розділ FR03 завершено! Твоя нагорода — Записник шефа.",
	["quest.FR03.source_note"] = "Цей розділ засновано на реальній історії, а деякі деталі вигадано для гри.",
	["artifact.fr_chefs_notebook.name"] = "Записник шефа",
	["quest.FR04.title"] = "Ринок смаків",
	["quest.FR04.summary"] = "Обмінюйся інгредієнтами, читай вивіски й порівнюй походження сезонних продуктів",
	["quest.FR04.greeting"] = "Ласкаво просимо до «Ринку смаків»! Давай працювати разом: обмінюйся інгредієнтами, читай вивіски й порівнюй походження сезонних продуктів.",
	["quest.FR04.completion"] = "Розділ FR04 завершено! Твоя нагорода — Ринковий кошик.",
	["quest.FR04.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.fr_market_basket.name"] = "Ринковий кошик",
	["quest.FR05.title"] = "Камінь за каменем",
	["quest.FR05.summary"] = "Віднови фасад пекарні з віконницями за допомогою справжніх блоків і матеріалів",
	["quest.FR05.greeting"] = "Ласкаво просимо до «Камінь за каменем»! Давай попрацюємо разом: віднови фасад пекарні з віконницями за допомогою справжніх блоків і матеріалів.",
	["quest.FR05.completion"] = "Розділ FR05 завершено! Твоя нагорода — Герб муляра.",
	["quest.FR05.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.fr_masons_crest.name"] = "Герб муляра",
	["quest.FR06.title"] = "Рецепт рідного дому",
	["quest.FR06.summary"] = "Влаштуй спільну зустріч і збери архів рецептів громади",
	["quest.FR06.greeting"] = "Ласкаво просимо до «Рецепту рідного дому»! Давай попрацюємо разом: влаштуй спільну зустріч і збери архів рецептів громади.",
	["quest.FR06.completion"] = "Розділ FR06 завершено! Твоя нагорода — Марка спадщини Ліона.",
	["quest.FR06.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.fr_lyon_heritage_stamp.name"] = "Марка спадщини Ліона",
	["country.KR.name"] = "Південна Корея (Чонджу)",
	["country.KR.story"] = "П'ять кольорів Чонджу",
	["country.KR.cultural_warning"] = "The historical origin of bibimbap is debated; five-color symbolism is an interpretation and should be marked as such. Do not substitute generic Japanese or Chinese assets.",
	["artifact.kr_five_color_bibimbap_bowl.name"] = "Миска для п'ятиколірного пібімпапу",
	["vocab.KR.hanok"] = "한옥 (hanok) — традиційний корейський дерев'яний будинок із вигнутою черепицею ківа",
	["vocab.KR.obangsaek"] = "오방색 (obangsaek) — традиційна корейська палітра гармонії п'яти кольорів",
	["vocab.KR.bibimbap"] = "비빔밥 (bibimbap) — теплий рис із пряними овочами та смачними соусами",
	["npc.kr_jiwoo_halmeoni.name"] = "Джіу та Хальмоні (지우와 할머니)",
	["npc.kr_gardener_minho.name"] = "Городник Мінхо (농부 민호)",
	["npc.kr_carpenter_seojun.name"] = "Тесляр ханоків Соджун (대목장 서준)",
	["npc.kr_cook_soyeon.name"] = "Кухарка громади Сойон (요리사 소연)",
	["npc.kr_guide_haneul.name"] = "Архіваріус Ханиль (학예사 하늘)",
	["quest.KR01.title"] = "Брама ханока",
	["quest.KR01.summary"] = "Знайди шлях до входу та полагодь садову стежку",
	["quest.KR01.greeting"] = "Ласкаво просимо до «Брами ханока»! Давай попрацюємо разом: знайди шлях до входу та полагодь садову стежку.",
	["quest.KR01.completion"] = "Розділ KR01 завершено! Твоя нагорода — Оберіг для дверей ханока.",
	["quest.KR01.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.kr_hanok_door_charm.name"] = "Оберіг для дверей ханока",
	["quest.KR02.title"] = "П'ять кольорів, багато значень",
	["quest.KR02.summary"] = "Збери та розсортуй інгредієнти за кольорами обансек",
	["quest.KR02.greeting"] = "Ласкаво просимо до гри «П’ять кольорів, багато значень»! Давай працювати разом: збери та розсортуй інгредієнти за кольорами обансек.",
	["quest.KR02.completion"] = "Розділ KR02 пройдено! Твоя нагорода — П’ятиколірна палітра.",
	["quest.KR02.source_note"] = "Цей розділ ґрунтується на справжній історії, але деякі деталі вигадані спеціально для гри.",
	["artifact.kr_five_color_palette.name"] = "П’ятиколірна палітра",
	["quest.KR03.title"] = "Базарний ранок",
	["quest.KR03.summary"] = "Торгуй овочами та навчися ввічливо спілкуватися на ринку",
	["quest.KR03.greeting"] = "Ласкаво просимо до гри «Базарний ранок»! Давай працювати разом: торгуй овочами та навчися ввічливо спілкуватися на ринку.",
	["quest.KR03.completion"] = "Розділ KR03 пройдено! Твоя нагорода — Базарний жетон.",
	["quest.KR03.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і досі. У кожній оселі вони можуть дещо відрізнятися.",
	["artifact.kr_market_token.name"] = "Базарний жетон",
	["quest.KR04.title"] = "Спільна миска Чонджу",
	["quest.KR04.summary"] = "Приготуй пібімпап, викладаючи інгредієнти шар за шаром",
	["quest.KR04.greeting"] = "Ласкаво просимо до гри «Спільна миска Чонджу»! Давай працювати разом: приготуй пібімпап, викладаючи інгредієнти шар за шаром.",
	["quest.KR04.completion"] = "Розділ KR04 пройдено! Твоя нагорода — Миска для пібімпапа.",
	["quest.KR04.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і досі. У кожній оселі вони можуть дещо відрізнятися.",
	["artifact.kr_bibimbap_bowl.name"] = "Миска для пібімпапа",
	["quest.KR05.title"] = "Майстерність подвір’я",
	["quest.KR05.summary"] = "Віднови деталь ханока за допомогою дерев’яних елементів",
	["quest.KR05.greeting"] = "Ласкаво просимо до гри «Майстерність подвір’я»! Давай працювати разом: віднови деталь ханока за допомогою дерев’яних елементів.",
	["quest.KR05.completion"] = "Розділ KR05 пройдено! Твоя нагорода — Взірець з’єднання.",
	["quest.KR05.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і досі. У кожній оселі вони можуть дещо відрізнятися.",
	["artifact.kr_joinery_pattern.name"] = "Взірець з’єднання",
	["quest.KR06.title"] = "Бенкет гармонії",
	["quest.KR06.summary"] = "Збери друзів на спільну трапезу та напиши історію про єдність",
	["quest.KR06.greeting"] = "Ласкаво просимо до гри «Бенкет гармонії»! Давай працювати разом: збери друзів на спільну трапезу та напиши історію про єдність.",
	["quest.KR06.completion"] = "Розділ KR06 пройдено! Твоя нагорода — Печатка гармонії Чонджу.",
	["quest.KR06.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і досі. У кожній оселі вони можуть дещо відрізнятися.",
	["artifact.kr_jeonju_harmony_stamp.name"] = "Печатка гармонії Чонджу",
	["country.DE.name"] = "Німеччина (Рейн / символічний край Ґрааля)",
	["country.DE.story"] = "Пісня та цілюще запитання",
	["country.DE.cultural_warning"] = "Lorelei and Parzival are literary/mythic tales and should not be presented as literal history. Remove drowning, trauma and religious coercion from child-facing gameplay; provide respectful historical framing.",
	["artifact.de_compass_of_compassion.name"] = "Компас співчуття",
	["vocab.DE.mitgefuehl"] = "Mitgefühl (mit-guh-fuel) — Співчуття та щира турбота про інших",
	["vocab.DE.strom"] = "Strom (shtrohm) — Широка судноплавна річкова течія",
	["vocab.DE.frage"] = "Frage (frah-guh) — Турботливе запитання, яке відкриває шлях до розуміння",
	["npc.de_navigator_klara.name"] = "Річкова навігаторка Клара (Flusslotsin Klara)",
	["npc.de_historian_lukas.name"] = "Історик Лукас (Historiker Lukas)",
	["npc.de_narrator_lorelei.name"] = "Оповідачка Марлена (Erzählerin Marlene)",
	["npc.de_parzival.name"] = "Мандрівник Парцифаль (Wanderer Parzival)",
	["npc.de_gardener_jonas.name"] = "Садівник Йонас (Gärtner Jonas)",
	["quest.DE01.title"] = "Вигин річки",
	["quest.DE01.summary"] = "Проклади безпечний маршрут Рейном за допомогою маяків, напрямків течії та символів на карті",
	["quest.DE01.greeting"] = "Ласкаво просимо до Вигину річки! Працюймо разом: проклади безпечний маршрут Рейном за допомогою маяків, напрямків течії та символів на карті.",
	["quest.DE01.completion"] = "Розділ DE01 завершено! Ти здобув Карту маршруту Рейном.",
	["quest.DE01.source_note"] = "Цей розділ ґрунтується на справжній історії, але деякі деталі вигадано спеціально для гри.",
	["artifact.de_rhine_route_map.name"] = "Карта маршруту Рейном",
	["quest.DE02.title"] = "Зачарована пісня",
	["quest.DE02.summary"] = "Знайди те, що відволікає, у головоломці зі звуком і світлом та послухай різні версії легенди про Лорелей",
	["quest.DE02.greeting"] = "Ласкаво просимо до Зачарованої пісні! Працюймо разом: знайди те, що відволікає, у головоломці зі звуком і світлом та послухай різні версії легенди про Лорелей.",
	["quest.DE02.completion"] = "Розділ DE02 завершено! Ти здобув Пісенний камінь Лорелей.",
	["quest.DE02.source_note"] = "Ця історія походить із літератури: це витвір художньої уяви, а не запис справжніх подій.",
	["artifact.de_lorelei_songstone.name"] = "Пісенний камінь Лорелей",
	["quest.DE03.title"] = "Вибір навігатора",
	["quest.DE03.summary"] = "Допоможи човну дістатися укриття, звертаючи увагу на справжні сигнали, а не на оманливе відлуння",
	["quest.DE03.greeting"] = "Ласкаво просимо до Вибору навігатора! Працюймо разом: допоможи човну дістатися укриття, звертаючи увагу на справжні сигнали, а не на оманливе відлуння.",
	["quest.DE03.completion"] = "Розділ DE03 завершено! Ти здобув Надійне кермо.",
	["quest.DE03.source_note"] = "Це завдання було вигадано спеціально для гри, щоб допомогти розповісти історію.",
	["artifact.de_steady_helm.name"] = "Надійне кермо",
	["quest.DE04.title"] = "Тиха зала Грааля",
	["quest.DE04.summary"] = "Досліди міфічний замок і зверни увагу, що персонажу потрібна допомога",
	["quest.DE04.greeting"] = "Ласкаво просимо до Тихої зали Грааля! Працюймо разом: досліди міфічний замок і зверни увагу, що персонажу потрібна допомога.",
	["quest.DE04.completion"] = "Розділ DE04 завершено! Ти здобув Жетон Зали запитань.",
	["quest.DE04.source_note"] = "Ця історія походить із літератури: це витвір художньої уяви, а не запис справжніх подій.",
	["artifact.de_hall_of_questions_token.name"] = "Жетон Зали запитань",
	["quest.DE05.title"] = "Що тебе турбує?",
	["quest.DE05.summary"] = "Постав співчутливе запитання та допоможи ділом, замість того щоб мовчати",
	["quest.DE05.greeting"] = "Ласкаво просимо до пригоди «Що тебе турбує?»! Нумо разом: постав співчутливе запитання та допоможи ділом, замість того щоб мовчати.",
	["quest.DE05.completion"] = "Розділ DE05 завершено! Твоя нагорода — Сувій цілющого запитання.",
	["quest.DE05.source_note"] = "Це походить із художньої літератури: вигаданого твору, а не з опису справжніх подій.",
	["artifact.de_healing_question_scroll.name"] = "Сувій цілющого запитання",
	["quest.DE06.title"] = "Сад повертається",
	["quest.DE06.summary"] = "Разом відновіть занедбаний сад і запиши, що змінилося",
	["quest.DE06.greeting"] = "Ласкаво просимо до пригоди «Сад повертається»! Нумо разом: відновіть занедбаний сад і запиши, що змінилося.",
	["quest.DE06.completion"] = "Розділ DE06 завершено! Твоя нагорода — Німецька марка пам'яті.",
	["quest.DE06.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. Вони можуть різнитися від оселі до оселі.",
	["artifact.de_german_memory_stamp.name"] = "Німецька марка пам'яті",
	["country.CN.name"] = "Китай (Персикове джерело, світ за мотивами краю Улін)",
	["country.CN.story"] = "Долина за цвітом",
	["country.CN.cultural_warning"] = "Peach Blossom Spring is literary fiction. Chang’e’s moon story has multiple versions and should be introduced as folklore, not fact.",
	["artifact.cn_peach_blossom_keepsake.name"] = "Пам'ятка персикового цвіту",
	["vocab.CN.taohua"] = "桃花 (táohuā) — Квітка персика",
	["vocab.CN.tuanyuan"] = "团圆 (tuányuán) — Тепле возз'єднання та зустріч разом",
	["vocab.CN.bianhua"] = "变化 (biànhuà) — Природні зміни та оновлення з плином часу",
	["npc.cn_elder_lin.name"] = "Сільський старійшина Лінь (林长老)",
	["npc.cn_fisher_zhou.name"] = "Рибалка Чжоу (渔夫周叔)",
	["npc.cn_orchard_keeper_mei.name"] = "Доглядачка саду Мей (果园守护者梅姨)",
	["npc.cn_mapmaker_chen.name"] = "Картограф Чень (制图师小陈)",
	["npc.cn_moon_host_yue.name"] = "Господиня Свята місяця Юе (中秋主理人悦姐)",
	["quest.CN01.title"] = "Де повертає річка",
	["quest.CN01.summary"] = "Вирушай слідом за рибалкою проти течії та відшукай квітучий гай",
	["quest.CN01.greeting"] = "Ласкаво просимо до пригоди «Де повертає річка»! Нумо разом: вирушай слідом за рибалкою проти течії та відшукай квітучий гай.",
	["quest.CN01.completion"] = "Розділ CN01 завершено! Твоя нагорода — Квіткова пелюстка.",
	["quest.CN01.source_note"] = "Це походить із художньої літератури: вигаданого твору, а не з опису справжніх подій.",
	["artifact.cn_blossom_petal.name"] = "Квіткова пелюстка",
	["quest.CN02.title"] = "Захована долина",
	["quest.CN02.summary"] = "Познайомся із селянами, збери садові речі та допоможи полагодити міст",
	["quest.CN02.greeting"] = "Ласкаво просимо до Захованої долини! Давай працювати разом: познайомся із селянами, збери садові речі та допоможи полагодити міст.",
	["quest.CN02.completion"] = "Розділ CN02 завершено! Ти отримуєш Карту долини.",
	["quest.CN02.source_note"] = "Це походить із літератури: вигаданий твір, а не опис справжніх подій.",
	["artifact.cn_valley_map.name"] = "Карта долини",
	["quest.CN03.title"] = "Календар змін",
	["quest.CN03.summary"] = "Порівняй сезонні врожаї та ознаки плину часу",
	["quest.CN03.greeting"] = "Ласкаво просимо до Календаря змін! Давай працювати разом: порівняй сезонні врожаї та ознаки плину часу.",
	["quest.CN03.completion"] = "Розділ CN03 завершено! Ти отримуєш Колесо пір року.",
	["quest.CN03.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.cn_season_wheel.name"] = "Колесо пір року",
	["quest.CN04.title"] = "Шлях, що рухається",
	["quest.CN04.summary"] = "Спробуй відстежити мінливий маршрут і дізнайся, чому карта з пам'яті більше не працює",
	["quest.CN04.greeting"] = "Ласкаво просимо до Шляху, що рухається! Давай працювати разом: спробуй відстежити мінливий маршрут і дізнайся, чому карта з пам'яті більше не працює.",
	["quest.CN04.completion"] = "Розділ CN04 завершено! Ти отримуєш Мінливий компас.",
	["quest.CN04.source_note"] = "Це походить із літератури: вигаданий твір, а не опис справжніх подій.",
	["artifact.cn_changing_compass.name"] = "Мінливий компас",
	["quest.CN05.title"] = "Місячні листи",
	["quest.CN05.summary"] = "Познайомся з дитячою версією історії про Чан'е та приготуй символічні місячні пряники",
	["quest.CN05.greeting"] = "Ласкаво просимо до Місячних листів! Давай працювати разом: познайомся з дитячою версією історії про Чан'е та приготуй символічні місячні пряники.",
	["quest.CN05.completion"] = "Розділ CN05 завершено! Ти отримуєш Місячний лист.",
	["quest.CN05.source_note"] = "Це походить із фольклору: народні оповідки, які мають багато версій, а не опис справжніх подій.",
	["artifact.cn_moon_letter.name"] = "Місячний лист",
	["quest.CN06.title"] = "Посади новий сад",
	["quest.CN06.summary"] = "Створи новий спільний сад, а не намагайся повторити зникле минуле",
	["quest.CN06.greeting"] = "Ласкаво просимо до розділу «Посади новий сад»! Давай працювати разом: створи новий спільний сад, а не намагайся повторити зникле минуле.",
	["quest.CN06.completion"] = "Розділ CN06 завершено! Ти отримуєш штамп «Персикове джерело».",
	["quest.CN06.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. У різних домівках вони можуть відрізнятися.",
	["artifact.cn_peach_spring_stamp.name"] = "Штамп «Персикове джерело»",
	["country.JP.name"] = "Японія (подорож Басьо, маршрут, натхненний Тохоку)",
	["country.JP.story"] = "Вузька дорога додому",
	["country.JP.cultural_warning"] = "Bashō’s journey is historical literature; distinguish reconstructed poetic scenes from verified route facts. Haiku examples must be newly authored or rights-cleared translations.",
	["artifact.jp_travelers_ink_brush.name"] = "Чорнильний пензель мандрівника",
	["vocab.JP.tabi"] = "旅 (tabi) — Подорож та усвідомлені мандри крізь пори року",
	["vocab.JP.haiku"] = "俳句 (haiku) — Короткий трирядковий вірш про пори року та спостереження за природою",
	["vocab.JP.kakehashi"] = "架け橋 (kakehashi) — Міст, що з'єднує між собою різні місця та людей",
	["npc.jp_guide_haruka.name"] = "Провідниця мандрівників Харука (旅の案内人 はるか)",
	["npc.jp_innkeeper_kenji.name"] = "Господар заїзду Кенджі (宿の主人 けんじ)",
	["npc.jp_bridge_builder_takumi.name"] = "Мостобудівник Такумі (橋大工 たくみ)",
	["npc.jp_poet_aoi.name"] = "Поетка Аой (俳人 あおい)",
	["npc.jp_gardener_ren.name"] = "Садівник Рен (庭師 れん)",
	["quest.JP01.title"] = "Перший крок",
	["quest.JP01.summary"] = "Збери дорожній набір, обери дороговказ і зустрінься з мандрівником",
	["quest.JP01.greeting"] = "Ласкаво просимо до завдання «Перший крок»! Давай діяти разом: збери дорожній набір, обери дороговказ і зустрінься з мандрівником.",
	["quest.JP01.completion"] = "Розділ JP01 завершено! Ти отримуєш Сандалію мандрівника.",
	["quest.JP01.source_note"] = "Це походить із літератури: витвір уяви, а не розповідь про справжні події.",
	["artifact.jp_travelers_sandal.name"] = "Сандалія мандрівника",
	["quest.JP02.title"] = "Переправа через річку",
	["quest.JP02.summary"] = "Допоможи полагодити безпечний міст і перенести припаси",
	["quest.JP02.greeting"] = "Ласкаво просимо до завдання «Переправа через річку»! Давай діяти разом: допоможи полагодити безпечний міст і перенести припаси.",
	["quest.JP02.completion"] = "Розділ JP02 завершено! Ти отримуєш Жетон річкового мосту.",
	["quest.JP02.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. Вони можуть різнитися в кожній домівці.",
	["artifact.jp_river_bridge_token.name"] = "Жетон річкового мосту",
	["quest.JP03.title"] = "Три рядки неба",
	["quest.JP03.summary"] = "Спостерігай за погодою та склади короткий вірш про пору року за підказками",
	["quest.JP03.greeting"] = "Ласкаво просимо до завдання «Три рядки неба»! Давай діяти разом: спостерігай за погодою та склади короткий вірш про пору року за підказками.",
	["quest.JP03.completion"] = "Розділ JP03 завершено! Ти отримуєш Листок хайку.",
	["quest.JP03.source_note"] = "Це походить із літератури: витвір уяви, а не розповідь про справжні події.",
	["artifact.jp_haiku_leaf.name"] = "Листок хайку",
	["quest.JP04.title"] = "Прихисток подорожнього",
	["quest.JP04.summary"] = "Обміняй припаси та відремонтуй дах маленького заїзду",
	["quest.JP04.greeting"] = "Ласкаво просимо до завдання «Прихисток подорожнього»! Давай діяти разом: обміняй припаси та відремонтуй дах маленького заїзду.",
	["quest.JP04.completion"] = "Розділ JP04 завершено! Ти отримуєш Ліхтар заїзду.",
	["quest.JP04.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. Вони можуть різнитися в кожній домівці.",
	["artifact.jp_waystation_lantern.name"] = "Ліхтар поштової станції",
	["quest.JP05.title"] = "Мінлива стежка",
	["quest.JP05.summary"] = "Досліди краєвид у різний час і запиши, що змінилося",
	["quest.JP05.greeting"] = "Ласкаво просимо до «Мінливої стежки»! Нумо працювати разом: досліди краєвид у різний час і запиши, що змінилося.",
	["quest.JP05.completion"] = "Розділ JP05 завершено! Ти отримуєш Сезонний сувій.",
	["quest.JP05.source_note"] = "Це взято з літератури: вигаданого твору, а не запису справжніх подій.",
	["artifact.jp_seasonal_scroll.name"] = "Сезонний сувій",
	["quest.JP06.title"] = "Дорога — це дім",
	["quest.JP06.summary"] = "Облаштуй спільний сад для відпочинку та поміркуй про відчуття дому під час змін",
	["quest.JP06.greeting"] = "Ласкаво просимо до «Дорога — це дім»! Нумо працювати разом: облаштуй спільний сад для відпочинку та поміркуй про відчуття дому під час змін.",
	["quest.JP06.completion"] = "Розділ JP06 завершено! Ти отримуєш Штамп вузької дороги.",
	["quest.JP06.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й сьогодні. Вони можуть відрізнятися від однієї оселі до іншої.",
	["artifact.jp_narrow_road_stamp.name"] = "Штамп вузької дороги",
	["country.RU.name"] = "Росія (озеро Світлояр / міфічний краєвид, натхненний Китежем)",
	["country.RU.story"] = "Дзвони на дні озера",
	["country.RU.cultural_warning"] = "Kitezh is folklore with historical variants, not a factual submerged city. Avoid romanticizing political violence or presenting spiritual-national exclusivity as moral truth; support plural interpretations.",
	["artifact.ru_kitezh_bell.name"] = "Китезький дзвін",
	["vocab.RU.ozero"] = "озеро (ózero) — Чисте лісове озеро",
	["vocab.RU.gusli"] = "гусли (gúsli) — Традиційний щипковий багатострунний народний інструмент",
	["vocab.RU.predaniye"] = "предание (predániye) — Усна легенда, що передається з покоління в покоління",
	["npc.ru_keeper_yelena.name"] = "Хранителька озера Олена (Хранительница озера Елена)",
	["npc.ru_historian_pavel.name"] = "Сільський історик Павло (Историк Павел)",
	["npc.ru_musician_ilya.name"] = "Мандрівний музикант Ілля (Музыкант Илья)",
	["npc.ru_archivist_vera.name"] = "Архівістка Віра (Архивист Вера)",
	["npc.ru_carpenter_maksim.name"] = "Тесляр Максим (Плотник Максим)",
	["quest.RU01.title"] = "Дзвін на світанку",
	["quest.RU01.summary"] = "Знайди звукові мітки на березі та віднови сільський дзвін",
	["quest.RU01.greeting"] = "Ласкаво просимо до «Дзвону на світанку»! Нумо працювати разом: знайди звукові мітки на березі та віднови сільський дзвін.",
	["quest.RU01.completion"] = "Розділ RU01 завершено! Ти отримуєш Уламок озерного дзвона.",
	["quest.RU01.source_note"] = "Це походить із фольклору: історій, які розповідають у багатьох варіантах, а не запису справжніх подій.",
	["artifact.ru_lake_bell_fragment.name"] = "Уламок озерного дзвона",
	["quest.RU02.title"] = "Місто у віддзеркаленні",
	["quest.RU02.summary"] = "Досліджуй чарівне видіння, що змінюється разом із відблисками на воді",
	["quest.RU02.greeting"] = "Ласкаво просимо до «Міста у віддзеркаленні»! Попрацюймо разом: досліджуй чарівне видіння, що змінюється разом із відблисками на воді.",
	["quest.RU02.completion"] = "Розділ RU02 завершено! Ти отримуєш Призму віддзеркалення.",
	["quest.RU02.source_note"] = "Це походить із фольклору: це історії, які переповідають у багатьох варіантах, а не запис справжніх подій.",
	["artifact.ru_reflection_prism.name"] = "Призма віддзеркалення",
	["quest.RU03.title"] = "Струни Садка",
	["quest.RU03.summary"] = "Зіграй у ритмічну головоломку, натхненну фольклорним музикантом Садком",
	["quest.RU03.greeting"] = "Ласкаво просимо до «Струн Садка»! Попрацюймо разом: зіграй у ритмічну головоломку, натхненну фольклорним музикантом Садком.",
	["quest.RU03.completion"] = "Розділ RU03 завершено! Ти отримуєш Оберіг-гусла.",
	["quest.RU03.source_note"] = "Це походить із фольклору: це історії, які переповідають у багатьох варіантах, а не запис справжніх подій.",
	["artifact.ru_gusli_charm.name"] = "Оберіг-гусла",
	["quest.RU04.title"] = "Водний сад",
	["quest.RU04.summary"] = "Допоможи створити затишний сад на березі озера, не зашкодивши природному довкіллю",
	["quest.RU04.greeting"] = "Ласкаво просимо до «Водного саду»! Попрацюймо разом: допоможи створити затишний сад на березі озера, не зашкодивши природному довкіллю.",
	["quest.RU04.completion"] = "Розділ RU04 завершено! Ти отримуєш Очеретяний вінок.",
	["quest.RU04.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й досі. Вони можуть відрізнятися в кожній оселі.",
	["artifact.ru_reed_wreath.name"] = "Очеретяний вінок",
	["quest.RU05.title"] = "Хранителі історій",
	["quest.RU05.summary"] = "Запиши різні варіанти оповіді про Кітеж до місцевого архіву",
	["quest.RU05.greeting"] = "Ласкаво просимо до «Хранителів історій»! Попрацюймо разом: запиши різні варіанти оповіді про Кітеж до місцевого архіву.",
	["quest.RU05.completion"] = "Розділ RU05 завершено! Ти отримуєш Фоліант легенд.",
	["quest.RU05.source_note"] = "Це походить із фольклору: це історії, які переповідають у багатьох варіантах, а не запис справжніх подій.",
	["artifact.ru_legend_folio.name"] = "Фоліант легенд",
	["quest.RU06.title"] = "Історія над водою",
	["quest.RU06.summary"] = "Збудуй павільйон для історій і навчися відрізняти традицію від спостережуваних доказів",
	["quest.RU06.greeting"] = "Ласкаво просимо до «Історії над водою»! Попрацюймо разом: збудуй павільйон для історій і навчися відрізняти традицію від спостережуваних доказів.",
	["quest.RU06.completion"] = "Розділ RU06 завершено! Ти отримуєш Пам’ятний штамп Кітежа.",
	["quest.RU06.source_note"] = "Цей розділ спирається на живі традиції, яких родини дотримуються й досі. Вони можуть відрізнятися в кожній оселі.",
	["artifact.ru_kitezh_memory_stamp.name"] = "Пам’ятний штамп Кітежа",
	["country.UA.name"] = "Україна (пагорби заснування Києва / музичний майдан громади)",
	["country.UA.story"] = "Хранитель пісень",
	["country.UA.cultural_warning"] = "The Kyiv founders are chronicle legends. Kobzar traditions are varied; do not imply all practitioners were blind or use disability as a supernatural device. No graphic violence or combat reenactment.",
	["artifact.ua_bandura_memory_charm.name"] = "Пам’ятний оберіг-бандура",
	["vocab.UA.bandura"] = "бандура (bandúra) — український щипковий інструмент, що поєднує риси лютні та арфи",
	["vocab.UA.dumy"] = "думи (dúmy) — співані епічні твори, які зберігають усну пам'ять нашого народу",
	["vocab.UA.toloka"] = "толока (tolóka) — дружня спільна праця всією громадою, щоб разом будувати або відновлювати",
	["npc.ua_guide_lybid.name"] = "Провідниця Олена (маршрут «Либідь»)",
	["npc.ua_storyteller_taras.name"] = "Оповідач історій Тарас",
	["npc.ua_kobzar_mykola.name"] = "Кобзар Микола",
	["npc.ua_maker_solomiya.name"] = "Майстриня інструментів Соломія",
	["npc.ua_curator_kateryna.name"] = "Кураторка Катерина",
	["quest.UA01.title"] = "Четверо засновників",
	["quest.UA01.summary"] = "Досліди три пагорби й річку, збираючи мапу легенди про заснування міста",
	["quest.UA01.greeting"] = "Ласкаво просимо до пригоди «Четверо засновників»! Давай діяти разом: досліди три пагорби й річку та збери мапу легенди про заснування міста.",
	["quest.UA01.completion"] = "Розділ UA01 завершено! Твоя нагорода — Річкова мапа засновників.",
	["quest.UA01.source_note"] = "Це походить із фольклору: давніх історій, які розповідають у різних варіантах. Це перекази, а не запис справжніх історичних подій.",
	["artifact.ua_founders_river_map.name"] = "Річкова мапа засновників",
	["quest.UA02.title"] = "Місто біля води",
	["quest.UA02.summary"] = "Збери дерево й каміння, щоб полагодити зручний пішохідний місток",
	["quest.UA02.greeting"] = "Ласкаво просимо до пригоди «Місто біля води»! Давай діяти разом: збери дерево й каміння, щоб полагодити зручний пішохідний місток.",
	["quest.UA02.completion"] = "Розділ UA02 завершено! Твоя нагорода — Пам'ятна дощечка річкового мосту.",
	["quest.UA02.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і сьогодні. У кожній домівці вони можуть трохи відрізнятися.",
	["artifact.ua_river_bridge_plaque.name"] = "Пам'ятна дощечка річкового мосту",
	["quest.UA03.title"] = "Послухай кобзаря",
	["quest.UA03.summary"] = "Навчися уважно слухати музику та грати у пісенну перекличку",
	["quest.UA03.greeting"] = "Ласкаво просимо до пригоди «Послухай кобзаря»! Давай діяти разом: навчися уважно слухати музику та грати у пісенну перекличку.",
	["quest.UA03.completion"] = "Розділ UA03 завершено! Твоя нагорода — Струна бандури.",
	["quest.UA03.source_note"] = "Цей розділ спирається на живі традиції, які родини бережуть і сьогодні. У кожній домівці вони можуть трохи відрізнятися.",
	["artifact.ua_bandura_string.name"] = "Струна бандури",
	["quest.UA04.title"] = "Зошит дум",
	["quest.UA04.summary"] = "Збери та впорядкуй строфи пісень, відрізняючи усну пам'ять від записаних історичних подій",
	["quest.UA04.greeting"] = "Ласкаво просимо до пригоди «Зошит дум»! Давай діяти разом: збери та впорядкуй строфи пісень, відрізняючи усну пам'ять від записаних історичних подій.",
	["quest.UA04.completion"] = "Розділ UA04 завершено! Твоя нагорода — Сторінка з думою.",
	["quest.UA04.source_note"] = "Цей розділ ґрунтується на справжній історії, але деякі деталі вигадано спеціально для гри.",
	["artifact.ua_dumy_page.name"] = "Сторінка з думою",
	["quest.UA05.title"] = "Жива музична зала",
	["quest.UA05.summary"] = "Віднови концертну залу та розстав музичні інструменти з підписами",
	["quest.UA05.greeting"] = "Ласкаво просимо до пригоди «Жива музична зала»! Давай діяти разом: віднови концертну залу та розстав музичні інструменти з підписами.",
	["quest.UA05.completion"] = "Розділ UA05 пройдено! Твоя нагорода — Різьблений пюпітр.",
	["quest.UA05.source_note"] = "Цей розділ ґрунтується на живих традиціях, які родини бережуть і досі. У різних домівках вони можуть відрізнятися.",
	["artifact.ua_carved_music_stand.name"] = "Різьблений пюпітр",
	["quest.UA06.title"] = "Пісні, що мандрують",
	["quest.UA06.summary"] = "Створи разом з іншими нову авторську мелодію чи ритм та збережи її у спільній скарбничці",
	["quest.UA06.greeting"] = "Ласкаво просимо до розділу «Пісні, що мандрують»! Нумо творити разом: вигадай нову авторську мелодію чи ритм та збережи її у спільній скарбничці.",
	["quest.UA06.completion"] = "Розділ UA06 пройдено! Твоя нагорода — Штамп «Українська пісня».",
	["quest.UA06.source_note"] = "Цей розділ ґрунтується на живих традиціях, які родини бережуть і досі. У різних домівках вони можуть відрізнятися.",
	["artifact.ua_ukraine_song_stamp.name"] = "Штамп «Українська пісня»",
	["country.MA.name"] = "Марокко (Марракеш / площа, натхненна Джемаа-ель-Фна)",
	["country.MA.story"] = "Живе коло",
	["country.MA.cultural_warning"] = "Al Halqa is a living performance tradition, not one fixed text. Cultural/religious stories, including the Seven Saints, must be reviewed and presented respectfully without assigning sacred characters arbitrary game powers.",
	["artifact.ma_storytellers_circle_drum.name"] = "Барабан кола оповідача",
	["vocab.MA.halqa"] = "حلقة (ḥalqa) — Інтерактивне коло слухачів навколо оповідача",
	["vocab.MA.atay"] = "أتاي (atāy) — Марокканський зелений чай зі свіжою м'ятою",
	["vocab.MA.zellij"] = "زليج (zallīj) — Вирізана вручну геометрична глазурована мозаїка",
	["npc.ma_hakawati_driss.name"] = "Майстер-хакаваті Дрісс (الحكواتي المعلم إدريس)",
	["npc.ma_tea_host_kenza.name"] = "Господиня чаювання Кенза (لالة كنزة مضيفة أتاي)",
	["npc.ma_merchant_yassine.name"] = "Ремісник Яссін (الصانع ياسين)",
	["npc.ma_historian_salma.name"] = "Історикиня Сальма (المؤرخة سلمى)",
	["npc.ma_performer_amine.name"] = "Юний артист Амін (الفنان الشاب أمين)",
	["quest.MA01.title"] = "Приєднуйся до кола",
	["quest.MA01.summary"] = "Знайди площу та дізнайся, як слухачі допомагають казці оживати",
	["quest.MA01.greeting"] = "Ласкаво просимо до розділу «Приєднуйся до кола»! Нумо творити разом: знайди площу та дізнайся, як слухачі допомагають казці оживати.",
	["quest.MA01.completion"] = "Розділ MA01 пройдено! Твоя нагорода — Запрошення до кола.",
	["quest.MA01.source_note"] = "Цей розділ ґрунтується на живих традиціях, які родини бережуть і досі. У різних домівках вони можуть відрізнятися.",
	["artifact.ma_circle_invitation.name"] = "Запрошення до кола",
	["quest.MA02.title"] = "Оповідка багатьох голосів",
	["quest.MA02.summary"] = "Обирай звуки, жести та запитання-підказки для живої оповідки з багатьма розгалуженнями",
	["quest.MA02.greeting"] = "Ласкаво просимо до розділу «Оповідка багатьох голосів»! Нумо творити разом: обирай звуки, жести та запитання-підказки для живої оповідки з багатьма розгалуженнями.",
	["quest.MA02.completion"] = "Розділ MA02 завершено! Ти отримуєш Жетон хакаваті.",
	["quest.MA02.source_note"] = "Це походить із фольклору: історій, які розповідають у багатьох варіантах, а не записів реальних подій.",
	["artifact.ma_hakawati_token.name"] = "Жетон хакаваті",
	["quest.MA03.title"] = "Чай і ремесло",
	["quest.MA03.summary"] = "Збери м'яту, виконай кроки гостинності без нагрівання та обміняй їх на ремісничі прикраси",
	["quest.MA03.greeting"] = "Ласкаво просимо до «Чай і ремесло»! Давай попрацюємо разом: збери м'яту, виконай кроки гостинності без нагрівання та обміняй їх на ремісничі прикраси.",
	["quest.MA03.completion"] = "Розділ MA03 завершено! Ти отримуєш Тацю для м'ятного чаю.",
	["quest.MA03.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У кожній оселі вони можуть бути особливими.",
	["artifact.ma_mint_tea_tray.name"] = "Таця для м'ятного чаю",
	["quest.MA04.title"] = "Історія, яку ми змінюємо",
	["quest.MA04.summary"] = "Склади разом коротку казку з різними закінченнями та збережи ім'я автора",
	["quest.MA04.greeting"] = "Ласкаво просимо до «Історія, яку ми змінюємо»! Давай попрацюємо разом: склади коротку казку з різними закінченнями та збережи ім'я автора.",
	["quest.MA04.completion"] = "Розділ MA04 завершено! Ти отримуєш Нитку історій.",
	["quest.MA04.source_note"] = "Це завдання було вигадане спеціально для гри, щоб допомогти розповісти історію.",
	["artifact.ma_story_thread.name"] = "Нитка історій",
	["quest.MA05.title"] = "Стежки мудрості",
	["quest.MA05.summary"] = "Досліди шанобливу карту спадщини, натхненну розповідями про Сім святих Марракеша",
	["quest.MA05.greeting"] = "Ласкаво просимо до «Стежки мудрості»! Давай попрацюємо разом: досліди шанобливу карту спадщини, натхненну розповідями про Сім святих Марракеша.",
	["quest.MA05.completion"] = "Розділ MA05 завершено! Ти отримуєш Карту спадщини.",
	["quest.MA05.source_note"] = "Цей розділ ґрунтується на справжній історії, але деякі деталі вигадані спеціально для гри.",
	["artifact.ma_heritage_map.name"] = "Карта спадщини",
	["quest.MA06.title"] = "Коло мандрує",
	["quest.MA06.summary"] = "Збудуй невеличку сцену для оповідача та проведи спільний виступ різними мовами",
	["quest.MA06.greeting"] = "Ласкаво просимо до «Коло мандрує»! Давай попрацюємо разом: збудуй невеличку сцену для оповідача та проведи спільний виступ різними мовами.",
	["quest.MA06.completion"] = "Розділ MA06 завершено! Ти отримуєш Печатку марокканського кола.",
	["quest.MA06.source_note"] = "Цей розділ ґрунтується на живих традиціях, яких родини дотримуються й сьогодні. У кожній оселі вони можуть бути особливими.",
