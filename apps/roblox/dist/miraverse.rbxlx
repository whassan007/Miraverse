	["quest.DE01.title"] = "河流的拐弯处",
	["quest.DE01.summary"] = "利用航标、水流规律和地图符号，规划一条安全的莱茵河航线",
	["quest.DE01.greeting"] = "欢迎来到河流的拐弯处！让我们携手合作：利用航标、水流规律和地图符号，规划一条安全的莱茵河航线。",
	["quest.DE01.completion"] = "DE01章节完成！你获得了莱茵河航线图。",
