	["artifact.de_rhine_route_map.name"] = "خريطة مسار نهر الراين",
	["quest.DE02.title"] = "الأغنية المسحورة",
	["quest.DE02.summary"] = "اكتشف الأشياء يلي بتشتت انتباهك بلغز الصوت والضو، واسمع روايات مختلفة لأسطورة لورلاي",
	["quest.DE02.greeting"] = "أهلاً فيك بـ الأغنية المسحورة! خلّينا نشتغل سوا: اكتشف الأشياء يلي بتشتت انتباهك بلغز الصوت والضو، واسمع روايات مختلفة لأسطورة لورلاي.",
