	["npc.ma_performer_amine.name"] = "الفنان الشاب أمين",
	["quest.MA01.title"] = "انضم للحلقة",
	["quest.MA01.summary"] = "لقى الساحة وتعلّم كيفاش الجمهور كيعاون القصة باش تبان وتكمل",
	["quest.MA01.greeting"] = "مرحبا بيك فـ انضم للحلقة! يلا نتعاونو: لقى الساحة وتعلّم كيفاش الجمهور كيعاون القصة باش تبان وتكمل.",
	["quest.MA01.completion"] = "كملتي الفصل MA01! ربحتي دعوة للحلقة.",
	["quest.MA01.source_note"] = "هاد الفصل مستوحى من تقاليد حية كيمارسوها العائلات حتى لليوم. وتقدر تختلف من دار لدار.",
	["artifact.ma_circle_invitation.name"] = "دعوة للحلقة",
	["quest.MA02.title"] = "حكاية بأصوات كثيرة",
	["quest.MA02.summary"] = "ختار الصوت، والحركات، والأسئلة باش توجه حكاية شفوية متفرعة",
	["quest.MA02.greeting"] = "مرحبا بيك فـ حكاية بأصوات كثيرة! يلا نتعاونو: ختار الصوت، والحركات، والأسئلة باش توجه حكاية شفوية متفرعة.",
	["quest.MA02.completion"] = "كملتي الفصل MA02! ربحتي رمز الحكواتي.",
	["quest.MA02.source_note"] = "هادشي جاي من التراث الشعبي: حكايات كيتعاودو بطرق مختلفة، ماشي أحداث حقيقية وقعات.",
	["artifact.ma_hakawati_token.name"] = "رمز الحكواتي",
	["quest.MA03.title"] = "أتاي والصنعة",
	["quest.MA03.summary"] = "جمع النعناع ودير خطوات الضيافة بلا عافية، وبدّل باش تاخد زواق ديال الصنعة",
	["quest.MA03.greeting"] = "مرحباً بك في أتاي والصنعة! يالاه نتعاونو: جمع النعناع ودير خطوات الضيافة بلا عافية، وبدّل باش تاخد زواق ديال الصنعة.",
	["quest.MA03.completion"] = "كملتي الفصل MA03! ربحتي صينية أتاي بالنعناع.",
	["quest.MA03.source_note"] = "هاد الفصل مستوحى من تقاليد حية باقين العائلات كيديروها دابا، وتقدر تختلف من دار لدار.",
	["artifact.ma_mint_tea_tray.name"] = "صينية أتاي بالنعناع",
	["quest.MA04.title"] = "القصة اللي كنبدلو",
	["quest.MA04.summary"] = "شارك فكتابة قصة قصيرة بنهايات مختلفة مع الحفاظ على اسم اللي ألفها",
	["quest.MA04.greeting"] = "مرحباً بك في القصة اللي كنبدلو! يالاه نتعاونو: شارك فكتابة قصة قصيرة بنهايات مختلفة مع الحفاظ على اسم اللي ألفها.",
	["quest.MA04.completion"] = "كملتي الفصل MA04! ربحتي خيط الحكاية.",
	["quest.MA04.source_note"] = "هاد النشاط تخترع خصيصاً للّعبة باش يعاون فمعاودة القصة.",
	["artifact.ma_story_thread.name"] = "خيط الحكاية",
	["quest.MA05.title"] = "دروب الحكمة",
	["quest.MA05.summary"] = "اكتشف خريطة تراثية محترمة مستوحاة من قصص رجالات مراكش السبعة",
	["quest.MA05.greeting"] = "مرحباً بك في دروب الحكمة! يالاه نتعاونو: اكتشف خريطة تراثية محترمة مستوحاة من قصص رجالات مراكش السبعة.",
