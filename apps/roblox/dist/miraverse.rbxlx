	["quest.MA03.title"] = "Tee und Handwerk",
	["quest.MA03.summary"] = "Sammle Minze, bereite ganz ohne Hitze eine traditionelle Bewirtung vor und tausche sie gegen kunsthandwerkliche Dekorationen ein",
	["quest.MA03.greeting"] = "Willkommen bei Tee und Handwerk! Lass uns zusammenarbeiten: Sammle Minze, bereite ganz ohne Hitze eine traditionelle Bewirtung vor und tausche sie gegen kunsthandwerkliche Dekorationen ein.",
	["quest.MA03.completion"] = "Kapitel MA03 abgeschlossen! Du hast das Minztee-Tablett erhalten.",
	["quest.MA03.source_note"] = "Dieses Kapitel beruht auf lebendigen Traditionen, die Familien bis heute pflegen. Sie können von Familie zu Familie unterschiedlich sein.",
