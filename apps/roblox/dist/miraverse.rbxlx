	["vocab.LB.mina"] = "مينا (mīnā) — مينا عالبحر ورصيف حجر",
	["npc.lb_teta_nahla.name"] = "تيتا نهلة",
	["npc.lb_archivist_rami.name"] = "الأرشيفي الشاب رامي",
	["npc.lb_captain_faris.name"] = "قبطان المينا فارس",
