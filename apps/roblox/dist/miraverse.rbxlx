	["npc.lb_artisan_nadia.name"] = "حرفية الخط نادية",
	["quest.LB01.title"] = "المينا عم يفيق",
	["quest.LB01.summary"] = "الحق الأرصفة اللي عليها فوانيس، اجمَع أغراض المينا، وصلّح ممر مشاة آمن",
	["quest.LB01.greeting"] = "أهلاً فيك بـ «المينا عم يفيق»! خلّينا نشتغل سوا: الحق الأرصفة اللي عليها فوانيس، اجمَع أغراض المينا، وصلّح ممر مشاة آمن.",
	["quest.LB01.completion"] = "خلّصت الفصل LB01! ربحت بوصلة المينا.",
	["quest.LB01.source_note"] = "هيدا الفصل مستوحى من تقاليد حيّة بعدهن العائلات بيمارسوها لليوم، وممكن تختلف من بيت للتاني.",
	["artifact.lb_harbor_compass.name"] = "بوصلة المينا",
	["quest.LB02.title"] = "حروف على الحجر",
	["quest.LB02.summary"] = "طابِق رسوم الحروف المستوحاة من الفينيقية مع ملصقات التجارة، وركّب من جديد لوحة صغيرة منقوشة",
	["quest.LB02.greeting"] = "أهلاً فيك بـ «حروف على الحجر»! خلّينا نشتغل سوا: طابِق رسوم الحروف المستوحاة من الفينيقية مع ملصقات التجارة، وركّب من جديد لوحة صغيرة منقوشة.",
	["quest.LB02.completion"] = "خلّصت الفصل LB02! ربحت بلاطة الأبجدية.",
	["quest.LB02.source_note"] = "هيدا الفصل مبني على تاريخ حقيقي، مع بعض التفاصيل اللي تخيّلناها كرمال اللعبة.",
	["artifact.lb_alphabet_tile.name"] = "بلاطة الأبجدية",
	["quest.LB03.title"] = "سفرة تيتا",
	["quest.LB03.summary"] = "اجمَع الزعتر والمكونات، فاصِل بالسوق، وحضّر منقوشة بحرارة تمثيلية بإشراف الكبار",
	["quest.LB03.greeting"] = "أهلاً فيك ع طاولة تيتا! تعا نشتغل سوا: جمّع زعتر ومكوّنات، فاوض بالسوق، وحضّر منقوشة بنار تمثيلية تحت إشراف الكبار.",
	["quest.LB03.completion"] = "خلص الفصل LB03! ربحت بطاقة وصفة العيلة.",
	["quest.LB03.source_note"] = "هالفصل مأخوذ من تقاليد حيّة لليوم عم تمارسها العِيَل، وممكن تختلف من بيت لبيت.",
	["artifact.lb_family_recipe_card.name"] = "بطاقة وصفة العيلة",
	["quest.LB04.title"] = "صندوق الأرز",
	["quest.LB04.summary"] = "استكشف صندوق أرز مستوحى من الأساطير، وقارن بين الأسطورة والأدلّة التاريخية",
	["quest.LB04.greeting"] = "أهلاً فيك بصندوق الأرز! تعا نشتغل سوا: استكشف صندوق أرز مستوحى من الأساطير، وقارن بين الأسطورة والأدلّة التاريخية.",
	["quest.LB04.completion"] = "خلص الفصل LB04! ربحت رمز الأرز.",
	["quest.LB04.source_note"] = "هيدا مأخوذ من الفلكلور: قصص انحكت بروايات كتيرة، ومش توثيق لأحداث حقيقية.",
	["artifact.lb_cedar_token.name"] = "رمز الأرز",
	["quest.LB05.title"] = "صور عبر البحر",
	["quest.LB05.summary"] = "قابِل شخصيات عائلية خيالية، رتّب صور مؤرّخة، ونسّق معرض بيحترم موافقة أصحابه",
	["quest.LB05.greeting"] = "أهلاً فيك بصور عبر البحر! تعا نشتغل سوا: قابِل شخصيات عائلية خيالية، رتّب صور مؤرّخة، ونسّق معرض بيحترم موافقة أصحابه.",
	["quest.LB05.completion"] = "خلص الفصل LB05! ربحت ألبوم الأرشيف.",
	["quest.LB05.source_note"] = "هيدا النشاط تم ابتكاره كرمال اللعبة لحتى يساعدنا نخبر القصة.",
	["artifact.lb_archive_album.name"] = "ألبوم الأرشيف",
	["quest.LB06.title"] = "مهرجان الرجعة",
	["quest.LB06.summary"] = "رمّم ساحة التجمّع، جهّز سفرة أكل تشاركية، وخبّر قصة عائلية جديدة",
	["quest.LB06.greeting"] = "أهلاً فيك بمهرجان الرجعة! تعا نشتغل سوا: رمّم ساحة التجمّع، جهّز سفرة أكل تشاركية، وخبّر قصة عائلية جديدة.",
	["quest.LB06.completion"] = "خلص الفصل LB06! ربحت ختم بيت المينا.",
