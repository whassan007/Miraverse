	["quest.DE01.title"] = "انعطافة النهر",
	["quest.DE01.summary"] = "خطط طريق آمن بنهر الراين باستعمال المنارات، وحركة تيار المي، ورموز الخريطة",
	["quest.DE01.greeting"] = "أهلاً بيك بانعطافة النهر! خل نشتغل سوة: خطط طريق آمن بنهر الراين باستعمال المنارات، وحركة تيار المي، ورموز الخريطة.",
	["quest.DE01.completion"] = "كملت الفصل DE01! حصلت على خريطة مسار نهر الراين.",
	["quest.DE01.source_note"] = "هذا الفصل مبني على تاريخ حقيقي، ويا شوية تفاصيل تخيلناها علمود اللعبة.",
	["artifact.de_rhine_route_map.name"] = "خريطة مسار نهر الراين",
	["quest.DE02.title"] = "الأغنية المسحورة",
	["quest.DE02.summary"] = "اعرف الشغلات اللي تلهيك بحزورة الصوت والضوء، واسمع روايات مختلفة لأسطورة لورلاي",
	["quest.DE02.greeting"] = "أهلاً بيك بالأغنية المسحورة! خل نشتغل سوة: اعرف الشغلات اللي تلهيك بحزورة الصوت والضوء، واسمع روايات مختلفة لأسطورة لورلاي.",
	["quest.DE02.completion"] = "كملت الفصل DE02! حصلت على حجر أغنية لورلاي.",
	["quest.DE02.source_note"] = "هذا الشي جاي من الأدب: عمل من الخيال، مو تسجيل لأحداث حقيقية صارت بالواقع.",
	["artifact.de_lorelei_songstone.name"] = "حجر أغنية لورلاي",
	["quest.DE03.title"] = "اختيار الملاح",
	["quest.DE03.summary"] = "ساعد قارب يوصل لمكان آمن، وقدم الإشارات الحقيقية على أصوات الصدى اللي تلهي",
	["quest.DE03.greeting"] = "أهلاً بيك باختيار الملاح! خل نشتغل سوة: ساعد قارب يوصل لمكان آمن، وقدم الإشارات الحقيقية على أصوات الصدى اللي تلهي.",
	["quest.DE03.completion"] = "كملت الفصل DE03! حصلت على سكان السفينة الثابت.",
	["quest.DE03.source_note"] = "هاي الفعالية اخترعناها مخصوص للعبة حتى تساعد برواية القصة.",
	["artifact.de_steady_helm.name"] = "سكان السفينة الثابت",
	["quest.DE04.title"] = "قاعة الكأس الهادئة",
	["quest.DE04.summary"] = "استكشف قلعة أسطورية، وانتبه لشخصية محتاجة مساعدة",
	["quest.DE04.greeting"] = "أهلاً بيك بقاعة الكأس الهادئة! خل نشتغل سوة: استكشف قلعة أسطورية، وانتبه لشخصية محتاجة مساعدة.",
	["quest.DE04.completion"] = "كملت الفصل DE04! حصلت على رمز قاعة الأسئلة.",
	["quest.DE04.source_note"] = "هذا الشي جاي من الأدب: عمل من الخيال، مو تسجيل لأحداث حقيقية صارت بالواقع.",
	["artifact.de_hall_of_questions_token.name"] = "رمز قاعة الأسئلة",
	["quest.DE05.title"] = "شنو اللي مأذيك؟",
	["quest.DE05.summary"] = "اسأل سؤال بي حنية وتعاطف، واختار تصرفات تساعد بدل ما تضل ساكت",
	["quest.DE05.greeting"] = "أهلاً بيك بـ شنو اللي مأذيك؟! خل نشتغل سوة: اسأل سؤال بي حنية وتعاطف، واختار تصرفات تساعد بدل ما تضل ساكت.",
	["quest.DE05.completion"] = "كملت الفصل DE05! حصلت على مخطوطة السؤال الشافي.",
	["quest.DE05.source_note"] = "هذا الشي جاي من الأدب: عمل من الخيال، مو تسجيل لأحداث حقيقية صارت بالواقع.",
	["artifact.de_healing_question_scroll.name"] = "مخطوطة أسئلة الشفاء",
	["quest.DE06.title"] = "عودة الحديقة",
	["quest.DE06.summary"] = "نتعاون سوى حتى نصلّح حديقة مهجورة ونسجّل شنو اللي تغيّر",
	["quest.DE06.greeting"] = "أهلاً بيك بـ عودة الحديقة! خلّينا نشتغل سوى: نتعاون حتى نصلّح حديقة مهجورة ونسجّل شنو اللي تغيّر.",
	["quest.DE06.completion"] = "كمل فصل DE06! حصلت على طابع الذكريات الألماني.",
