	["artifact.ma_circle_invitation.name"] = "دعوة الحلقة",
	["quest.MA02.title"] = "حكاية بأصوات كتير",
	["quest.MA02.summary"] = "اختار الأصوات والحركات والأسئلة لحكاية شفوية متفرعة",
	["quest.MA02.greeting"] = "أهلاً بيك في حكاية بأصوات كتير! يلا نشتغل سوا: اختار الأصوات والحركات والأسئلة لحكاية شفوية متفرعة.",
	["quest.MA02.completion"] = "خلصت فصل MA02! كسبت عملة الحكواتي.",
	["quest.MA02.source_note"] = "ده جاي من الفولكلور الشعبي: حكايات بتتحكي بطرق وروايات كتيرة، ومش تسجيل لأحداث حقيقية.",
