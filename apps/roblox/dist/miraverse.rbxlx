              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "Liban (Byblos / Jbeil)",
	["country.LB.story"] = "Le port des histoires retrouvées",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "Coffre à souvenirs de cèdre et de mer",
	["vocab.LB.saj"] = "صاج (ṣāj) — Plaque bombée pour cuire les galettes de pain",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — Mélange parfumé de thym sauvage, de sésame et de sumac",
	["vocab.LB.mina"] = "مينا (mīnā) — Port côtier et quai de pierre",
	["npc.lb_teta_nahla.name"] = "Téta Nahla (تيتا نهلة)",
	["npc.lb_archivist_rami.name"] = "Le jeune archiviste Rami (الأرشيفي رامي)",
	["npc.lb_captain_faris.name"] = "Le capitaine du port Faris (القبطان فارس)",
	["npc.lb_baker_tariq.name"] = "Le boulanger Tariq (الخبّاز طارق)",
	["npc.lb_artisan_nadia.name"] = "L'artisane de l'écriture Nadia (الحرفية نادية)",
	["quest.LB01.title"] = "Le port s'éveille",
	["quest.LB01.summary"] = "Suis les quais éclairés par les lanternes, rassemble des provisions pour le port et répare un sentier sûr",
	["quest.LB01.greeting"] = "Bienvenue dans « Le port s'éveille » ! Travaillons ensemble : suis les quais éclairés par les lanternes, rassemble des provisions pour le port et répare un sentier sûr.",
	["quest.LB01.completion"] = "Chapitre LB01 terminé ! Tu as obtenu : Boussole du port.",
	["quest.LB01.source_note"] = "Ce chapitre s'inspire de traditions vivantes que les familles pratiquent encore aujourd'hui. Elles peuvent varier d'un foyer à l'autre.",
	["artifact.lb_harbor_compass.name"] = "Boussole du port",
	["quest.LB02.title"] = "Des lettres dans la pierre",
	["quest.LB02.summary"] = "Associe des motifs de lettres inspirés de l'alphabet phénicien à des étiquettes commerciales, puis reconstitue un petit panneau gravé",
	["quest.LB02.greeting"] = "Bienvenue dans « Des lettres dans la pierre » ! Travaillons ensemble : associe des motifs de lettres inspirés de l'alphabet phénicien à des étiquettes commerciales, puis reconstitue un petit panneau gravé.",
	["quest.LB02.completion"] = "Chapitre LB02 terminé ! Tu as gagné la Tuile de l'alphabet.",
	["quest.LB02.source_note"] = "Ce chapitre s'inspire de l'histoire réelle, avec quelques détails imaginés pour le jeu.",
	["artifact.lb_alphabet_tile.name"] = "Tuile de l'alphabet",
	["quest.LB03.title"] = "La table de Teta",
	["quest.LB03.summary"] = "Rassemble du zaatar et des ingrédients, négocie au marché et prépare une man'ouché avec une cuisson simulée et surveillée",
	["quest.LB03.greeting"] = "Bienvenue à La table de Teta ! Travaillons ensemble : rassemble du zaatar et des ingrédients, négocie au marché et prépare une man'ouché avec une cuisson simulée et surveillée.",
	["quest.LB03.completion"] = "Chapitre LB03 terminé ! Tu as gagné la Fiche de recette familiale.",
	["quest.LB03.source_note"] = "Ce chapitre s'inspire de traditions vivantes que les familles pratiquent encore aujourd'hui. Elles peuvent varier d'un foyer à l'autre.",
	["artifact.lb_family_recipe_card.name"] = "Fiche de recette familiale",
	["quest.LB04.title"] = "Le coffre en cèdre",
	["quest.LB04.summary"] = "Enquête sur un coffre en cèdre inspiré de mythes et compare la légende aux preuves historiques",
	["quest.LB04.greeting"] = "Bienvenue devant Le coffre en cèdre ! Travaillons ensemble : enquête sur un coffre en cèdre inspiré de mythes et compare la légende aux preuves historiques.",
	["quest.LB04.completion"] = "Chapitre LB04 terminé ! Tu as gagné le Jeton en cèdre.",
	["quest.LB04.source_note"] = "Cela provient du folklore : des histoires racontées sous de nombreuses versions, et non le récit d'événements réels.",
	["artifact.lb_cedar_token.name"] = "Jeton en cèdre",
	["quest.LB05.title"] = "Photographies par-delà les mers",
	["quest.LB05.summary"] = "Interroge des personnages de fiction d'une même famille, classe des photos datées et organise une exposition respectueuse du consentement",
	["quest.LB05.greeting"] = "Bienvenue dans Photographies par-delà les mers ! Travaillons ensemble : interroge des personnages de fiction d'une même famille, classe des photos datées et organise une exposition respectueuse du consentement.",
	["quest.LB05.completion"] = "Chapitre LB05 terminé ! Tu as gagné l'Album d'archives.",
	["quest.LB05.source_note"] = "Cette activité a été inventée pour le jeu afin d'aider à raconter l'histoire.",
	["artifact.lb_archive_album.name"] = "Album d'archives",
	["quest.LB06.title"] = "Le festival du retour",
	["quest.LB06.summary"] = "Restaure la place de rassemblement, prépare un festin partagé et raconte une nouvelle histoire de famille",
	["quest.LB06.greeting"] = "Bienvenue dans Le festival du retour ! Travaillons ensemble : restaure la place de rassemblement, prépare un festin partagé et raconte une nouvelle histoire de famille.",
	["quest.LB06.completion"] = "Chapitre LB06 terminé ! Tu as gagné le Tampon du port d'attache.",
	["quest.LB06.source_note"] = "Ce chapitre s'inspire de traditions vivantes que les familles pratiquent encore aujourd'hui. Elles peuvent varier d'un foyer à l'autre.",
	["artifact.lb_harbor_home_stamp.name"] = "Tampon du port d'attache",
	["country.IQ.name"] = "Irak (Bagdad)",
	["country.IQ.story"] = "La bibliothèque qui voyage",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "Livre de la Maison de la sagesse",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — Balcon en treillis de bois sculpté surplombant la rue",
	["vocab.IQ.kleicha"] = "كليجة (klīcha) — Pâtisserie aux dattes parfumée à la cardamome partagée lors des fêtes",
	["vocab.IQ.hikma"] = "حكمة (ḥikma) — Sagesse et quête commune du savoir",
	["npc.iq_bibi_amal.name"] = "Bibi Amal (بيبي أمل)",
	["npc.iq_merchant_hassan.name"] = "Le marchand de livres Hassan (الكتبي حسان)",
	["npc.iq_translator_mariam.name"] = "La traductrice Mariam (المترجمة مريم)",
	["npc.iq_baker_salim.name"] = "Le boulanger Salim (الخبّاز سليم)",
	["npc.iq_astronomer_zaid.name"] = "L'apprenti astronome Zaid (الفلكي زيد)",
	["quest.IQ01.title"] = "La rue des livres",
	["quest.IQ01.summary"] = "Ouvre les volets, rapporte les livres éparpillés aux marchands et cartographie les étagères",
	["quest.IQ01.greeting"] = "Bienvenue dans La rue des livres ! Travaillons ensemble : ouvre les volets, rapporte les livres éparpillés aux marchands et cartographie les étagères.",
	["quest.IQ01.completion"] = "Chapitre IQ01 terminé ! Tu as obtenu le Sceau du libraire.",
	["quest.IQ01.source_note"] = "Ce chapitre s'inspire de traditions vivantes que les familles pratiquent encore aujourd'hui. Elles peuvent varier d'une maison à l'autre.",
	["artifact.iq_bookseller_seal.name"] = "Sceau du libraire",
	["quest.IQ02.title"] = "La Maison de la sagesse",
	["quest.IQ02.summary"] = "Rassemble des outils mathématiques et aide à restaurer une salle des savants",
	["quest.IQ02.greeting"] = "Bienvenue dans La Maison de la sagesse ! Travaillons ensemble : rassemble des outils mathématiques et aide à restaurer une salle des savants.",
	["quest.IQ02.completion"] = "Chapitre IQ02 terminé ! Tu as obtenu l'Astrolabe du savant.",
	["quest.IQ02.source_note"] = "Ce chapitre s'appuie sur l'histoire réelle, avec quelques détails imaginés pour le jeu.",
	["artifact.iq_scholars_astrolabe.name"] = "Astrolabe du savant",
	["quest.IQ03.title"] = "Les mots qui voyagent",
	["quest.IQ03.summary"] = "Associe les traductions de concepts issus de l'arabe, du grec et du syriaque à leurs étiquettes d'origine",
