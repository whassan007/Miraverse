              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "黎巴嫩（比布鲁斯/朱拜勒）",
	["country.LB.story"] = "故事归来的港湾",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "雪松与大海的记忆宝箱",
	["vocab.LB.saj"] = "صاج (ṣāj) — 用于烘烤薄饼的凸面铁板",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — 由野百里香、芝麻和漆树调配而成的芳香混合香料",
	["vocab.LB.mina"] = "مينا (mīnā) — 海岸港口与石砌码头",
	["npc.lb_teta_nahla.name"] = "纳赫拉奶奶 (تيتا نهلة)",
	["npc.lb_archivist_rami.name"] = "年轻的档案员拉米 (الأرشيفي رامي)",
	["npc.lb_captain_faris.name"] = "港口船长法里斯 (القبطان فارس)",
	["npc.lb_baker_tariq.name"] = "面包师塔里克 (الخبّاز طارق)",
	["npc.lb_artisan_nadia.name"] = "文字手艺人纳迪娅 (الحرفية نادية)",
	["quest.LB01.title"] = "苏醒的港湾",
	["quest.LB01.summary"] = "跟随挂有灯笼的码头指引，收集港口物资，修复安全的步道",
	["quest.LB01.greeting"] = "欢迎来到《苏醒的港湾》！让我们一起努力：沿着挂有灯笼的码头前行，收集港口物资，修好安全的人行便道。",
	["quest.LB01.completion"] = "章节 LB01 完成！你获得了海港罗盘。",
	["quest.LB01.source_note"] = "本章节取材于各家庭至今仍在延续的生活传统。不同家庭的习俗可能会有所不同。",
	["artifact.lb_harbor_compass.name"] = "海港罗盘",
	["quest.LB02.title"] = "石刻文字",
	["quest.LB02.summary"] = "将腓尼基风格的字母图案与贸易标签相匹配；复原一块小小的石刻标牌",
	["quest.LB02.greeting"] = "欢迎来到《石刻文字》！让我们一起努力：将腓尼基风格的字母图案与贸易标签相匹配；复原一块小小的石刻标牌。",
	["quest.LB02.completion"] = "LB02 章节完成！你获得了字母瓷砖。",
	["quest.LB02.source_note"] = "本章节基于真实历史，其中部分细节是为游戏而构想的。",
	["artifact.lb_alphabet_tile.name"] = "字母瓷砖",
	["quest.LB03.title"] = "泰塔奶奶的餐桌",
	["quest.LB03.summary"] = "收集扎塔尔香料与食材，在集市上讨价还价，并在指导下使用模拟火候烤制马努什大饼",
	["quest.LB03.greeting"] = "欢迎来到泰塔奶奶的餐桌！让我们一起来：收集扎塔尔香料与食材，在集市上讨价还价，并在指导下使用模拟火候烤制马努什大饼。",
	["quest.LB03.completion"] = "LB03 章节完成！你获得了家庭食谱卡。",
	["quest.LB03.source_note"] = "本章节取材于当今家庭中仍然延续的生活传统。各个家庭的传统可能会有所不同。",
	["artifact.lb_family_recipe_card.name"] = "家庭食谱卡",
	["quest.LB04.title"] = "雪松木箱",
	["quest.LB04.summary"] = "探索一个受神话启发的雪松木箱，并将传说与历史证据进行对比",
	["quest.LB04.greeting"] = "欢迎来到雪松木箱！让我们一起来：探索一个受神话启发的雪松木箱，并将传说与历史证据进行对比。",
	["quest.LB04.completion"] = "LB04 章节完成！你获得了雪松代币。",
	["quest.LB04.source_note"] = "这来自民间传说：这些故事有许多流传的版本，并不是对真实事件的记录。",
	["artifact.lb_cedar_token.name"] = "雪松代币",
	["quest.LB05.title"] = "漂洋过海的照片",
	["quest.LB05.summary"] = "采访虚构的家庭角色，按日期整理照片，策划一场征得同意的安全展览",
	["quest.LB05.greeting"] = "欢迎来到漂洋过海的照片！让我们一起来：采访虚构的家庭角色，按日期整理照片，策划一场征得同意的安全展览。",
	["quest.LB05.completion"] = "LB05 章节完成！你获得了档案相册。",
	["quest.LB05.source_note"] = "这个活动是为本游戏而虚构的，旨在帮助讲述故事。",
	["artifact.lb_archive_album.name"] = "档案相册",
	["quest.LB06.title"] = "回归节",
	["quest.LB06.summary"] = "修整聚会广场，筹办一场合作盛宴，讲述一个全新的家庭故事",
	["quest.LB06.greeting"] = "欢迎来到回归节！让我们一起来：修整聚会广场，筹办一场合作盛宴，讲述一个全新的家庭故事。",
	["quest.LB06.completion"] = "LB06 章节完成！你获得了海港家园印章。",
	["quest.LB06.source_note"] = "本章节取材于当今家庭中仍然延续的生活传统。各个家庭的传统可能会有所不同。",
	["artifact.lb_harbor_home_stamp.name"] = "海港家园印章",
	["country.IQ.name"] = "伊拉克（巴格达）",
	["country.IQ.story"] = "会旅行的图书馆",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "智慧宫之书",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — 伸向街道上方的雕花木格阳台",
	["vocab.IQ.kleicha"] = "كليجة (klīcha) — 在庆祝活动中一起分享的豆蔻风味椰枣糕点",
	["vocab.IQ.hikma"] = "حكمة (ḥikma) — 智慧与共同的求知探索",
	["npc.iq_bibi_amal.name"] = "比比·阿迈勒 (بيبي أمل)",
	["npc.iq_merchant_hassan.name"] = "书商哈桑 (الكتبي حسان)",
	["npc.iq_translator_mariam.name"] = "翻译家玛丽亚姆 (المترجمة مريم)",
	["npc.iq_baker_salim.name"] = "面包师萨利姆 (الخبّاز سليم)",
	["npc.iq_astronomer_zaid.name"] = "天文学徒扎伊德 (الفلكي زيد)",
	["quest.IQ01.title"] = "书街",
	["quest.IQ01.summary"] = "打开百叶窗，把散落的书籍归还给书商，并绘制书架地图",
	["quest.IQ01.greeting"] = "欢迎来到书街！让我们一起合作：打开百叶窗，把散落的书籍归还给书商，并绘制书架地图。",
	["quest.IQ01.completion"] = "章节 IQ01 完成！你获得了书商印章。",
	["quest.IQ01.source_note"] = "本章取材于至今仍有家庭在实践的鲜活传统。每个家庭的做法可能会有所不同。",
	["artifact.iq_bookseller_seal.name"] = "书商印章",
	["quest.IQ02.title"] = "智慧之家",
	["quest.IQ02.summary"] = "收集数学工具，帮助修缮一间学者书房",
	["quest.IQ02.greeting"] = "欢迎来到智慧之家！让我们一起合作：收集数学工具，帮助修缮一间学者书房。",
	["quest.IQ02.completion"] = "章节 IQ02 完成！你获得了学者星盘。",
	["quest.IQ02.source_note"] = "本章基于真实历史创作，部分细节为游戏虚构。",
	["artifact.iq_scholars_astrolabe.name"] = "学者星盘",
	["quest.IQ03.title"] = "文字的旅程",
	["quest.IQ03.summary"] = "将源自阿拉伯语、希腊语和叙利亚语的概念译词与它们的来源标签相匹配",
	["quest.IQ03.greeting"] = "欢迎来到文字的旅程！让我们一起合作：将源自阿拉伯语、希腊语和叙利亚语的概念译词与它们的来源标签相匹配。",
	["quest.IQ03.completion"] = "章节 IQ03 完成！你获得了翻译卷轴。",
	["quest.IQ03.source_note"] = "本章基于真实历史创作，部分细节为游戏虚构。",
	["artifact.iq_translation_scroll.name"] = "翻译卷轴",
	["quest.IQ04.title"] = "椰枣与克莱查饼",
	["quest.IQ04.summary"] = "采摘椰枣，交换香料，并完成一次家庭烘焙",
	["quest.IQ04.greeting"] = "欢迎来到椰枣与克莱查饼！让我们一起合作：采摘椰枣，交换香料，并完成一次家庭烘焙。",
	["quest.IQ04.completion"] = "章节 IQ04 完成！你获得了克莱查饼模具。",
	["quest.IQ04.source_note"] = "本章取材于至今仍有家庭在实践的鲜活传统。每个家庭的做法可能会有所不同。",
	["artifact.iq_kleicha_mold.name"] = "克莱查饼模具",
	["quest.IQ05.title"] = "提问庭院",
	["quest.IQ05.summary"] = "修复沙纳希勒木格窗，打造一个光影相伴的阅读角",
	["quest.IQ05.greeting"] = "欢迎来到疑问庭院！让我们一起：修复珊纳希尔木格窗，打造一个光影交织的阅读角吧。",
	["quest.IQ05.completion"] = "章节 IQ05 完成！你获得了庭院木格窗。",
	["quest.IQ05.source_note"] = "本章内容取材于许多家庭至今仍在传承的生活传统。不同人家的习俗可能会有所不同。",
	["artifact.iq_courtyard_lattice.name"] = "庭院木格窗",
	["quest.IQ06.title"] = "跨越大洋的图书馆",
	["quest.IQ06.summary"] = "打造双语展览，与访客分享故事，并保存一份图书目录",
	["quest.IQ06.greeting"] = "欢迎来到跨越大洋的图书馆！让我们一起：打造双语展览，与访客分享故事，并保存一份图书目录吧。",
	["quest.IQ06.completion"] = "章节 IQ06 完成！你获得了知识守护者印章。",
	["quest.IQ06.source_note"] = "这个活动是为本游戏专门虚构创作的，用来帮助讲述故事。",
	["artifact.iq_knowledge_keeper_stamp.name"] = "知识守护者印章",
	["country.EG.name"] = "埃及（开罗）",
	["country.EG.story"] = "开罗的花灯",
	["country.EG.cultural_warning"] = "The Fatimid lantern origin is a widely circulated tradition, not a single definitively established historical account. Distinguish contemporary Cairo from ancient Egyptian settings.",
	["artifact.eg_fanous_of_shared_light.name"] = "同享光明法努斯花灯",
	["vocab.EG.fanous"] = "فانوس (fānūs) — 用黄铜和彩色玻璃制成的装饰花灯",
	["vocab.EG.koshari"] = "كشري (kusharī) — 由米饭、小扁豆、通心粉、番茄酱和酥脆炸洋葱层层铺制的美食",
	["vocab.EG.mashrabiya"] = "مشربية (mashrabiyya) — 用木工车削工艺制成的几何花纹木格窗",
	["npc.eg_layla_guide.name"] = "蕾拉与萨米拉奶奶 (ليلى وتيتا سميرة)",
	["npc.eg_lantern_maker_amm_adel.name"] = "花灯工匠阿德尔大叔 (عم عادل صانع الفوانيس)",
	["npc.eg_market_auntie_nadia.name"] = "集市上的纳迪娅阿姨 (طنط نادية في السوق)",
	["npc.eg_cook_ibrahim.name"] = "厨师易卜拉欣 (الشيف إبراهيم)",
	["npc.eg_storyteller_youssef.name"] = "说书人优素福 (الحكواتي يوسف)",
	["quest.EG01.title"] = "昏暗的庭院",
	["quest.EG01.summary"] = "跟随彩色花灯的光芒，找回遗失的铜片",
	["quest.EG01.greeting"] = "欢迎来到昏暗的庭院！让我们一起：跟随彩色花灯的光芒，找回遗失的铜片吧。",
	["quest.EG01.completion"] = "章节 EG01 完成！你获得了花灯框架。",
	["quest.EG01.source_note"] = "本章内容取材于许多家庭至今仍在传承的生活传统。不同人家的习俗可能会有所不同。",
	["artifact.eg_lantern_frame.name"] = "花灯框架",
	["quest.EG02.title"] = "法努斯花灯工坊",
	["quest.EG02.summary"] = "使用带花纹的体素零件，亲手制作一盏安全的装饰花灯",
	["quest.EG02.greeting"] = "欢迎来到法努斯灯工坊！让我们一起合作：用带花纹的体素零件制作一盏安全又漂亮的装饰灯笼吧。",
	["quest.EG02.completion"] = "章节 EG02 完成！你获得了玻璃之星。",
	["quest.EG02.source_note"] = "本章节取材于今天许多家庭仍在延续的生活传统。每个家庭的做法可能会有所不同。",
	["artifact.eg_glass_star.name"] = "玻璃之星",
	["quest.EG03.title"] = "黄昏集市",
	["quest.EG03.summary"] = "买卖小扁豆、大米和蔬菜，同时学会看懂称重",
	["quest.EG03.greeting"] = "欢迎来到黄昏集市！让我们一起合作：买卖小扁豆、大米和蔬菜，同时学会看懂称重。",
	["quest.EG03.completion"] = "章节 EG03 完成！你获得了集市秤。",
	["quest.EG03.source_note"] = "本章节取材于今天许多家庭仍在延续的生活传统。每个家庭的做法可能会有所不同。",
	["artifact.eg_market_scale.name"] = "集市秤",
	["quest.EG04.title"] = "大家的库莎丽",
	["quest.EG04.summary"] = "按顺序准备食材，并帮忙在社区餐桌上分发食物",
	["quest.EG04.greeting"] = "欢迎来到“大家的库莎丽”！让我们一起合作：按顺序准备食材，并帮忙在社区餐桌上分发食物。",
	["quest.EG04.completion"] = "章节 EG04 完成！你获得了库莎丽碗。",
	["quest.EG04.source_note"] = "本章节取材于今天许多家庭仍在延续的生活传统。每个家庭的做法可能会有所不同。",
