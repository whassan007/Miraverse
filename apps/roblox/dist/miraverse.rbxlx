	["artifact.cn_season_wheel.name"] = "عجلة الفصول",
	["quest.CN04.title"] = "طريق يتحرك",
	["quest.CN04.summary"] = "حاول تتبّع مسار متغير واكتشف لماذا لم تعد الخريطة المحفوظة في الذاكرة صالحة",
	["quest.CN04.greeting"] = "أهلاً بك في طريق يتحرك! هيا نعمل معاً: حاول تتبّع مسار متغير واكتشف لماذا لم تعد الخريطة المحفوظة في الذاكرة صالحة.",
	["quest.CN04.completion"] = "اكتمل الفصل CN04! لقد حصلت على البوصلة المتغيرة.",
	["quest.CN04.source_note"] = "هذه القصة مستوحاة من الأدب: عمل خيالي وليست تسجيلاً لأحداث حقيقية.",
