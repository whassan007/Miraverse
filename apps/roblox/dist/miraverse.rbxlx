	["npc.lb_artisan_nadia.name"] = "فنانة الخط نادية",
	["quest.LB01.title"] = "المينا بيصحى",
	["quest.LB01.summary"] = "امشي ورا أرصفة الفوانيس، واجمع مستلزمات المينا، وصَلّح ممر مشي آمن",
	["quest.LB01.greeting"] = "أهلاً بيك في «المينا بيصحى»! يلا نشتغل سوا: امشي ورا أرصفة الفوانيس، واجمع مستلزمات المينا، وصَلّح ممر مشي آمن.",
	["quest.LB01.completion"] = "فصل LB01 كمل خلاص! كسبت بوصلة المينا.",
	["quest.LB01.source_note"] = "الفصل ده مبني على تقاليد حية لسه العائلات بتمارسها لحد النهاردة، وممكن تختلف من بيت للتاني.",
	["artifact.lb_harbor_compass.name"] = "بوصلة المينا",
	["quest.LB02.title"] = "حروف في الحجر",
	["quest.LB02.summary"] = "وفّق بين أشكال الحروف المستوحاة من الفينيقية وبين بطاقات التجارة، وركّب يافطة صغيرة منقوشة من جديد",
	["quest.LB02.greeting"] = "أهلاً بيك في «حروف في الحجر»! يلا نشتغل سوا: وفّق بين أشكال الحروف المستوحاة من الفينيقية وبين بطاقات التجارة، وركّب يافطة صغيرة منقوشة من جديد.",
	["quest.LB02.completion"] = "فصل LB02 خلص! كسبت بلاطة الحروف الأبجدية.",
	["quest.LB02.source_note"] = "الفصل ده مبني على تاريخ حقيقي، مع شوية تفاصيل من الخيال عشان اللعبة.",
	["artifact.lb_alphabet_tile.name"] = "بلاطة الحروف الأبجدية",
	["quest.LB03.title"] = "سفرة تيتا",
	["quest.LB03.summary"] = "اجمع زعتر ومكونات، وفاصِل في السوق، واعمل مناقيش بحرارة افتراضية تحت إشراف",
	["quest.LB03.greeting"] = "أهلاً بيك في سفرة تيتا! يلا نشتغل سوا: اجمع زعتر ومكونات، وفاصِل في السوق، واعمل مناقيش بحرارة افتراضية تحت إشراف.",
	["quest.LB03.completion"] = "فصل LB03 خلص! كسبت كارت وصفة العيلة.",
	["quest.LB03.source_note"] = "الفصل ده مستوحى من تقاليد لسه عايشة وبتمارسها العائلات لحد النهاردة، وممكن تختلف من بيت للتاني.",
	["artifact.lb_family_recipe_card.name"] = "كارت وصفة العيلة",
	["quest.LB04.title"] = "صندوق شجر الأرز",
	["quest.LB04.summary"] = "استكشف صندوق من خشب الأرز مستوحى من الأساطير، وقارن بين الأسطورة والأدلة التاريخية",
	["quest.LB04.greeting"] = "أهلاً بيك في صندوق شجر الأرز! يلا نشتغل سوا: استكشف صندوق من خشب الأرز مستوحى من الأساطير، وقارن بين الأسطورة والأدلة التاريخية.",
	["quest.LB04.completion"] = "فصل LB04 خلص! كسبت رمز الأرز.",
	["quest.LB04.source_note"] = "ده جاي من الفولكلور الشعبي: حكايات بتتحكي بطرق وروايات كتيرة، ومش تسجيل لأحداث حقيقية.",
	["artifact.lb_cedar_token.name"] = "رمز الأرز",
	["quest.LB05.title"] = "صور عبر البحر",
	["quest.LB05.summary"] = "اعمل مقابلات مع شخصيات عائلية خيالية، ورتب الصور حسب التواريخ، ونظم معرض يراعي موافقة أصحابه",
	["quest.LB05.greeting"] = "أهلاً بيك في صور عبر البحر! يلا نشتغل سوا: اعمل مقابلات مع شخصيات عائلية خيالية، ورتب الصور حسب التواريخ، ونظم معرض يراعي موافقة أصحابه.",
	["quest.LB05.completion"] = "فصل LB05 خلص! كسبت ألبوم الأرشيف.",
