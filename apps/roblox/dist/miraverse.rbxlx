	["country.UA.name"] = "أوكرانيا (تلال تأسيس كييف / ساحة الموسيقى الشعبية)",
	["country.UA.story"] = "حارس الأغاني",
	["country.UA.cultural_warning"] = "The Kyiv founders are chronicle legends. Kobzar traditions are varied; do not imply all practitioners were blind or use disability as a supernatural device. No graphic violence or combat reenactment.",
	["artifact.ua_bandura_memory_charm.name"] = "تميمة ذكرى الباندورا",
	["vocab.UA.bandura"] = "бандура (bandúra) — آلة وترية أوكرانية بتنعزف بالنقر، بتجمع بين ميزات العود والهارب",
	["vocab.UA.dumy"] = "думи (dúmy) — قصائد ملحمية مغناة بتحفظ الذاكرة الثقافية الشفهية",
	["vocab.UA.toloka"] = "толока (tolóka) — لمّة تضامن شعبية ليتعاونوا الناس ويبنوا أو يرمموا سوا",
	["npc.ua_guide_lybid.name"] = "المرشدة أولينا (مسار ليبيد) (Провідниця Олена)",
