	["quest.DE01.title"] = "منعطف النهر",
	["quest.DE01.summary"] = "رسم طريق آمن فـ نهر الراين باستعمال المنارات، واتجاه الما، ورموز الخريطة",
	["quest.DE01.greeting"] = "مرحبا بيك فـ منعطف النهر! يلاه نخدمو مجموعين: رسم طريق آمن فـ نهر الراين باستعمال المنارات، واتجاه الما، ورموز الخريطة.",
	["quest.DE01.completion"] = "كملتي الفصل DE01! ربحتي خريطة طريق الراين.",
	["quest.DE01.source_note"] = "هاد الفصل مبني على تاريخ حقيقي، مع شوية ديال التفاصيل من الخيال مديورة على قبل اللعبة.",
	["artifact.de_rhine_route_map.name"] = "خريطة طريق الراين",
	["quest.DE02.title"] = "الأغنية المسحورة",
	["quest.DE02.summary"] = "اكتشف الحوايج لي كيتلفو فـ لغز الصوت والضو، وتصنت لروايات مختلفة من أسطورة لوريلاي",
	["quest.DE02.greeting"] = "مرحبا بيك فـ الأغنية المسحورة! يلاه نخدمو مجموعين: اكتشف الحوايج لي كيتلفو فـ لغز الصوت والضو، وتصنت لروايات مختلفة من أسطورة لوريلاي.",
	["quest.DE02.completion"] = "كملتي الفصل DE02! ربحتي حجر أغنية لوريلاي.",
	["quest.DE02.source_note"] = "هادشي جاي من الأدب: عمل من الخيال، ماشي تسجيل لأحداث حقيقية.",
	["artifact.de_lorelei_songstone.name"] = "حجر أغنية لوريلاي",
	["quest.DE03.title"] = "اختيار الملاح",
	["quest.DE03.summary"] = "عاون باطو باش يوصل لمكان آمن بالتركيز على الإشارات الحقيقية وتفادي الصدى لي كيتلف",
	["quest.DE03.greeting"] = "مرحبا بيك فـ اختيار الملاح! يلاه نخدمو مجموعين: عاون باطو باش يوصل لمكان آمن بالتركيز على الإشارات الحقيقية وتفادي الصدى لي كيتلف.",
	["quest.DE03.completion"] = "كملتي الفصل DE03! ربحتي الدفة الثابتة.",
	["quest.DE03.source_note"] = "هاد النشاط تخترع خصيصاً لهاد اللعبة باش يعاون فـ حكي القصة.",
	["artifact.de_steady_helm.name"] = "الدفة الثابتة",
	["quest.DE04.title"] = "قاعة الغرال الهادئة",
	["quest.DE04.summary"] = "استكشف قلعة أسطورية ورد البال بلي كاين شخص محتاج مساعدة",
	["quest.DE04.greeting"] = "مرحبا بيك فـ قاعة الغرال الهادئة! يلاه نخدمو مجموعين: استكشف قلعة أسطورية ورد البال بلي كاين شخص محتاج مساعدة.",
