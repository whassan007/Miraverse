	["quest.UA03.source_note"] = "يستند هذا الفصل إلى تقاليد حيّة لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.ua_bandura_string.name"] = "وتر الباندورا",
	["quest.UA04.title"] = "دفتر قصائد الدومي",
	["quest.UA04.summary"] = "اجمع مقاطع القصة ورتّبها، مميزاً بين الذاكرة الشفهية والأحداث الموثقة",
	["quest.UA04.greeting"] = "أهلاً بك في دفتر قصائد الدومي! دعنا نعمل معاً: اجمع مقاطع القصة ورتّبها، مميزاً بين الذاكرة الشفهية والأحداث الموثقة.",
	["quest.UA04.completion"] = "اكتمل الفصل UA04! لقد حصلت على صفحة قصائد الدومي.",
	["quest.UA04.source_note"] = "يعتمد هذا الفصل على تاريخ حقيقي، مع بعض التفاصيل الخيالية المبتكرة من أجل اللعبة.",
	["artifact.ua_dumy_page.name"] = "صفحة أغاني الدومي",
	["quest.UA05.title"] = "قاعة الموسيقى الحية",
	["quest.UA05.summary"] = "أصلح مكان العروض واعرض الآلات الموسيقية مع بطاقات تعريفية",
	["quest.UA05.greeting"] = "أهلاً بك في قاعة الموسيقى الحية! هيا نعمل معاً: أصلح مكان العروض واعرض الآلات الموسيقية مع بطاقات تعريفية.",
	["quest.UA05.completion"] = "اكتمل الفصل UA05! لقد حصلت على حامل نوتة موسيقية منحوت.",
	["quest.UA05.source_note"] = "يستند هذا الفصل إلى تقاليد حية لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.ua_carved_music_stand.name"] = "حامل نوتة موسيقية منحوت",
	["quest.UA06.title"] = "أغانٍ تسافر",
	["quest.UA06.summary"] = "تعاون في ابتكار لحن أو إيقاع جديد وأنشئ أرشيفاً للمجتمع",
	["quest.UA06.greeting"] = "أهلاً بك في أغانٍ تسافر! هيا نعمل معاً: تعاون في ابتكار لحن أو إيقاع جديد وأنشئ أرشيفاً للمجتمع.",
	["quest.UA06.completion"] = "اكتمل الفصل UA06! لقد حصلت على طابع أغنية أوكرانيا.",
	["quest.UA06.source_note"] = "يستند هذا الفصل إلى تقاليد حية لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
