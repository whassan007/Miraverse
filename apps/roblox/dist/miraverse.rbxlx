	["artifact.de_lorelei_songstone.name"] = "حجر أغنية لوريلاي",
	["quest.DE03.title"] = "اختيار الملاح",
	["quest.DE03.summary"] = "ساعد المركب توصل لبر الأمان عن طريق التركيز على الإشارات الحقيقية بدل صدى الصوت اللي بيشتت",
	["quest.DE03.greeting"] = "أهلاً بيك في اختيار الملاح! يلا نشتغل سوا: ساعد المركب توصل لبر الأمان عن طريق التركيز على الإشارات الحقيقية بدل صدى الصوت اللي بيشتت.",
