	["country.MA.name"] = "المغرب (مراكش / ساحة مستوحاة من جامع الفنا)",
	["country.MA.story"] = "الحلقة الحية",
	["country.MA.cultural_warning"] = "Al Halqa is a living performance tradition, not one fixed text. Cultural/religious stories, including the Seven Saints, must be reviewed and presented respectfully without assigning sacred characters arbitrary game powers.",
	["artifact.ma_storytellers_circle_drum.name"] = "طبل حلقة الحكواتي",
	["vocab.MA.halqa"] = "حلقة (ḥalqa) — دائرة تفاعلية من الجمهور تجتمع حول الحكواتي",
	["vocab.MA.atay"] = "أتاي (atāy) — شاي أخضر مغربي مُنكّه بالنعناع الطازج",
	["vocab.MA.zellij"] = "زليج (zallīj) — بلاط خزفي هندسي مقطوع يدوياً",
	["npc.ma_hakawati_driss.name"] = "الحكواتي المعلم إدريس",
	["npc.ma_tea_host_kenza.name"] = "لالة كنزة مضيفة أتاي",
