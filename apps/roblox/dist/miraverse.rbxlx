	["artifact.ma_story_thread.name"] = "خيط الحكاية",
	["quest.MA05.title"] = "مسارات الحكمة",
	["quest.MA05.summary"] = "استكشف خريطة تراثية مليانة احترام، مستوحاة من حكايات أولياء مراكش السبعة",
	["quest.MA05.greeting"] = "أهلاً بيك في مسارات الحكمة! يلا نشتغل مع بعض: استكشف خريطة تراثية مليانة احترام، مستوحاة من حكايات أولياء مراكش السبعة.",
