              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "لبنان (بيبلوس/جبيل)",
	["country.LB.story"] = "مرسى الحكايات العائدة",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "صندوق ذكريات الأرز والبحر",
	["vocab.LB.saj"] = "صاج (ṣāj) — صفيحة دائرية مقوسة كيتخبز عليها الخبز الرقيق",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — خليط منسم من الزعتر البري والجلجلان والسماق",
	["vocab.LB.mina"] = "مينا (mīnā) — مرسى ساحلي ورصيف حجري للبواخر",
	["npc.lb_teta_nahla.name"] = "تيتا نهلة",
	["npc.lb_archivist_rami.name"] = "الأرشيفي الشاب رامي",
	["npc.lb_captain_faris.name"] = "قبطان المرسى فارس",
	["npc.lb_baker_tariq.name"] = "الخباز طارق",
	["npc.lb_artisan_nadia.name"] = "الحرفية نادية",
	["quest.LB01.title"] = "المرسى كيفيق",
	["quest.LB01.summary"] = "تبع الأرصفة اللي مضوية بالفوانيس، جمع لوازم المرسى، وقاد طريق آمن للمشي",
	["quest.LB01.greeting"] = "مرحباً بيك فـ المرسى كيفيق! يالاه نتعاونو: تبع الأرصفة اللي مضوية بالفوانيس، جمع لوازم المرسى، وقاد طريق آمن للمشي.",
	["quest.LB01.completion"] = "كمل الفصل LB01! ربحتي بوصلة المرسى.",
	["quest.LB01.source_note"] = "هاد الفصل مستلهم من تقاليد حية باقين العائلات كيمارسوها لليوم، وتقدر تختلف من دار لدار.",
	["artifact.lb_harbor_compass.name"] = "بوصلة المرسى",
	["quest.LB02.title"] = "حروف فالحجر",
	["quest.LB02.summary"] = "طابق أشكال الحروف المستوحاة من الفينيقية مع بطاقات التجارة، وعاود ركب لوحة منقوشة صغيرة",
	["quest.LB02.greeting"] = "مرحباً بيك فـ حروف فالحجر! يالاه نتعاونو: طابق أشكال الحروف المستوحاة من الفينيقية مع بطاقات التجارة، وعاود ركب لوحة منقوشة صغيرة.",
	["quest.LB02.completion"] = "كملتي الفصل LB02! ربحتي قطعة الحروف الأبجدية.",
	["quest.LB02.source_note"] = "هاد الفصل مبني على تاريخ حقيقي، مع بعض التفاصيل اللي تخيلناها على قبل اللعبة.",
	["artifact.lb_alphabet_tile.name"] = "قطعة الحروف الأبجدية",
	["quest.LB03.title"] = "طبلة تيتة",
	["quest.LB03.summary"] = "جمع الزعتر والمكونات، شطّر فالسوق، ووجد المنقوشة بعافية تجريبية وتحت المراقبة",
	["quest.LB03.greeting"] = "مرحبا بك فـ طبلة تيتة! يلا نتعاونو مجموعين: جمع الزعتر والمكونات، شطّر فالسوق، ووجد المنقوشة بعافية تجريبية وتحت المراقبة.",
	["quest.LB03.completion"] = "كملتي الفصل LB03! ربحتي بطاقة وصفة العائلة.",
	["quest.LB03.source_note"] = "هاد الفصل مستوحى من تقاليد حية كيديروها العائلات حتى لليوم. وتقدر تختلف من دار لدار.",
	["artifact.lb_family_recipe_card.name"] = "بطاقة وصفة العائلة",
	["quest.LB04.title"] = "صندوق الأرز",
	["quest.LB04.summary"] = "استكشف صندوق ديال خشب الأرز مستوحى من الأساطير، وقارن بين الخرافة والأدلة التاريخية",
	["quest.LB04.greeting"] = "مرحبا بك فـ صندوق الأرز! يلا نتعاونو مجموعين: استكشف صندوق ديال خشب الأرز مستوحى من الأساطير، وقارن بين الخرافة والأدلة التاريخية.",
	["quest.LB04.completion"] = "كملتي الفصل LB04! ربحتي رمز الأرز.",
	["quest.LB04.source_note"] = "هادشي جاي من الفلكلور: قصص كتعاود بروايات كتيرة، وماشي تسجيل لأحداث حقيقية وقعات.",
	["artifact.lb_cedar_token.name"] = "رمز الأرز",
	["quest.LB05.title"] = "تصاور عبر البحر",
	["quest.LB05.summary"] = "دير حوار مع شخصيات عائلية خيالية، رتب تصاور بالتواريخ ديالهم، ونظم معرض كيحترم خصوصية وموافقة الجميع",
	["quest.LB05.greeting"] = "مرحبا بك فـ تصاور عبر البحر! يلا نتعاونو مجموعين: دير حوار مع شخصيات عائلية خيالية، رتب تصاور بالتواريخ ديالهم، ونظم معرض كيحترم خصوصية وموافقة الجميع.",
	["quest.LB05.completion"] = "كملتي الفصل LB05! ربحتي ألبوم الأرشيف.",
	["quest.LB05.source_note"] = "هاد النشاط تخيلناه وصنعناه للعبة باش يعاون فمعاودة القصة.",
	["artifact.lb_archive_album.name"] = "ألبوم الأرشيف",
	["quest.LB06.title"] = "مهرجان الرجوع",
	["quest.LB06.summary"] = "صلّح ساحة التجمع، وجد وليمة تعاونية، وعاود قصة عائلية جديدة",
	["quest.LB06.greeting"] = "مرحبا بك فـ مهرجان الرجوع! يلا نتعاونو مجموعين: صلّح ساحة التجمع، وجد وليمة تعاونية، وعاود قصة عائلية جديدة.",
	["quest.LB06.completion"] = "كملتي الفصل LB06! ربحتي طابع دار المرسى.",
	["quest.LB06.source_note"] = "هاد الفصل مستوحى من تقاليد حية كيديروها العائلات حتى لليوم. وتقدر تختلف من دار لدار.",
	["artifact.lb_harbor_home_stamp.name"] = "طابع دار المرسى",
	["country.IQ.name"] = "العراق (بغداد)",
	["country.IQ.story"] = "المكتبة اللي كتسافر",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "كتاب بيت الحكمة",
