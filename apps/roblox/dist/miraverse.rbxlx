              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "لبنان (جبيل / بيبلوس)",
	["country.LB.story"] = "مرفأ الحكايات العائدة",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "صندوق ذكريات الأرز والبحر",
	["vocab.LB.saj"] = "صاج (ṣāj) — صفيحة مقببة لخبز الخبز الرقيق",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — خلطة عطرية من الزعتر البري والسمسم والسماق",
	["vocab.LB.mina"] = "مينا (mīnā) — مرفأ ساحلي ورصيف حجري",
	["npc.lb_teta_nahla.name"] = "تيتا نهلة",
	["npc.lb_archivist_rami.name"] = "الأرشيفي الشاب رامي",
	["npc.lb_captain_faris.name"] = "قبطان المرفأ فارس",
	["npc.lb_baker_tariq.name"] = "الخبّاز طارق",
	["npc.lb_artisan_nadia.name"] = "حرفية النقش نادية",
	["quest.LB01.title"] = "المرفأ يستيقظ",
	["quest.LB01.summary"] = "اتبع الأرصفة المضاءة بالفوانيس، واجمع مؤن المرفأ، وأصلح ممشى آمناً",
	["quest.LB01.greeting"] = "مرحباً بك في «المرفأ يستيقظ»! هيا نعمل معاً: اتبع الأرصفة المضاءة بالفوانيس، واجمع مؤن المرفأ، وأصلح ممشى آمناً.",
	["quest.LB01.completion"] = "اكتمل الفصل LB01! لقد حصلت على بوصلة المرفأ.",
	["quest.LB01.source_note"] = "يستند هذا الفصل إلى تقاليد حيّة لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.lb_harbor_compass.name"] = "بوصلة المرفأ",
	["quest.LB02.title"] = "حروف على الحجر",
	["quest.LB02.summary"] = "طابق نقوش الحروف المستوحاة من الفينيقية بملصقات التجارة، وأعد تركيب لافتة منقوشة صغيرة",
	["quest.LB02.greeting"] = "مرحباً بك في «حروف على الحجر»! هيا نعمل معاً: طابق نقوش الحروف المستوحاة من الفينيقية بملصقات التجارة، وأعد تركيب لافتة منقوشة صغيرة.",
	["quest.LB02.completion"] = "اكتمل الفصل LB02! لقد حصلت على بلاطة الأبجدية.",
	["quest.LB02.source_note"] = "يستند هذا الفصل إلى تاريخ حقيقي، مع بعض التفاصيل الخيالية التي أُضيفت من أجل اللعبة.",
	["artifact.lb_alphabet_tile.name"] = "بلاطة الأبجدية",
	["quest.LB03.title"] = "مائدة تيتا",
	["quest.LB03.summary"] = "اجمع الزعتر والمكونات، وفاوض في السوق، وحضّر المنقوشة بحرارة محاكاة تحت الإشراف",
	["quest.LB03.greeting"] = "أهلاً بك في مائدة تيتا! هيا نعمل معاً: اجمع الزعتر والمكونات، وفاوض في السوق، وحضّر المنقوشة بحرارة محاكاة تحت الإشراف.",
	["quest.LB03.completion"] = "اكتمل الفصل LB03! لقد حصلت على بطاقة وصفة العائلة.",
	["quest.LB03.source_note"] = "يستند هذا الفصل إلى تقاليد حية لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.lb_family_recipe_card.name"] = "بطاقة وصفة العائلة",
	["quest.LB04.title"] = "صندوق الأرز",
	["quest.LB04.summary"] = "استكشف صندوقاً من خشب الأرز مستوحى من الأساطير، وقارن بين الأسطورة والأدلة التاريخية",
	["quest.LB04.greeting"] = "أهلاً بك في صندوق الأرز! هيا نعمل معاً: استكشف صندوقاً من خشب الأرز مستوحى من الأساطير، وقارن بين الأسطورة والأدلة التاريخية.",
	["quest.LB04.completion"] = "اكتمل الفصل LB04! لقد حصلت على رمز الأرز.",
	["quest.LB04.source_note"] = "هذا مأخوذ من الفلكلور: قصص تُروى بروايات متعددة، وليست توثيقاً لأحداث حقيقية.",
	["artifact.lb_cedar_token.name"] = "رمز الأرز",
	["quest.LB05.title"] = "صور عبر البحر",
	["quest.LB05.summary"] = "حاور شخصيات عائلية خيالية، ورتّب صوراً مؤرخة، ونظّم معرضاً يراعي الخصوصية والموافقة",
	["quest.LB05.greeting"] = "أهلاً بك في صور عبر البحر! هيا نعمل معاً: حاور شخصيات عائلية خيالية، ورتّب صوراً مؤرخة، ونظّم معرضاً يراعي الخصوصية والموافقة.",
	["quest.LB05.completion"] = "اكتمل الفصل LB05! لقد حصلت على ألبوم الأرشيف.",
	["quest.LB05.source_note"] = "تم ابتكار هذا النشاط للعبة للمساعدة في سرد القصة.",
	["artifact.lb_archive_album.name"] = "ألبوم الأرشيف",
	["quest.LB06.title"] = "مهرجان العودة",
	["quest.LB06.summary"] = "أعد إحياء ساحة التجمع، ورتّب وليمة تشاركية، واروِ قصة عائلية جديدة",
	["quest.LB06.greeting"] = "أهلاً بك في مهرجان العودة! هيا نعمل معاً: أعد إحياء ساحة التجمع، ورتّب وليمة تشاركية، واروِ قصة عائلية جديدة.",
	["quest.LB06.completion"] = "اكتمل الفصل LB06! لقد حصلت على طابع بيت المرفأ.",
	["quest.LB06.source_note"] = "يستند هذا الفصل إلى تقاليد حية لا تزال العائلات تمارسها حتى اليوم، وقد تختلف من بيت إلى آخر.",
	["artifact.lb_harbor_home_stamp.name"] = "طابع بيت المرفأ",
	["country.IQ.name"] = "العراق (بغداد)",
