	["quest.RU01.title"] = "黎明钟声",
	["quest.RU01.summary"] = "寻找湖岸的声音标记，修复村庄里的大钟",
	["quest.RU01.greeting"] = "欢迎来到《黎明钟声》！让我们一起合作：寻找湖岸的声音标记，修复村庄里的大钟吧。",
	["quest.RU01.completion"] = "章节 RU01 已完成！你获得了湖钟碎片。",
	["quest.RU01.source_note"] = "这源自民间传说：是流传着许多版本的故事，并不是真实事件的记录哦。",
	["artifact.ru_lake_bell_fragment.name"] = "湖钟碎片",
	["quest.RU02.title"] = "倒影之城",
	["quest.RU02.summary"] = "探索随水面倒影而变化的神奇幻景",
	["quest.RU02.greeting"] = "欢迎来到《倒影之城》！让我们一起合作：探索随水面倒影而变化的神奇幻景吧。",
	["quest.RU02.completion"] = "章节 RU02 已完成！你获得了倒影棱镜。",
	["quest.RU02.source_note"] = "这来自于民间传说：故事有着许多不同版本，并不是对真实事件的记录。",
	["artifact.ru_reflection_prism.name"] = "倒影棱镜",
	["quest.RU03.title"] = "萨德阔的琴弦",
	["quest.RU03.summary"] = "来玩一个受民间传说音乐家萨德阔启发的节奏解谜游戏吧",
	["quest.RU03.greeting"] = "欢迎来到萨德阔的琴弦！让我们一起合作：玩一个受民间传说音乐家萨德阔启发的节奏解谜游戏吧。",
	["quest.RU03.completion"] = "RU03 章节完成！你获得了古斯里琴护身符。",
	["quest.RU03.source_note"] = "这来自于民间传说：故事有着许多不同版本，并不是对真实事件的记录。",
	["artifact.ru_gusli_charm.name"] = "古斯里琴护身符",
	["quest.RU04.title"] = "水上花园",
	["quest.RU04.summary"] = "在不破坏生态环境的前提下，帮忙打造一座宁静的湖畔花园",
	["quest.RU04.greeting"] = "欢迎来到水上花园！让我们一起合作：在不破坏生态环境的前提下，帮忙打造一座宁静的湖畔花园。",
	["quest.RU04.completion"] = "RU04 章节完成！你获得了芦苇花环。",
	["quest.RU04.source_note"] = "本章取材于许多家庭至今仍在延续的生活传统。各个家庭的传统可能会有所不同。",
	["artifact.ru_reed_wreath.name"] = "芦苇花环",
	["quest.RU05.title"] = "故事守护者",
	["quest.RU05.summary"] = "在当地档案馆里记录基杰日故事的不同版本",
	["quest.RU05.greeting"] = "欢迎来到故事守护者！让我们一起合作：在当地档案馆里记录基杰日故事的不同版本。",
	["quest.RU05.completion"] = "RU05 章节完成！你获得了传说册页。",
	["quest.RU05.source_note"] = "这来自于民间传说：故事有着许多不同版本，并不是对真实事件的记录。",
	["artifact.ru_legend_folio.name"] = "传说册页",
	["quest.RU06.title"] = "水面之上的故事",
	["quest.RU06.summary"] = "建造一座故事亭，并学会区分传统与观察到的事实证据",
	["quest.RU06.greeting"] = "欢迎来到水面之上的故事！让我们一起合作：建造一座故事亭，并学会区分传统与观察到的事实证据。",
	["quest.RU06.completion"] = "RU06 章节完成！你获得了基杰日记忆印章。",
	["quest.RU06.source_note"] = "本章取材于许多家庭至今仍在延续的生活传统。各个家庭的传统可能会有所不同。",
