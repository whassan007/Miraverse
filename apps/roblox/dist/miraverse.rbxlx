            <Properties>
              <string name="Name">fr-CA</string>
              <string name="Source"><![CDATA[-- GENERATED by tools/roblox/compile-atlas.mjs. Do not edit.
return {
	["country.LB.name"] = "Liban (Byblos/Jbeil)",
	["country.LB.story"] = "Le port des histoires retrouvées",
	["country.LB.cultural_warning"] = "The Isis/Osiris journey to Byblos is mythology, not evidence of the historical events; Phoenician writing should be contextualized, not called the single uncontested origin of all alphabets.",
	["artifact.lb_cedar_sea_memory_chest.name"] = "Coffre aux souvenirs de cèdre et de mer",
	["vocab.LB.saj"] = "صاج (ṣāj) — Plaque bombée pour cuire le pain plat",
	["vocab.LB.zaatar"] = "زعتر (za'tar) — Mélange parfumé de thym sauvage, de sésame et de sumac",
	["vocab.LB.mina"] = "مينا (mīnā) — Port côtier et quai de pierre",
	["npc.lb_teta_nahla.name"] = "Teta Nahla (تيتا نهلة)",
	["npc.lb_archivist_rami.name"] = "Jeune archiviste Rami (الأرشيفي رامي)",
	["npc.lb_captain_faris.name"] = "Capitaine du port Faris (القبطان فارس)",
	["npc.lb_baker_tariq.name"] = "Boulanger Tariq (الخبّاز طارق)",
	["npc.lb_artisan_nadia.name"] = "Artisane de l'écriture Nadia (الحرفية نادية)",
	["quest.LB01.title"] = "Le port se réveille",
	["quest.LB01.summary"] = "Suis les quais éclairés par des lanternes, rassemble des fournitures du port et répare un sentier sécuritaire",
	["quest.LB01.greeting"] = "Bienvenue dans Le port se réveille! Travaillons ensemble : suis les quais éclairés par des lanternes, rassemble des fournitures du port et répare un sentier sécuritaire.",
	["quest.LB01.completion"] = "Chapitre LB01 terminé! Tu as obtenu la Boussole du port.",
	["quest.LB01.source_note"] = "Ce chapitre s'inspire de traditions vivantes que des familles pratiquent encore aujourd'hui. Elles peuvent varier d'une maison à l'autre.",
	["artifact.lb_harbor_compass.name"] = "Boussole du port",
	["quest.LB02.title"] = "Des lettres dans la pierre",
	["quest.LB02.summary"] = "Associe des motifs de lettres d'inspiration phénicienne à des étiquettes de commerce; reconstitue un petit panneau gravé",
	["quest.LB02.greeting"] = "Bienvenue dans Des lettres dans la pierre! Travaillons ensemble : associe des motifs de lettres d'inspiration phénicienne à des étiquettes de commerce; reconstitue un petit panneau gravé.",
	["quest.LB02.completion"] = "Chapitre LB02 terminé ! Tu as gagné Tuile de l'alphabet.",
	["quest.LB02.source_note"] = "Ce chapitre s'inspire de la véritable histoire, avec certains détails imaginés pour le jeu.",
	["artifact.lb_alphabet_tile.name"] = "Tuile de l'alphabet",
	["quest.LB03.title"] = "La table de Teta",
	["quest.LB03.summary"] = "Rassemble du zaatar et des ingrédients, négocie au marché et prépare une man’ouché avec une chaleur simulée et supervisée",
	["quest.LB03.greeting"] = "Bienvenue à La table de Teta ! Travaillons ensemble : rassemble du zaatar et des ingrédients, négocie au marché et prépare une man’ouché avec une chaleur simulée et supervisée.",
	["quest.LB03.completion"] = "Chapitre LB03 terminé ! Tu as gagné Fiche de recette familiale.",
	["quest.LB03.source_note"] = "Ce chapitre s'inspire de traditions vivantes que des familles pratiquent encore aujourd'hui. Elles peuvent varier d'une maison à l'autre.",
	["artifact.lb_family_recipe_card.name"] = "Fiche de recette familiale",
	["quest.LB04.title"] = "Le coffre en cèdre",
	["quest.LB04.summary"] = "Examine un coffre en cèdre inspiré d'un mythe et compare la légende aux preuves historiques",
	["quest.LB04.greeting"] = "Bienvenue à Le coffre en cèdre ! Travaillons ensemble : examine un coffre en cèdre inspiré d'un mythe et compare la légende aux preuves historiques.",
	["quest.LB04.completion"] = "Chapitre LB04 terminé ! Tu as gagné Jeton de cèdre.",
	["quest.LB04.source_note"] = "Cela provient du folklore : des histoires racontées sous plusieurs versions, et non le récit d'événements réels.",
	["artifact.lb_cedar_token.name"] = "Jeton de cèdre",
	["quest.LB05.title"] = "Photos par-delà la mer",
	["quest.LB05.summary"] = "Passe en entrevue des personnages familiaux fictifs, classe des photos par date et organise une exposition respectueuse du consentement",
	["quest.LB05.greeting"] = "Bienvenue à Photos par-delà la mer ! Travaillons ensemble : passe en entrevue des personnages familiaux fictifs, classe des photos par date et organise une exposition respectueuse du consentement.",
	["quest.LB05.completion"] = "Chapitre LB05 terminé ! Tu as gagné Album d'archives.",
	["quest.LB05.source_note"] = "Cette activité a été inventée pour le jeu afin d'aider à raconter l'histoire.",
	["artifact.lb_archive_album.name"] = "Album d'archives",
	["quest.LB06.title"] = "Festival du retour",
	["quest.LB06.summary"] = "Restaure la place de rassemblement, organise un grand festin communautaire et raconte une nouvelle histoire de famille",
	["quest.LB06.greeting"] = "Bienvenue au Festival du retour ! Travaillons ensemble : restaure la place de rassemblement, organise un grand festin communautaire et raconte une nouvelle histoire de famille.",
	["quest.LB06.completion"] = "Chapitre LB06 terminé ! Tu as gagné Timbre du port d'attache.",
	["quest.LB06.source_note"] = "Ce chapitre s'inspire de traditions vivantes que des familles pratiquent encore aujourd'hui. Elles peuvent varier d'une maison à l'autre.",
	["artifact.lb_harbor_home_stamp.name"] = "Timbre du port d'attache",
	["country.IQ.name"] = "Irak (Bagdad)",
	["country.IQ.story"] = "La bibliothèque qui voyage",
	["country.IQ.cultural_warning"] = "Present Bayt al-Hikma as historical scholarship with limits of reconstruction. Modern Al-Mutanabbi Street events must be handled sensitively; avoid violent reenactments and conflating Abbasid Baghdad with today.",
	["artifact.iq_house_of_wisdom_book.name"] = "Livre de la Maison de la sagesse",
	["vocab.IQ.shanasheel"] = "شناشيل (shanāshīl) — Balcon en treillis de bois sculpté surplombant la rue",
	["vocab.IQ.kleicha"] = "كليجة (klīcha) — Pâtisserie aux dattes parfumée à la cardamome partagée lors des fêtes",
	["vocab.IQ.hikma"] = "حكمة (ḥikma) — Sagesse et recherche partagée du savoir",
	["npc.iq_bibi_amal.name"] = "Bibi Amal (بيبي أمل)",
	["npc.iq_merchant_hassan.name"] = "Marchand de livres Hassan (الكتبي حسان)",
	["npc.iq_translator_mariam.name"] = "Traductrice Mariam (المترجمة مريم)",
	["npc.iq_baker_salim.name"] = "Boulanger Salim (الخبّاز سليم)",
	["npc.iq_astronomer_zaid.name"] = "Apprenti astronome Zaid (الفلكي زيد)",
	["quest.IQ01.title"] = "La rue des livres",
	["quest.IQ01.summary"] = "Ouvre les volets, rapporte les livres éparpillés aux marchands et cartographie les étagères",
	["quest.IQ01.greeting"] = "Bienvenue dans La rue des livres! Travaillons ensemble : ouvre les volets, rapporte les livres éparpillés aux marchands et cartographie les étagères.",
	["quest.IQ01.completion"] = "Chapitre IQ01 terminé! Tu as obtenu le Sceau du libraire.",
	["quest.IQ01.source_note"] = "Ce chapitre s'inspire de traditions vivantes que des familles pratiquent encore aujourd'hui. Elles peuvent varier d'une maison à l'autre.",
	["artifact.iq_bookseller_seal.name"] = "Sceau du libraire",
	["quest.IQ02.title"] = "La Maison de la sagesse",
	["quest.IQ02.summary"] = "Rassemble des outils de mathématiques et aide à restaurer une salle de savants",
	["quest.IQ02.greeting"] = "Bienvenue à La Maison de la sagesse! Travaillons ensemble : rassemble des outils de mathématiques et aide à restaurer une salle de savants.",
	["quest.IQ02.completion"] = "Chapitre IQ02 terminé! Tu as obtenu l'Astrolabe du savant.",
	["quest.IQ02.source_note"] = "Ce chapitre est basé sur l'histoire réelle, avec quelques détails imaginés pour le jeu.",
	["artifact.iq_scholars_astrolabe.name"] = "Astrolabe du savant",
	["quest.IQ03.title"] = "Les mots qui voyagent",
	["quest.IQ03.summary"] = "Associe des traductions de concepts d'origine arabe, grecque et syriaque à leurs étiquettes de provenance",
	["quest.IQ03.greeting"] = "Bienvenue dans Les mots qui voyagent! Travaillons ensemble : associe des traductions de concepts d'origine arabe, grecque et syriaque à leurs étiquettes de provenance.",
	["quest.IQ03.completion"] = "Chapitre IQ03 terminé! Tu as obtenu le Rouleau de traduction.",
	["quest.IQ03.source_note"] = "Ce chapitre est basé sur l'histoire réelle, avec quelques détails imaginés pour le jeu.",
	["artifact.iq_translation_scroll.name"] = "Rouleau de traduction",
	["quest.IQ04.title"] = "Dattes et kleicha",
	["quest.IQ04.summary"] = "Récolte des dattes, échange des épices et complète une séquence de pâtisserie en famille",
	["quest.IQ04.greeting"] = "Bienvenue dans Dattes et kleicha! Travaillons ensemble : récolte des dattes, échange des épices et complète une séquence de pâtisserie en famille.",
