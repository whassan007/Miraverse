	["country.UA.name"] = "乌克兰（基辅建城山丘 / 社区音乐广场）",
	["country.UA.story"] = "歌谣守护者",
	["country.UA.cultural_warning"] = "The Kyiv founders are chronicle legends. Kobzar traditions are varied; do not imply all practitioners were blind or use disability as a supernatural device. No graphic violence or combat reenactment.",
	["artifact.ua_bandura_memory_charm.name"] = "班杜拉琴记忆护身符",
	["vocab.UA.bandura"] = "бандура (bandúra) — 融合了鲁特琴与竖琴元素的乌克兰弹拨乐器",
	["vocab.UA.dumy"] = "думи (dúmy) — 传承口头文化记忆的吟唱史诗",
	["vocab.UA.toloka"] = "толока (tolóka) — 齐心协力共同建造或修缮的社区互助集会",
	["npc.ua_guide_lybid.name"] = "向导奥莱娜（雷比季路线）(Провідниця Олена)",
	["npc.ua_storyteller_taras.name"] = "历史说书人塔拉斯 (Оповідач Тарас)",
	["npc.ua_kobzar_mykola.name"] = "音乐家米科拉 (Кобзар Микола)",
	["npc.ua_maker_solomiya.name"] = "乐器制作师索洛米娅 (Майстриня Соломія)",
	["npc.ua_curator_kateryna.name"] = "策展人卡捷琳娜 (Кураторка Катерина)",
	["quest.UA01.title"] = "四位建城者",
	["quest.UA01.summary"] = "一边探索三座小山和一条河流，一边拼出建城传说的地图",
	["quest.UA01.greeting"] = "欢迎来到《四位建城者》！让我们一起合作：一边探索三座小山和一条河流，一边拼出建城传说的地图吧。",
	["quest.UA01.completion"] = "UA01 章节已完成！你获得了“建城者河流地图”。",
	["quest.UA01.source_note"] = "这来自民间传说：是由人们口口相传、有着许多不同版本的故事，并不是对真实历史事件的记录。",
	["artifact.ua_founders_river_map.name"] = "建城者河流地图",
	["quest.UA02.title"] = "水畔之城",
	["quest.UA02.summary"] = "收集木材和石块，修复一座方便大家通行的无障碍步行桥",
	["quest.UA02.greeting"] = "欢迎来到《水畔之城》！让我们一起合作：收集木材和石块，修复一座方便大家通行的无障碍步行桥吧。",
	["quest.UA02.completion"] = "UA02 章节已完成！你获得了“河桥铭牌”。",
	["quest.UA02.source_note"] = "这一章取材于至今仍活跃在许多家庭中的生活传统。每个家庭的做法都可能各有不同。",
	["artifact.ua_river_bridge_plaque.name"] = "河桥铭牌",
	["quest.UA03.title"] = "倾听科布扎尔",
	["quest.UA03.summary"] = "学习专注礼貌地聆听音乐，并体验呼应问答的音乐互动",
	["quest.UA03.greeting"] = "欢迎来到《倾听科布扎尔》！让我们一起合作：学习专注礼貌地聆听音乐，并体验呼应问答的音乐互动吧。",
	["quest.UA03.completion"] = "UA03 章节已完成！你获得了“班杜拉琴弦”。",
	["quest.UA03.source_note"] = "这一章取材于至今仍活跃在许多家庭中的生活传统。每个家庭的做法都可能各有不同。",
	["artifact.ua_bandura_string.name"] = "班杜拉琴弦",
	["quest.UA04.title"] = "杜马笔记本",
	["quest.UA04.summary"] = "收集并整理故事诗节，把口传的记忆与有文献记录的史实区分开来",
	["quest.UA04.greeting"] = "欢迎来到《杜马笔记本》！让我们一起合作：收集并整理故事诗节，把口传的记忆与有文献记录的史实区分开来吧。",
	["quest.UA04.completion"] = "UA04 章节已完成！你获得了“杜马诗页”。",
	["quest.UA04.source_note"] = "这一章基于真实历史，其中部分细节是专为游戏创作的虚构想象。",
	["artifact.ua_dumy_page.name"] = "杜马诗页",
	["quest.UA05.title"] = "充满生机的音乐厅",
	["quest.UA05.summary"] = "修缮演出场地，并给展出的乐器贴上说明标签",
	["quest.UA05.greeting"] = "欢迎来到《充满生机的音乐厅》！让我们一起合作：修缮演出场地，并给展出的乐器贴上说明标签吧。",
	["quest.UA05.completion"] = "第 UA05 章完成！你获得了雕花乐谱架。",
	["quest.UA05.source_note"] = "这一章取材于今天仍有家庭在延续的生活传统。不同家庭的做法可能会有所不同。",
	["artifact.ua_carved_music_stand.name"] = "雕花乐谱架",
	["quest.UA06.title"] = "传唱四方的歌",
	["quest.UA06.summary"] = "合作创作一段全新的旋律或节奏，并建立一个社区档案",
	["quest.UA06.greeting"] = "欢迎来到“传唱四方的歌”！让我们一起合作：合作创作一段全新的旋律或节奏，并建立一个社区档案。",
	["quest.UA06.completion"] = "第 UA06 章完成！你获得了乌克兰歌曲印章。",
