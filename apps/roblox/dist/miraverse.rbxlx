	["quest.UA01.title"] = "المؤسسون الأربعة",
	["quest.UA01.summary"] = "استكشف تلال ثلاثة ونهر وأنت تركّب خريطة أسطورة تأسيس المدينة",
	["quest.UA01.greeting"] = "أهلاً بيك بمغامرة المؤسسون الأربعة! تعال نشتغل سوة: استكشف تلال ثلاثة ونهر وأنت تركّب خريطة أسطورة تأسيس المدينة.",
	["quest.UA01.completion"] = "اكتمل الفصل UA01! حصلت على خريطة نهر المؤسسين.",
	["quest.UA01.source_note"] = "هذا مأخوذ من الفولكلور والتراث الشعبي: قصص تناقلوها الناس بروايات مختلفة، مو تسجيل لأحداث حقيقية.",
	["artifact.ua_founders_river_map.name"] = "خريطة نهر المؤسسين",
	["quest.UA02.title"] = "المدينة اللي يم المي",
	["quest.UA02.summary"] = "اجمع خشب وحجر حتى نصلّح جسر مشاة مريح يكدر الكل يعبر عليه بسهولة",
	["quest.UA02.greeting"] = "أهلاً بيك بالمدينة اللي يم المي! تعال نشتغل سوة: اجمع خشب وحجر حتى نصلّح جسر مشاة مريح يكدر الكل يعبر عليه بسهولة.",
