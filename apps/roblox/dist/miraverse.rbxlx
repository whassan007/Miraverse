	["artifact.de_rhine_route_map.name"] = "莱茵河航线图",
	["quest.DE02.title"] = "魔力歌声",
	["quest.DE02.summary"] = "在声光谜题中分辨干扰物，聆听不同版本的罗蕾莱传说",
	["quest.DE02.greeting"] = "欢迎来到魔力歌声！让我们携手合作：在声光谜题中分辨干扰物，聆听不同版本的罗蕾莱传说。",
	["quest.DE02.completion"] = "DE02章节完成！你获得了罗蕾莱歌之石。",
