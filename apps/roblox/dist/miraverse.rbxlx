	["artifact.cn_season_wheel.name"] = "عجلة الفصول",
	["quest.CN04.title"] = "طريق يتحرك",
	["quest.CN04.summary"] = "حاول تتبّع مسار متغير واكتشف لماذا لم تعد الخريطة المحفوظة في الذاكرة صالحة",
	["quest.CN04.greeting"] = "أهلاً بك في طريق يتحرك! هيا نعمل معاً: حاول تتبّع مسار متغير واكتشف لماذا لم تعد الخريطة المحفوظة في الذاكرة صالحة.",
	["quest.CN04.completion"] = "اكتمل الفصل CN04! لقد حصلت على البوصلة المتغيرة.",
	["quest.CN04.source_note"] = "هذه القصة مستوحاة من الأدب: عمل خيالي وليست تسجيلاً لأحداث حقيقية.",
	["artifact.cn_changing_compass.name"] = "البوصلة المتغيرة",
	["quest.CN05.title"] = "رسائل ضوء القمر",
	["quest.CN05.summary"] = "تعرّف على رواية مناسبة لعمرك لأسطورة تشانغ إي وأعدّ كعكات القمر الرمزية",
	["quest.CN05.greeting"] = "أهلاً بك في رسائل ضوء القمر! هيا نعمل معاً: تعرّف على رواية مناسبة لعمرك لأسطورة تشانغ إي وأعدّ كعكات القمر الرمزية.",
	["quest.CN05.completion"] = "اكتمل الفصل CN05! لقد حصلت على رسالة القمر.",
	["quest.CN05.source_note"] = "هذه القصة مستوحاة من الموروث الشعبي: حكايات تُروى بروايات متعددة وليست تسجيلاً لأحداث حقيقية.",
	["artifact.cn_moon_letter.name"] = "رسالة القمر",
	["quest.CN06.title"] = "ازرع حديقة جديدة",
