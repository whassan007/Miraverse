	["quest.DE01.title"] = "منحنى النهر",
	["quest.DE01.summary"] = "ارسم طريق آمن في نهر الراين باستخدام إشارات الفنار، وحركة التيارات، ورموز الخريطة",
	["quest.DE01.greeting"] = "أهلاً بيك في منحنى النهر! يلا نشتغل سوا: ارسم طريق آمن في نهر الراين باستخدام إشارات الفنار، وحركة التيارات، ورموز الخريطة.",
	["quest.DE01.completion"] = "الفصل DE01 اكتمل! كسبت خريطة مسار نهر الراين.",
	["quest.DE01.source_note"] = "الفصل ده مبني على تاريخ حقيقي، مع شوية تفاصيل من الخيال اتعملت عشان اللعبة.",
	["artifact.de_rhine_route_map.name"] = "خريطة مسار نهر الراين",
	["quest.DE02.title"] = "الأغنية المسحورة",
	["quest.DE02.summary"] = "اكتشف الحاجات اللي بتشتتك في لغز الصوت والضوء، واسمع روايات مختلفة لأسطورة لوريلاي",
	["quest.DE02.greeting"] = "أهلاً بيك في الأغنية المسحورة! يلا نشتغل سوا: اكتشف الحاجات اللي بتشتتك في لغز الصوت والضوء، واسمع روايات مختلفة لأسطورة لوريلاي.",
