	["quest.KR05.title"] = "中庭の職人わざ",
	["quest.KR05.summary"] = "えらんだ木のパーツを使って、ハノク（伝統家屋）を修復しよう",
	["quest.KR05.greeting"] = "「中庭の職人わざ」へようこそ！いっしょにやってみよう。えらんだ木のパーツを使って、ハノク（伝統家屋）を修復しよう。",
	["quest.KR05.completion"] = "チャプターKR05クリア！「木組みのもよう」を手に入れたよ。",
	["quest.KR05.source_note"] = "このチャプターは、今も家族の間で受けつがれている伝統をもとにしているよ。おうちによってやり方が違うこともあるよ。",
	["artifact.kr_joinery_pattern.name"] = "木組みのもよう",
	["quest.KR06.title"] = "みんなで囲むごちそう",
	["quest.KR06.summary"] = "みんなで力を合わせて食事をととのえ、なかまの物語を書こう",
	["quest.KR06.greeting"] = "「みんなで囲むごちそう」へようこそ！いっしょにやってみよう。みんなで力を合わせて食事をととのえ、なかまの物語を書こう。",
	["quest.KR06.completion"] = "チャプターKR06クリア！「チョンジュの調和スタンプ」を手に入れたよ。",
	["quest.KR06.source_note"] = "このチャプターは、今も家族の間で受けつがれている伝統をもとにしているよ。おうちによってやり方が違うこともあるよ。",
	["artifact.kr_jeonju_harmony_stamp.name"] = "チョンジュの調和スタンプ",
	["country.DE.name"] = "ドイツ（ライン川／聖杯伝説の象徴的な風景）",
	["country.DE.story"] = "歌といやしの問いかけ",
	["country.DE.cultural_warning"] = "Lorelei and Parzival are literary/mythic tales and should not be presented as literal history. Remove drowning, trauma and religious coercion from child-facing gameplay; provide respectful historical framing.",
	["artifact.de_compass_of_compassion.name"] = "思いやりのコンパス",
	["vocab.DE.mitgefuehl"] = "Mitgefühl (mit-guh-fuel) — 他の人を思いやり、心を通わせること",
	["vocab.DE.strom"] = "Strom (shtrohm) — 船が行き交う幅の広い川の流れ",
	["vocab.DE.frage"] = "Frage (frah-guh) — 相手を深く理解するための、思いやりのある問いかけ",
	["npc.de_navigator_klara.name"] = "川の水先案内人クラーラ (Flusslotsin Klara)",
	["npc.de_historian_lukas.name"] = "歴史家ルーカス (Historiker Lukas)",
	["npc.de_narrator_lorelei.name"] = "語り部マレーネ (Erzählerin Marlene)",
	["npc.de_parzival.name"] = "旅人パルツィヴァル (Wanderer Parzival)",
	["npc.de_gardener_jonas.name"] = "庭師ヨーナス (Gärtner Jonas)",
	["quest.DE01.title"] = "川の曲がり角",
	["quest.DE01.summary"] = "航路標識や川の流れ、地図の記号を使って、ライン川の安全な航路を調べよう",
	["quest.DE01.greeting"] = "「川の曲がり角」へようこそ！いっしょに力を合わせよう。航路標識や川の流れ、地図の記号を使って、ライン川の安全な航路を調べよう。",
	["quest.DE01.completion"] = "チャプターDE01クリア！「ライン川の航路図」を手に入れたよ。",
	["quest.DE01.source_note"] = "このチャプターは実際の歴史にもとづいていますが、ゲームのために一部の細部は想像で作られています。",
	["artifact.de_rhine_route_map.name"] = "ライン川の航路図",
	["quest.DE02.title"] = "魔法の歌",
	["quest.DE02.summary"] = "音と光のパズルでまどわすものを見つけ出し、いろいろなバージョンのローレライ伝説を聞こう",
	["quest.DE02.greeting"] = "「魔法の歌」へようこそ！いっしょに力を合わせよう。音と光のパズルでまどわすものを見つけ出し、いろいろなバージョンのローレライ伝説を聞こう。",
	["quest.DE02.completion"] = "チャプターDE02クリア！「ローレライの歌石」を手に入れたよ。",
	["quest.DE02.source_note"] = "これは文学から生まれたものです。実際の出来事の記録ではなく、想像で作られた作品です。",
	["artifact.de_lorelei_songstone.name"] = "ローレライの歌石",
	["quest.DE03.title"] = "水先案内人の選択",
	["quest.DE03.summary"] = "まどわすこだまよりも本物の合図を優先して、船が避難場所にたどり着けるよう手助けしよう",
	["quest.DE03.greeting"] = "「水先案内人の選択」へようこそ！いっしょに力を合わせよう。まどわすこだまよりも本物の合図を優先して、船が避難場所にたどり着けるよう手助けしよう。",
	["quest.DE03.completion"] = "チャプターDE03クリア！「安定の舵」を手に入れたよ。",
	["quest.DE03.source_note"] = "このアクティビティは、お話を伝えるためにゲーム用に作られた創作です。",
	["artifact.de_steady_helm.name"] = "安定の舵",
	["quest.DE04.title"] = "静かな聖杯の間",
	["quest.DE04.summary"] = "神話のお城を探検して、困っている人に気づいてあげよう",
	["quest.DE04.greeting"] = "「静かな聖杯の間」へようこそ！いっしょに力を合わせよう。神話のお城を探検して、困っている人に気づいてあげよう。",
	["quest.DE04.completion"] = "チャプターDE04クリア！「問いかけの間のトークン」を手に入れたよ。",
	["quest.DE04.source_note"] = "これは文学から生まれたものです。実際の出来事の記録ではなく、想像で作られた作品です。",
	["artifact.de_hall_of_questions_token.name"] = "問いかけの間のトークン",
	["quest.DE05.title"] = "どうしたの？",
	["quest.DE05.summary"] = "だまりこむ代わりに、相手の気持ちを思いやって声をかけ、助けになる行動を選ぼう",
	["quest.DE05.greeting"] = "「どうしたの？」へようこそ！いっしょに力を合わせよう。だまりこむ代わりに、相手の気持ちを思いやって声をかけ、助けになる行動を選ぼう。",
	["quest.DE05.completion"] = "チャプターDE05クリア！「癒やしの問いかけの巻物」を手に入れたよ。",
	["quest.DE05.source_note"] = "これは文学作品からのお話だよ。実際にあったできごとの記録ではなく、想像して書かれた物語なんだ。",
	["artifact.de_healing_question_scroll.name"] = "癒やしの問いかけの巻物",
	["quest.DE06.title"] = "よみがえる庭",
	["quest.DE06.summary"] = "みんなで協力して放置された庭をお手入れして、どんな変化があったか記録しよう",
	["quest.DE06.greeting"] = "「よみがえる庭」へようこそ！いっしょに力を合わせよう。みんなで協力して放置された庭をお手入れして、どんな変化があったか記録しよう。",
	["quest.DE06.completion"] = "チャプターDE06クリア！「ドイツの思い出スタンプ」を手に入れたよ。",
	["quest.DE06.source_note"] = "このチャプターは、いまも家族の間で受けつがれている生きた伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.de_german_memory_stamp.name"] = "ドイツの思い出スタンプ",
	["country.CN.name"] = "中国（武陵をモデルにした桃花源の世界）",
	["country.CN.story"] = "桃の花の向こうの谷",
	["country.CN.cultural_warning"] = "Peach Blossom Spring is literary fiction. Chang’e’s moon story has multiple versions and should be introduced as folklore, not fact.",
	["artifact.cn_peach_blossom_keepsake.name"] = "桃の花の記念の品",
	["vocab.CN.taohua"] = "桃花 (táohuā) — 桃の花",
	["vocab.CN.tuanyuan"] = "团圆 (tuányuán) — 心あたたまる再会や、みんなで仲よく集まること",
	["vocab.CN.bianhua"] = "变化 (biànhuà) — 時がたつにつれて自然に移り変わり、新しくなること",
	["npc.cn_elder_lin.name"] = "村の長老 リン（林長老）",
	["npc.cn_fisher_zhou.name"] = "漁師のジョウ（漁師の周おじさん）",
	["npc.cn_orchard_keeper_mei.name"] = "果樹園の番人 メイ（果樹園を守るメイおばさん）",
	["npc.cn_mapmaker_chen.name"] = "地図職人 チェン（地図職人の小陳）",
	["npc.cn_moon_host_yue.name"] = "中秋節の案内役 ユエ（中秋節リーダーのユエ姉さん）",
	["quest.CN01.title"] = "川が曲がるところ",
	["quest.CN01.summary"] = "漁師について川をさかのぼり、花咲く桃の林を見つけよう",
	["quest.CN01.greeting"] = "「川が曲がるところ」へようこそ！いっしょに力を合わせよう。漁師について川をさかのぼり、花咲く桃の林を見つけよう。",
	["quest.CN01.completion"] = "チャプターCN01クリア！「桃の花びら」を手に入れたよ。",
	["quest.CN01.source_note"] = "これは文学作品からのお話だよ。実際にあったできごとの記録ではなく、想像して書かれた物語なんだ。",
	["artifact.cn_blossom_petal.name"] = "桃の花びら",
	["quest.CN02.title"] = "ひみつの谷",
	["quest.CN02.summary"] = "村の人たちと出会い、畑の道具を集めて、橋を直すのを手伝おう",
	["quest.CN02.greeting"] = "「ひみつの谷」へようこそ！いっしょにやってみよう。村の人たちと出会って、畑の道具を集めて、橋を直すのを手伝ってね。",
	["quest.CN02.completion"] = "チャプターCN02クリア！「谷の地図」を手に入れたよ。",
	["quest.CN02.source_note"] = "これは文学から生まれたお話だよ。実際に起きたできごとの記録ではなく、心の中でえがかれた想像の作品なんだ。",
	["artifact.cn_valley_map.name"] = "谷の地図",
	["quest.CN03.title"] = "移りかわりのカレンダー",
	["quest.CN03.summary"] = "季節の作物をくらべて、時が流れるしるしを見つけよう",
	["quest.CN03.greeting"] = "「移りかわりのカレンダー」へようこそ！いっしょにやってみよう。季節の作物をくらべて、時が流れるしるしを見つけてね。",
	["quest.CN03.completion"] = "チャプターCN03クリア！「季節の輪」を手に入れたよ。",
	["quest.CN03.source_note"] = "このチャプターは、今も家族の間で大切に受けつがれているならわしをもとにしているよ。おうちによってちがいがあることもあるんだ。",
	["artifact.cn_season_wheel.name"] = "季節の輪",
	["quest.CN04.title"] = "動く道",
	["quest.CN04.summary"] = "移りかわるルートをたどってみて、覚えたはずの地図がなぜ使えなくなったのか探ってみよう",
	["quest.CN04.greeting"] = "「動く道」へようこそ！いっしょにやってみよう。移りかわるルートをたどって、覚えたはずの地図がどうして使えなくなったのか探ってみてね。",
	["quest.CN04.completion"] = "チャプターCN04クリア！「変化するコンパス」を手に入れたよ。",
	["quest.CN04.source_note"] = "これは文学から生まれたお話だよ。実際に起きたできごとの記録ではなく、心の中でえがかれた想像の作品なんだ。",
	["artifact.cn_changing_compass.name"] = "変化するコンパス",
	["quest.CN05.title"] = "月あかりの手紙",
	["quest.CN05.summary"] = "嫦娥（じょうが）のお話を知り、特別な意味のこめられた月餅（げっぺい）を作ろう",
	["quest.CN05.greeting"] = "「月あかりの手紙」へようこそ！いっしょにやってみよう。嫦娥（じょうが）のお話を知って、特別な意味のこめられた月餅（げっぺい）を作ってね。",
	["quest.CN05.completion"] = "チャプターCN05クリア！「月の手紙」を手に入れたよ。",
	["quest.CN05.source_note"] = "これは伝承（民話）からのお話だよ。いろいろな形で伝えられてきた物語で、実際に起きたできごとの記録ではないんだ。",
	["artifact.cn_moon_letter.name"] = "月の手紙",
	["quest.CN06.title"] = "新しい庭を作ろう",
	["quest.CN06.summary"] = "消えてしまった過去をそのまま真似するのではなく、みんなの新しい庭を作ろう",
	["quest.CN06.greeting"] = "「新しい庭を作ろう」へようこそ！いっしょにやってみよう。消えてしまった過去をそのまま真似するのではなく、みんなの新しい庭を作ってみてね。",
	["quest.CN06.completion"] = "チャプターCN06クリア！「桃花源スタンプ」を手に入れたよ。",
	["quest.CN06.source_note"] = "このチャプターは、今も家族の間で大切に受けつがれているならわしをもとにしているよ。おうちによってちがいがあることもあるんだ。",
	["artifact.cn_peach_spring_stamp.name"] = "桃花源スタンプ",
	["country.JP.name"] = "日本（芭蕉の旅、東北をめぐるルート）",
	["country.JP.story"] = "家へとつづく細道",
	["country.JP.cultural_warning"] = "Bashō’s journey is historical literature; distinguish reconstructed poetic scenes from verified route facts. Haiku examples must be newly authored or rights-cleared translations.",
	["artifact.jp_travelers_ink_brush.name"] = "旅人の筆",
	["vocab.JP.tabi"] = "旅 (tabi) — 季節を感じながら、心をこめて旅をすること",
	["vocab.JP.haiku"] = "俳句 (haiku) — 自然を観察してよむ、短い三行の季節の詩",
	["vocab.JP.kakehashi"] = "架け橋 (kakehashi) — 場所と場所、人と人をつなぐ橋",
	["npc.jp_guide_haruka.name"] = "旅の案内人 はるか",
	["npc.jp_innkeeper_kenji.name"] = "宿の主人 けんじ",
	["npc.jp_bridge_builder_takumi.name"] = "橋大工 たくみ",
	["npc.jp_poet_aoi.name"] = "俳人 あおい",
	["npc.jp_gardener_ren.name"] = "庭師 れん",
	["quest.JP01.title"] = "はじめの一歩",
	["quest.JP01.summary"] = "旅の道具をまとめて、道しるべをえらび、旅人に会おう",
	["quest.JP01.greeting"] = "「はじめの一歩」へようこそ！ いっしょに力を合わせよう。旅の道具をまとめて、道しるべをえらび、旅人に会おう。",
	["quest.JP01.completion"] = "チャプターJP01クリア！「旅人の草履」を手に入れたよ。",
	["quest.JP01.source_note"] = "これは文学から生まれたお話だよ。実際にあったできごとの記録ではなく、想像で作られた作品なんだ。",
	["artifact.jp_travelers_sandal.name"] = "旅人の草履",
	["quest.JP02.title"] = "川渡り",
	["quest.JP02.summary"] = "安全な橋を直すのを手伝って、荷物を運ぼう",
	["quest.JP02.greeting"] = "「川渡り」へようこそ！ いっしょに力を合わせよう。安全な橋を直すのを手伝って、荷物を運ぼう。",
	["quest.JP02.completion"] = "チャプターJP02クリア！「川の橋のしるし」を手に入れたよ。",
	["quest.JP02.source_note"] = "このチャプターは、今も家族の間で受けつがれている伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.jp_river_bridge_token.name"] = "川の橋のしるし",
	["quest.JP03.title"] = "三行の空",
	["quest.JP03.summary"] = "天気を観察して、ヒントを参考に短い季節の詩をよもう",
	["quest.JP03.greeting"] = "「三行の空」へようこそ！ いっしょに力を合わせよう。天気を観察して、ヒントを参考に短い季節の詩をよもう。",
	["quest.JP03.completion"] = "チャプターJP03クリア！「俳句の葉」を手に入れたよ。",
	["quest.JP03.source_note"] = "これは文学から生まれたお話だよ。実際にあったできごとの記録ではなく、想像で作られた作品なんだ。",
	["artifact.jp_haiku_leaf.name"] = "俳句の葉",
	["quest.JP04.title"] = "旅人の宿",
	["quest.JP04.summary"] = "物資を交換して、小さな宿の屋根を直そう",
	["quest.JP04.greeting"] = "「旅人の宿」へようこそ！ いっしょに力を合わせよう。物資を交換して、小さな宿の屋根を直そう。",
	["quest.JP04.completion"] = "チャプターJP04クリア！「宿場のちょうちん」を手に入れたよ。",
	["quest.JP04.source_note"] = "このチャプターは、今も家族の間で受けつがれている伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.jp_waystation_lantern.name"] = "宿場のちょうちん",
	["quest.JP05.title"] = "変わりゆく道",
	["quest.JP05.summary"] = "いろんな時間に景色をたんけんして、変わったところを記録しよう",
	["quest.JP05.greeting"] = "「変わりゆく道」へようこそ！ いっしょに力を合わせよう。いろんな時間に景色をたんけんして、変わったところを記録しよう。",
	["quest.JP05.completion"] = "チャプターJP05クリア！「季節の巻物」を手に入れたよ。",
	["quest.JP05.source_note"] = "これは文学作品から生まれたお話です。そうぞう力で作られたフィクション（物語）であり、実際に起きたできごとの記録ではありません。",
	["artifact.jp_seasonal_scroll.name"] = "季節の巻物",
	["quest.JP06.title"] = "道こそが我が家",
	["quest.JP06.summary"] = "みんなの休み場になる庭を作って、変わりゆく世界での自分の居場所について考えてみよう",
	["quest.JP06.greeting"] = "『道こそが我が家』へようこそ！いっしょに力を合わせよう：みんなの休み場になる庭を作って、変わりゆく世界での自分の居場所について考えてみよう。",
	["quest.JP06.completion"] = "チャプターJP06をクリア！『奥の細道スタンプ』を手に入れたよ。",
	["quest.JP06.source_note"] = "このチャプターは、今も家族の間で受けつがれている生きた伝統をもとにしています。おうちによってやり方がちがうこともあるよ。",
	["artifact.jp_narrow_road_stamp.name"] = "奥の細道スタンプ",
	["country.RU.name"] = "ロシア（スヴェトロヤール湖／キーテジ伝説から生まれた神話の地）",
	["country.RU.story"] = "湖の底の鐘",
	["country.RU.cultural_warning"] = "Kitezh is folklore with historical variants, not a factual submerged city. Avoid romanticizing political violence or presenting spiritual-national exclusivity as moral truth; support plural interpretations.",
	["artifact.ru_kitezh_bell.name"] = "キーテジの鐘",
	["vocab.RU.ozero"] = "озеро (ózero) — 森のすきとおった湖",
	["vocab.RU.gusli"] = "гусли (gúsli) — たくさんの弦をはじいて奏でる伝統的な民俗楽器",
	["vocab.RU.predaniye"] = "предание (predániye) — 世代をこえて口づてに伝えられてきた言い伝え（伝説）",
	["npc.ru_keeper_yelena.name"] = "湖の守り人 エレナ（Хранительница озера Елена）",
	["npc.ru_historian_pavel.name"] = "村の歴史家 パーヴェル（Историк Павел）",
	["npc.ru_musician_ilya.name"] = "旅の音楽家 イリヤ（Музыкант Илья）",
	["npc.ru_archivist_vera.name"] = "記録係 ヴェーラ（Архивист Вера）",
	["npc.ru_carpenter_maksim.name"] = "大工のマクシム（Плотник Максим）",
	["quest.RU01.title"] = "夜明けの鐘",
	["quest.RU01.summary"] = "湖の岸辺にある音のめじるしを見つけて、村の鐘をもと通りに直そう",
	["quest.RU01.greeting"] = "『夜明けの鐘』へようこそ！いっしょに力を合わせよう：湖の岸辺にある音のめじるしを見つけて、村の鐘をもと通りに直そう。",
	["quest.RU01.completion"] = "チャプターRU01をクリア！『湖の鐘のかけら』を手に入れたよ。",
	["quest.RU01.source_note"] = "これは民俗伝承（フォークロア）からのお話です。いくつもの形で語り継がれている言い伝えであり、実際に起きたできごとの記録ではありません。",
	["artifact.ru_lake_bell_fragment.name"] = "湖の鐘のかけら",
	["quest.RU02.title"] = "水面に映る街",
	["quest.RU02.summary"] = "水面の反射で姿を変える、ふしぎな幻の景色を探検しよう",
	["quest.RU02.greeting"] = "『水面に映る街』へようこそ！いっしょに力を合わせよう：水面の反射で姿を変える、ふしぎな幻の景色を探検しよう。",
	["quest.RU02.completion"] = "チャプターRU02をクリア！『反射のプリズム』を手に入れたよ。",
	["quest.RU02.source_note"] = "これは民間伝承から生まれたお話だよ。実際に起きた出来事の記録ではなくて、たくさんの種類のお話として語り継がれてきたものなんだ。",
	["artifact.ru_reflection_prism.name"] = "反射のプリズム",
	["quest.RU03.title"] = "サドコの弦",
	["quest.RU03.summary"] = "民話に登場する音楽家サドコをテーマにしたリズムパズルを遊ぼう",
	["quest.RU03.greeting"] = "『サドコの弦』へようこそ！いっしょに挑戦しよう。民話に登場する音楽家サドコをテーマにしたリズムパズルを遊んでみてね。",
	["quest.RU03.completion"] = "チャプターRU03クリア！グースリのお守りを手に入れたよ。",
	["quest.RU03.source_note"] = "これは民間伝承から生まれたお話だよ。実際に起きた出来事の記録ではなくて、たくさんの種類のお話として語り継がれてきたものなんだ。",
	["artifact.ru_gusli_charm.name"] = "グースリのお守り",
	["quest.RU04.title"] = "水辺の庭",
	["quest.RU04.summary"] = "生き物たちのすみかをこわさずに、おだやかな湖の庭づくりを手伝おう",
	["quest.RU04.greeting"] = "『水辺の庭』へようこそ！いっしょに力を合わせよう。生き物たちのすみかをこわさずに、おだやかな湖の庭づくりを手伝ってね。",
	["quest.RU04.completion"] = "チャプターRU04クリア！アシのリースを手に入れたよ。",
	["quest.RU04.source_note"] = "このチャプターは、今も家族の間で受け継がれている生きた伝統をもとにしているよ。おうちによってやり方が違うこともあるんだ。",
	["artifact.ru_reed_wreath.name"] = "アシのリース",
	["quest.RU05.title"] = "物語の守り手たち",
	["quest.RU05.summary"] = "地域の資料館にキテジの伝説のさまざまなお話を記録しよう",
	["quest.RU05.greeting"] = "『物語の守り手たち』へようこそ！いっしょに力を合わせよう。地域の資料館にキテジの伝説のさまざまなお話を記録してね。",
	["quest.RU05.completion"] = "チャプターRU05クリア！伝説の書を手に入れたよ。",
	["quest.RU05.source_note"] = "これは民間伝承から生まれたお話だよ。実際に起きた出来事の記録ではなくて、たくさんの種類のお話として語り継がれてきたものなんだ。",
	["artifact.ru_legend_folio.name"] = "伝説の書",
	["quest.RU06.title"] = "水の上に浮かぶ物語",
	["quest.RU06.summary"] = "お話の東屋を建てて、昔からの言い伝えと実際に見つかった証拠を見分けよう",
	["quest.RU06.greeting"] = "『水の上に浮かぶ物語』へようこそ！いっしょに力を合わせよう。お話の東屋を建てて、昔からの言い伝えと実際に見つかった証拠を見分けてね。",
	["quest.RU06.completion"] = "チャプターRU06クリア！キテジの記憶スタンプを手に入れたよ。",
	["quest.RU06.source_note"] = "このチャプターは、今も家族の間で受け継がれている生きた伝統をもとにしているよ。おうちによってやり方が違うこともあるんだ。",
	["artifact.ru_kitezh_memory_stamp.name"] = "キテジの記憶スタンプ",
	["country.UA.name"] = "ウクライナ（キーウ建国の丘／みんなの音楽広場）",
	["country.UA.story"] = "歌の守り人",
	["country.UA.cultural_warning"] = "The Kyiv founders are chronicle legends. Kobzar traditions are varied; do not imply all practitioners were blind or use disability as a supernatural device. No graphic violence or combat reenactment.",
	["artifact.ua_bandura_memory_charm.name"] = "バンドゥーラの記憶のお守り",
	["vocab.UA.bandura"] = "бандура (bandúra) — リュートとハープの特徴をあわせ持つウクライナの弦楽器",
	["vocab.UA.dumy"] = "думи (dúmy) — 口づてで受け継がれてきた文化の記憶を守る、歌われる叙事詩",
	["vocab.UA.toloka"] = "толока (tolóka) — みんなで助け合って作ったり直したりする、地域の共同作業の集まり",
	["npc.ua_guide_lybid.name"] = "ガイドのオレナ（リビジ・ルート）（Провідниця Олена）",
	["npc.ua_storyteller_taras.name"] = "歴史の語り部タラス（オポヴィダーチ・タラス）",
	["npc.ua_kobzar_mykola.name"] = "音楽家ミコラ（コブザール・ミコラ）",
	["npc.ua_maker_solomiya.name"] = "楽器職人ソロミヤ（マイストリーニャ・ソロミヤ）",
	["npc.ua_curator_kateryna.name"] = "学芸員カテリーナ（クラートルカ・カテリーナ）",
	["quest.UA01.title"] = "街をひらいた4人",
	["quest.UA01.summary"] = "3つの丘と川を探検しながら、建国伝説の地図を完成させよう",
	["quest.UA01.greeting"] = "「街をひらいた4人」へようこそ！ いっしょにがんばろう：3つの丘と川を探検しながら、建国伝説の地図を完成させよう。",
	["quest.UA01.completion"] = "チャプターUA01クリア！ 「建国者の川の地図」を手に入れたよ。",
	["quest.UA01.source_note"] = "これは民間伝承によるものです。実際に起きたできごとの記録ではなく、さまざまに語り継がれてきたお話です。",
	["artifact.ua_founders_river_map.name"] = "建国者の川の地図",
	["quest.UA02.title"] = "水辺の街",
	["quest.UA02.summary"] = "木と石を集めて、だれもが渡りやすい歩道橋を直そう",
	["quest.UA02.greeting"] = "「水辺の街」へようこそ！ いっしょにがんばろう：木と石を集めて、だれもが渡りやすい歩道橋を直そう。",
	["quest.UA02.completion"] = "チャプターUA02クリア！ 「川の橋のプレート」を手に入れたよ。",
	["quest.UA02.source_note"] = "このチャプターは、いまも家族の間で受け継がれている生きた伝統をもとにしています。家庭によって少しずつやり方がちがうこともあります。",
	["artifact.ua_river_bridge_plaque.name"] = "川の橋のプレート",
	["quest.UA03.title"] = "コブザールの演奏を聴こう",
	["quest.UA03.summary"] = "心をこめて音楽を聴き、呼びかけにこたえる掛け合い（コール＆レスポンス）を学ぼう",
	["quest.UA03.greeting"] = "「コブザールの演奏を聴こう」へようこそ！ いっしょにがんばろう：心をこめて音楽を聴き、呼びかけにこたえる掛け合い（コール＆レスポンス）を学ぼう。",
	["quest.UA03.completion"] = "チャプターUA03クリア！ 「バンドゥーラの弦」を手に入れたよ。",
	["quest.UA03.source_note"] = "このチャプターは、いまも家族の間で受け継がれている生きた伝統をもとにしています。家庭によって少しずつやり方がちがうこともあります。",
	["artifact.ua_bandura_string.name"] = "バンドゥーラの弦",
	["quest.UA04.title"] = "ドゥーマのノート",
	["quest.UA04.summary"] = "口づてに伝わる記憶と記録されたできごとを分けながら、物語の節を集めて順番にならべよう",
	["quest.UA04.greeting"] = "「ドゥーマのノート」へようこそ！ いっしょにがんばろう：口づてに伝わる記憶と記録されたできごとを分けながら、物語の節を集めて順番にならべよう。",
	["quest.UA04.completion"] = "チャプターUA04クリア！ 「ドゥーマのページ」を手に入れたよ。",
	["quest.UA04.source_note"] = "このチャプターは実際の歴史にもとづいていますが、ゲームのために一部のお話は想像で作られています。",
	["artifact.ua_dumy_page.name"] = "ドゥーマのページ",
	["quest.UA05.title"] = "息づく音楽堂",
	["quest.UA05.summary"] = "演奏会場を直して、説明ラベルをつけて楽器をかざろう",
	["quest.UA05.greeting"] = "「息づく音楽堂」へようこそ！ いっしょにがんばろう：演奏会場を直して、説明ラベルをつけて楽器をかざろう。",
	["quest.UA05.completion"] = "チャプターUA05クリア！「木彫りの譜面台」を手に入れたよ！",
	["quest.UA05.source_note"] = "このチャプターは、今も家族の間で受け継がれている生きた伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.ua_carved_music_stand.name"] = "木彫りの譜面台",
	["quest.UA06.title"] = "旅する歌",
	["quest.UA06.summary"] = "オリジナルの新しいメロディやリズムをいっしょに作って、みんなの記録（アーカイブ）に残そう",
	["quest.UA06.greeting"] = "「旅する歌」へようこそ！いっしょに力を合わせよう。オリジナルの新しいメロディやリズムを作って、みんなの記録（アーカイブ）に残そう！",
	["quest.UA06.completion"] = "チャプターUA06クリア！「ウクライナの歌スタンプ」を手に入れたよ！",
	["quest.UA06.source_note"] = "このチャプターは、今も家族の間で受け継がれている生きた伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.ua_ukraine_song_stamp.name"] = "ウクライナの歌スタンプ",
	["country.MA.name"] = "モロッコ（マラケシュ／ジャマ・エル・フナ広場をモデルにした広場）",
	["country.MA.story"] = "息づく人の輪",
	["country.MA.cultural_warning"] = "Al Halqa is a living performance tradition, not one fixed text. Cultural/religious stories, including the Seven Saints, must be reviewed and presented respectfully without assigning sacred characters arbitrary game powers.",
	["artifact.ma_storytellers_circle_drum.name"] = "語り部の輪の太鼓",
	["vocab.MA.halqa"] = "حلقة (ḥalqa) — 語り手のまわりに集まる、参加型の観客の輪",
	["vocab.MA.atay"] = "أتاي (atāy) — 新鮮なスペアミントを入れたモロッコの緑茶",
	["vocab.MA.zellij"] = "زليج (zallīj) — 手作業で切り出された幾何学模様のつや出しタイル細工",
	["npc.ma_hakawati_driss.name"] = "語り部の達人イドリース（الحكواتي المعلم إدريس）",
	["npc.ma_tea_host_kenza.name"] = "お茶のもてなし役ケンザ（لالة كنزة مضيفة أتاي）",
	["npc.ma_merchant_yassine.name"] = "工芸職人の商人ヤシン（الصانع ياسين）",
	["npc.ma_historian_salma.name"] = "歴史家サルマ（المؤرخة سلمى）",
	["npc.ma_performer_amine.name"] = "若きパフォーマー・アミン（الفنان الشاب أمين）",
	["quest.MA01.title"] = "輪に入ろう",
	["quest.MA01.summary"] = "広場を見つけて、見ている人たち（観客）がどうやって物語をいっしょに広げていくのかを学ぼう",
	["quest.MA01.greeting"] = "「輪に入ろう」へようこそ！いっしょにやってみよう。広場を見つけて、見ている人たち（観客）がどうやって物語をいっしょに広げていくのかを学ぼう！",
	["quest.MA01.completion"] = "チャプターMA01クリア！「輪への招待状」を手に入れたよ！",
	["quest.MA01.source_note"] = "このチャプターは、今も家族の間で受け継がれている生きた伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.ma_circle_invitation.name"] = "輪への招待状",
	["quest.MA02.title"] = "たくさんの声で紡ぐ物語",
	["quest.MA02.summary"] = "音や身ぶり、問いかけを選んで、枝分かれしていく語りのお話を作ろう",
	["quest.MA02.greeting"] = "「たくさんの声で紡ぐ物語」へようこそ！いっしょにやってみよう。音や身ぶり、問いかけを選んで、枝分かれしていく語りのお話を作ろう！",
	["quest.MA02.completion"] = "チャプター MA02 クリア！「ハカワティのトークン」を手に入れたよ。",
	["quest.MA02.source_note"] = "これは民間伝承（昔話）にもとづいているよ。実際に起きたことの記録ではなく、いろいろな形で語りつがれてきたお話なんだ。",
	["artifact.ma_hakawati_token.name"] = "ハカワティのトークン",
	["quest.MA03.title"] = "お茶とクラフト",
	["quest.MA03.summary"] = "ミントを集めて火を使わないおもてなしの手順を完成させよう。クラフトのかざりと交換しよう",
	["quest.MA03.greeting"] = "『お茶とクラフト』へようこそ！ 一緒にやってみよう：ミントを集めて火を使わないおもてなしの手順を完成させよう。クラフトのかざりと交換しよう。",
	["quest.MA03.completion"] = "チャプター MA03 クリア！「ミントティーのトレイ」を手に入れたよ。",
	["quest.MA03.source_note"] = "このチャプターは、いまも家族の間で受けつがれている生きた伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.ma_mint_tea_tray.name"] = "ミントティーのトレイ",
	["quest.MA04.title"] = "みんなでかえる物語",
	["quest.MA04.summary"] = "いろいろな結末がある短いお話を一緒に作って、だれが作ったかしっかり残そう",
	["quest.MA04.greeting"] = "『みんなでかえる物語』へようこそ！ 一緒にやってみよう：いろいろな結末がある短いお話を一緒に作って、だれが作ったかしっかり残そう。",
	["quest.MA04.completion"] = "チャプター MA04 クリア！「物語の糸」を手に入れたよ。",
	["quest.MA04.source_note"] = "このアクティビティは、お話をわかりやすく伝えるためにこのゲーム用に考えられたものだよ。",
	["artifact.ma_story_thread.name"] = "物語の糸",
	["quest.MA05.title"] = "知恵の小道",
	["quest.MA05.summary"] = "マラケシュの「7人の聖人」のお話をもとに作られた歴史マップを、敬意を持って探検しよう",
	["quest.MA05.greeting"] = "『知恵の小道』へようこそ！ 一緒にやってみよう：マラケシュの「7人の聖人」のお話をもとに作られた歴史マップを、敬意を持って探検しよう。",
	["quest.MA05.completion"] = "チャプター MA05 クリア！「歴史マップ」を手に入れたよ。",
	["quest.MA05.source_note"] = "このチャプターは実際の歴史にもとづいているけれど、ゲームのために一部想像で作られた内容もふくまれているよ。",
	["artifact.ma_heritage_map.name"] = "歴史マップ",
	["quest.MA06.title"] = "旅するサークル",
	["quest.MA06.summary"] = "小さな語り手ステージを作って、いろんな言葉でみんなで協力しながら発表しよう",
	["quest.MA06.greeting"] = "『旅するサークル』へようこそ！ 一緒にやってみよう：小さな語り手ステージを作って、いろんな言葉でみんなで協力しながら発表しよう。",
	["quest.MA06.completion"] = "チャプター MA06 クリア！「モロッコのサークルスタンプ」を手に入れたよ。",
	["quest.MA06.source_note"] = "このチャプターは、いまも家族の間で受けつがれている生きた伝統をもとにしているよ。おうちによってやり方がちがうこともあるんだ。",
	["artifact.ma_morocco_circle_stamp.name"] = "モロッコのサークルスタンプ",
