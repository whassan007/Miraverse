	["artifact.ma_mint_tea_tray.name"] = "صينية شاي بالنعناع",
	["quest.MA04.title"] = "القصة اللي بنغيرها",
	["quest.MA04.summary"] = "شارك في تأليف حكاية قصيرة بنهايات مختلفة وحافظ على اسم مؤلفها",
	["quest.MA04.greeting"] = "أهلاً بيك في القصة اللي بنغيرها! يلا نشتغل مع بعض: شارك في تأليف حكاية قصيرة بنهايات مختلفة وحافظ على اسم مؤلفها.",
