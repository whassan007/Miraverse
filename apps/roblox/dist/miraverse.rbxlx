	["quest.UA01.completion"] = "كملتي الفصل UA01! ربحتي خريطة واد المؤسسين.",
	["quest.UA01.source_note"] = "هادشي جاي من التراث الشعبي (الفلكلور): قصص كيتعاودو بعدة روايات، وماشي توثيق لأحداث حقيقية.",
	["artifact.ua_founders_river_map.name"] = "خريطة واد المؤسسين",
	["quest.UA02.title"] = "المدينة اللي حدا الما",
	["quest.UA02.summary"] = "جمع الخشب والحجر باش تصلح قنطرة د الراجلين تكون ساهلة للعبور للجميع",
	["quest.UA02.greeting"] = "مرحبا بك فـ المدينة اللي حدا الما! يلاه نخدمو مجموعين: جمع الخشب والحجر باش تصلح قنطرة د الراجلين تكون ساهلة للعبور للجميع.",
	["quest.UA02.completion"] = "كملتي الفصل UA02! ربحتي لوحة قنطرة الواد.",
	["quest.UA02.source_note"] = "هاد الفصل مستوحى من تقاليد حية باقين العائلات كيمارسوها حتى لليوم، وتقدر تختلف من دار لدار.",
	["artifact.ua_river_bridge_plaque.name"] = "لوحة قنطرة الواد",
	["quest.UA03.title"] = "سمع للكوبزار",
	["quest.UA03.summary"] = "تعلم كيفاش تسمع للموسيقى باحترام، وتشارك فـ نشاط ديال الترديد والجواب الموسيقي",
	["quest.UA03.greeting"] = "مرحبا بك فـ سمع للكوبزار! يلاه نخدمو مجموعين: تعلم كيفاش تسمع للموسيقى باحترام، وتشارك فـ نشاط ديال الترديد والجواب الموسيقي.",
	["quest.UA03.completion"] = "كملتي الفصل UA03! ربحتي وتر الباندورا.",
	["quest.UA03.source_note"] = "هاد الفصل مستوحى من تقاليد حية باقين العائلات كيمارسوها حتى لليوم، وتقدر تختلف من دار لدار.",
	["artifact.ua_bandura_string.name"] = "وتر الباندورا",
	["quest.UA04.title"] = "دفتر الدومي",
	["quest.UA04.summary"] = "جمع ورتب مقاطع القصة، وميز بين الذاكرة الشفوية والأحداث الموثقة",
	["quest.UA04.greeting"] = "مرحبا بك فـ دفتر الدومي! يلاه نخدمو مجموعين: جمع ورتب مقاطع القصة، وميز بين الذاكرة الشفوية والأحداث الموثقة.",
	["quest.UA04.completion"] = "كملتي الفصل UA04! ربحتي صفحة الدومي.",
	["quest.UA04.source_note"] = "هاد الفصل مبني على تاريخ حقيقي، مع شي تفاصيل تخيلناها على قبل اللعبة.",
	["artifact.ua_dumy_page.name"] = "صفحة الدوما",
	["quest.UA05.title"] = "قاعة الموسيقى الحية",
	["quest.UA05.summary"] = "صلّح فضاء ديال العروض واعْرض الآلات مع السميات ديالها",
	["quest.UA05.greeting"] = "مرحبا بيك فقاعة الموسيقى الحية! يلا نتعاونو: صلّح فضاء ديال العروض واعْرض الآلات مع السميات ديالها.",
	["quest.UA05.completion"] = "كملتي الفصل UA05! ربحتي حامل نوتات منقوش.",
	["quest.UA05.source_note"] = "هاد الفصل مستوحى من تقاليد حية كيمارسوها العائلات حتى لليوم. وتقدر تختلف من دار لدار.",
	["artifact.ua_carved_music_stand.name"] = "حامل نوتات منقوش",
	["quest.UA06.title"] = "أغاني كتسافر",
	["quest.UA06.summary"] = "تعاون باش تبدع لحن ولا إيقاع جديد وأصيل، وصاوب أرشيف للجماعة",
	["quest.UA06.greeting"] = "مرحبا بيك فـ أغاني كتسافر! يلا نتعاونو: تعاون باش تبدع لحن ولا إيقاع جديد وأصيل، وصاوب أرشيف للجماعة.",
	["quest.UA06.completion"] = "كملتي الفصل UA06! ربحتي طابع أغنية أوكرانيا.",
	["quest.UA06.source_note"] = "هاد الفصل مستوحى من تقاليد حية كيمارسوها العائلات حتى لليوم. وتقدر تختلف من دار لدار.",
	["artifact.ua_ukraine_song_stamp.name"] = "طابع أغنية أوكرانيا",
