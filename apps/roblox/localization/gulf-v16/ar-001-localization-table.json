    {
      "key": "country.ae.mentor.greeting",
      "source": "Marhaba الساع! From the coastal dhow creek to the shaded falaj of Al Ain, let us chart the routes of sea and oasis.",
      "context": "United Arab Emirates (ar-AE) fictional mentor greeting",
      "translations": {
        "ar-001": "مرحبا الساع! من خور المحامل الساحلي إلى ظلال أفلاج العين، يلا نرسم مسارات البحر والواحة.",
        "en-us": "Marhaba الساع! From the coastal dhow creek to the shaded falaj of Al Ain, let us chart the routes of sea and oasis."
      },
      "dialectVariant": "ar-AE",
      "arabizi": "Marhaba il-sa3! Min khor il-mahamil ila wahat Al-3ain, yalla naktashif il-bahr wal-waha."
    },
