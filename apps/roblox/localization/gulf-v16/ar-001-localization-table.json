    {
      "key": "country.kw.mentor.greeting",
      "source": "Ya hala bil-ghalyin! Welcome to the Naq'ah harbor of Kuwait—where every Boom dhow carries a story and every lantern guides friends home.",
      "context": "Kuwait (ar-KW) fictional mentor greeting",
      "translations": {
        "ar-001": "يا هلا بالغاليين! حياكم في نقعة الكويت، حيث يحمل كل بوم حكاية ويهدي كل فنر الأحباب إلى الديرة.",
        "en-us": "Ya hala bil-ghalyin! Welcome to the Naq'ah harbor of Kuwait—where every Boom dhow carries a story and every lantern guides friends home."
      },
      "dialectVariant": "ar-KW",
      "arabizi": "Ya hala bil-ghalyin! Hayyakum fi naq3at il-Kuwait, hayth yahmil kull boom hikaya."
    },
