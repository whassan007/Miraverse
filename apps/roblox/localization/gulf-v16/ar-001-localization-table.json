    {
      "key": "country.qa.mentor.greeting",
      "source": "Hayyakum Allah by the Doha harbor! Let us explore the boatwrights' ledger and the stories of the pearl coast.",
      "context": "Qatar (ar-QA) fictional mentor greeting",
      "translations": {
        "ar-001": "حياكم الله على سيف الدوحة! يلا نكتشف دفتر القلاف وحكايات ساحل اللؤلؤ.",
        "en-us": "Hayyakum Allah by the Doha harbor! Let us explore the boatwrights' ledger and the stories of the pearl coast."
      },
      "dialectVariant": "ar-QA",
      "arabizi": "Hayyakum Allah 3ala seef il-Doha! Yalla niktishif il-lulu wa daftar il-qallaf."
    },
