HistoricalMonumentRegistry.MONUMENTS = MONUMENTS

function HistoricalMonumentRegistry.getMonument(monumentId: string): MonumentDef?
	return MONUMENTS[monumentId]
end

function HistoricalMonumentRegistry.getMonumentsForSite(siteId: string): { MonumentDef }
	local list: { MonumentDef } = {}
	for _, m in MONUMENTS do
		if m.siteId == siteId then
			table.insert(list, m)
		end
	end
	return list
end

return HistoricalMonumentRegistry
